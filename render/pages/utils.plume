ref renderLatexAST: macro(node)
	let tnode = $ type(node) == "table" and node.type? or type(node)
	if tnode == "treeNode"
		if node.label == "+"
			@Table.join(sep: +)
				for x in node.children
					- $ renderLatexAST(x)
				end
			end
		elseif node.label == "-"
			@Table.join(sep: -)
				for x in node.children
					- $ renderLatexAST(x)
				end
			end
		elseif node.label == "number"
			$node.children[1]
		end
	elseif type(node) == "number"
		$node
	else
		raise Unexpected type "$tnode" inside tree.
	end
end