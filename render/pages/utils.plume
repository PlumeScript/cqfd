ref renderLatexAST: macro(node, ?mayPar)
	
	let tnode = $ type(node) == "table" and node.type? or type(node)
	if tnode == "treeNode"
		if mayPar and node.label != "number" and node.label != "bold" and node.label != "*" and node.label != "/"
			(
		end
		if node.label == "+"
			// a sum is a list of signed terms: a unary-minus child is a
			// negative term. Without fullSign the minus is folded into the
			// separator (5-3); with fullSign every term is explicit ((+5)+(-3))
			for i in seq(len(node.children))
				if type(node.children[i]) == "table" and node.children[i].label == "-" and len(node.children[i].children) == 1
					if node.fullSign?
						if i > 1
							+
						end
						(-
						$ renderLatexAST(node.children[i].children[1], ?mayPar)
						)
					else
						\0-
						$ renderLatexAST(node.children[i].children[1], ?mayPar)
					end
				else
					if i > 1
						+
					end
					if node.fullSign?
						(+
						$ renderLatexAST(node.children[i], ?mayPar)
						)
					else
						$ renderLatexAST(node.children[i])
					end
				end
			end
		elseif node.label == "-"
			if len(node.children) > 2
				@Table.join(sep: -)
					for x in node.children
						- $ renderLatexAST(x, ?mayPar)
					end
				end
			elseif len(node.children) == 2
				// the left operand starts the expression: a sum always needs
				// grouping; a bare negative operand is redundant in (-x)-y,
				// except under fullSign where every signed operand is explicit
				if type(node.children[1]) == "table" and node.children[1].label == "+"
					$ renderLatexAST(node.children[1], ?mayPar)
				else
					if node.fullSign? and type(node.children[1]) == "table" and node.children[1].label == "-" and len(node.children[1].children) == 1
						$ renderLatexAST(node.children[1], ?mayPar)
					else
						$ renderLatexAST(node.children[1])
					end
				end
				\0-
				$ renderLatexAST(node.children[2], ?mayPar)
			else
				\0-
				$ renderLatexAST(node.children[1], ?mayPar)
			end
		elseif node.label == "*"
			for i in seq(len(node.children))
				if i > 1
					\\times
				end
				if node.fullSign?
					// full sign: positive factors get (+x), negative factors
					// keep their own (-x) grouping
					if type(node.children[i]) == "table" and node.children[i].label == "-" and len(node.children[i].children) == 1
						$ renderLatexAST(node.children[i], ?mayPar)
					else
						(+
						$ renderLatexAST(node.children[i], ?mayPar)
						)
					end
				else
					$ renderLatexAST(node.children[i], ?mayPar)
				end
			end
		elseif node.label == "^"
			
			$ renderLatexAST(node.children[1], ?mayPar)
			^{
				$ renderLatexAST(node.children[2])
			}
		elseif node.label == "-:"
			// the left operand starts the expression: a sum needs grouping;
			// a signed one is only explicit under fullSign
			if type(node.children[1]) == "table" and node.children[1].label == "+"
				$ renderLatexAST(node.children[1], ?mayPar)
			else
				if node.fullSign? and type(node.children[1]) == "table" and node.children[1].label == "-" and len(node.children[1].children) == 1
					$ renderLatexAST(node.children[1], ?mayPar)
				else
					$ renderLatexAST(node.children[1])
				end
			end
			\\div
			$ renderLatexAST(node.children[2], ?mayPar)
		elseif node.label == "/"
			\\dfrac
			{
				$ renderLatexAST(node.children[1])
			}
			{
				$ renderLatexAST(node.children[2])
			}
		elseif node.label == "<"
			@Table.join(sep: \\lt)
				for x in node.children
					- $ renderLatexAST(x)
				end
			end
		elseif node.label == ">"
			@Table.join(sep: \\gt)
				for x in node.children
					- $ renderLatexAST(x)
				end
			end
		elseif node.label == "number"
			$ Number(node.children[1]).localize()
		elseif node.label == "bold"
			\\mathbf{$renderLatexAST($node.children[1])}
		end
		if mayPar and node.label != "number" and node.label != "bold" and node.label != "*" and node.label != "/"
			)
		end
	elseif type(node) == "number"
		$ Number(node).localize()
	elseif type(node) == "string"
		\\text{$node}
	else
		raise Unexpected type "$tnode" inside tree.
	end
	
end
