ref renderLatexAST: macro(node, ?mayPar)
	
	let tnode = $ type(node) == "table" and node.type? or type(node)
	if tnode == "treeNode"
		if mayPar and node.label != "number" and node.label != "bold" and node.label != "*"
			(
		end
		if node.label == "+"
			@Table.join(sep: +)
				for x in node.children
					- $ renderLatexAST(x)
				end
			end
		elseif node.label == "-"
			if len(node.children) > 1
				@Table.join(sep: -)
					for x in node.children
						- $ renderLatexAST(x, ?mayPar)
					end
				end
			else
				\0-
				$ renderLatexAST(node.children[1], ?mayPar)
			end
		elseif node.label == "*"
			@Table.join(sep: \\times)
				for x in node.children
					- $ renderLatexAST(x, ?mayPar)
				end
			end
		elseif node.label == "^"
			
			$ renderLatexAST(node.children[1], ?mayPar)
			^{
				$ renderLatexAST(node.children[2], ?mayPar)
			}
		elseif node.label == "-:"
			$ renderLatexAST(node.children[1])
			\\div
			$ renderLatexAST(node.children[2], ?mayPar)
		elseif node.label == "/"
			\\frac
			{
				$ renderLatexAST(node.children[1])
			}
			{
				$ renderLatexAST(node.children[2])
			}
		elseif node.label == "<"
			@Table.join(sep: \\lt)
				for x in node.children
					- $ renderLatexAST(x)
				end
			end
		elseif node.label == ">"
			@Table.join(sep: \\gt)
				for x in node.children
					- $ renderLatexAST(x)
				end
			end
		elseif node.label == "number"
			$ Number(node.children[1]).localize()
		elseif node.label == "bold"
			\\mathbf{$renderLatexAST($node.children[1])}
		end
		if mayPar and node.label != "number" and node.label != "bold" and node.label != "*"
			)
		end
	elseif type(node) == "number"
		$ Number(node).localize()
	elseif type(node) == "string"
		\\text{$node}
	else
		raise Unexpected type "$tnode" inside tree.
	end
	
end