let pages = $import(pages)
let ardoise = $import(ardoise) // TODO: Replace by contextual variables (#47)

let names = do
	fr: do
		$("p-3"): milième
		$("p-2"): centième
		$("p-1"): dixième
		$("p0"): unité
		$("p1"): dizaine
		$("p2"): centaine
		$("p3"): milier
		$("p4"): dizaine de millier
		$("p5"): centaine de millier
		$("p6"): milions
		$("p7"): dizaine de milions
		$("p8"): centaine de milions
		$("p9"): miliards
		$("p10"): dizaine de miliards
		$("p11"): centaine de miliards
	end
end

macro plural(name, x, locale)
	if x > 1 and locale == "fr"
		if name.find(" ")
			$name.replace(dizaine, dizaines).replace(centaine, centaines)s
		else
			$name\0s
		end
	else
		$name
	end
end

decimalEnigmaSimple: do
	instruction: macro(question)
		let first = $ question.instruction.firstIndex
		let locale = $ plume.locale()
		let localeName = $ names[locale]? or names.fr

		J'ai\s
		for i in seq(question.instruction.length)
			let x = $question.instruction.figures[i]
			if x != 0
				$pages.formula($x) $ plural(localeName["p"..(i+first)], x, locale)
				if i < question.instruction.length-1
					,\s
				elseif i == question.instruction.length-1
					\set\s
				end
			end
		end
		. Qui suis-je?
	end

	solutionShort: macro(question)
		$pages.formula($question.solution).
	end

	solution: macro(question)
		Je suis $pages.formula($question.solution).
	end
end

decimalEnigmaCalc2: do
	instruction: macro(question)
		Je suis entre $pages.formula($question.instruction.bottom) et $pages.formula($question.instruction.top).\s
		if question.instruction.calc == "+"
			La somme
		elseif question.instruction.calc == "*"
			Le produit
		elseif question.instruction.calc == "-"
			La différence
		elseif question.instruction.calc == "/"
			Le quotient
		end
		\sde mes chiffres vaut $pages.formula($question.instruction.target).
		\sQui suis-je?
		if len(question.solution) > 1
			\s@ardoise.hint \0(Aide: $(len(question.solution)) possibilités.)
		end
	end

	solutionShort: macro(question)
		@Table.join(sep:\s;\s)
			for x in question.solution
				- $pages.formula($x)
			end
		end
	end

	solution: macro(question)
		Je suis @Table.join(sep:\sou\s)
			for x in question.solution
				- $pages.formula($x)
			end
		end
	end
end

decimalDecomposition: do
	macro makeSolution(question)
		@Table.join(sep: +)
			for i in seq(question.solution.length, 1, -1)
				let exp = $ question.solution.firstIndex + i - 1
				if question.solution.figures[i] != 0
					- if exp >= 0
						$question.solution.figures[i] \\times $(10^exp)
					else
						\\frac {$question.solution.figures[i]} {$(10^(-exp))}
					end
				end
			end
		end
	end

	instruction: macro(question)
		$pages.formula($question.instruction)
	end

	solutionShort: macro(question)
		$pages.formula($makeSolution($question))
	end

	solution: macro(question)
		$pages.formula($question.instruction = $makeSolution($question))
	end
end

inverseDecomposition: do
	macro makeSolution(question)
		@Table.join(sep: +)
			for i in seq(question.solution.length, 1, -1)
				let exp = $ question.solution.firstIndex + i - 1
				if question.solution.figures[i] != 0
					- if exp >= 0
						$question.solution.figures[i] \\times $(10^exp)
					else
						\\frac {$question.solution.figures[i]} {$(10^(-exp))}
					end
				end
			end
		end
	end

	instruction: macro(question)
		$pages.formula($makeSolution($question))
	end

	solutionShort: macro(question)
		$pages.formula($question.instruction)
	end

	solution: macro(question)
		$pages.formula($makeSolution($question) = $question.instruction)
	end
end