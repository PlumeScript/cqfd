let pages = $import(pages)
let Renderer from $import(../../core/cls/renderer)
let ardoise = $import(ardoise) // TODO: Replace by contextual variables (#47)

@Renderer(pages)
	macro guessColumnsNumber(n)
		if (n^0.5).floor() == n^0.5
			return $ n^0.5
		else
			for m in (3, 2, 1)
				if n%m==0
					return $m
				end
			end
		end
	end

	macro id(content, item)
		$content
	end
	batch: do
		any: macro(mode, batch, renderer)
			let render = $ batch.overwriteRender?[mode]? or id
			if mode == "instruction" and batch.instruction
				@ardoise.instruction $batch.instruction
			end
			@pages.List
				// Options
				gap: 1
				indent: 0
				marker: $ (batch.styleOptn.m? or "%a")
				columns: $ batch.styleOptn.c? or guessColumnsNumber(len(batch.items))
				...batch.styleOptn
				// Content
				for item in batch.items
					- $ render(item.render(mode, renderer: renderer), item)
				end
			end
		end
	end

	...import(./decimal)
	...import(./applyFormula)
	...import(./drawSolid)
	...import(./calcul)
	...import(./logic)
	...import(./draw)
	...import(./comp)
	...import(./problem)
	...import(./eq)
end