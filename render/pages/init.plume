let pages = $import(pages)
let Renderer from $import(../../core/cls/renderer)
let renderLatexAST from $import(./utils)
let ardoise = $import(ardoise) // TODO: Replace by contextual variables (#47)

@Renderer(pages)
	calcul: do
		instruction:macro(question)
			$ pages.formula(renderLatexAST(question.instruction))
		end
		solutionShort: macro(question)
			$ pages.formula(renderLatexAST(question.solution))
		end
		solution: macro(question)
			@pages.formula
				$ renderLatexAST(question.instruction)
				=
				$ renderLatexAST(question.solution)
			end
		end
	end

	macro guessColumnsNumber(n)
		if (n^0.5).floor() == n^0.5
			return $ n^0.5
		else
			for m in (3, 2, 1)
				if n%m==0
					return $m
				end
			end
		end
	end


	batch: do
		any: macro(mode, batch, renderer)
			if mode == "instruction" and batch.instruction
				@ardoise.instruction $batch.instruction
			end
			@pages.List
				// Options
				gap: 1
				indent: 0
				marker: $ (batch.styleOptn.m? or "%a")
				columns: $ batch.styleOptn.c? or guessColumnsNumber(len(batch.items))
				...batch.styleOptn
				// Content
				for item in batch.items
					- $ item.render(mode, renderer: renderer)
				end
			end
		end
	end

	...import(./decimal)
	...import(./applyFormula)
	...import(./drawSolid)
end