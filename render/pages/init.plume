let pages = $import(pages)
let Renderer from $import(../../core/cls/renderer)
let renderLatexAST from $import(./utils)

@Renderer(pages)
	calcul: do
		instruction:macro(question)
			$ pages.formula(renderLatexAST(question.instruction))
		end
		solutionShort: macro(question)
			$ pages.formula(renderLatexAST(question.solution))
		end
		solution: macro(question)
			@pages.formula
				$ renderLatexAST(question.instruction)
				=
				$ renderLatexAST(question.solution)
			end
		end
	end

	batch: do
		any: macro(mode, batch, renderer)
			if mode == "instruction"
				$batch.instruction?
			end
			@pages.List(...batch.styleOptn)
				for item in batch.items
					- $ item.render(mode, renderer: renderer)
				end
			end
		end
	end

	...import(./decimalEnigma)
	...import(./applyFormula)
end