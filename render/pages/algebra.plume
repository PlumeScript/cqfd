let pages = $import(pages)
let ardoise = $import(ardoise)
let renderLatexAST from $import(./utils)

eq: do
	instruction:macro(question)
		$ pages.formula(String(question.steps[1]), ?display)
	end
	solutionShort: macro(question)
		@pages.formula(?display)
			$ String(Table.at(question.steps, -1))
		end
	end
	solution: macro(question)
		@pages.formula(?display)
			$ String(question.steps[1])
			=
			$ String(question.steps[2])
		end
		for i in seq(3, len(question.steps))
			$pages.newline
			@pages.formula(?display)
				=
				$ String(question.steps[i])
			end
		end
	end
end

eqn: do
	instruction:macro(question)
		@pages.formula(?display)
			$ String(question.steps[1].l)
			=
			$ String(question.steps[1].r)
		end
	end
	solutionShort: macro(question)
		if question.steps.finalLabel?
			@pages.Align(?center) $question.steps.finalLabel
		else
			@pages.box
				@pages.formula(?inlineDisplay)
					$ String(Table.at(question.steps, -1).l.pretty())
					=
					$ String(Table.at(question.steps, -1).r.pretty())
				end
				if Table.at(question.steps, -1).r2?
					\sou\s
					@pages.formula(?inlineDisplay)
						$ String(Table.at(question.steps, -1).l)
						=
						$ String(Table.at(question.steps, -1).r2)
					end
				end
			end
		end
	end
	solution: macro(question)
		let last
		@pages.EqnAlign(boxLast: $(not question.steps.finalLabel?), ?display)
			for i, step in enumerate(question.steps)
				let current =  $(String(step.l))=$(String(step.r))
				if current != last
					set last = $current
					- do
						- do
							$ String(step.l)
							=
							$ String(step.r)
							if step.r2?
								\\text{\sou\s}
								$ String(step.l)
								=
								$ String(step.r2)
							end
						end
					end
				end
			end
		end
		@pages.Align(?center) $question.steps.finalLabel?
	end
end

eval: do
	instruction:macro(question)
		Si\s
		@pages.formula
			$question.instruction.letter
			=
			$question.instruction.value
		end
		, alors\s
		@pages.formula
			$ renderLatexAST(question.instruction.calc)
			=
			\0...
		end
	end
	solutionShort: macro(question)
		@pages.formula
			$ renderLatexAST(question.solution)
		end
	end
	solution: macro(question)
		Si\s
		@pages.formula
			$question.instruction.letter
			=
			$question.instruction.value
		end
		, alors\s
		@pages.formula
			$ renderLatexAST(question.instruction.calc)
			=
			$ renderLatexAST(question.solutionCalc)
			=
			$ renderLatexAST(question.solution)
		end
	end
end

evalCheck: do
	instruction:macro(question)
		if question.alt?
			@pages.formula
				$ renderLatexAST(question.instruction.left)
				=
				$ renderLatexAST(question.instruction.right)
			end
			\s$pages.bold(si)\s
			@pages.formula
				$question.instruction.letter
				=
				$question.instruction.value
			end
		else
			@pages.formula
				$question.instruction.value
			end
			\sest solution de l'équation\s
			@pages.formula
				$ renderLatexAST(question.instruction.left)
				=
				$ renderLatexAST(question.instruction.right)
			end
		end
	end
	solutionShort: macro(question)
		if question.solution
			Vrai.
		else
			Faux.
		end
	end
	solution: macro(question)
		@pages.formula
			$ renderLatexAST(question.solutionCalcLeft)
			=
			$ renderLatexAST(question.validResultLeft)
			if not question.solution
				\\neq
				$ renderLatexAST(question.instruction.right)
			end
		end
		\sdonc\s
		if question.solution
			c'est vrai.
		else
			c'est faux.
		end
	end
end

reduceBoth: do
	instruction:macro(question)
		let opp = $question.instruction.calc[1]
		let value = $question.instruction.calc[2]

		if opp=="*" and value<0
			set value = ($value)
		end
		Faites $pages.hspace(1)$pages.box($pages.underline($pages.formula($opp$value, ?inlineDisplay))) à chaque membre de
		$pages.hspace(2)
		@pages.box @pages.formula(?inlineDisplay)
			$question.instruction.eqn.l
			=
			$question.instruction.eqn.r
		end
		, puis réduisez.
		
	end
	solutionShort: macro(question)
		@pages.box @pages.formula(?inlineDisplay)
			$ String(Table.at(question.steps, -1).l)
			=
			$ String(Table.at(question.steps, -1).r)
		end
	end
	solution: macro(question)
		@pages.EqnAlign(?display, ?boxLast)
			for step in question.steps
				- do
					- $ String(step.l)
					- =
					- $ String(step.r)
				end
			end
		end
	end
end