let pages = $import(pages)
let ardoise = $import(ardoise)
let renderLatexAST from $import(./utils)

eq: do
	instruction:macro(question)
		$ pages.formula(String(question.steps[1]), ?display)
	end
	solutionShort: macro(question)
		@pages.formula(?display)
			$ String(Table.at(question.steps, -1))
		end
	end
	solution: macro(question)
		@pages.formula(?display)
			$ String(question.steps[1])
			=
			$ String(question.steps[2])
		end
		for i in seq(3, len(question.steps))
			$pages.newline
			@pages.formula(?display)
				=
				$ String(question.steps[i])
			end
		end
	end
end

eqn: do
	instruction:macro(question)
		@pages.formula(?display)
			$ String(question.steps[1].l.pretty())
			=
			$ String(question.steps[1].r.pretty())
		end
	end
	solutionShort: macro(question)
		@pages.box @pages.formula(?display)
			$ String(Table.at(question.steps, -1).l.pretty())
			=
			$ String(Table.at(question.steps, -1).r.pretty())
		end
	end
	solution: macro(question)
		@pages.EqnAlign(boxLast: $(not question.steps.finalLabel?))
			for step in question.steps
				- do
					- $ String(step.l.pretty())
					- =
					- $ String(step.r.pretty())
					if step.r2?
						- ou
						- $ String(step.l.pretty())
						- =
						- $ String(step.r2.pretty())
					end
				end
			end
		end
		$question.steps.finalLabel?
	end
end

eval: do
	instruction:macro(question)
		Si\s
		@pages.formula
			$question.instruction.letter
			=
			$question.instruction.value
		end
		, alors\s
		@pages.formula
			$ renderLatexAST(question.instruction.calc)
			=
			\0...
		end
	end
	solutionShort: macro(question)
		@pages.formula
			$ renderLatexAST(question.solution)
		end
	end
	solution: macro(question)
		Si\s
		@pages.formula
			$question.instruction.letter
			=
			$question.instruction.value
		end
		, alors\s
		@pages.formula
			$ renderLatexAST(question.instruction.calc)
			=
			$ renderLatexAST(question.solutionCalc)
			=
			$ renderLatexAST(question.solution)
		end
	end
end

evalCheck: do
	instruction:macro(question)
		if question.alt?
			@pages.formula
				$ renderLatexAST(question.instruction.left)
				=
				$ renderLatexAST(question.instruction.right)
			end
			\s$pages.bold(si)\s
			@pages.formula
				$question.instruction.letter
				=
				$question.instruction.value
			end
		else
			@pages.formula
				$question.instruction.value
			end
			\sest solution de l'équation\s
			@pages.formula
				$ renderLatexAST(question.instruction.left)
				=
				$ renderLatexAST(question.instruction.right)
			end
		end
	end
	solutionShort: macro(question)
		if question.solution
			Vrai.
		else
			Faux.
		end
	end
	solution: macro(question)
		@pages.formula
			$ renderLatexAST(question.solutionCalcLeft)
			=
			$ renderLatexAST(question.validResultLeft)
			if not question.solution
				\\neq
				$ renderLatexAST(question.instruction.right)
			end
		end
		\sdonc\s
		if question.solution
			c'est vrai.
		else
			c'est faux.
		end
	end
end

reduceBoth: do
	instruction:macro(question)
		let opp = $question.instruction.calc[1]
		let value = $question.instruction.calc[2]

		if opp=="*" and value<0
			set value = ($value)
		end
		Faîtes $pages.hspace(1)$pages.box($pages.underline($pages.formula($opp$value))) à chaque membre de
		$pages.hspace(2)
		@pages.box @pages.formula
			$question.instruction.eqn.l.pretty()
			=
			$question.instruction.eqn.r.pretty()
		end
		, puis réduisez.
		
	end
	solutionShort: macro(question)
		a
	end
	solution: macro(question)
		@pages.EqnAlign
			for step in question.steps
				- do
					- $ String(step.l.pretty())
					- =
					- $ String(step.r.pretty())
				end
			end
		end
	end
end