let pages = $import(pages)
let ardoise = $import(ardoise)
let renderLatexAST from $import(./utils)

problem: do
	instruction:macro(question)
		$question.instruction
	end
	solution: macro(question)
		let eq = if question.approx?
			\\approx
		else
			=
		end
		@ardoise.formula
			if not question.solutionHideCalcul?
				$ renderLatexAST(question.step)
				$eq
			end
			$ renderLatexAST(question.solution)
		end
		$pages.newline
		$question.answer
	end
end

problemInv: do
	instruction:macro(question)
		let eq = if question.src.approx?
			\\approx
		else
			=
		end
		@pages.formula
			if not question.src.solutionHideCalcul?
				$renderLatexAST($question.src.step)
				$eq
			end
			$renderLatexAST($question.src.solution)
		end
	end
	solution: macro(question)
		Une réponse parmi d'autres: $ardoise.hint($question.src.render(instruction))
	end
end