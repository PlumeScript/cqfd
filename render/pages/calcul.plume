let pages = $import(pages)
let ardoise = $import(ardoise)
let renderLatexAST from $import(./utils)

calcul: do
	instruction:macro(question)
		$ pages.formula(renderLatexAST(question.instruction))
	end
	solutionShort: macro(question)
		$ pages.formula(renderLatexAST(question.solution))
	end
	solution: macro(question)
		@pages.formula
			$ renderLatexAST(question.instruction)
			=
			$ renderLatexAST(question.solution)
		end
	end
end

calculHole: do
	instruction:macro(question)
		@pages.formula
			$ renderLatexAST(question.instruction)
			=
			$ renderLatexAST(question.target)
		end
	end
	solutionShort: macro(question)
		$ pages.formula(renderLatexAST(question.solution))
	end
	solution: macro(question)
		@pages.formula
			$ renderLatexAST(question.completed)
			=
			$ renderLatexAST(question.target)
		end
	end
	solutionLong: macro(question)
		@pages.List(indent: 0)
			- @ardoise.hint
				@pages.formula
					$ renderLatexAST(question.solutionCalc)
					=
					$ renderLatexAST(question.solution)
				end
			end
			- @pages.formula
				$ renderLatexAST(question.completed)
				=
				$ renderLatexAST(question.target)
			end
		end
	end
end

calculHoleNoSolution: do
	instruction:macro(question)
		@pages.formula
			$ renderLatexAST(question.instruction)
			=
			$ renderLatexAST(question.target)
		end
	end
	solutionShort: macro(question)
		Impossible
	end
	solution: macro(question)
		Impossible car\s
		@pages.formula
			$ renderLatexAST(question.solution)
		end
		.
	end
end

pbCalcN2: do
	macro cap(x)
		$x.sub(1).upper()$x.sub(2, -1)
	end
	macro getName(question, first)
		if question.name?
			have: if first
				$question.name[1] a
			elseif question.name[2] == "m"
				il a
			else
				elle a
			end
			// "en" form of the conjugated verb: "il en a" / "j'en ai"
			haveEn: if first
				$question.name[1] en a
			elseif question.name[2] == "m"
				il en a
			else
				elle en a
			end
			had: if first
				$question.name[1] avait
			elseif question.name[2] == "m"
				il avait
			else
				elle avait
			end
			qhave: if question.name[2] == "m"
				a-t-il
			else
				a-t-elle
			end
			qhad: if question.name[2] == "m"
				avait-il
			else
				avait-elle
			end
		else
			have: j'ai
			haveEn: j'en ai
			had: j'avais
			qhave: ai-je
			qhad: avais-je
		end
	end
	instruction:macro(question)
		if question.instructions.unknown != "x"
			$cap($getName($question, $true).had) $pages.formula($question.values.x) $question.context.unit.\s
		end

		if question.instructions.unknown != "y"
			// en-form only when the noun was already stated (start sentence rendered)
			let introduced = $ (question.instructions.unknown == "z")
			let name = $ getName(question, question.instructions.unknown == "x")
			if question.instructions.isLoss
				$question.context.sentence.lose($name, $pages.formula($question.values.y), $question.context.unit, $introduced)
			else
				$question.context.sentence.get($name, $pages.formula($question.values.y), $question.context.unit, $introduced)
			end
		end

		let name = $ getName(question, false)
		if question.instructions.unknown != "z"
			\s$question.context.sentence.now($name, $pages.formula($(question.values.z)), $question.context.unit)\s
		end

		// trap: useless extra info provided by the context
		if question.trap and question.context.sentence.trap?
			\s$question.context.sentence.trap($name)
		end

		if question.instructions.unknown == "x"
			\s$question.context.sentence.qstart($name)
		elseif question.instructions.unknown == "y"
			\s
			if question.instructions.isLoss
				$question.context.sentence.qlose($name)
			else
				$question.context.sentence.qget($name)
			end
		else
			\s$question.context.sentence.qtotal($name)
		end
	end
	solution: macro(question)
		let name = $ getName(question, true)
		$pages.formula($renderLatexAST($question.calcul) = $question.solution).\s
		let value = $pages.formula($question.solution)
		let introduced = $ (question.instructions.unknown == "z")
		if question.instructions.unknown == "x"
			\s$question.context.sentence.start($name, $value, $question.context.unit)
		elseif question.instructions.unknown == "y"
			if question.instructions.isLoss
				$question.context.sentence.lose($name, $value, $question.context.unit, $introduced)
			else
				$question.context.sentence.get($name, $value, $question.context.unit, $introduced)
			end
		else
			// dispatch here (not in the sentence template): named and plain
			// gain share the same shape, only loss differs
			if question.name?
				\s$question.context.sentence.total($name, $value, $question.context.unit)
			elseif question.instructions.isLoss
				\s$question.context.sentence.totalLoss($name, $value, $question.context.unit)
			else
				\s$question.context.sentence.total($name, $value, $question.context.unit)
			end
		end
	end
end

pbMulX: do
	instruction:macro(question)
		let start = $ question.context.start
		if start + question.instructions.depth > len(question.context.voc)
			set start = $ len(question.context.voc) - question.instructions.depth
		end
		let depth = $question.instructions.depth
		let sent = $question.context.sentence
		$ sent.starts[start](pages.formula(question.values[1]))
		for i in seq(1, depth)
			\s$ sent.trans[start+i-1](pages.formula(question.values[i+1]))
		end
		// trap: the level below the target, useless for the answer
		if question.trap and start+depth+1 <= len(question.context.voc) and depth+2 <= len(question.context.values)
			\s$ sent.trans[start+depth](pages.formula(question.context.values[depth+2]))
		end
		\s$ sent.q[start+depth]()
	end
	solution: macro(question)
		let start = $ question.context.start
		if start + question.instructions.depth > len(question.context.voc)
			set start = $ len(question.context.voc) - question.instructions.depth
		end

		$pages.formula($renderLatexAST($question.calcul) = $question.solution).\s
		$ question.context.sentence.a[start+question.instructions.depth](pages.formula(question.solution))
	end
end