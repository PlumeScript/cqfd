let pages = $import(pages)

logic: do
	instruction:macro(question)
		$question.instruction
	end
	solution: macro(question)
		if question.solution
			Vrai.
		else
			Faux.
		end

		if question.solutionTip?
			\s$question.solutionTip
		end
	end
end