let pages = $import(pages)
let ardoise = $import(ardoise)

logic: do
	instruction:macro(question)
		$question.instruction
	end
	solutionShort: macro(question)
		if question.solution
			Vrai.
		else
			Faux.
		end

		if question.solutionTip?
			\s$question.solutionTip
		end
	end
	solution: macro(question)
		@ardoise.quote $question.instruction
		\s—\s
		@ardoise.important
			if question.solution
				vrai.
			else
				faux.
			end
		end

		if question.solutionTip?
			\s$question.solutionTip
		end
	end
end