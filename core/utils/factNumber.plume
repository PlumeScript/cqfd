let primes = (2, 3, 5, 7, 11, 13)

macro getNextPrime()
	let candidate = $ Table.at(primes, -1)+1
	let index = 0
	while true
		set index += 1
		if candidate % primes[index] == 0
			set candidate += 1
			set index = 0
		elseif index == len(primes)
			break
		end
	end
	run $ Table.append(primes, candidate)
end

ref FactNumberCls: do
	fromNumber: macro(x)
		if x != x.floor()
			raise x must be an integer
		end
		@FactNumberCls
			if x>0
				sign: 1
			elseif x<0
				sign: -1
				set x *= -1
			end

			if x>0
				let i=0
				while x>1
					set i += 1
					if i > len(primes)
						run $getNextPrime()
					end
					let p = $primes[i]
					let vp = 1
					while x % p^vp == 0
						set vp += 1
					end
					set x /= $ p^(vp-1)
					- $(vp-1)
				end
			else
				isZero: $true
			end
		end
	end

	meta call: macro(sign: 1, isZero: $false, ...vp)
		type: Number
		vp: $vp
		let value = $sign
		for i, vi in enumerate(vp)
			set value *= $ primes[i] ^ vi
		end
		value: if isZero
			0
		else
			$value
		end
		sign: $sign
		meta tostring: macro()
			$value
		end
		id: $value
		gcd: macro(x)
			if type(x) == "number"
				set x = $ FactNumberCls.fromNumber(x)
			end
			@FactNumberCls
				for i in seq(max(len(self.vp), len(x.vp)))
					- $ min(self.vp[i]? or 0, x.vp[i]? or 0)
				end
			end
		end

		lcm: macro(x)
			if type(x) == "number"
				set x = $ FactNumberCls.fromNumber(x)
			end
			@FactNumberCls
				for i in seq(max(len(self.vp), len(x.vp)))
					- $ max(self.vp[i]? or 0, x.vp[i]? or 0)
				end
			end
		end

		meta mul: macro(x, y)
			if y != self
				set x, y = ($y, $x)
			end
			if type(x) == "number"
				set x = $ FactNumberCls.fromNumber(x)
			end

			return if x.value==0 or y.value==0
				$FactNumberCls(isZero: $true)
			else
				@FactNumberCls
					sign: $ x.sign * y.sign
					for i in seq(max(len(self.vp), len(x.vp)))
						- $ (self.vp[i]? or 0) + (x.vp[i]? or 0)
					end
				end
			end
		end
	end
end