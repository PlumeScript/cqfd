let primes = (2, 3, 5, 7, 11, 13)

ref FactNumberCls: do
	fromNumber: macro(x)
		@FactNumberCls
			for p in primes
				let vp = 1
				while x % p^vp == 0
					set vp += 1
				end
				- $(vp-1)
			end
		end
	end

	meta call: macro(...vp)
		type: Number
		vp: $vp
		let value = 1
		for i, vi in enumerate(vp)
			set value *= $ primes[i] ^ vi
		end
		value: $value
		meta tostring: macro()
			$value
		end
		id: $value
		gcd: macro(x)
			if type(x) == "number"
				set x = $ FactNumberCls.fromNumber(x)
			end
			@FactNumberCls
				for i in seq(len(primes))
					- $ min(self.vp[i]? or 0, x.vp[i]? or 0)
				end
			end
		end

		lcm: macro(x)
			if type(x) == "number"
				set x = $ FactNumberCls.fromNumber(x)
			end
			@FactNumberCls
				for i in seq(len(primes))
					- $ max(self.vp[i]? or 0, x.vp[i]? or 0)
				end
			end
		end

		meta mul: macro(x, y)
			if y != self
				set x, y = ($y, $x)
			end
			if type(x) == "number"
				set x = $ FactNumberCls.fromNumber(x)
			end
			@FactNumberCls
				for i in seq(len(primes))
					- $ (self.vp[i]? or 0) + (x.vp[i]? or 0)
				end
			end
		end
	end
end