macro isExpression(x)
	$ type(x) == "table" and x.type? == "Expression"
end

let Expression
macro makeExpression(x)
	if isExpression(x)
		return $x
	end

	if type(x) == "table"
		raise Cannot convert a table to an expression
	elseif type(x) == "string" and not x.isNumber()
		return $ Expression(left: x, kind: "symbol")
	elseif (type(x) == "string" and x.isNumber()) or type(x) == "number"
		return $ Expression(left: Number(x), kind: "number")
	else
		raise Cannot convert a `$type($x)` to an expression
	end
end

macro paren(x)
	if isExpression(x) and (x.kind == "add" or x.kind == "sub")
		($String($x))
	else
		$String($x)
	end
end

macro flattensum(x)
	if isExpression(x) and x.kind == "add"
		return (...flattensum($x.left), ...flattensum($x.right))
	elseif isExpression(x) and x.kind == "sub"
		return (...flattensum($x.left), ...flattensum($(-1*x.right).reduce()))
	else
		return $Table($x)
	end
end

macro flattenprod(x)
	if isExpression(x) and x.kind == "mul"
		return (...flattenprod($x.left), ...flattenprod($x.right))
	else
		return $Table($x)
	end
end

// True when t carries a minus: a negative number, or a mul with exactly one
// negative number factor.
macro isNegativeTerm(t)
	if isExpression(t) and t.kind == "number"
		return $ t.left < 0
	end
	if isExpression(t) and t.kind == "mul"
		let nl = $ isExpression(t.left) and t.left.kind == "number" and t.left.left < 0
		let nr = $ isExpression(t.right) and t.right.kind == "number" and t.right.left < 0
		return $ (nl and not nr) or (nr and not nl)
	end
	return $false
end

// The positive twin of a negative term (25, or the mul without its minus).
// A coefficient of -1 leaves no coefficient: the twin of -x is x, not 1x.
macro positivePart(t)
	if isExpression(t) and t.kind == "number"
		let n = $ -t.left
		return $ makeExpression(n)
	end
	if isExpression(t) and t.kind == "mul"
		if isExpression(t.left) and t.left.kind == "number" and t.left.left < 0
			let n = $ -t.left.left
			if n == 1
				return $t.right
			end
			return $ makeExpression(n) * t.right
		end
		if isExpression(t.right) and t.right.kind == "number" and t.right.left < 0
			let n = $ -t.right.left
			if n == 1
				return $t.left
			end
			return $ t.left * makeExpression(n)
		end
	end
	return $t
end

// A factor tostring can render bare inside a product: a number, a symbol,
// a symbol-based pow, or a sum (paren() keeps it grouped).
macro isLeafFactor(f)
	if isExpression(f) and (f.kind == "number" or f.kind == "symbol" or f.kind == "add" or f.kind == "sub")
		return $true
	end
	if isExpression(f) and f.kind == "pow" and isExpression(f.left) and f.left.kind == "symbol"
		return $true
	end
	return $false
end

// Table(c: <number expr>, u: <factor expr>) when t is a bare factor (c = 1) or
// a number×factor mul (either order); empty otherwise.
macro unitTerm(t)
	if not isExpression(t)
		return $empty
	end
	if t.kind == "mul"
		if isExpression(t.left) and t.left.kind == "number" and isExpression(t.right) and t.right.kind != "number"
			return (c:$t.left, u: $t.right)
		end
		if isExpression(t.right) and t.right.kind == "number" and isExpression(t.left) and t.left.kind != "number"
			return (c: $t.right, u: $t.left)
		end
		return (c: $makeExpression(1), u: $t)
	end
	return (c: $makeExpression(1), u: $t)
end


set Expression = macro(kind:, left:, right:)
	type: Expression
	kind: $kind
	left: $left
	right: $right
	
	meta tostring: macro()
		if kind == "symbol" or kind == "number"
			$left
		elseif kind == "add"
			// Faithful (issue #175): the tree as is — a negative addend keeps
			// its own sign (x + -5, -3 + x). Inelegant but meaningful; the
			// subtraction forms (x - 5, x - 3) are built by pretty, which
			// rewrites a negative addend into a sub.
			$ String(left)
			\s+\s
			$ String(right)
		elseif kind == "sub"
			$ String(left)
			// x - (y + z) is distributed term by term: x - y - z, a negative
			// term being re-added: x - (y - 3) → x - y + 3 (a right-side sub
			// distributes too, since pretty rewrites x + -3 into x - 3);
			// a negative right operand is kept grouped: x - -5 → x - (-5).
			if isExpression(right) and (right.kind == "add" or right.kind == "sub")
				let flat = $ flattensum(right)
				for i in seq(1, len(flat))
					let t = $flat[i]
					if isNegativeTerm(t)
						\s+\s
						$ String(positivePart(t))
					else
						\s-\s
						$ String(t)
					end
				end
			elseif isNegativeTerm(right)
				\s-\s
				(
				$ String(right)
				)
			else
				\s-\s
				$ paren(right)
			end
		elseif kind == "mul"
			// Faithful render (issue #175): the factors in their own tree
			// order, and no algebra — no coefficient merging, no
			// number-first reordering, no 1/-1 folding (that is pretty's
			// and reduce's job); flattenprod only unfolds the mul nodes.
			// A factor tightens to its predecessor when the whole chain is
			// clean (leaves only) and the pair cannot be misread: a bare
			// number only at the head of a run (2x, xy, 5x², 2(x+1) —
			// never 23, x2 or (x+1)3) and no bare symbol next to a
			// symbol-based pow (x² \times x — x²x would read as x³); sums
			// stay parenthesized; any impure factor (div, compound pow)
			// keeps \times all along. A leading -1 is the sign of the
			// product (-x, -x², -(x+1)); a non-leading minus number is
			// grouped: x \times (-3).
			let flat = $ flattenprod(self)
			let simple = $true
			for i in seq(1, len(flat))
				let f = $flat[i]
				if not isLeafFactor(f)
					set simple = $false
				end
			end
			let f1 = $flat[1]
			let f2 = $ len(flat) > 1 and flat[2]
			let leadMinus = $ simple and isExpression(f1) and f1.kind == "number" and f1.left == -1 and not (isExpression(f2) and f2.kind == "number")
			let prevSy = $false
			let prevPow = $false
			for i in seq(1, len(flat))
				let f = $flat[i]
				let isNum = $ isExpression(f) and f.kind == "number"
				let isSy = $ isExpression(f) and f.kind == "symbol"
				let isPow = $ isExpression(f) and f.kind == "pow"
				let tightNow = $ simple and i > 1 and not isNum and not (prevSy and isPow) and not (prevPow and isSy)
				if i > 1 and not tightNow
					\s\\times\s
				end
				if leadMinus and i == 1
					$ "-"
				elseif isExpression(f) and (f.kind == "add" or f.kind == "sub")
					$ paren(f)
				elseif i > 1 and isNum and f.left < 0
					(
					$ String(f)
					)
				else
					$f
				end
				set prevSy = $isSy
				set prevPow = $isPow
			end
		elseif kind == "div"
			\\frac{
				$ String(left)
			}{
				$ String(right)
			}
		elseif kind == "pow"
			{
				$ paren(left)
			}^{
				$ String(right)
			}
		else
			NYI `$kind` render.
		end
	end

	eval: macro(...values)
		if self.kind == "symbol"
			for k, v in items(values)
				if k == self.left
					return $v
				end
			end
			return $self
		elseif self.kind == "number"
			return $self.left
		else
			let left  = $ makeExpression(self.left.eval(...values))
			let right = $ makeExpression(self.right.eval(...values))

			let result = $ Expression(kind: self.kind, left: left, right: right)
			if left.kind == "number" and right.kind == "number"
				set result = $result.reduce()
				if result.kind == "number"
					return $result.left
				end
			end

			return $result
		end
	end

	// Remove x1, x0, +0, -0, 0^, 1^, ^0 and ^1, reorient x·3 to 3x, and
	// rewrite a negative addend into a sub: x + -5 -> x - 5, -3 + x -> x - 3
	// (tostring stays faithful and would render "x + -5" as is).
	pretty: macro()
		if not isExpression(self.left)
			return $self
		end

		let left  = $ self.left.pretty()
		let right = $ self.right and self.right.pretty()
		
		if self.kind == "add"
			if left == 0
				return $right
			end
			if right == 0
				return $left
			end
			if isNegativeTerm(right)
				return $ Expression(kind: "sub", left: left, right: positivePart(right))
			end
			if isNegativeTerm(left)
				return $ Expression(kind: "sub", left: right, right: positivePart(left))
			end
		end
		if self.kind == "sub"
			if right == 0
				return $left
			end
		end
		if self.kind == "mul"
			if left == 0
				return $makeExpression(0)
			end
			if right == 0
				return $makeExpression(0)
			end
			if left == 1
				return $right
			end
			if right == 1
				return $left
			end
			// x·3 → 3x (number first); x·(-1) → -x via the tostring above.
			if isExpression(left) and left.kind == "symbol" and isExpression(right) and right.kind == "number"
				return $ Expression(kind: "mul", left: right, right: left)
			end
		end
		if self.kind == "pow"
			if left == 0
				return $makeExpression(0)
			end
			if right == 0
				return $makeExpression(1)
			end
			if left == 1
				return $makeExpression(1)
			end
			if right == 1
				return $left
			end
		end
		
		return $ Expression(kind: self.kind, left: left, right: right)
	end

	// Apply linear simplifications
	reduce: macro()
		// if/else on purpose: the `A and B or C` idiom evaluates `false or empty`
		// to false (plume quirk) and poisoned the reconstructed leaves with
		// right: false, breaking meta eq.
		let left
		let right
		if isExpression(self.left)
			set left = $ self.left.reduce()
		else
			set left = $ self.left
		end
		if isExpression(self.right)
			set right = $ self.right.reduce()
		else
			set right = $ self.right
		end

		if self.kind == "add" or self.kind == "sub"
			let flat = $ flattensum(self)
			// Reduce each term first, so that the pairwise merges compare
			// reduced terms (x·x and {x}^{2} are the same unit).
			for i in seq(1, len(flat))
				set flat[i] = $ flat[i].reduce()
			end
			for i in seq(1, len(flat)-1)
				for j in seq(i+1, len(flat))
					let left  = $flat[i]
					let right = $flat[j]

					if right.kind == "number" and left.kind == "number"
						set flat[i] = $ makeExpression(right.left + left.left)
						set flat[j] = $ makeExpression(0)
					elseif right == left
						set flat[i] = $ (2*makeExpression(right)).reduce()
						set flat[j] = $ makeExpression(0)
					elseif right.kind == "mul" and left.kind == "mul"
						let rl = $right.left
						let rr = $right.right
						let ll = $left.left
						let lr = $left.right

						// Align the two terms: the shared factor on the same side.
						if rl==lr or rr==ll
							set ll, lr = ($lr, $ll)
						end

						if rl==ll and rr==lr
							// Same coefficient and same factor: (rr+lr)·rl, re-reduced.
							set flat[i] = $ (makeExpression(rr + lr).reduce() * rl).reduce()
							set flat[j] = $ makeExpression(0)
						elseif rr==lr
							// Same factor, different coefficients: try to reduce the
							// coefficients rl+ll — if it merges to a single term,
							// factorize (rl+ll)·rr, otherwise leave the terms alone.
							let sum = $ makeExpression(rl + ll).reduce()
							if isExpression(sum) and sum.kind != "add" and sum.kind != "sub"
								set flat[i] = $ (sum * rr).reduce()
								set flat[j] = $ makeExpression(0)
							end
						elseif rl==ll
							// Same coefficient, different factors: try to reduce the
							// factors rr+lr — if it merges to a single term,
							// factorize rl·(rr+lr), otherwise leave the terms alone.
							let sum = $ makeExpression(rr + lr).reduce()
							if isExpression(sum) and sum.kind != "add" and sum.kind != "sub"
								set flat[i] = $ (rl * sum).reduce()
								set flat[j] = $ makeExpression(0)
							end
						end
					else
						// A bare factor and a number×(same factor): merge the
						// coefficients — x + 2x → 3x, x - x → 0, x² - x² → 0.
						let a = $ unitTerm(left)
						let b = $ unitTerm(right)
						if type(a) == "table" and type(b) == "table" and a.c? and b.c? and a.u == b.u
							set flat[i] = $ makeExpression(a.c.left + b.c.left) * a.u
							set flat[j] = $ makeExpression(0)
						end
					end
				end
			end

			// Rebuild with explicit signs: a negative term is subtracted.
			let value = $flat[1]
			for i in seq(2, len(flat))
				if flat[i] != 0
					if isNegativeTerm(flat[i])
						set value -= $ positivePart(flat[i])
					else
						set value += $flat[i]
					end
				end
			end
			return $value.pretty()
		elseif self.kind == "mul"
			let flat = $ flattenprod(self)
			// Reduce the compound factors (sums, divs): (0·x + 2)·2 must be
			// seen as 2·2, not as an unreduced sum. Numbers, symbols and pows
			// stay raw on purpose — the same-base pow merge (n⁻¹·n → n⁰ → 1)
			// needs the pow nodes, and reducing pow(n, 1) would unwrap it to n.
			for i in seq(1, len(flat))
				if not (isExpression(flat[i]) and (flat[i].kind == "number" or flat[i].kind == "symbol" or flat[i].kind == "pow"))
					set flat[i] = $ flat[i].reduce()
				end
			end
			// A reduced factor can itself be a product (x + x → 2x): re-flatten
			// so that its factors join the pairwise merges below.
			let prod = $flat[1]
			for i in seq(2, len(flat))
				set prod *= $flat[i]
			end
			set flat = $ flattenprod(prod)
			// A bare 0 factor kills the whole product (checked before the
			// merges, so that a real 0 is not mistaken for a consumed slot).
			for i in seq(1, len(flat))
				if flat[i] == 0
					return $makeExpression(0)
				end
			end
			for i in seq(1, len(flat)-1)
				for j in seq(i+1, len(flat))
					let left  = $flat[i]
					let right = $flat[j]

					if right.kind == "number" and left.kind == "number"
						// A 0 slot is a consumed factor (merge sentinel): it
						// must not swallow a live number (0·n would drop n).
						if left != 0 and right != 0
							set flat[i] = $ makeExpression(right.left * left.left)
							set flat[j] = $ makeExpression(0)
						end
					elseif right.kind == "pow" and left.kind == "pow" and right.left == left.left
						// Same base: (x²)·(x³) → x⁵ — the exponents are added.
						let e = $ (right.right + left.right).reduce()
						set flat[i] = $ Expression(kind: "pow", left: right.left, right: e).reduce()
						set flat[j] = $ makeExpression(0)
					elseif right == left
						set flat[i] = $ (makeExpression(right)^2).reduce()
						set flat[j] = $ makeExpression(0)
					end
				end
			end

			let value = $flat[1]
			for i in seq(2, len(flat))
				if flat[i] != 0
					set value *= $flat[i]
				end
			end
			return $value.pretty()
		else
			return $ Expression(kind: self.kind, left: left, right: right).pretty()
		end
	end

	meta addr: macro(x)
		@Expression
			kind: add
			left: $self
			right: $makeExpression($x)
		end
	end
	meta addl: macro(x)
		@Expression
			kind: add
			left: $makeExpression($x)
			right: $self
		end
	end
	meta subr: macro(x)
		@Expression
			kind: sub
			left: $self
			right: $makeExpression($x)
		end
	end
	meta subl: macro(x)
		@Expression
			kind: sub
			left: $makeExpression($x)
			right: $self
		end
	end
	meta mulr: macro(x)
		@Expression
			kind: mul
			left: $self
			right: $makeExpression($x)
		end
	end
	meta mull: macro(x)
		@Expression
			kind: mul
			left: $makeExpression($x)
			right: $self
		end
	end
	meta divr: macro(x)
		@Expression
			kind: div
			left: $self
			right: $makeExpression($x)
		end
	end
	meta divl: macro(x)
		@Expression
			kind: div
			left: $makeExpression($x)
			right: $self
		end
	end
	meta powr: macro(x)
		@Expression
			kind: pow
			left: $self
			right: $makeExpression($x)
		end
	end
	meta powl: macro(x)
		@Expression
			kind: pow
			left: $makeExpression($x)
			right: $self
		end
	end
	meta eq: macro(x, y)
		set x = $ makeExpression(x)
		set y = $ makeExpression(y)
		// kind and left first (leaves carry no right field); .right only
		// compared for operator kinds.
		if x.kind != y.kind
			return $false
		end
		if x.left != y.left
			return $false
		end
		if x.kind == "number" or x.kind == "symbol"
			return $true
		end
		return $ x.right == y.right
	end
end

Symbol: macro(label)
	@Expression
		kind: symbol
		left: $label
	end
end

s: $makeExpression
