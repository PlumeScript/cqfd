macro isExpression(x)
	$ type(x) == "table" and x.type? == "Expression"
end

let Expression
macro makeExpression(x)
	if isExpression(x)
		return $x
	end

	if type(x) == "table"
		raise Cannot convert a table to an expression
	elseif type(x) == "string" and not x.isNumber()
		return $ Expression(left: x, kind: "symbol")
	elseif (type(x) == "string" and x.isNumber()) or type(x) == "number"
		return $ Expression(left: Number(x), kind: "number")
	else
		raise Cannot convert a `$type($x)` to an expression
	end
end

macro paren(x)
	if isExpression(x) and (x.kind == "add" or x.kind == "sub")
		($String($x))
	else
		$String($x)
	end
end

// Parenthesize a pow base that is not a single character: a sum, a div or a
// product would attach the exponent to its last factor only ((1/2)^2 would
// render \frac{1}{2}^{2}). A symbol, a number and a symbol pow stay bare
// (x^2, 2^3 — the braces stack the exponents).
macro parenBase(x)
	if isExpression(x) and (x.kind == "add" or x.kind == "sub" or x.kind == "div" or x.kind == "mul" or x.kind == "pow")
		($String($x))
	else
		$String($x)
	end
end

macro flattensum(x)
	if isExpression(x) and x.kind == "add"
		return (...flattensum($x.left), ...flattensum($x.right))
	elseif isExpression(x) and x.kind == "sub"
		return (...flattensum($x.left), ...flattensum($(-x.right).reduce()))
	else
		return $Table($x)
	end
end

macro flattenprod(x)
	if isExpression(x) and x.kind == "mul"
		return (...flattenprod($x.left), ...flattenprod($x.right))
	else
		return $Table($x)
	end
end

// The value of a pow exponent: a raw number (root() stores it plain) or a
// number expression (pretty/eval rebuilt it) — the number, or empty when
// the exponent is not one (a symbol, an add, ...).
macro powExp(e)
	if type(e) == "number"
		return $e
	end
	if isExpression(e) and e.kind == "number"
		return $e.left
	end
	return $empty
end

// Add the exponent e of base label to the (labels, exps) accumulator.
macro addExp(labels, exps, label, e)
	let k = $ Table.find(labels, label)
	if k
		set exps[k] = $ exps[k] + e
	else
		run $ Table.append(labels, label)
		run $ Table.append(exps, e)
	end
end

// Greatest common divisor of two integers (Euclid, absolute values).
macro gcd(a, b)
	set a = $ Number.abs(a)
	set b = $ Number.abs(b)
	while b != 0
		let t = $b
		set b = $ a % b
		set a = $t
	end
	return $a
end

// The integer square root of a non-negative perfect square n, or empty when
// n is not one (binary search on the square).
macro sqrtInt(n)
	if n < 0 or n % 1 != 0
		return $empty
	end
	let lo = $0
	let hi = $n
	while hi - lo > 1
		let mid = $ Number.floor((lo + hi) / 2)
		if mid * mid <= n
			set lo = $mid
		else
			set hi = $mid
		end
	end
	if lo * lo == n
		return $lo
	end
	if hi * hi == n
		return $hi
	end
	return $empty
end

// n raised to a positive integer e (repeated multiplication).
macro intPow(n, e)
	let r = $1
	while e > 0
		set r = $ r * n
		set e = $ e - 1
	end
	return $r
end

// A reduced fraction has a finite decimal expansion iff its denominator
// is of the form 2^a·5^b.
macro finiteDecimal(d)
	set d = $ Number.abs(d)
	while d % 2 == 0
		set d = $ d / 2
	end
	while d % 5 == 0
		set d = $ d / 5
	end
	return $ d == 1
end

// Collect the factors of one side of a div into (out): a number, a symbol
// or a symbol pow goes in, and a nested div keeps its own numerator factors
// here while sending its denominator factors to (other) — (a/b)/c = a/(b·c).
// Returns false when a factor is not one of those (a sum, a compound pow,
// ...), true otherwise.
macro divFlatten(flat, out, other)
	let ok = $true
	for i in seq(1, len(flat))
		let f = $flat[i]
		if isExpression(f) and f.kind == "div"
			let lf = $ flattenprod(f.left)
			let rf = $ flattenprod(f.right)
			set ok = $ divFlatten(lf, out, other) and ok
			set ok = $ divFlatten(rf, other, out) and ok
		elseif isExpression(f) and f.kind == "number"
			run $ Table.append(out, f)
		elseif isExpression(f) and f.kind == "symbol"
			run $ Table.append(out, f)
		elseif isExpression(f) and f.kind == "pow" and isExpression(f.left) and f.left.kind == "symbol" and powExp(f.right)
			run $ Table.append(out, f)
		else
			set ok = $false
		end
	end
	return $ok
end

// Like divFlatten, but a factor that cannot be decomposed (a sum, a compound
// pow, ...) is collected in (impure) instead of failing the walk — the plain
// factors are still collected, so they can be simplified on their own
// (3(x + 4)/3: the 3 cancels, x + 4 is kept whole).
macro divFlatten2(flat, out, other, impure)
	for i in seq(1, len(flat))
		let f = $flat[i]
		if isExpression(f) and f.kind == "div"
			let lf = $ flattenprod(f.left)
			let rf = $ flattenprod(f.right)
			run $ divFlatten2(lf, out, other, impure)
			run $ divFlatten2(rf, other, out, impure)
		elseif isExpression(f) and f.kind == "number"
			run $ Table.append(out, f)
		elseif isExpression(f) and f.kind == "symbol"
			run $ Table.append(out, f)
		elseif isExpression(f) and f.kind == "pow" and isExpression(f.left) and f.left.kind == "symbol" and powExp(f.right)
			run $ Table.append(out, f)
		else
			run $ Table.append(impure, f)
		end
	end
end

// True when t carries a minus: a negative number, a product holding an odd
// number of negative factors (looked through the whole product, so a minus
// nested in the tree (mul(-1, y*x)) counts too), or a div whose numerator
// carries one.
macro isNegativeTerm(t)
	if isExpression(t) and t.kind == "number"
		return $ t.left < 0
	end
	if isExpression(t) and t.kind == "mul"
		let neg = $0
		let flat = $ flattenprod(t)
		for i in seq(1, len(flat))
			if isExpression(flat[i]) and flat[i].kind == "number" and flat[i].left < 0
				set neg += 1
			end
		end
		return $ neg % 2 == 1
	end
	if isExpression(t) and t.kind == "div"
		return $ isNegativeTerm(t.left)
	end
	return $false
end

// The positive twin of a negative term (25, or the product without its
// minus). A coefficient of -1 leaves no coefficient: the twin of -x is x,
// not 1x. The minus may sit at any depth of the product.
macro positivePart(t)
	if isExpression(t) and t.kind == "number"
		let n = $ -t.left
		return $ makeExpression(n)
	end
	if isExpression(t) and t.kind == "mul"
		let flat = $ flattenprod(t)
		for i in seq(1, len(flat))
			if isExpression(flat[i]) and flat[i].kind == "number" and flat[i].left < 0
				let n = $ -flat[i].left
				let u = $empty
				for k in seq(1, len(flat))
					if k != i
						if u
							set u *= $flat[k]
						else
							set u = $flat[k]
						end
					end
				end
				if not u
					return $ makeExpression(n)
				end
				if n == 1
					return $u
				end
				return $ makeExpression(n) * u
			end
		end
	end
	if isExpression(t) and t.kind == "div" and isNegativeTerm(t.left)
		return $ Expression(kind: "div", left: positivePart(t.left), right: t.right, print: t.print?)
	end
	return $t
end

// True when the two factor lists hold the same factors — the order is
// ignored (multiplication is commutative: xy and yx are the same unit).
macro sameFactors(a, b)
	if len(a) != len(b)
		return $false
	end
	let used = $Table()
	for i in seq(1, len(a))
		let f = $a[i]
		let found = $false
		for j in seq(1, len(b))
			if not Table.find(used, j) and f == b[j]
				run $ Table.append(used, j)
				set found = $true
			end
		end
		if not found
			return $false
		end
	end
	return $true
end

// A factor tostring can render bare inside a product: a number, a symbol,
// a pow on a symbol or a number base (the braces keep it readable), or a
// sum (paren() keeps it grouped).
macro isLeafFactor(f)
	if isExpression(f) and (f.kind == "number" or f.kind == "symbol" or f.kind == "add" or f.kind == "sub")
		return $true
	end
	if isExpression(f) and f.kind == "pow" and isExpression(f.left) and (f.left.kind == "symbol" or f.left.kind == "number")
		return $true
	end
	return $false
end

// Recursively unfold x into acc (see decomposeTerm), for the side held in
// side ("num" or "den"): a number multiplies cnum / cden (integers only),
// a symbol / symbol pow joins unit on the num side (a symbol in a denominator
// makes the term non-decomposable), a mul unfolds on the same side, a div
// splits (its numerator goes up, its denominator down). False otherwise.
macro collectTermSide(x, acc, side)
	if isExpression(x) and x.kind == "mul"
		let ok = $ collectTermSide(x.left, acc, side)
		if not ok
			return $false
		end
		return $ collectTermSide(x.right, acc, side)
	end
	if isExpression(x) and x.kind == "div"
		if side == "num"
			let ok = $ collectTermSide(x.left, acc, "num")
			if not ok
				return $false
			end
			return $ collectTermSide(x.right, acc, "den")
		end
		let ok = $ collectTermSide(x.left, acc, "den")
		if not ok
			return $false
		end
		return $ collectTermSide(x.right, acc, "num")
	end
	if isExpression(x) and x.kind == "number"
		if x.left % 1 != 0
			return $false
		end
		if side == "num"
			set acc.cnum = $ acc.cnum * x.left
		else
			set acc.cden = $ acc.cden * x.left
		end
		return $true
	end
	if isExpression(x) and (x.kind == "symbol" or (x.kind == "pow" and isExpression(x.left) and x.left.kind == "symbol" and powExp(x.right)))
		if side == "den"
			return $false
		end
		run $ Table.append(acc.unit, x)
		return $true
	end
	return $false
end

// Decompose a term into the table (cnum:, cden:, unit:): the term written as
// (cnum/cden) × (the factors in unit, in order) — cnum/cden the rational
// coefficient (integers, from the number factors, a div's numerator into
// cnum and its denominator into cden), unit the symbol / symbol-pow
// factors. Empty when the term is not such a product (a sum, a symbol in a
// denominator, a compound pow, a non-integer coefficient) — the term
// then only merges with itself (caught earlier by right == left).
macro decomposeTerm(t)
	if not isExpression(t)
		return $empty
	end
	let acc = (cnum: 1, cden: 1, unit: $Table())
	if not collectTermSide(t, acc, "num")
		return $empty
	end
	return $acc
end

// Rebuild the merged term (cnum/cden) × (the unit factors): a bare number
// when there is no unit, a bare unit when the coefficient is 1, a
// number × unit product over 1, or the fraction over cden otherwise.
macro rebuildTerm(cnum, cden, unit)
	let up
	if len(unit) == 0
		set up = $empty
	else
		set up = $unit[1]
		for k in seq(2, len(unit))
			set up = $ up * unit[k]
		end
	end
	if cden == 1
		if up
			if cnum == 1
				return $up
			elseif cnum == -1
				return $ makeExpression(-1) * up
			end
			return $ makeExpression(cnum) * up
		end
		return $ makeExpression(cnum)
	end
	let num
	if up
		if cnum == 1
			set num = $up
		elseif cnum == -1
			set num = $ makeExpression(-1) * up
		else
			set num = $ makeExpression(cnum) * up
		end
	else
		set num = $ makeExpression(cnum)
	end
	return $ Expression(kind: "div", left: num, right: makeExpression(cden))
end


set Expression = macro(kind:, left:, right:, print:)
	type: Expression
	kind: $kind
	left: $left
	right: $right
	print: $print
	
	meta tostring: macro()
		if kind == "symbol" or kind == "number"
			$left
		elseif kind == "add"
			// Faithful (issue #175): the tree as is — a negative addend keeps
			// its own sign (x + -5, -3 + x). Inelegant but meaningful; the
			// subtraction forms (x - 5, x - 3) are built by pretty, which
			// rewrites a negative addend into a sub.
			$ String(left)
			\s+\s
			$ String(right)
		elseif kind == "sub"
			$ String(left)
			// x - (y + z) is distributed term by term: x - y - z, a negative
			// term being re-added: x - (y - 3) → x - y + 3 (a right-side sub
			// distributes too, since pretty rewrites x + -3 into x - 3);
			// a negative right operand is kept grouped: x - -5 → x - (-5).
			if isExpression(right) and (right.kind == "add" or right.kind == "sub")
				let flat = $ flattensum(right)
				for i in seq(1, len(flat))
					let t = $flat[i]
					if isNegativeTerm(t)
						\s+\s
						$ String(positivePart(t))
					else
						\s-\s
						$ String(t)
					end
				end
			elseif isNegativeTerm(right)
				\s-\s
				(
				$ String(right)
				)
			else
				\s-\s
				$ paren(right)
			end
		elseif kind == "mul"
			// Faithful render (issue #175): the factors in their own tree
			// order, and no algebra — no coefficient merging, no
			// number-first reordering, no 1/-1 folding (that is pretty's
			// and reduce's job); flattenprod only unfolds the mul nodes.
			// A factor tightens to its predecessor when the whole chain is
			// clean (leaves only) and the pair cannot be misread: a bare
			// number only at the head of a run (2x, xy, 5x², 2(x+1) —
			// never 23, x2 or (x+1)3); a bare symbol never next to the same
			// symbol (x \times x — xx would read as a name) nor to a pow of
			// the same base (x² \times x, x \times x² — x²x would read as
			// x³; xf² and f²x juxtapose); sums stay parenthesized; any impure
			// factor (div, compound pow) keeps \times all along. A leading
			// -1 is the sign of the
			// product (-x, -x², -(x+1)); a non-leading minus number is
			// grouped: x \times (-3).
			let flat = $ flattenprod(self)
			let simple = $true
			for i in seq(1, len(flat))
				let f = $flat[i]
				if not isLeafFactor(f)
					set simple = $false
				end
			end
			let f1 = $flat[1]
			let f2 = $ len(flat) > 1 and flat[2]
			// The -1 is the sign of the product, rendered bare (-x, -x²,
			// -(x + 1), -\frac{1}{2}, -\frac{1}{2} \times x): the second
			// factor glues to it (its own braces group it) and the rest of
			// the product follows. A -1 next to a number is not a sign
			// (that is pretty's -1 folding): -1 \times 2 stays faithful.
			let leadMinus = $ isExpression(f1) and f1.kind == "number" and f1.left == -1 and not (isExpression(f2) and f2.kind == "number")
			let prevSy = $false
			let prevPow = $false
			let prevLabel = $empty
			let prevPowBase = $empty
			for i in seq(1, len(flat))
				let f = $flat[i]
				let isNum = $ isExpression(f) and f.kind == "number"
				let isSy = $ isExpression(f) and f.kind == "symbol"
				let isPow = $ isExpression(f) and f.kind == "pow"
				let powBase = $ isPow and isExpression(f.left) and f.left.kind == "symbol" and f.left.left or empty
				let tightNow = $ simple and i > 1 and not isNum and not (prevSy and isPow and prevLabel == powBase) and not (prevPow and isSy and prevPowBase == f.left) and not (prevSy and isSy and prevLabel == f.left)
				// The second factor glues to the lead sign (-(1/2), not
				// -\times\frac{1}{2}).
				if i > 1 and not tightNow and not (leadMinus and i == 2)
					\s\\times\s
				end
				if leadMinus and i == 1
					$ "-"
				elseif isExpression(f) and (f.kind == "add" or f.kind == "sub")
					$ paren(f)
				elseif i > 1 and isNum and f.left < 0
					(
					$ String(f)
					)
				else
					$f
				end
				set prevSy = $isSy
				set prevPow = $isPow
				set prevLabel = $ isSy and f.left or empty
				set prevPowBase = $powBase
			end
		elseif kind == "div"
			\\frac{
				$ String(left)
			}{
				$ String(right)
			}
		elseif kind == "pow"
			// right may be a raw number (root()) or a number expression
			// (pretty/eval rebuilt it): compare its value, and take the
			// index from the value, not from a node (1 / <expr> would
			// dispatch a div).
			let e = $ isExpression(right) and right.kind == "number" and right.left or right
			if self.print?.root?
				\\sqrt
				if e != 0.5
					[\\leftroot{$String($(1/e))}]
				end
				{
				$ paren(left)
				}
			else
				{
					$ parenBase(left)
				}^{
					$ String(right)
				}
			end
		else
			NYI `$kind` render.
		end
	end

	eval: macro(...values)
		if self.kind == "symbol"
			for k, v in items(values)
				if k == self.left
					return $v
				end
			end
			return $self
		elseif self.kind == "number"
			return $self.left
		else
			// A child may be raw (root() stores a plain number on right):
			// only expressions carry an eval.
			let left
			let right
			if isExpression(self.left)
				set left = $ makeExpression(self.left.eval(...values))
			else
				set left = $ makeExpression(self.left)
			end
			if isExpression(self.right)
				set right = $ makeExpression(self.right.eval(...values))
			else
				set right = $ makeExpression(self.right)
			end

			let result = $ Expression(kind: self.kind, left: left, right: right, print: self.print?)
			if left.kind == "number" and right.kind == "number"
				set result = $result.reduce()
				if result.kind == "number"
					return $result.left
				end
			end

			return $result
		end
	end

	// Remove x1, x0, +0, -0, 0^, 1^, ^0 and ^1, reorient x·3 to 3x,
	// rewrite a negative addend into a sub: x + -5 -> x - 5, -3 + x -> x - 3
	// (tostring stays faithful and would render "x + -5" as is), and hoist a
	// fraction's sign out of it: (-1)/2 -> -(1/2), 1/(-2) -> -(1/2),
	// (-1)/(-2) -> 1/2 (two signs cancel).
	pretty: macro()
		if not isExpression(self.left)
			return $self
		end

		let left  = $ makeExpression(self.left).pretty()
		let right = $ self.right and makeExpression(self.right).pretty()
		
		if self.kind == "add"
			if left == 0
				return $right
			end
			if right == 0
				return $left
			end
			if isNegativeTerm(right)
				return $ Expression(kind: "sub", left: left, right: positivePart(right))
			end
			if isNegativeTerm(left)
				return $ Expression(kind: "sub", left: right, right: positivePart(left))
			end
		end
		if self.kind == "sub"
			if right == 0
				return $left
			end
			// The symmetric of the add rewrite: a double sign is a plus
			// (x - -(1/2) -> x + (1/2), x - -5 -> x + 5).
			if isNegativeTerm(right)
				return $ Expression(kind: "add", left: left, right: positivePart(right))
			end
		end
		if self.kind == "mul"
			if left == 0
				return $makeExpression(0)
			end
			if right == 0
				return $makeExpression(0)
			end
			if left == 1
				return $right
			end
			if right == 1
				return $left
			end
			// A -1 factor is a sign, not a factor: it folds into the
			// neighboring number (-1·2x → -2x, 2·(-1) → -2). No real
			// computation here (2·2x is untouched — that is reduce's job).
			if isExpression(left) and left.kind == "number" and left.left == -1 and isExpression(right) and right.kind == "number"
				return $ makeExpression(-right.left)
			end
			if isExpression(left) and left.kind == "number" and left.left == -1 and isExpression(right) and right.kind == "mul" and isExpression(right.left) and right.left.kind == "number"
				let n = $ -right.left.left
				if n == 1
					return $right.right
				end
				return $ makeExpression(n) * right.right
			end
			if isExpression(right) and right.kind == "number" and right.left == -1 and isExpression(left) and left.kind == "number"
				return $ makeExpression(-left.left)
			end
			if isExpression(right) and right.kind == "number" and right.left == -1 and isExpression(left) and left.kind == "mul" and isExpression(left.left) and left.left.kind == "number"
				let n = $ -left.left.left
				if n == 1
					return $left.right
				end
				return $ makeExpression(n) * left.right
			end
			// A bare factor in front of a number flips, so that the number
			// leads: x·3 → 3x, x²·3 → 3x², √5·2 → 2√5, (x+1)·3 → 3(x+1).
			// x·(-1) → -x (the flip, then the tostring lead-minus).
			if isLeafFactor(left) and not (isExpression(left) and left.kind == "number") and isExpression(right) and right.kind == "number"
				return $ Expression(kind: "mul", left: right, right: left)
			end
		end
		if self.kind == "pow"
			if left == 0
				return $makeExpression(0)
			end
			if right == 0
				return $makeExpression(1)
			end
			if left == 1
				return $makeExpression(1)
			end
			if right == 1
				return $left
			end
		end
		if self.kind == "div"
			// A sign inside a fraction is inelegant: hoist it out. The
			// numerator's sign leads the fraction ((-1)/2 -> -(1/2),
			// (-3x)/4 -> -(3x/4)), the denominator's sign does the same
			// (1/(-2) -> -(1/2)), and two signs cancel ((-1)/(-2) -> 1/2).
			// The sign rides on the fraction as a leading -1 factor (meta
			// minus), rendered -\frac{1}{2}.
			let numNeg = $ isNegativeTerm(left)
			let denNeg = $ isNegativeTerm(right)
			if numNeg or denNeg
				let n
				let d
				if numNeg
					set n = $ positivePart(left)
				else
					set n = $left
				end
				if denNeg
					set d = $ positivePart(right)
				else
					set d = $right
				end
				let fr = $ Expression(kind: "div", left: n, right: d, print: self.print?)
				if numNeg and denNeg
					return $fr
				end
				return $ -fr
			end
		end

		// Carry the print flags (root: the rebuilt node must keep rendering
		// \sqrt, not x^{0.5}).
		return $ Expression(kind: self.kind, left: left, right: right, print: self.print?)
	end

	// Apply linear simplifications. ?decimal: a pure number fraction with a
	// finite decimal expansion becomes the number (2/4 ?decimal -> 0.5).
	reduce: macro(?decimal)
		// if/else on purpose: the `A and B or C` idiom evaluates `false or empty`
		// to false (plume quirk) and poisoned the reconstructed leaves with
		// right: false, breaking meta eq.
		let left
		let right
		if isExpression(self.left)
			set left = $ self.left.reduce()
		else
			set left = $ self.left
		end
		if isExpression(self.right)
			set right = $ self.right.reduce()
		else
			set right = $ self.right
		end

		if self.kind == "add" or self.kind == "sub"
			let flat = $ flattensum(self)
			// Reduce each term first, so that the pairwise merges compare
			// reduced terms (x·x and {x}^{2} are the same unit).
			for i in seq(1, len(flat))
				set flat[i] = $ flat[i].reduce()
			end
			// A reduced term can be a sum itself ((3x + 4)/3 -> x + 4/3): its
			// terms join the merges and the common denominator.
			let flat2 = $Table()
			for i in seq(1, len(flat))
				let t = $flat[i]
				if isExpression(t) and (t.kind == "add" or t.kind == "sub")
					let ts = $ flattensum(t)
					for j in seq(1, len(ts))
						run $ Table.append(flat2, ts[j])
					end
				else
					run $ Table.append(flat2, t)
				end
			end
			set flat = $flat2
			for i in seq(1, len(flat)-1)
				for j in seq(i+1, len(flat))
					let left  = $flat[i]
					let right = $flat[j]

					if right.kind == "number" and left.kind == "number"
						set flat[i] = $ makeExpression(right.left + left.left)
						set flat[j] = $ makeExpression(0)
					elseif right.kind == "number" and isExpression(left) and left.kind == "div" and isExpression(left.left) and left.left.kind == "number" and isExpression(left.right) and left.right.kind == "number"
						// A number and a pure number fraction merge over the
						// fraction's denominator (2 + 1/2 -> 5/2, 4/3 + 1 -> 7/3).
						let a = $left.left.left
						let b = $left.right.left
						let n = $right.left
						let c = $ a + n * b
						if c == 0
							set flat[i] = $ makeExpression(0)
							set flat[j] = $ makeExpression(0)
						else
							let g = $ gcd(c, b)
							let cn = $ c / g
							let cd = $ b / g
							if cd < 0
								set cn = $ -cn
								set cd = $ -cd
							end
							if cd == 1
								set flat[i] = $ makeExpression(cn)
							else
								set flat[i] = $ Expression(kind: "div", left: makeExpression(cn), right: makeExpression(cd))
							end
							set flat[j] = $ makeExpression(0)
						end
					elseif left.kind == "number" and isExpression(right) and right.kind == "div" and isExpression(right.left) and right.left.kind == "number" and isExpression(right.right) and right.right.kind == "number"
						// Same merge, the number leads (1 + 1/2 -> 3/2).
						let a = $right.left.left
						let b = $right.right.left
						let n = $left.left
						let c = $ a + n * b
						if c == 0
							set flat[i] = $ makeExpression(0)
							set flat[j] = $ makeExpression(0)
						else
							let g = $ gcd(c, b)
							let cn = $ c / g
							let cd = $ b / g
							if cd < 0
								set cn = $ -cn
								set cd = $ -cd
							end
							if cd == 1
								set flat[i] = $ makeExpression(cn)
							else
								set flat[i] = $ Expression(kind: "div", left: makeExpression(cn), right: makeExpression(cd))
							end
							set flat[j] = $ makeExpression(0)
						end
					elseif left.kind == "div" and right.kind == "div" and isExpression(left.left) and left.left.kind == "number" and isExpression(right.left) and right.left.kind == "number" and isExpression(left.right) and left.right.kind == "number" and isExpression(right.right) and right.right.kind == "number" and left.right == right.right
						// Same denominator, number numerators: the numerators
						// add (1/2 + 3/2 -> 2, -4/3 + 1/3 -> -1).
						let b = $left.right.left
						let c = $ left.left.left + right.left.left
						if c == 0
							set flat[i] = $ makeExpression(0)
							set flat[j] = $ makeExpression(0)
						else
							let g = $ gcd(c, b)
							let cn = $ c / g
							let cd = $ b / g
							if cd < 0
								set cn = $ -cn
								set cd = $ -cd
							end
							if cd == 1
								set flat[i] = $ makeExpression(cn)
							else
								set flat[i] = $ Expression(kind: "div", left: makeExpression(cn), right: makeExpression(cd))
							end
							set flat[j] = $ makeExpression(0)
						end
					elseif right == left
						set flat[i] = $ (2*makeExpression(right)).reduce()
						set flat[j] = $ makeExpression(0)
					elseif right.kind == "mul" and left.kind == "mul"
						// Flatten both terms: a coefficient (the product of the
						// number factors) times its unit factors. The unit is
						// compared commutatively — the factor order is ignored
						// (2xy + yx are the same term).
						let lf = $ flattenprod(left)
						let rf = $ flattenprod(right)
						let lc = $1
						let rc = $1
						let lu = $Table()
						let ru = $Table()
						for k in seq(1, len(lf))
							if isExpression(lf[k]) and lf[k].kind == "number"
								set lc *= $lf[k].left
							else
								run $ Table.append(lu, lf[k])
							end
						end
						for l in seq(1, len(rf))
							if isExpression(rf[l]) and rf[l].kind == "number"
								set rc *= $rf[l].left
							else
								run $ Table.append(ru, rf[l])
							end
						end

						if sameFactors(lu, ru)
							// Same unit: the coefficients add — 2xy + xy → 3xy,
							// 2xy - 2yx → 0.
							let c = $ lc + rc
							if c == 0
								set flat[i] = $ makeExpression(0)
								set flat[j] = $ makeExpression(0)
							else
								let u = $lu[1]
								for m in seq(2, len(lu))
									set u *= $lu[m]
								end
								if c != 1
									set u = $ makeExpression(c) * u
								end
								set flat[i] = $u.reduce()
								set flat[j] = $ makeExpression(0)
							end
						elseif lc == rc and len(lu) == 1 and len(ru) == 1
							// Same coefficient, two single factors: try to reduce
							// u+v — if it merges to a single term, factorize
							// lc·(u+v), otherwise leave the terms alone.
							let sum = $ makeExpression(lu[1] + ru[1]).reduce()
							if isExpression(sum) and sum.kind != "add" and sum.kind != "sub"
								set flat[i] = $ (makeExpression(lc) * sum).reduce()
								set flat[j] = $ makeExpression(0)
							end
						end
					else
						// Coefficient × unit merge (general): decompose each term into
						// (rational coefficient, unit factors) and merge when the factors
						// are the same (commutative) — x + 2x → 3x, x - x → 0,
						// x² - x² → 0, x/10 - x → -9x/10, 6 - 12/5 → 18/5. A sign-
						// hoisted fraction is a product with a negative coefficient, so it
						// decomposes like any other term.
						let pl = $ decomposeTerm(left)
						let pr = $ decomposeTerm(right)
						if pl and pr and sameFactors(pl.unit, pr.unit)
							let cnum = $ pl.cnum * pr.cden + pr.cnum * pl.cden
							let cden = $ pl.cden * pr.cden
							if cnum == 0
								set flat[i] = $ makeExpression(0)
								set flat[j] = $ makeExpression(0)
							else
								let g = $ gcd(cnum, cden)
								set cnum = $ cnum / g
								set cden = $ cden / g
								if cden < 0
									set cnum = $ -cnum
									set cden = $ -cden
								end
								set flat[i] = $ rebuildTerm(cnum, cden, pl.unit).reduce()
								set flat[j] = $ makeExpression(0)
							end
						end
					end
				end
			end

			// A div term: rewrite the sum over the common denominator
			// (3/2 + 2 -> 7/2, x/2 + x/4 -> 3x/4). Each term t contributes
			// a/b (its numerator/denominator, or the term itself over 1), and
			// the numerator collects a·(the other denominators) — no div
			// survives into N, so it reduces without coming back here. The
			// fraction is then reduced by the div branch (gcd + symbol
			// cancellation).
			let hasDiv = $false
			for i in seq(1, len(flat))
				if isExpression(flat[i]) and flat[i].kind == "div"
					set hasDiv = $true
				end
			end
			if hasDiv
				let aps = $Table()
				let bs = $Table()
				for i in seq(1, len(flat))
					let t = $flat[i]
					if t != 0
						let a
						let b
						if isExpression(t) and t.kind == "div"
							set a = $t.left
							set b = $t.right
						else
							set a = $t
							set b = $makeExpression(1)
						end
						run $ Table.append(aps, a)
						run $ Table.append(bs, b)
					end
				end
				let D = $bs[1]
				for i in seq(2, len(bs))
					set D = $ D * bs[i]
				end
				let N = $empty
				for i in seq(1, len(aps))
					let piece = $aps[i]
					for j in seq(1, len(bs))
						if j != i
							set piece = $ piece * bs[j]
						end
					end
					if N
						set N = $ N + piece
					else
						set N = $piece
					end
				end
				let nr = $ N.reduce()
				let dr = $ D.reduce()
				// The numerator must come out as a single term: a sum would
				// be distributed back by the div branch, ping-ponging forever
				// (x/2 + x/y -> (xy + 2x)/(2y) -> x/2 + x/y). A single
				// numerator is reduced by the div branch and never comes back
				// as a sum. Terms of different units stay a sum (x + 1/2,
				// x/2 + x/y).
				let pass = $true
				if isExpression(nr) and (nr.kind == "add" or nr.kind == "sub")
					set pass = $false
				end
				if pass
					let fr = $ Expression(kind: "div", left: nr, right: dr, print: self.print?)
					return $ fr.reduce()
				end
			end

			// Rebuild with explicit signs: a negative term is subtracted.
			let value = $flat[1]
			for i in seq(2, len(flat))
				if flat[i] != 0
					if isNegativeTerm(flat[i])
						set value -= $ positivePart(flat[i])
					else
						set value += $flat[i]
					end
				end
			end
			return $value.pretty()
		elseif self.kind == "mul"
			let flat = $ flattenprod(self)
			// Reduce the compound factors (sums): (0·x + 2)·2 must be seen as
			// 2·2, not as an unreduced sum. Numbers, symbols and pows stay raw
			// on purpose — the same-base pow merge (n⁻¹·n → n⁰ → 1) needs the
			// pow nodes, and reducing pow(n, 1) would unwrap it to n. Divs stay
			// raw too: the extraction below works on their own numerator and
			// denominator ((x + 1)/2 · 7 -> (x + 1)·7/2 — reducing the div
			// first would distribute its sum and lose the fraction).
			for i in seq(1, len(flat))
				if isExpression(flat[i]) and flat[i].kind == "pow" and isExpression(flat[i].left) and flat[i].left.kind == "number"
					// A number power evaluates to a number (5² -> 25); it
					// cannot interfere with the symbol-base merges below.
					set flat[i] = $ flat[i].reduce()
				elseif not (isExpression(flat[i]) and (flat[i].kind == "number" or flat[i].kind == "symbol" or flat[i].kind == "pow" or flat[i].kind == "div"))
					set flat[i] = $ flat[i].reduce()
				end
			end
			// A reduced factor can itself be a product (x + x → 2x): re-flatten
			// so that its factors join the pairwise merges below.
			let prod = $flat[1]
			for i in seq(2, len(flat))
				set prod *= $flat[i]
			end
			set flat = $ flattenprod(prod)
			// A bare 0 factor kills the whole product (checked before the
			// merges, so that a real 0 is not mistaken for a consumed slot).
			for i in seq(1, len(flat))
				if flat[i] == 0
					return $makeExpression(0)
				end
			end
			// A div factor turns the product into a fraction: its numerator
			// joins the product, its denominator collects below, and the
			// fraction is reduced by the div branch — (x/7)·7 -> x,
			// 2·(y/4) -> y/2, (x/2)·(x/2) -> x²/4. A reduced div holds no
			// div factor, so the two products reduce without coming back
			// into this branch.
			let hasDiv = $false
			let plain = $Table()
			let den = $Table()
			for i in seq(1, len(flat))
				let f = $flat[i]
				if isExpression(f) and f.kind == "div"
					set hasDiv = $true
					let dl = $ flattenprod(f.left)
					let dr = $ flattenprod(f.right)
					for k in seq(1, len(dl))
						run $ Table.append(plain, dl[k])
					end
					for k in seq(1, len(dr))
						run $ Table.append(den, dr[k])
					end
				else
					run $ Table.append(plain, f)
				end
			end
			if hasDiv
				let num = $plain[1]
				for i in seq(2, len(plain))
					set num = $ num * plain[i]
				end
				let denp = $den[1]
				for i in seq(2, len(den))
					set denp = $ denp * den[i]
				end
				let nr = $ num.reduce()
				let dnr = $ denp.reduce()
				let fr = $ Expression(kind: "div", left: nr, right: dnr, print: self.print?)
				return $ fr.reduce()
			end
			for i in seq(1, len(flat)-1)
				for j in seq(i+1, len(flat))
					let left  = $flat[i]
					let right = $flat[j]

					if right.kind == "number" and left.kind == "number"
						// A 0 slot is a consumed factor (merge sentinel): it
						// must not swallow a live number (0·n would drop n).
						if left != 0 and right != 0
							set flat[i] = $ makeExpression(right.left * left.left)
							set flat[j] = $ makeExpression(0)
						end
					elseif right.kind == "pow" and left.kind == "pow" and right.left == left.left
						// Same base: (x²)·(x³) → x⁵ — the exponents are added.
						// makeExpression: root() stores raw exponents, and a
						// raw sum has no reduce to call on.
						let e = $ makeExpression(right.right + left.right).reduce()
						set flat[i] = $ Expression(kind: "pow", left: right.left, right: e).reduce()
						set flat[j] = $ makeExpression(0)
					elseif (isExpression(right) and right.kind == "pow" and isExpression(left) and left.kind == "symbol" and right.left == left) or (isExpression(left) and left.kind == "pow" and isExpression(right) and right.kind == "symbol" and left.left == right)
						// Same base, one bare factor: (x²)·(x) → x³.
						let base
						let e
						if isExpression(right) and right.kind == "pow"
							set base = $right.left
							set e = $ (right.right + makeExpression(1)).reduce()
						else
							set base = $left.left
							set e = $ (left.right + makeExpression(1)).reduce()
						end
						set flat[i] = $ Expression(kind: "pow", left: base, right: e).reduce()
						set flat[j] = $ makeExpression(0)
					elseif right == left
						set flat[i] = $ (makeExpression(right)^2).reduce()
						set flat[j] = $ makeExpression(0)
					end
				end
			end

			// The number factors lead the product (25fj, not fj25): the
			// faithful tostring keeps the tree order, so the coefficient is
			// moved up front here (pretty only does the two-factor flip).
			let numf = $empty
			let value = $empty
			for i in seq(1, len(flat))
				let f = $flat[i]
				if f != 0
					if isExpression(f) and f.kind == "number"
						if numf
							set numf = $ numf * f
						else
							set numf = $f
						end
					else
						if value
							set value = $ value * f
						else
							set value = $f
						end
					end
				end
			end
			if numf
				if value
					set value = $ numf * value
				else
					set value = $numf
				end
			end
			return $value.pretty()
		elseif self.kind == "div"
			// Fraction reduction: the integer coefficients are simplified by
			// their gcd and the same symbol base cancels between the
			// numerator and the denominator (2x/4 -> x/2, x/x² -> 1/x,
			// (2/3)x/4 -> x/6, x/x -> 1). ?decimal turns a pure number
			// fraction with a finite decimal expansion into the number
			// (2/4 ?decimal -> 0.5); 1/3 has none and stays a fraction. A
			// sum over a plain denominator distributes term by term
			// ((3x + 4)/3 -> x + 4/3); a side that is not a product of
			// numbers, symbols, symbol pows and nested divs (a sum in the
			// denominator, a compound pow, ...) keeps its plain factors
			// simplified and the rest whole (3(x + 4)/3 -> x + 4).
			if not isExpression(left) or not isExpression(right)
				return $ Expression(kind: "div", left: left, right: right, print: self.print?).pretty()
			end
			let nf = $Table()
			let df = $Table()
			let lf = $ flattenprod(left)
			let rf = $ flattenprod(right)
			// A sum over a plain denominator distributes term by term
			// ((3x + 4)/3 -> x + 4/3): each term keeps its own unit, so the
			// add branch never pulls the terms back over a common
			// denominator (their numerator would not merge into a single
			// term and the common denominator bails — no ping-pong).
			if isExpression(left) and (left.kind == "add" or left.kind == "sub")
				let tmp = $Table()
				let tmp2 = $Table()
				if divFlatten(rf, tmp, tmp2)
					let terms = $ flattensum(left)
					let res = $ Expression(kind: "div", left: terms[1], right: right, print: self.print?).reduce()
					for i in seq(2, len(terms))
						set res += $ Expression(kind: "div", left: terms[i], right: right, print: self.print?).reduce()
					end
					return $ res.reduce()
				end
			end
			let impureN = $Table()
			let impureD = $Table()
			run $ divFlatten2(lf, nf, df, impureN)
			run $ divFlatten2(rf, df, nf, impureD)
			// Number factors per side.
			let ln = $1
			for i in seq(1, len(nf))
				let f = $nf[i]
				if isExpression(f) and f.kind == "number"
					set ln *= $ f.left
				end
			end
			let rn = $1
			for i in seq(1, len(df))
				let f = $df[i]
				if isExpression(f) and f.kind == "number"
					set rn *= $ f.left
				end
			end
			// No integer simplification possible (division by zero or a
			// non-integer coefficient): keep the reduced children.
			if rn == 0 or ln % 1 != 0 or rn % 1 != 0
				return $ Expression(kind: "div", left: left, right: right, print: self.print?).pretty()
			end
			let g = $ gcd(ln, rn)
			let cn = $ ln / g
			let cd = $ rn / g
			if cd < 0
				set cn = $ -cn
				set cd = $ -cd
			end
			if cn == 0
				return $makeExpression(0)
			end
			// Symbol bases: the net exponent decides the side (> 0
			// numerator, < 0 denominator, = 0 cancelled), in first
			// appearance order.
			let labels = $Table()
			let exps = $Table()
			for i in seq(1, len(nf))
				let f = $nf[i]
				let e = $empty
				if isExpression(f) and f.kind == "symbol"
					set e = $1
				elseif isExpression(f) and f.kind == "pow" and isExpression(f.left) and f.left.kind == "symbol"
					set e = $ powExp(f.right)
				end
				if e
					let lb = $ isExpression(f.left) and f.left.left or f.left
					run $ addExp(labels, exps, lb, e)
				end
			end
			for i in seq(1, len(df))
				let f = $df[i]
				let pe = $empty
				if isExpression(f) and f.kind == "symbol"
					set pe = $1
				elseif isExpression(f) and f.kind == "pow" and isExpression(f.left) and f.left.kind == "symbol"
					set pe = $ powExp(f.right)
				end
				if pe
					let lb = $ isExpression(f.left) and f.left.left or f.left
					run $ addExp(labels, exps, lb, -pe)
				end
			end
			// One factor per surviving base (a bare symbol when the
			// exponent is 1, a pow otherwise).
			let hasSym = $false
			let numSy = $Table()
			let denSy = $Table()
			for i in seq(1, len(labels))
				let e = $exps[i]
				let f = $empty
				if e > 0
					set hasSym = $true
					if e == 1
						set f = $ makeExpression(labels[i])
					else
						let b = $ makeExpression(labels[i])
						let ex = $ makeExpression(e)
						set f = $ Expression(kind: "pow", left: b, right: ex)
					end
					run $ Table.append(numSy, f)
				elseif e < 0
					set hasSym = $true
					if -e == 1
						set f = $ makeExpression(labels[i])
					else
						let b = $ makeExpression(labels[i])
						let ex = $ makeExpression(-e)
						set f = $ Expression(kind: "pow", left: b, right: ex)
					end
					run $ Table.append(denSy, f)
				end
			end
			// No symbol survives and no impure factor: a pure number
			// fraction.
			if not hasSym and len(impureN) == 0 and len(impureD) == 0
				if cd == 1
					return $ makeExpression(cn)
				end
				// ?decimal: a finite decimal expansion becomes the number;
				// 1/3 has none and stays a fraction.
				if decimal and finiteDecimal(cd)
					return $ makeExpression(cn / cd)
				end
				let n = $ makeExpression(cn)
				let d = $ makeExpression(cd)
				return $ Expression(kind: "div", left: n, right: d, print: self.print?).pretty()
			end
			// Rebuild both sides: the coefficient, then the symbol factors,
			// then the impure factors kept whole (x(y + 1)/2, 2(x + 1)).
			let num = $empty
			if cn != 1
				set num = $ makeExpression(cn)
			end
			for i in seq(1, len(numSy))
				let f = $numSy[i]
				if num
					set num = $ num * f
				else
					set num = $f
				end
			end
			if len(impureN) > 0
				if num
					set num = $ num * impureN[1]
				else
					set num = $impureN[1]
				end
				for i in seq(2, len(impureN))
					set num = $ num * impureN[i]
				end
			end
			if not num
				set num = $makeExpression(1)
			end
			let den = $empty
			if cd != 1
				set den = $ makeExpression(cd)
			end
			for i in seq(1, len(denSy))
				let f = $denSy[i]
				if den
					set den = $ den * f
				else
					set den = $f
				end
			end
			if len(impureD) > 0
				if den
					set den = $ den * impureD[1]
				else
					set den = $impureD[1]
				end
				for i in seq(2, len(impureD))
					set den = $ den * impureD[i]
				end
			end
			if not den
				set den = $makeExpression(1)
			end
			if num == 1
				return $ Expression(kind: "div", left: num, right: den, print: self.print?).pretty()
			end
			if den == 1
				return $num.pretty()
			end
			return $ Expression(kind: "div", left: num, right: den, print: self.print?).pretty()
		elseif self.kind == "pow"
			// A number power that computes to a number is computed:
			// sqrt(9) -> 3, sqrt(4/9) -> 2/3 (a fraction of perfect
			// squares), 5^2 -> 25. Anything else (sqrt(2), x^2, x^1.5)
			// keeps its reduced children.
			let e = $ powExp(right)
			if e
				if isExpression(left) and left.kind == "number"
					if e == 0.5
						let r = $ sqrtInt(left.left)
						if r
							return $ makeExpression(r)
						end
					elseif e >= 1 and e % 1 == 0
						return $ makeExpression(intPow(left.left, e))
					end
				elseif isExpression(left) and left.kind == "div"
					if e == 0.5
						let rl = $ sqrtInt(left.left.left)
						let rr = $ sqrtInt(left.right.left)
						if rl and rr
							let nl = $ makeExpression(rl)
							let dl = $ makeExpression(rr)
							return $ Expression(kind: "div", left: nl, right: dl, print: self.print?)
						end
					end
				end
			end
			return $ Expression(kind: "pow", left: left, right: right, print: self.print?).pretty()
		else
			// Carry the print flags (root: the reduced node must keep
			// rendering \sqrt, not x^{0.5}).
			return $ Expression(kind: self.kind, left: left, right: right, print: self.print?).pretty()
		end
	end

	root: macro(n: 2)
		@Expression
			kind: pow
			left: $self
			right: $(1/n)
			print: (root: $true)
		end
	end

	root: macro(n: 2)
		@Expression
			kind: pow
			left: $self
			right: $(1/n)
			print: (root: $true)
		end
	end

	isNumber: macro
		return $ self.reduce().kind == "number"
	end

	meta addr: macro(x)
		@Expression
			kind: add
			left: $self
			right: $makeExpression($x)
		end
	end
	meta addl: macro(x)
		@Expression
			kind: add
			left: $makeExpression($x)
			right: $self
		end
	end
	meta subr: macro(x)
		@Expression
			kind: sub
			left: $self
			right: $makeExpression($x)
		end
	end
	meta subl: macro(x)
		@Expression
			kind: sub
			left: $makeExpression($x)
			right: $self
		end
	end
	meta mulr: macro(x)
		@Expression
			kind: mul
			left: $self
			right: $makeExpression($x)
		end
	end
	meta mull: macro(x)
		@Expression
			kind: mul
			left: $makeExpression($x)
			right: $self
		end
	end
	meta divr: macro(x)
		@Expression
			kind: div
			left: $self
			right: $makeExpression($x)
		end
	end
	meta divl: macro(x)
		@Expression
			kind: div
			left: $makeExpression($x)
			right: $self
		end
	end
	meta powr: macro(x)
		@Expression
			kind: pow
			left: $self
			right: $makeExpression($x)
		end
	end
	meta powl: macro(x)
		@Expression
			kind: pow
			left: $makeExpression($x)
			right: $self
		end
	end
	meta minus: macro()
		// Unary minus (the `-x` operator): the opposite of the expression.
		// A number is negated in place (-s(3) → -3); anything else carries
		// the sign as a leading -1 factor, the product's lead-minus
		// convention (rendered -x, -x², -(x + 1), -\frac{1}{2}).
		if self.kind == "number"
			return $ makeExpression(-self.left)
		end
		return $ makeExpression(-1) * self
	end
	meta eq: macro(x, y)
		set x = $ makeExpression(x)
		set y = $ makeExpression(y)
		// kind and left first (leaves carry no right field); .right only
		// compared for operator kinds.
		if x.kind != y.kind
			return $false
		end
		if x.left != y.left
			return $false
		end
		if x.kind == "number" or x.kind == "symbol"
			return $true
		end
		return $ x.right == y.right
	end
end

Symbol: macro(label)
	@Expression
		kind: symbol
		left: $label
	end
end

s: $makeExpression
