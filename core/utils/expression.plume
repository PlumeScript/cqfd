macro isExpression(x)
	$ type(x) == "table" and x.type? == "Expression"
end

let Expression
macro makeExpression(x)
	if isExpression(x)
		return $x
	end

	if type(x) == "table"
		raise Cannot convert a table to an expression
	elseif type(x) == "string" and not x.isNumber()
		return $ Expression(left: x, kind: "symbol")
	elseif (type(x) == "string" and x.isNumber()) or type(x) == "number"
		return $ Expression(left: x, kind: "number")
	else
		raise Cannot convert a `$type($x)` to an expression
	end
end

macro paren(x)
	if isExpression(x) and (x.kind == "add" or x.kind == "sub")
		($String($x))
	else
		$String($x)
	end
end

macro flattensum(x)
	if isExpression(x) and x.kind == "add"
		return (...flattensum($x.left), ...flattensum($x.right))
	elseif isExpression(x) and x.kind == "sub"
		return (...flattensum($x.left), ...flattensum($(-1*x.right).reduce()))
	else
		return $Table($x)
	end
end

macro flattenprod(x)
	if isExpression(x) and x.kind == "mul"
		return (...flattenprod($x.left), ...flattenprod($x.right))
	else
		return $Table($x)
	end
end


set Expression = macro(kind:, left:, right:)
	type: Expression
	kind: $kind
	left: $left
	right: $right
	
	meta tostring: macro()
		if kind == "symbol" or kind == "number"
			$left
		elseif kind == "add"
			$ String(left)
			\s+\s
			$ String(right)
		elseif kind == "sub"
			$ String(left)
			\s-\s
			$ paren(right)
		elseif kind == "mul"
			$ paren(left)
			if (left.kind == "number" or right.kind == "number") and right.kind != "symbol"
				\s\\times\s
			end
			$ paren(right)
		elseif kind == "div"
			\\frac{
				$ String(left)
			}{
				$ String(right)
			}
		elseif kind == "pow"
			{
				$ paren(left)
			}^{
				$ String(right)
			}
		else
			NYI `$kind` render.
		end
	end

	// Remove x1, x0, +0, -0, 0^, 1^, ^0 and ^1
	pretty: macro()
		if not isExpression(self.left)
			return $self
		end

		let left  = $ self.left.pretty()
		let right = $ self.right and self.right.pretty()
		
		if self.kind == "add"
			if left == 0
				return $right
			end
			if right == 0
				return $left
			end
		end
		if self.kind == "mul"
			if left == 0
				return $makeExpression(0)
			end
			if right == 0
				return $makeExpression(0)
			end
			if left == 1
				return $right
			end
			if right == 1
				return $left
			end
		end
		if self.kind == "pow"
			if left == 0
				return $makeExpression(0)
			end
			if right == 0
				return $makeExpression(1)
			end
			if left == 1
				return $makeExpression(1)
			end
			if right == 1
				return $left
			end
		end
		
		return $ Expression(kind: self.kind, left: left, right: right)
	end

	// Apply linear simplifications
	reduce: macro()
		let left  = $ isExpression(self.left) and self.left.reduce() or self.left
		let right = $ isExpression(self.right) and self.right.reduce() or self.right

		if self.kind == "add" or self.kind == "sub"
			let flat = $ flattensum(self)
			for i in seq(1, len(flat)-1)
				for j in seq(i+1, len(flat))
					let left  = $flat[i]
					let right = $flat[j]

					if right.kind == "number" and left.kind == "number"
						set flat[i] = $ makeExpression(right.left + left.left)
						set flat[j] = $ makeExpression(0)
					elseif right == left
						set flat[i] = $ 2*makeExpression(right).reduce()
						set flat[j] = $ makeExpression(0)
					elseif right.kind == "mul" and left.kind == "mul"
						let rl = $right.left
						let rr = $right.right
						let ll = $left.left
						let lr = $left.right

						if rl==lr or rr==ll
							set ll, lr = ($lr, $ll)
						end

						if rl==ll and rr==lr
							if rl.kind != "symbol" and rr.kind == "symbol"
								set rl, rr, ll, lr = ($ll, $lr, $rl, $rr)
							end
						end

						if rl==ll
							set flat[i] = $ makeExpression(rr + lr).reduce() * rl
							set flat[j] = $ makeExpression(0)
						elseif rr==lr
							set flat[i] = $ makeExpression(rl + ll).reduce() * rr
							set flat[j] = $ makeExpression(0)
						end
					end
				end
			end

			let value = $flat[1]
			for i in seq(2, len(flat))
				if flat[i] != 0
					set value += $flat[i]
				end
			end
			return $value.pretty()
		elseif self.kind == "mul"
			let flat = $ flattenprod(self)
			for i in seq(1, len(flat)-1)
				for j in seq(i+1, len(flat))
					let left  = $flat[i]
					let right = $flat[j]

					if right.kind == "number" and left.kind == "number"
						set flat[i] = $ makeExpression(right.left * left.left)
						set flat[j] = $ makeExpression(0)
					elseif right == left
						set flat[i] = $ (makeExpression(right)^2).reduce()
						set flat[j] = $ makeExpression(0)
					end
				end
			end

			let value = $flat[1]
			for i in seq(2, len(flat))
				if flat[i] != 0
					set value *= $flat[i]
				end
			end
			return $value.pretty()
		else
			return $ Expression(kind: self.kind, left: left, right: right).pretty()
		end

		
	end

	meta addr: macro(x)
		@Expression
			kind: add
			left: $self
			right: $makeExpression($x)
		end
	end
	meta addl: macro(x)
		@Expression
			kind: add
			left: $makeExpression($x)
			right: $self
		end
	end
	meta subr: macro(x)
		@Expression
			kind: sub
			left: $self
			right: $makeExpression($x)
		end
	end
	meta subl: macro(x)
		@Expression
			kind: sub
			left: $makeExpression($x)
			right: $self
		end
	end
	meta mulr: macro(x)
		@Expression
			kind: mul
			left: $self
			right: $makeExpression($x)
		end
	end
	meta mull: macro(x)
		@Expression
			kind: mul
			left: $makeExpression($x)
			right: $self
		end
	end
	meta divr: macro(x)
		@Expression
			kind: div
			left: $self
			right: $makeExpression($x)
		end
	end
	meta divl: macro(x)
		@Expression
			kind: div
			left: $makeExpression($x)
			right: $self
		end
	end
	meta powr: macro(x)
		@Expression
			kind: pow
			left: $self
			right: $makeExpression($x)
		end
	end
	meta powl: macro(x)
		@Expression
			kind: pow
			left: $makeExpression($x)
			right: $self
		end
	end
	meta eq: macro(x, y)
		set x = $ makeExpression(x)
		set y = $ makeExpression(y)

		return $ x.kind == y.kind and x.left == y.left and x.right == y.right
	end
end

Symbol: macro(label)
	@Expression
		kind: symbol
		left: $label
	end
end

s: $makeExpression