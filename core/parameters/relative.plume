let QuestionFactory from $import(../cls/questionfactory)
let Choice from $import(./set)

Relative: macro(parameter)
	@QuestionFactory
		type: $parameter.type
		parameters: ($parameter, $Choice(+, -))
		get: macro(value, sign)
			if sign=="-"
				$ -1 * value
			else
				$value
			end
		end
	end
end