let Parameter from $import(../cls/parameter)
let QuestionFactory from $import(../cls/questionfactory)
let Constant from $import(./set)

/*
Generate a number between $posParam(Number, start, 1) and $posParam(Number, stop, 2)
*/
ref Range: macro(Number start, Number stop)
	if start > stop
		raise Stop (`$stop`) must be greater than start (`$start`).
	end
	@Parameter
		type: integer
		size: $ stop-start+1
		get: macro(i)
			$ start + i
		end
	end
end

/*
Two modes:
@InfosList
	- Generate an integer with $posParam(Number, figures, 1) figures.
	- Generate an integer with between $posParam(Number, minFigures, 1) and $posParam(Number, maxFigures, 2) figures.
end
*/
ref Integer: macro (...args)
	let smin, smax
	if len(args) == 0
		raise To few arguments
	elseif len(args) == 1
		set smin = $ Number(args[1])
		set smax = $ Number(args[1])
	elseif len(args) == 2
		set smin = $ Number(args[1])
		set smax = $ Number(args[2])
	else
		raise To many arguments.
	end

	if smax < smin
		raise The larger value cannot be less than the smaller one.
	end

	let size = 0
	for i in seq(smin, smax)
		set size += $ 9 * 10^(i-1)
	end
	@Parameter
		type: integer
		size: $size
		// The per-length blocks tile [10^(smin-1) .. 10^smax-1] contiguously,
		// so position i maps to i + 10^(smin-1).
		get: macro(i)
			$ i + 10^(smin-1)
		end
	end
end

/*
Generate a number with
@InfosList
	- Mantissa with between $posParam(Number, minFigures, 1) and $posParam(Number, maxFigures, 2) figures
	- Exponent between $posParam(Number, minIndex, 1) and $posParam(Number, maxIndex, 2) 
end
*/
Decimal: macro (minFigures, maxFigures, minIndex, maxIndex)
	@QuestionFactory
		parameters: do
			- $ Integer(minFigures, maxFigures)
			- $ Range(minIndex, maxIndex)
		end
		
		get: macro(value, exposant)
			$ value * 10^(exposant)
		end
		type: number
	end
end