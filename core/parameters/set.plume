let Parameter from $import(../cls/parameter)
let derive, FeistelWalker from $import(../utils/walkers)

/*
Apply $posParam(macro, transform, 1) on another $posParam(Parameter, parameter, 2) output.
*/
Map: macro(parameter, transform)
	@Parameter
		size: $parameter.getSize()
		get: macro(i)
			$ transform(parameter.get(i))
		end
	end
end

/*
Always return $posParam(any, value, 1)
*/
Constant: macro(value)
	@Parameter
		size: 1
		get: macro(i)
			$value
		end
	end
end

/*
Return an element from $posParam(any, values, variadic)
*/
ref Choice: macro(...values)
	@Parameter
		size: $ len(values)
		get: macro(i, n: 0, seed: 0)
			let v = $values[i+1]
			return if v.type? == "Parameter" or v.type? == "QuestionFactory" or v.type? == "QuestionFactoryTree"
				let subseed = $ derive(i, n, 0)
				let size = $ v.getSize()
				$ v.get(FeistelWalker(size, subseed)(0), seed: subseed)
			else
				$v
			end
		end
	end
end

macro fact(n)
	let i = 1
	for j in seq(n)
		set i *= $j
	end
	return $i
end

/*
Return a subset of $posParam(Number, count, 1) values from $posParam(any, values, variadic)
*/
ChoiceSet: macro(Number count, ...values)
	// Implementation not clean (some overlaps)
	if count==0 or count.floor() != count or count==len(values)
		raise count must be a positive integer less than $len($values), not "$count".
	end
	let choice = $Choice(...values)
	@Parameter
		size: $ fact(len(values)) / (fact(count) * fact(len(values) - count))
		get: macro(i, n: 0, seed: 0)
			let result = $Table()
			while len(result) < count
				let next = $ choice.get(i % choice.size)
				if not Table.find(result, next)
					run $ Table.append(result, next)
				end
				set i += 1
			end

			return $result
		end
	end
end