let Parameter from $import(../cls/parameter)
let derive, FeistelWalker from $import(../utils/walkers)

Map: macro(parameter, transform)
	@Parameter
		size: $parameter.size
		get: macro(i)
			$ transform(parameter.get(i))
		end
	end
end

Constant: macro(value)
	@Parameter
		size: 1
		get: macro(i)
			$value
		end
	end
end

Choice: macro(...values)
	@Parameter
		size: $ len(values)
		get: macro(i, n: 0, seed: 0)
			let v = $values[i+1]
			return if v.type? == "Parameter" or v.type? == "QuestionFactory" or v.type? == "QuestionFactoryTree"
				let subseed = $ derive(i, n, 0)
				let size = $ v.size? or v.getSize()
				$ v.get(FeistelWalker(size, subseed)(0), seed: subseed)
			else
				$v
			end
		end
	end
end