let Parameter from $import(../cls/parameter)

Map: macro(parameter, transform)
	@Parameter
		size: $parameter.size
		get: macro(i)
			$ transform(parameter.get(i))
		end
	end
end

Constant: macro(value)
	@Parameter
		size: 1
		get: macro(i)
			$value
		end
	end
end

Choice: macro(...values)
	@Parameter
		size: $ len(values)
		get: macro(i)
			$values[i+1]
		end
	end
end