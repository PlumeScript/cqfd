let QuestionFactory from $import(../cls/questionfactory)
let Choice from $import(./set)
let Range from $import(./range)
let FactNumberCls from $import(../utils/factNumber)

ref FactNumber: macro(Number minP: 1, Number maxP: 6, Number maxE: 2, Number minN: 2, Number maxN: 1000)
	@QuestionFactory
		parameters: do
			for i in seq(1, minP-1)
				- $Choice(0)
			end
			for i in seq(minP, maxP)
				- $Range(0, $maxE)
			end
		end
		get: macro(...vp)
			let result = $FactNumberCls(...vp)
			if result.value >= minN and result.value <= maxN
				return $result
			end
		end
	end
end

ref FactNumber2Multiples: macro(Number minP: 1, Number maxP: 6, Number maxE: 2, Number minN: 2, Number maxN: 1000, minK: 2, maxK: 10)
	@QuestionFactory
		parameters: do
			// Base
			- $ FactNumber(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			// Multiple
			- $ Range(minK, maxK)
			// Order
			- $ Choice(0, 1)
		end
		get: macro(a, k, order)
			let b = $ FactNumberCls.fromNumber(a.value * k)

			if a.value != b.value and a.value >= minN and a.value <= maxN and b.value >= minN and b.value <= maxN and a.value != b.value
				if order==1
					set a, b = ($b, $a)
				end
				return do
					- $a
					- $b
					id: $a.id-$b.id
				end
			else
				return
			end
		end
	end
end

ref FactNumber2Coprimes: macro(Number minP: 1, Number maxP: 6, Number maxE: 2, Number minN: 2, Number maxN: 1000)
	@QuestionFactory
		parameters: do
			// weight
			for i in seq(1, minP-1)
				- $Choice(0)
			end
			for i in seq(minP, maxP)
				- $Range(0, $maxE)
			end
			// choice
			for i in seq(1, maxP)
				- $Choice(0, 1)
			end
		end
		get: macro(...vp)
			let weight = for i in seq(1, maxP)
				- $vp[i]
			end
			let choice = for i in seq(maxP+1, 2*maxP)
				- $vp[i]
			end

			let a = @FactNumberCls
				for i in seq(1, maxP)
					if choice[i] == 0
						- $weight[i]
					else
						- 0
					end
				end
			end
			let b = @FactNumberCls
				for i in seq(1, maxP)
					if choice[i] == 1
						- $weight[i]
					else
						- 0
					end
				end
			end
			
			if a.value >= minN and a.value <= maxN and b.value >= minN and b.value <= maxN and a.value != b.value
				return do
					- $a
					- $b
					id: $a.id-$b.id
				end
			else
				return
			end
		end
	end
end

ref FactNumber2NoCoprimesNoMultiples: macro(Number minP: 1, Number maxP: 6, Number maxE: 2, Number minN: 2, Number maxN: 1000)

	@QuestionFactory
		parameters: do
			- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			for i in seq(1, maxP)
				- $Range(0, $maxE)
			end
		end
		get: macro(base, ...vp)
			let vpa = $ Table.copy(base[1].vp)
			let vpb = $ Table.copy(base[2].vp)

			let nullcheck = $true
			for i in seq(1, maxP)
				if vp[i] != 0
					set nullcheck = $false
				end
				set vpa[i] += $ vp[i]
				set vpb[i] += $ vp[i]
			end

			if nullcheck
				return
			end

			let a = $FactNumberCls(...vpa)
			let b = $FactNumberCls(...vpb)

			if a.value >= minN and a.value <= maxN and b.value >= minN and b.value <= maxN and not a.value % b.value == 0 and not b.value % a.value == 0
				return do
					- $a
					- $b
					id: $a.id-$b.id
				end
			else
				return
			end
		end
	end
end

// Get two numbers b and d, then a coprime with b and c coprime with d.
FactNumber4: macro(minP:, maxP: 6, maxE:, minN: 1, maxN: 1000, minK:, maxK:, ?multiple, ?coprime, ?sameDenominator, ?noSameNumerator)
	if multiple and coprime
		raise Theses flags are mutually exclusives
	end
	@QuestionFactory
		parameters: do
			- if coprime
				$ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			elseif multiple
				$ FactNumber2Multiples(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN, minK: minK, maxK: maxK)
			elseif sameDenominator
				$ FactNumber(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			else
				$ FactNumber2NoCoprimesNoMultiples(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			end
			// Choice for c
			for i in seq(1, maxP)
				- $ Range(0, maxE)
			end
			// Choice for d
			for i in seq(1, maxP)
				- $ Range(0, maxE)
			end
		end

		get: macro(base, ...choice)
			let b, d = if sameDenominator
				($base, $base)
			else
				...base
			end
			let a = @FactNumberCls
				for i in seq(1, maxP)
					if (b.vp[i]? or 0) == 0
						- $choice[i]
					else
						- 0
					end
				end
			end
			let c = @FactNumberCls
				for i in seq(1, maxP)
					if (d.vp[i]? or 0) == 0
						- $choice[maxP + i]
					else
						- 0
					end
				end
			end

			if noSameNumerator and a.value==c.value
				return
			end


			if a.value != b.value and c.value != d.value and a.value >= minN and a.value <= maxN and c.value >= minN and c.value <= maxN
				return do
					- $a
					- $b
					- $c
					- $d
					id: $a/$b - $c/$d
				end
			else
				return
			end
		end
	end
end