let QuestionFactory from $import(../cls/questionfactory)
let Choice from $import(./set)
let Range from $import(./range)
let FactNumberCls from $import(../utils/factNumber)

/* 
Generate a number:
@InfosList
	- Between $Param(Number, minN, 2) and $Param(Number, maxN, 1000)
	- Using primes between the $Param(Number, minP, 1)-nth and the $Param(Number, maxP, 6)-nth
	- Without valuation greater than $Param(Number, maxE, 2)
end
*/
ref FactNumber: macro(Number minP: 1, Number maxP: 6, Number maxE: 2, Number minN: 2, Number maxN: 1000)
	@QuestionFactory
		parameters: do
			for i in seq(1, minP-1)
				- $Choice(0)
			end
			for i in seq(minP, maxP)
				- $Range(0, $maxE)
			end
		end
		get: macro(...vp)
			let result = $FactNumberCls(...vp)
			if result.value >= minN and result.value <= maxN
				return $result
			end
		end
	end
end

/* 
Generate two numbers $code(a) and $code(b), where one is a multiple of the other.$newline
@InfosList
	- Use $code(FactNumber) parameters to get the first one
	- Multiply it by a number between $Param(Number, minK, 2) and $Param(Number, maxK, 10)
end 
Value of $code(a) can be forced with $Param(Number, force, empty).$newline
Forced value will always be the greater.
*/
ref FactNumber2Multiples: macro(Number minP: 1, Number maxP: 6, Number maxE: 2, Number minN: 2, Number maxN: 1000, minK: 2, maxK: 10, force:)
	@QuestionFactory
		parameters: do
			// Base
			if force
				- $ Choice(FactNumberCls.fromNumber(force))
			else
				- $ FactNumber(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			end
			// Multiple
			- $ Range(minK, maxK)
			// Order
			- $ Choice(0, 1)
		end
		get: macro(a, k, order)
			let b = $ FactNumberCls.fromNumber(a.value * k)
			if a.value != b.value and a.value >= minN and a.value <= maxN and b.value >= minN and b.value <= maxN and a.value != b.value
				if order==1
					set a, b = ($b, $a)
				end
				return do
					- $a
					- $b
					id: $a.id-$b.id
				end
			else
				return
			end
		end
	end
end

/*
Generate two numbers $code(a) and $code(b) that are coprimes.$newline
Use same parameters as $code(FactNumber).$newline
Value of $code(a) can be forced with $Param(Number, force, empty).
*/
ref FactNumber2Coprimes: macro(Number minP: 1, Number maxP: 6, Number maxE: 2, Number minN: 2, Number maxN: 1000, force:)

	if force and (force < minN or force > maxN)
		raise `force` must be between `minN` and `maxN`
	end

	@QuestionFactory
		parameters: do
			if force
				let f = $ FactNumberCls.fromNumber(force)
				for i in seq(1, maxP)
				
					if f.vp[i]? and f.vp[i]? != 0
						- $Choice($f.vp[i])
					else
						- $Range(0, $maxE)
					end
				end

				for i in seq(1, maxP)
					if (f.vp[i]? or 0)==0
						- $Choice(1)
					else
						- $Choice(0)
					end
				end
			else
				// weight
				for i in seq(1, minP-1)
					- $Choice(0)
				end
				for i in seq(minP, maxP)
					- $Range(0, $maxE)
				end

				// choice
				for i in seq(1, maxP)
					- $Choice(0, 1)
				end
			end
		end
		get: macro(...vp)
			let weight = for i in seq(1, maxP)
				- $vp[i]
			end
			let choice = for i in seq(maxP+1, 2*maxP)
				- $vp[i]
			end

			let a = @FactNumberCls
				for i in seq(1, maxP)
					if choice[i] == 0
						- $weight[i]
					else
						- 0
					end
				end
			end
			let b = @FactNumberCls
				for i in seq(1, maxP)
					if choice[i] == 1
						- $weight[i]
					else
						- 0
					end
				end
			end
			
			if a.value >= minN and a.value <= maxN and b.value >= minN and b.value <= maxN and a.value != b.value
				return do
					- $a
					- $b
					id: $a.id-$b.id
				end
			else
				return
			end
		end
	end
end

/*
Generate two numbers $code(a) and $code(b) that are neither coprimes nor multiples.$newline
Use same parameters as $code(FactNumber).$newline
The shared factor $code(g) is drawn between 2 and the lesser of $code(maxN/10)
and 10, and a coprime
base $code(a_0) and $code(b_0) between $code(minN) and $code(maxN/2): $code(a = a_0 * g)
and $code(b = b_0 * g) always share $code(g) and stay within $code([minN\, maxN]).$newline
Value of $code(a) can be forced with $Param(Number, force, empty).
*/
ref FactNumber2NoCoprimesNoMultiples: macro(Number minP: 1, Number maxP: 6, Number maxE: 2, Number minN: 2, Number maxN: 1000, force:)
	if maxN < 20
		raise maxN must be at least 20 (the shared factor range would be empty).
	end
	let gMaxN = $ Number.floor(maxN / 10)
	if gMaxN > 10
		set gMaxN = 10
	end
	let baseMaxN = $ Number.floor(maxN / 2)
	if force and force > baseMaxN
		set baseMaxN = $force
	end

	@QuestionFactory
		parameters: do
			- $Range(2, $gMaxN)
			- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: baseMaxN, force: force)
		end
		get: macro(g, ab)
			let a = if force
				$ab[1]
			else
				$ FactNumberCls.fromNumber(ab[1].value * g)
			end
			let b = $ FactNumberCls.fromNumber(ab[2].value * g)
			if force
				let k = $ a.gcd(b)
				if k.value == 1
					return
				end
			end
			if a.value >= minN and a.value <= maxN and b.value >= minN and b.value <= maxN and a.value % b.value != 0 and b.value % a.value != 0
				return do
					- $a
					- $b
					id: $a.id-$b.id
				end
			else
				return
			end
		end
	end
end

/*
Target $formula(\\frac a b + \\frac c d) usage: generate four numbers $code(a\, b\, c\, d) where
$glue
@InfosList
	- $code(a) and $code(b) are coprimes
	- $code(c) and $code(d) are coprimes
end

Use same parameters as $code(FactNumber), plus some flags:
$glue
@InfosList
	- $code(\0?multiple) (exclusive with coprime)\: $code(b) and $code(d) will be multiples.
	- $code(\0?coprime) (exclusive with multiple)\: $code(b) and $code(d) will be coprimes.
	- $code(\0?sameDenominator)\: $code(b) and $code(d) will be equal.
	- $code(\0?noSameNumerator)\: $code(a) and $code(c) will be different.
end
$glue
$Param(Number, forceb, empty) will set the value of $code(b).
*/
FactNumber4: macro(minP:, maxP: 6, maxE: 2, minN: 1, maxN: 1000, minK:, maxK:, forceb:, ?multiple, ?coprime, ?sameDenominator, ?noSameNumerator)
	if multiple and coprime
		raise These flags are mutually exclusive
	end
	@QuestionFactory
		parameters: do
			- if coprime
				$ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN, force: forceb)
			elseif multiple
				$ FactNumber2Multiples(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN, minK: minK, maxK: maxK, force: forceb)
			elseif sameDenominator
				if forceb
					$ Choice(FactNumberCls.fromNumber(forceb))
				else
					$ FactNumber(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
				end
			else
				$ FactNumber2NoCoprimesNoMultiples(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN, force: forceb)
			end
			// Choice for c
			for i in seq(1, maxP)
				- $ Range(0, maxE)
			end
			// Choice for d
			for i in seq(1, maxP)
				- $ Range(0, maxE)
			end
		end

		get: macro(base, ...choice)
			let b, d = if sameDenominator
				($base, $base)
			else
				...base
			end
			let a = @FactNumberCls
				for i in seq(1, maxP)
					if (b.vp[i]? or 0) == 0
						- $choice[i]
					else
						- 0
					end
				end
			end
			let c = @FactNumberCls
				for i in seq(1, maxP)
					if (d.vp[i]? or 0) == 0
						- $choice[maxP + i]
					else
						- 0
					end
				end
			end

			if noSameNumerator and a.value==c.value
				return
			end

			if a.value != b.value and c.value != d.value and a.value >= minN and a.value <= maxN and c.value >= minN and c.value <= maxN
				return do
					- $a
					- $b
					- $c
					- $d
					id: $a/$b - $c/$d
				end
			else
				return
			end
		end
	end
end