// A value domain of `size` elements indexed 0..size-1, accessed via get(i).
Parameter: macro(Number size: 1, get:)
	if size <= 0 or size != Number.floor(size)
		raise Size must be a positive integer.
	end
	type: Parameter
	size: $size
	get: macro(i)
		if i > size
			raise Parameter size exceeded ($i > $size).
		end
		return $ get(i)
	end
end