let QuestionFactoryTree from $import(./QuestionFactoryTree)
let FeistelWalker, derive from $import(../utils/walkers)

let hyperParameterMap = $Table()

let qfid = 0
// Wraps named Parameters into a deterministic question generator. `size` is
// the product of all parameter sizes (argument combinations); get(n, seed)
// returns the n-th question, stable per seed.
ref QuestionFactory: macro(parameters: $Table(), hyperParameters: $Table(), get:, validate:, type: any, renderClass:, size:)
	cls: $QuestionFactory
	set qfid += 1
	type: QuestionFactory
	renderClass: $renderClass
	id: QuestionFactory<$qfid>
	parameters: $parameters
	hyperParameters: $hyperParameters
	validate: $validate
	valueType: $type
	if not size
		set size = 1
		for _, parameter in items(parameters)
			set size *= $parameter.getSize()
		end
	end
	size: $size
	memory: $Table()
	idhash: $Table()
	
	// Decode n into mixed-radix digits: first parameter is most significant,
	// each digit turned into one argument value via parameter.get. A nested
	// QuestionFactory receives the outer block (so it re-draws its own
	// hyperparameters per block); plain Parameters are positional and keep argn.
	macro makeArgs(Number n, Number block)
		let args = $Table()
		let basei = $size
		set n = $ n % size
		for name, parameter in items(parameters)
			set basei = $ basei / parameter.getSize()
			let argn = $ Number.floor(n / basei)
			// Nested factories and trees both draw an infinite stream: forward
			// the outer block so each block queries fresh positions.
			if parameter.type? == "QuestionFactory" or parameter.type? == "QuestionFactoryTree"
				set args[name] = $ parameter.get(block * parameter.getSize() + argn)
			else
				set args[name] = $ parameter.get(argn)
			end
			if not args[name]
				return
			end
			set n = $ n % basei
		end

		return $args
	end


	macro makeHyperArgs(Number seed)
		let args = $Table()
		let count = 1
		for name, parameter in items(hyperParameters)
			set count += 1
			let prev = $ hyperParameterMap[parameter]? or 0
			let index = $ prev + 1
			// draw block and position within it: one Feistel permutation per
			// block, so the sequence no longer repeats the same ordering
			let size = $ parameter.getSize()
			let hblock = $ Number.floor((index-1) / size)
			let pos = $ index % size
			let rindex = $ FeistelWalker(size, derive(seed*count, hblock, 0))(pos)
			if parameter.type? == "QuestionFactory"
				// nested factory: an invalid draw is a normal event ; redraw
				// until its own validate accepts, then skip the whole consumed
				// range in the draw stream (like the tree leaf counters)
				let hres = $ parameter.getUntilValid(rindex)
				set args[name] = $hres.result
				set hyperParameterMap[parameter] = $ prev + hres.try
			else
				set args[name] = $ parameter.get(rindex)
				set hyperParameterMap[parameter] = $ index
			end
			if not args[name]
				return
			end
		end
		return $args
	end

	// Bijectively shuffle n within its block so questions look random while
	// staying stable per seed; memoize on first demand, discarding invalid args.
	// The cache is scoped per block: each block re-draws its hyperparameters,
	// so documents longer than one block no longer repeat the same questions.
	get: macro(Number n, Number seed: 0)
		let block = $ Number.floor(n / size)
		set n = $ n % size
		set n = $ FeistelWalker(size, seed+block)(n)
		let bmem = $self.memory[block]?
		if bmem and bmem[n]?
			return $bmem[n]
		end

		let args  = $ makeArgs(n, block)
		let hargs = $ makeHyperArgs(seed)
		let result = if not args or not hargs or (validate and not validate(...args))
			$empty
		else
			$get(...args, ...hargs)
		end
		if not bmem
			set bmem = $Table()
			set self.memory[block] = $bmem
		end
		set bmem[n] = $result
		return $result
	end

	validSeen:
	// Try until first valid solution
	// Reject a cached question id if it would repeat too soon after its
	// original position, then retry with a nearby index.
	getUntilValid: macro(Number n, Number seed: 0)
		let result
		let try = 0
		
		while not result
			set result = $ self.get(n+try, seed: seed)
			set try += 1
			if result == empty
				if try > self.size and not self.validSeen
					raise No valid exercise was found among the `$self.size` existing parameter combinations.
				end
			else
				set self.validSeen = $true
				let existing = $self.idhash[result.id]?
				if existing
					if n+try - existing < self.size
						set result = $empty
					end
				end
			end
		end

		set self.idhash[result.id] = $(n+try)
		return (result: $result, try: $try)
	end

	getSize: macro()
		$self.size
	end

	tree: macro()
		let t = $QuestionFactoryTree()
		run $ t.addLeaf(self, 1)
		return $t
	end

	batch: macro(...args)
		let t = $QuestionFactoryTree()
		run $ t.addLeaf(self, 1)
		return $t.batch(...args)
	end

	meta addr: macro(x)
		let t = $QuestionFactoryTree()
		run $ t.addLeaf(self, 1)
		return $ t+x
	end
	meta addl: macro(x)
		let t = $QuestionFactoryTree()
		run $ t.addLeaf(self, 1)
		return $ x+t
	end

	meta mulr: macro(x)
		let t = $QuestionFactoryTree()
		if plume.type(x) == "number" or plume.type(x) == "string" and x.isNumber()
			if x <= 0
				raise Exposant must be greater than zero.
			elseif x != Number.floor(x)
				raise x must an integer.
			end
			run $ t.addLeaf(self, x)
			return $t
		else
			run $ t.addLeaf(self, 1)
		end
		return $ t*x
	end
	meta mull: macro(x)
		let t = $QuestionFactoryTree()
		if plume.type(x) == "number" or plume.type(x) == "string" and x.isNumber()
			if x <= 0
				raise Exposant must be greater than zero.
			elseif x != Number.floor(x)
				raise x must an integer.
			end
			run $ t.addLeaf(self, x)
			return $t
		else
			run $ t.addLeaf(self, 1)
		end
		return $ x*t
	end
end