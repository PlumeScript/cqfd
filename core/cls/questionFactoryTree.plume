let Question from $import(./Question)
let PermutationWalker, FeistelWalker from $import(../utils/walkers)

// Weighted tree of QuestionFactory leaves. get(n, seed) walks the tree with
// deterministic weighted selection and returns the n-th question.
ref QuestionFactoryTree: macro()
	cls: $QuestionFactoryTree
	lock: $false
	type: QuestionFactoryTree
	_batch: $empty
	questionFactoryList: $Table()
	copy: macro()
		let result = $QuestionFactoryTree()
		for q in self.questionFactoryList
			if q.type == "QuestionFactoryLeaf"
				run $ result.addLeaf(q.question, q.weight)
			else
				run $ result.addSubTree(q.tree.copy(), q.weight)
			end
		end

		return $result
	end

	addLeaf: macro(question, weight)
		if self.lock
			raise Cannot edit a tree after first generation.
		end
		@Table.append($self.questionFactoryList)
			- do
				type: QuestionFactoryLeaf
				question: $question
				weight: $weight
			end
		end
	end

	// Merge a subtree: single leaves flatten into this level (weights fold),
	// but a multi-leaf subtree stays a weighted QuestionFactorySubTree node.
	addSubTree: macro(tree, weight)
		if self.lock
			raise Cannot edit a tree after first generation.
		end
		if len(tree.questionFactoryList) == 1
			let leaf = $tree.questionFactoryList[1]
			if leaf.type == "QuestionFactorySubTree"
				@Table.append($self.questionFactoryList)
					- do
						type: QuestionFactorySubTree
						tree: $leaf.tree
						weight: $(leaf.weight * weight)
					end
				end
			else
				$ self.addLeaf(leaf.question, leaf.weight * weight)
			end
		else
			@Table.append($self.questionFactoryList)
				- do
					type: QuestionFactorySubTree
					tree: $tree
					weight: $weight
				end
			end
		end
	end

	meta add: macro(x, y)
		let tx = $ type(x) == "table" and x.type? or type(x)
		if tx == "QuestionFactory"
			let t = $QuestionFactoryTree()
			run $ t.addLeaf(x, 1)
			set x = $t
		elseif tx != "QuestionFactoryTree"
			raise Error\: cannot add "QuestionFactoryTree" and "$tx"
		end
		let ty = $ type(y) == "table" and y.type? or type(y)
		if ty == "QuestionFactory"
			let t = $QuestionFactoryTree()
			run $ t.addLeaf(y, 1)
			set y = $t
		elseif ty != "QuestionFactoryTree"
			raise Error\: cannot add "QuestionFactoryTree" and "$ty"
		end

		let result = $QuestionFactoryTree()

		set result.questionFactoryList = $Table(...x.questionFactoryList, ...y.questionFactoryList)
		return $result
	end

	meta mul: macro(x, y)
		let tx = $ type(x) == "table" and x.type? or type(x)
		if tx == "QuestionFactory"
			let t = $QuestionFactoryTree()
			run $ t.addLeaf(x, 1)
			set x = $t
		elseif tx != "QuestionFactoryTree"
			raise Error\: cannot mul "QuestionFactoryTree" and "$tx"
		end
		let ty = $ type(y) == "table" and y.type? or type(y)
		if ty == "QuestionFactory"
			let t = $QuestionFactoryTree()
			run $ t.addLeaf(y, 1)
			set y = $t
		elseif ty != "QuestionFactoryTree"
			raise Error\: cannot mul "QuestionFactoryTree" and "$ty"
		end

		let result = $QuestionFactoryTree()

		run $ result.addSubTree(x, 1)
		run $ result.addSubTree(y, 1)
		return $result
	end

	meta powr: macro(Number r)
		if r <= 0
			raise Exposant must be greater than zero.
		elseif r != Number.floor(r)
			raise r must an integer.
		end
		let t = $QuestionFactoryTree()
		run $ t.addSubTree(self, r)
		return $ t
	end

	tostring: macro(indent:)
		$indent\0[\n
		let iindent = $indent\s\s

		for elem in self.questionFactoryList
			$iindent$elem.weight ->
			if elem.type == "QuestionFactoryLeaf"
				\s$elem.question.id
			else
				$ elem.tree.tostring(indent: iindent)
			end

			\n
		end
		$indent\0]\n
	end

	meta tostring: macro()
		QuestionFactoryTree\n
		$self.tostring()
	end

	// Assign every tree node an id and the total weight of its children.
	createNodeMap: macro()
		let tovisit = $ Table(self)
		let count = 0
		while len(tovisit) > 0
			set count += 1
			let elem = $ Table.remove(tovisit)
			let weight = 0

			for child in elem.questionFactoryList
				set weight += $child.weight
				set count += 1
				if child.type == "QuestionFactorySubTree"
					run $ Table.append(tovisit, child.tree)
				end
			end

			$elem: (id: $count, weight: $weight)
		end
		_size: $count
	end

	get: macro(Number n, Number seed: 0)
		if self._batch
			let batch = for i in seq(self._batch.count)
				- $ self._get(n*self._batch.count + i - 1, seed)
			end
			return @Question(batch)
				id: $batch[1].id
				items: $batch
				styleOptn: $self._batch.styleOptn
				instruction: $self._batch.instruction
			end
		else
			return $ self._get(n, seed)
		end
	end

	_get: macro(n, seed)
		if not self.lock
			set self.lock = $true
			set self.nodeMap = $self.createNodeMap()
			set self.callCache = $Table()
			set self.questionCache = $Table()
			set self.questionMap = $Table()
			set self.questionId = 0
		end

		if not self.callCache[seed]?
			set self.callCache[seed] = $Table()
		end

		if n+1 <= len(self.callCache[seed])
			return $self.callCache[seed][n+1]
		else
			for i in seq(len(self.callCache[seed]), n-1)
				run $ self._get(i, seed)
			end
		end

		// Walk down (seed-driven) until a leaf: the weighted random pick.
		let selection = $self
		while true
			let infos = $ self.nodeMap[selection]
			let selectionSeed = $ FeistelWalker(self.nodeMap._size, seed)(infos.id)
			let index = $ PermutationWalker(infos.weight, seed+selectionSeed)(n)

			for elem in selection.questionFactoryList
				set index -= $elem.weight
				if index < 0
					set selection = $elem
					break
				end
			end

			if selection.type == "QuestionFactoryLeaf"
				break
			else
				set selection = $selection.tree
			end
		end

		if not self.questionMap[selection.question]?
			set self.questionId += 1
			set self.questionMap[selection.question] = (counter: 0, id: $self.questionId)
		end
		let questionInfos = $self.questionMap[selection.question]
		let questionSeed  = $ FeistelWalker(self.nodeMap._size, self.nodeMap._size+seed)(questionInfos.id)

		let result, try from @selection.question.getUntilValid
			- $questionInfos.counter
			seed: $questionSeed
		end

		set questionInfos.counter += $try
		set self.callCache[seed][n+1] = $result

		return $result
	end

	getNext: macro(seed: 0)
		if not self.counter?
			set self.counter = 0
		end
		set self.counter += 1
		return $ self.get(self.counter-1, seed: seed)
	end

	batch: macro(count, instruction:, ...args)
		if self._batch
			raise This tree is already a batch.
		end
		let result = $self.copy()
		set result._batch = (count: $count, styleOptn: $args, instruction: $instruction)
		return $result
	end
end