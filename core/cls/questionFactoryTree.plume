let Question from $import(./Question)
let PermutationWalker, FeistelWalker, PermFromRank, fact from $import(../utils/walkers)

// Weighted tree of QuestionFactory leaves. get(n, seed) walks the tree with
// deterministic weighted selection and returns the n-th question.
ref QuestionFactoryTree: macro()
	cls: $QuestionFactoryTree
	lock: $false
	type: QuestionFactoryTree
	_batch: $empty
	_window: $empty
	questionFactoryList: $Table()
	copy: macro(?preserveBatch)
		let result = $QuestionFactoryTree()
		if preserveBatch
			set result._batch = $self._batch
		end
		set result._window = $self._window
		for q in self.questionFactoryList
			if q.type == "QuestionFactoryLeaf"
				run $ result.addLeaf(q.question, q.weight)
			else
				run $ result.addSubTree(q.tree.copy(?preserveBatch), q.weight)
			end
		end

		return $result
	end

	addLeaf: macro(question, weight)
		if self.lock
			raise Cannot edit a tree after first generation.
		end
		@Table.append($self.questionFactoryList)
			- do
				type: QuestionFactoryLeaf
				question: $question
				weight: $weight
			end
		end
	end

	// Merge a subtree: single leaves flatten into this level (weights fold),
	// but a multi-leaf subtree stays a weighted QuestionFactorySubTree node.
	addSubTree: macro(tree, weight)
		if self.lock
			raise Cannot edit a tree after first generation.
		end
		if len(tree.questionFactoryList) == 1 and not tree._batch?
			let leaf = $tree.questionFactoryList[1]
			if leaf.type == "QuestionFactorySubTree"
				@Table.append($self.questionFactoryList)
					- do
						type: QuestionFactorySubTree
						tree: $leaf.tree
						weight: $(leaf.weight * weight)
					end
				end
			elseif leaf.type == "QuestionFactoryBatchLeaf"
				@Table.append($self.questionFactoryList)
					- do
						type: QuestionFactoryBatchLeaf
						tree: $leaf.tree
						weight: $(leaf.weight * weight)
					end
				end
			else
				$ self.addLeaf(leaf.question, leaf.weight * weight)
			end
		else
			@Table.append($self.questionFactoryList)
				- do
					type: $ tree.batch? and "QuestionFactoryBatchLeaf" or "QuestionFactorySubTree"
					tree: $tree
					weight: $weight
				end
			end
		end
	end

	meta add: macro(x, y)
		let tx = $ type(x) == "table" and x.type? or type(x)
		if tx == "QuestionFactory"
			let t = $QuestionFactoryTree()
			run $ t.addLeaf(x, 1)
			set x = $t
		elseif tx != "QuestionFactoryTree"
			raise Error\: cannot add "QuestionFactoryTree" and "$tx"
		end
		let ty = $ type(y) == "table" and y.type? or type(y)
		if ty == "QuestionFactory"
			let t = $QuestionFactoryTree()
			run $ t.addLeaf(y, 1)
			set y = $t
		elseif ty != "QuestionFactoryTree"
			raise Error\: cannot add "QuestionFactoryTree" and "$ty"
		end

		if x._batch or y._batch
			raise Cannot add batch. Use "*" instead.
		end

		let result = $QuestionFactoryTree()

		set result.questionFactoryList = $Table(...x.questionFactoryList, ...y.questionFactoryList)
		return $result
	end

	meta mul: macro(x, y)
		let tx = $ type(x) == "table" and x.type? or type(x)
		let ty = $ type(y) == "table" and y.type? or type(y)

		let result = $QuestionFactoryTree()
		if tx == "number" or tx == "string" and x.isNumber()
			if x <= 0
				raise Exposant must be greater than zero.
			elseif x != Number.floor(x)
				raise x must an integer.
			end
			run $ result.addSubTree(y, x)
			return $result
		elseif ty == "number" or ty == "string" and y.isNumber()
			if y <= 0
				raise Exposant must be greater than zero.
			elseif y != Number.floor(y)
				raise y must an integer.
			end
			run $ result.addSubTree(x, y)
			return $result
		end

		if tx == "QuestionFactory"
			let t = $QuestionFactoryTree()
			run $ t.addLeaf(x, 1)
			set x = $t
		elseif tx != "QuestionFactoryTree"
			raise Error\: cannot mul "QuestionFactoryTree" and "$tx"
		end
		
		if ty == "QuestionFactory"
			let t = $QuestionFactoryTree()
			run $ t.addLeaf(y, 1)
			set y = $t
		elseif ty != "QuestionFactoryTree"
			raise Error\: cannot mul "QuestionFactoryTree" and "$ty"
		end

		

		run $ result.addSubTree(x, 1)
		run $ result.addSubTree(y, 1)
		return $result
	end

	meta powr: macro(Number r)
		if r <= 0
			raise Exposant must be greater than zero.
		elseif r != Number.floor(r)
			raise r must an integer.
		end
		let t = $QuestionFactoryTree()
		run $ t.addSubTree(self, r)
		return $ t
	end

	tostring: macro(indent:)
		$indent\0[\n
		let iindent = $indent\s\s

		for elem in self.questionFactoryList
			$iindent$elem.weight ->
			if elem.type == "QuestionFactoryLeaf"
				\s$elem.question.id
			else
				$ elem.tree.tostring(indent: iindent)
			end

			\n
		end
		$indent\0]\n
	end

	meta tostring: macro()
		QuestionFactoryTree\n
		$self.tostring()
	end

	// Assign every tree node an id and the total weight of its children.
	createNodeMap: macro()
		let tovisit = $ Table(self)
		let count = 0
		while len(tovisit) > 0
			set count += 1
			let elem = $ Table.remove(tovisit)
			let weight = 0

			for child in elem.questionFactoryList
				set weight += $child.weight
				set count += 1
				if child.type == "QuestionFactorySubTree"
					run $ Table.append(tovisit, child.tree)
				end
			end

			$elem: (id: $count, weight: $weight)
		end
		_size: $count
	end

	get: macro(Number n, Number seed: 0)
		if self._batch
			let batch = for i in seq(self._batch.count)
				- $ self._get(n*self._batch.count + i - 1, seed)
			end
			return @Question(batch)
				id: $batch[1].id
				items: $batch
				styleOptn: $self._batch.styleOptn
				instruction: $self._batch.instruction
			end
		else
			return $ self._get(n, seed)
		end
	end

	_get: macro(n, seed)
		if not self.lock
			set self.lock = $true
			set self.nodeMap = $self.createNodeMap()
			set self.callCache = $Table()
			set self.questionCache = $Table()
			set self.questionMap = $Table()
			set self.questionId = 0
			set self.nodeCounter = $Table()
			set self.windowState = $Table()
			// Default window: min(10, n/2) leaves, capped per node below.
			if not self._window
				let n = $self.leafCount()
				let d = $ Number.floor(n / 2)
				if d > 10
					set d = 10
				end
				set self._window = $d
			end
		end

		if not self.callCache[seed]?
			set self.callCache[seed] = $Table()
			set self.nodeCounter[seed] = $Table()
			set self.windowState[seed] = $Table()
		end

		if n+1 <= len(self.callCache[seed])
			return $self.callCache[seed][n+1]
		else
			for i in seq(len(self.callCache[seed]), n-1)
				run $ self._get(i, seed)
			end
		end

		// Walk down (seed-driven) until a leaf: the weighted random pick.
		// The root is indexed on the global draw n; each deeper level is indexed
		// on its own occurrence count (dense per seed), so a branch's inner walk
		// stays balanced in its own draw space.
		let selection = $self
		let levelIndex = $n
		while true
			let infos = $ self.nodeMap[selection]
			let selectionSeed = $ FeistelWalker(self.nodeMap._size, seed)(infos.id)
			let index = $ self._windowedSlot(selection, levelIndex, seed, selectionSeed)

			for elem in selection.questionFactoryList
				set index -= $elem.weight
				if index < 0
					set selection = $elem
					break
				end
			end

			if selection.type != "QuestionFactorySubTree"
				break
			else
				// Descend: the child's draw is its next occurrence, counted per seed.
				if not self.nodeCounter[seed][selection.tree]?
					set levelIndex = 0
				else
					set levelIndex = $ self.nodeCounter[seed][selection.tree]
				end
				set self.nodeCounter[seed][selection.tree] = $levelIndex + 1
				set selection = $selection.tree
			end
		end

		let key = $ selection.question? or selection.tree
		if not self.questionMap[key]?
			set self.questionId += 1
			set self.questionMap[key] = (counter: 0, id: $self.questionId)
		end
		let questionInfos = $self.questionMap[key]
		let questionSeed  = $ FeistelWalker(self.nodeMap._size, self.nodeMap._size+seed)(questionInfos.id)
		


		let result, try: 1 from if selection.type == "QuestionFactoryLeaf" 
			...@selection.question.getUntilValid
				- $questionInfos.counter
				seed: $(questionSeed+1)
			end
		else
			result: @selection.tree.get
				- $questionInfos.counter
				seed: $(questionSeed+1)
			end
		end

		set questionInfos.counter += $try
		set self.callCache[seed][n+1] = $result

		return $result
	end

	getNext: macro(seed: 0)
		// Per-seed counters: each seed walks its own dense sequence from 0, so
		// interleaved seeds don't fracture the aligned blocks.
		if not self.counter?
			set self.counter = $Table()
		end
		let c = $ self.counter[seed]? or 0
		set self.counter[seed] = $c + 1
		return $ self.get(c, seed: seed)
	end

	batch: macro(count, instruction:, ...args)
		if self._batch
			raise This tree is already a batch.
		end
		if count <= 0
			raise Batch count must be greater than zero.
		end
		if count != Number.floor(count)
			raise Batch count must be an integer.
		end
		let result = $self.copy()
		set result._batch = (count: $count, styleOptn: $args, instruction: $instruction)
		return $result
	end

	// Window: no identical child within k consecutive draws, at every level.
	// Returns a copy with the given window (the tree itself is untouched).
	window: macro(k)
		if self._batch
			raise This tree is already a batch.
		end
		if k < 1
			raise Window must be greater than zero.
		end
		if k != Number.floor(k)
			raise k must an integer.
		end
		let result = $self.copy()
		set result._window = $k
		return $result
	end

	// Total number of leaves (subtrees contribute their own leaves).
	leafCount: macro()
		let total = 0
		for elem in self.questionFactoryList
			if elem.type == "QuestionFactoryLeaf"
				set total += 1
			else
				set total += $elem.tree.leafCount()
			end
		end
		return $total
	end

	// Window-aware slot pick at a node. Mirrors PermutationWalker's block
	// structure (blocks of W = full multiset permutations), but the block
	// permutation is chosen by scanning the Feistel-ordered permutation ids
	// for the first one with no repeated group within window k, inside the
	// block and against the previous block's suffix. State per (seed, node)
	// holds the chosen block; the sequential cache fill guarantees that
	// blocks are visited in order.
	_windowedSlot: macro(node, levelIndex, seed, baseSeed)
		let W = $self.nodeMap[node].weight
		let k = $self._window
		let c = $ len(node.questionFactoryList)
		// A window wider than the child count is impossible: cap it.
		if k > c
			set k = $c
		end
		if k < 2
			return $ PermutationWalker(W, seed+baseSeed)(levelIndex)
		end

		// Block decomposition, mirrors PermutationWalker.
		let block =      $ fact(W) * W
		let blockId =    $ Number.floor(levelIndex / block)
		let posInBlock = $ levelIndex % block
		let permuId =    $ Number.floor(posInBlock / W)
		let permuPos =   $ posInBlock % W

		if not self.windowState[seed]?
			set self.windowState[seed] = $Table()
		end
		let st = $self.windowState[seed][node]?
		if st and st.blockId == blockId
			return $st.perm[permuPos+1]
		end

		// Boundary state: the previous block's last k-1 groups, boundary-first.
		let prevSuffix = $empty
		if st and st.blockId == blockId - 1
			set prevSuffix = $st.suffix
		end

		// First compatible block in Feistel order; best-effort (fewest
		// violations) if none exists (infeasible weight structures).
		let fw = $ FeistelWalker(fact(W), seed+baseSeed+blockId)
		let chosen = $empty
		let bestP = $empty
		let bestV = -1
		for t in seq(0, fact(W)-1)
			let p = $ PermFromRank(W, fw(permuId+t))
			let v = $ self._windowViolations(node, p, k, prevSuffix)
			if v == 0
				set chosen = $p
				break
			end
			if v < bestV
				set bestV = $v
				set bestP = $p
			end
		end
		if not chosen
			set chosen = $bestP
		end

		set self.windowState[seed][node] = (blockId: $blockId, perm: $chosen, suffix: $(self._blockSuffix(node, chosen, k)))
		return $chosen[permuPos+1]
	end

	// Count window-k violations of a candidate block: a group repeated within
	// k slots inside the block, or matched with the previous block's suffix
	// (T_i = i-th group from its end, U_j = j-th from the start; a window of
	// k holds both when i + j <= k).
	_windowViolations: macro(node, perm, k, prevSuffix)
		let v = 0
		for i in seq(1, len(perm))
			for d in seq(1, k-1)
				if i+d <= len(perm) and self._slotGroup(node, perm[i]) == self._slotGroup(node, perm[i+d])
					set v += 1
				end
			end
		end
		if prevSuffix
			for i in seq(1, len(prevSuffix))
				for j in seq(1, k-1)
					if i+j <= k and prevSuffix[i] == self._slotGroup(node, perm[j])
						set v += 1
					end
				end
			end
		end
		return $v
	end

	// A block's last k-1 groups, boundary-first (T_1 = the last group).
	_blockSuffix: macro(node, perm, k)
		let L = $ k - 1
		let W = $ len(perm)
		if L > W
			set L = $W
		end
		let suffix = for d in seq(0, L-1)
			- $ self._slotGroup(node, perm[W-d])
		end
		return $suffix
	end

	// Group id (1-based child position) of a slot in a node's weight range.
	_slotGroup: macro(node, slot)
		for i in seq(1, len(node.questionFactoryList))
			if slot < node.questionFactoryList[i].weight
				return $i
			end
			set slot -= $node.questionFactoryList[i].weight
		end
		return 0
	end
end