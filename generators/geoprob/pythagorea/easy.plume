let Question from $import(../../../core/cls/question)
let QuestionFactory from $import(../../../core/cls/questionFactory)

let PythagoreaDirect1 from $import(./standard)

let pages = $import(pages) // Should be in render
let m = macro(x) $pages.formula($x, processor: ascii)

PythagoreaDirectFormula: macro(sourceGenerator)
	@QuestionFactory
		parameters: do
			- $sourceGenerator
		end
		get: macro(source)
			@Question(demonstration)
				premise: $source.premise
				hypotheses: $Table()
				target: $source.target
				note: On cherche à déterminer la longueur $m($source.target.name) ; écrire l'égalité de Pythagore dans cette situation.
				steps: do
					- do
					 	type: eqn
						- $source.steps[2][1]
					end
				end
			end
		end
	end
end

// More or less a copy of eqnPythagorea

PythagoreaDirect1Solving: macro(sourceGenerator)
	@QuestionFactory
		parameters: do
			- $sourceGenerator
		end
		get: macro(source)
			@Question(eqn)
				steps: do
					for i in seq(2, len(source.steps[2]))
						- $source.steps[2][i]
					end
				end
			end
		end
	end
end
