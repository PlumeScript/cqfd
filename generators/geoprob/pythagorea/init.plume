// TODO? generalise option as flag-value OR table, like unit
// TODO: randomize triangle name

let Question from $import(../../../core/cls/question)
let QuestionFactory from $import(../../../core/cls/questionFactory)
let Choice from $import(../../../core/parameters/set)

let letters from $import(../../geo/utils)

let pages = $import(pages) // Should be in render
let m = macro(x) $pages.formula($x, processor: ascii)

let rationnalPythagoreTriplets, irrationnal1PythagoreTriplets, irrationnal2PythagoreTriplets, solveDirectPythagorea1, solveDirectPythagorea2, makeHiddenTriangle, solveIsoscelesDirectPythagorea1, solveIsoscelesDirectPythagorea2, makeHiddenIsoscelesTriangle, irrationnalPythagoreIsoscelesTriplets, irrationnal2PythagoreIsoscelesTriplets from $import(./utils)
let makeApproxInstruction from $import(../utils)

/*
Generate a Pythagorean theorem proof\: the right triangle hidden in $code(hiddenIn) has its two legs given and the hypotenuse is asked.$newline
$Param(Number, approx, empty) the number of digits the answer is rounded to (no rounding when empty).
$Param(String, unit, cm) the unit of the lengths (a list draws one).
$Param(String, hiddenIn, triangle) the shape that hides the right triangle\: $code(triangle), $code(rectangle), $code(losange), $code(hauteur) (a list draws one).
$code(\0?easy) and $code(\0?medium) lower the range of the values.
$code(\0?rationnal) to draw a Pythagorean triplet (a multiple of 3-4-5) instead of two integers.
*/
PythagoreaDirect1: macro(approx:, unit:, hiddenIn:, ?easy, ?medium, ?rationnal)
	@QuestionFactory
		parameters: do
			if rationnal
				- $ rationnalPythagoreTriplets(easy: easy, medium: medium)
			else
				- $ irrationnal1PythagoreTriplets(easy: easy, medium: medium)
			end
		end
		hyperParameters: do
			- $letters(5)
			- if type(unit) == "table"
				$Choice(...unit)
			else
				$Choice($unit)
			end
			- if type(hiddenIn) == "table"
				$Choice(...hiddenIn)
			else
				if hiddenIn
					$Choice($hiddenIn)
				else
					$Choice(triangle)
				end
			end
		end
		get: macro(pt, letters, unit, hiddenIn)
			let AB, AC, BC = $pt
			let L0, L1, L2, L3, L4 = $letters
			let tri = $ makeHiddenTriangle(hiddenIn, L0, L1, L2, L3, L4)
			@Question(demonstration)
				unit: $unit
				approx: $approx
				instruction: $tri.intro avec $m($tri.right$tri.leg1=$AB$unit) et $m($tri.right$tri.leg2=$AC$unit). Déterminer la longueur $m($tri.leg1$tri.leg2) $makeApproxInstruction($BC, $approx, $unit).
				steps: do
					- do
						type: sentence
						- $tri.rightSentence
						- D'après le théorème de Pythagore
					end
					- $ solveDirectPythagorea1(tri.right, tri.leg1, tri.leg2, AB, AC, BC)
				end
			end
		end
	end
end

/*
Generate a Pythagorean theorem proof\: the right triangle hidden in $code(hiddenIn) has a leg and the hypotenuse given, the other leg is asked.$newline
$Param(Number, approx, empty) the number of digits the answer is rounded to (no rounding when empty).
$Param(String, unit, cm) the unit of the lengths (a list draws one).
$Param(String, hiddenIn, triangle) the shape that hides the right triangle\: $code(triangle), $code(rectangle), $code(losange), $code(hauteur) (a list draws one).
$code(\0?easy) and $code(\0?medium) lower the range of the values.
$code(\0?rationnal) to draw a Pythagorean triplet (a multiple of 3-4-5) instead of two integers.
*/
PythagoreaDirect2: macro(approx:, unit:, hiddenIn:, ?easy, ?medium, ?rationnal)
	@QuestionFactory
		parameters: do
			if rationnal
				- $ rationnalPythagoreTriplets(easy: easy, medium: medium)
			else
				- $ irrationnal2PythagoreTriplets(easy: easy, medium: medium)
			end
		end
		hyperParameters: do
			- $letters(5)
			- if type(unit) == "table"
				$Choice(...unit)
			else
				$Choice($unit)
			end
			- $Choice(0, 1)
			- if type(hiddenIn) == "table"
				$Choice(...hiddenIn)
			else
				if hiddenIn
					$Choice($hiddenIn)
				else
					$Choice(triangle)
				end
			end
		end
		get: macro(pt, letters, unit, switch, hiddenIn)
			let AB, AC, BC = $pt
			let L0, L1, L2, L3, L4 = $letters
			let tri = $ makeHiddenTriangle(hiddenIn, L0, L1, L2, L3, L4)
			@Question(demonstration)
				unit: $unit
				approx: $approx
				instruction: do
					$tri.intro avec\s
					if switch==0
						$m($tri.leg1$tri.leg2=$BC$unit) et $m($tri.right$tri.leg1=$AB$unit)
					else
						$m($tri.right$tri.leg1=$AB$unit) et $m($tri.leg1$tri.leg2=$BC$unit)
					end
					.\s
					Déterminer la longueur $m($tri.right$tri.leg2) $makeApproxInstruction($AC, $approx, $unit).
				end

				steps: do
					- do
						type: sentence
						- $tri.rightSentence
						- D'après le théorème de Pythagore
					end
					- $ solveDirectPythagorea2(tri.right, tri.leg1, tri.leg2, AB, AC, BC)
				end
			end
		end
	end
end

/*
Generate a Pythagorean theorem proof on a right isosceles triangle hidden in $code(hiddenIn)\: a leg is given and the hypotenuse (an irrational length) is asked.$newline
$Param(Number, approx, empty) the number of digits the answer is rounded to (no rounding when empty).
$Param(String, unit, cm) the unit of the lengths (a list draws one).
$Param(String, hiddenIn, triangle) the shape that hides the right isosceles triangle\: $code(triangle) or $code(square) (a list draws one).
$code(\0?easy) and $code(\0?medium) lower the range of the values.
*/
PythagoreaIsoscelesDirect1: macro(approx:, unit:, hiddenIn:, ?easy, ?medium)
	@QuestionFactory
		parameters: do
			- $ irrationnalPythagoreIsoscelesTriplets(easy: easy, medium: medium)
		end
		hyperParameters: do
			- $letters(5)
			- if type(unit) == "table"
				$Choice(...unit)
			else
				$Choice($unit)
			end
			- if type(hiddenIn) == "table"
				$Choice(...hiddenIn)
			else
				if hiddenIn
					$Choice($hiddenIn)
				else
					$Choice(triangle)
				end
			end
		end
		get: macro(pt, letters, unit, hiddenIn)
			let L0, L1, L2, L3, L4 = $letters
			let tri = $ makeHiddenIsoscelesTriangle(hiddenIn, L0, L1, L2, L3, L4)
			let AB, AC, BC = $pt
			let BC2 = $ (BC^2).value()
			@Question(demonstration)
				unit: $unit
				approx: $approx
				instruction: do
					$tri.intro, avec $m($tri.right$tri.leg1=$AB$unit).\s
					Déterminer la longueur $m($tri.leg1$tri.leg2) $makeApproxInstruction($BC, $approx, $unit).
				end
				steps: do
					- do
						type: sentence
						- $tri.rightSentence
						- D'après le théorème de Pythagore
					end
					- $ solveIsoscelesDirectPythagorea1(tri.right, tri.leg1, tri.leg2, AB, BC, BC2)
				end
			end
		end
	end
end

/*
Generate a Pythagorean theorem proof on a right isosceles triangle hidden in $code(hiddenIn)\: the hypotenuse (an irrational length) is given and a leg is asked.$newline
$Param(Number, approx, empty) the number of digits the answer is rounded to (no rounding when empty).
$Param(String, unit, cm) the unit of the lengths (a list draws one).
$Param(String, hiddenIn, triangle) the shape that hides the right isosceles triangle\: $code(triangle) or $code(square) (a list draws one).
$code(\0?easy) and $code(\0?medium) lower the range of the values.
*/
PythagoreaIsoscelesDirect2: macro(approx:, unit:, hiddenIn:, ?easy, ?medium)
	@QuestionFactory
		parameters: do
			- $ irrationnal2PythagoreIsoscelesTriplets(easy: easy, medium: medium)
		end
		hyperParameters: do
			- $letters(5)
			- if type(unit) == "table"
				$Choice(...unit)
			else
				$Choice($unit)
			end
			- if type(hiddenIn) == "table"
				$Choice(...hiddenIn)
			else
				if hiddenIn
					$Choice($hiddenIn)
				else
					$Choice(triangle)
				end
			end
		end
		get: macro(pt, letters, unit, hiddenIn)
			let L0, L1, L2, L3, L4 = $letters
			let tri = $ makeHiddenIsoscelesTriangle(hiddenIn, L0, L1, L2, L3, L4)
			let AB, AC, BC = $pt
			let AB2 = $ (AC^2).value()
			@Question(demonstration)
				unit: $unit
				approx: $approx
				instruction: do
					$tri.intro, avec $m($tri.leg1$tri.leg2=$BC$unit).\s
					Déterminer la longueur $m($tri.right$tri.leg1) $makeApproxInstruction($AB, $approx, $unit).
				end
				steps: do
					- do
						type: sentence
						- $tri.rightSentence
						- D'après le théorème de Pythagore
					end
					- $ solveIsoscelesDirectPythagorea2(tri.right, tri.leg1, tri.leg2, AB, BC, AB2)
				end
			end
		end
	end
end