// TODO? generalise option as flag-value OR table, like unit
// TODO: randomize triangle name

let Question from $import(../../../core/cls/question)
let QuestionFactory from $import(../../../core/cls/questionFactory)
let Range from $import(../../../core/parameters/range)
let Choice from $import(../../../core/parameters/set)

let letters from $import(../../geo/utils)

let pages = $import(pages) // Should be in render
let m = macro(x) $pages.formula($x, processor: ascii)
let s from $import(../../../core/utils/expression)

let rationnalPythagoreTriplets, irrationnal1PythagoreTriplets, irrationnal2PythagoreTriplets, solveDirectPythagorea1, solveDirectPythagorea2, makeHiddenTriangle from $import(./utils)
let makeApproxInstruction from $import(../utils)

PythagoreaDirect1: macro(approx:, unit:, hiddenIn:, ?easy, ?medium, ?rationnal)
	@QuestionFactory
		parameters: do
			if rationnal
				- $ rationnalPythagoreTriplets(easy: easy, medium: medium)
			else
				- $ irrationnal1PythagoreTriplets(easy: easy, medium: medium)
			end
		end
		hyperParameters: do
			- $letters(5)
			- if type(unit) == "table"
				$Choice(...unit)
			else
				$Choice($unit)
			end
			- if type(hiddenIn) == "table"
				$Choice(...hiddenIn)
			else
				$Choice(triangle)
			end
		end
		get: macro(pt, letters, unit, hiddenIn)
			let AB, AC, BC = $pt
			let L0, L1, L2, L3, L4 = $letters
			let tri = $ makeHiddenTriangle(hiddenIn, L0, L1, L2, L3, L4)
			@Question(demonstration)
				unit: $unit
				approx: $approx
				instruction: $tri.intro avec $m($tri.right$tri.leg1=$AB$unit) et $m($tri.right$tri.leg2=$AC$unit). Déterminer la longueur $m($tri.leg1$tri.leg2) $makeApproxInstruction($BC, $approx, $unit).
				steps: do
					- do
						type: sentence
						- $tri.rightSentence
						- D'après le théorème de Pythagore
					end
					- $ solveDirectPythagorea1(tri.right, tri.leg1, tri.leg2, AB, AC, BC)
				end
			end
		end
	end
end

PythagoreaDirect2: macro(approx:, unit:, ?easy, ?medium, ?rationnal, ?hiddenIn)
	@QuestionFactory
		parameters: do
			if rationnal
				- $ rationnalPythagoreTriplets(easy: easy, medium: medium)
			else
				- $ irrationnal2PythagoreTriplets(easy: easy, medium: medium)
			end
		end
		hyperParameters: do
			- $letters(5)
			- if type(unit) == "table"
				$Choice(...unit)
			else
				$Choice($unit)
			end
			- $Choice(0, 1)
			- if type(hiddenIn) == "table"
				$Choice(...hiddenIn)
			else
				$Choice(triangle)
			end
		end
		get: macro(pt, letters, unit, switch, hiddenIn)
			let AB, AC, BC = $pt
			let L0, L1, L2, L3, L4 = $letters
			let tri = $ makeHiddenTriangle(hiddenIn, L0, L1, L2, L3, L4)
			@Question(demonstration)
				unit: $unit
				approx: $approx
				instruction: do
					$tri.intro avec\s
					if switch
						$m($tri.leg1$tri.leg2=$BC$unit) et $m($tri.right$tri.leg1=$AB$unit)
					else
						$m($tri.right$tri.leg1=$AB$unit) et $m($tri.leg1$tri.leg2=$BC$unit)
					end
					.\s
					Déterminer la longueur $m($tri.right$tri.leg2) $makeApproxInstruction($AC, $approx, $unit).
				end
				
				steps: do
					- do
						type: sentence
						- $tri.rightSentence
						- D'après le théorème de Pythagore
					end
					- $ solveDirectPythagorea2(tri.right, tri.leg1, tri.leg2, AB, AC, BC)
				end
			end
		end
	end
end