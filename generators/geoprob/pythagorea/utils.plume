let Question from $import(../../../core/cls/question)
let QuestionFactory from $import(../../../core/cls/questionFactory)

let Choice from $import(../../../core/parameters/set)
let Range from $import(../../../core/parameters/range)

let s from $import(../../../core/utils/expression)
let FactNumberCls from $import(../../../core/utils/factNumber)

let pages = $import(pages) // Should be in render
let m = macro(x) $pages.formula($x, processor: ascii)

rationnalPythagoreTriplets: macro(?easy, ?medium, ?hard)
	@QuestionFactory
		parameters: do
			- $Choice(3)
			- $Choice(4)
			- $Choice(5)
			if easy
				- $Choice(1, 2)
			elseif medium
				- $Choice(10, 0.1, 0.2, 20, 3, 4)
			else
				- $Choice(100, 0.01, 0.5, 5, 200, 0.02)
			end
		end
		get: macro(a, b, c, f)
			@Question(pythagoreTriplet)
				- $(a*f)
				- $(b*f)
				- $(c*f)
			end
		end
	end
end

irrationnal1PythagoreTriplets: macro(?easy, ?medium, ?hard)
	@QuestionFactory
		parameters: do
			for i in seq(2)
				if easy
					- $Range(1, 5)
				elseif medium
					- $Range(6, 10)
				else
					- $Range(11, 20)
				end
			end
		end
		validate: macro(a, b)
			$ not FactNumberCls.fromNumber(a^2+b^2).isRootRationnal(2)
		end
		get: macro(a, b)
			@Question(pythagoreTriplet)
				- $(a)
				- $(b)
				- $(s(a^2+b^2).root())
			end
		end
	end
end

irrationnal2PythagoreTriplets: macro(?easy, ?medium, ?hard)
	@QuestionFactory
		parameters: do
			for i in seq(2)
				if easy
					- $Range(1, 5)
				elseif medium
					- $Range(6, 10)
				else
					- $Range(11, 20)
				end
			end
		end
		validate: macro(a, b)
			$ not FactNumberCls.fromNumber(a^2+b^2).isRootRationnal(2)
		end
		get: macro(a, b)
			if a>b
				set a, b = ($b, $a)
			end
			@Question(pythagoreTriplet)
				- $(a)
				- $(s(b^2-a^2).root())
				- $(b)
			end
		end
	end
end

irrationnalPythagoreIsoscelesTriplets: macro(?easy, ?medium, ?hard)
	@QuestionFactory
		parameters: do
			if easy
				- $Range(1, 5)
			elseif medium
				- $Range(6, 10)
			else
				- $Range(11, 20)
			end
		end
		get: macro(a)
			@Question(pythagoreTriplet)
				- $(a)
				- $(a)
				- $(s(2*a^2).root())
			end
		end
	end
end
irrationnal2PythagoreIsoscelesTriplets: macro(?easy, ?medium, ?hard)
	@QuestionFactory
		parameters: do
			if easy
				- $Range(1, 5)
			elseif medium
				- $Range(6, 10)
			else
				- $Range(11, 20)
			end
		end
		get: macro(a)
			@Question(pythagoreTriplet)
				- $(s(a^2/2).root())
				- $(s(a^2/2).root())
				- $(a)
			end
		end
	end
end

solveDirectPythagorea1: macro(A, B, C, AB, AC, BC)
	type: eqn
	- do
		l: $A$B^2+$A$C^2
		r: $B$C^2
	end
	- do
		l: $AB^2+$AC^2
		r: $B$C^2
	end
	- do
		l: $(AB^2)+$(AC^2)
		r: $B$C^2
	end
	- do
		l: $(AB^2+AC^2)
		r: $B$C^2
	end
	- do
		l: $B$C
		r: $BC
	end
end

solveDirectPythagorea2: macro(A, B, C, AB, AC, BC)
	type: eqn
	- do
		l: $A$B^2+$A$C^2
		r: $B$C^2
	end
	- do
		l: $AB^2+$A$C^2
		r: $BC^2
	end
	- do
		l: $(AB^2)+$A$C^2
		r: $(BC^2)
	end
	- do
		l: $(AB^2)+$A$C^2-$(AB^2)
		r: $(BC^2)-$(AB^2)
	end
	- do
		l: $A$C^2
		r: $(BC^2-AB^2)
	end
	- do
		l: $A$C
		r: $AC
	end
end

solveIsoscelesDirectPythagorea1: macro(A, B, C, AB, BC, BC2)
	type: eqn
	- do
		l: $A$B^2+$A$C^2
		r: $B$C^2
	end
	- do
		l: $AB^2+$AB^2
		r: $B$C^2
	end
	- do
		l: $(AB^2+AB^2)
		r: $B$C^2
	end
	- do
		l: $B$C
		r: $BC
	end
end

solveIsoscelesDirectPythagorea2: macro(A, B, C, AB, BC, AB2)
	type: eqn
	- do
		l: $A$B^2+$A$C^2
		r: $B$C^2
	end
	- do
		l: $A$B^2+$A$B^2
		r: $B$C^2
	end
	- do
		l: 2$A$B^2
		r: $B$C^2
	end
	- do
		l: 2$A$B^2
		r: $(BC^2)
	end
	- do
		l: $A$B^2
		r: $(BC^2/2)
	end
	- do
		l: $A$B
		r: $AB
	end
end

// A right isosceles triangle: the two legs are equal (right angle at `right`)
makeHiddenIsoscelesTriangle: macro(hiddenIn, L0, L1, L2, L3, L4)
	if hiddenIn == "square"
		do
			right: $L1
			leg1: $L0
			leg2: $L2
			hyp: $L2
			intro: Soit $m($L0$L1$L2$L3) un carré
			rightSentence: $m($L0$L1$L2) est rectangle en $m($L1).
			isoSentence: $m($L0$L1$L2) est isocèle en $m($L1).
		end
	elseif hiddenIn == "squareDiag"
		do
			right: $L4
			leg1: $L0
			leg2: $L1
			hyp: $L1
			intro: Soit $m($L0$L1$L2$L3) un carré et $m($L4) l'intersection de ses diagonales
			rightSentence: $m($L0$L4$L2) est rectangle en $m($L4).
			isoSentence: $m($L0$L4$L2) est isocèle en $m($L4).
		end
	elseif hiddenIn == "triangle" or not hiddenIn
		do
			right: $L0
			leg1: $L1
			leg2: $L2
			hyp: $L2
			intro: Soit $m($L0$L1$L2) un triangle isocèle rectangle en $m($L0)
			rightSentence: $m($L0$L1$L2) est rectangle en $m($L0).
			isoSentence: $m($L0$L1$L2) est isocèle en $m($L0).
		end
	else
		raise Unknown hiddenIn mode "$hiddenIn".
	end
end

makeHiddenTriangle: macro(hiddenIn, L0, L1, L2, L3, L4)
	if hiddenIn == "rectangle"
		do
			right: $L1
			leg1: $L0
			leg2: $L2
			hyp: $L2
			intro: Soit $m($L0$L1$L2$L3) un rectangle
			rightSentence: $m($L0$L1$L2) est rectangle en $m($L1).
		end
	elseif hiddenIn == "losange"
		do
			right: $L4
			leg1: $L0
			leg2: $L1
			hyp: $L1
			intro: Soit $m($L0$L1$L2$L3) un losange et $m($L4) l'intersection de ses diagonales
			rightSentence: $m($L0$L4$L1) est rectangle en $m($L4).
		end
	elseif hiddenIn == "hauteur"
		do
			right: $L3
			leg1: $L0
			leg2: $L2
			hyp: $L2
			intro: Soit $m($L0$L1$L2) un triangle et $m($L0$L3) une hauteur
			rightSentence: $m($L0$L3$L2) est rectangle en $m($L3).
		end
	elseif hiddenIn == "triangle" or not hiddenIn
		do
			right: $L0
			leg1: $L1
			leg2: $L2
			hyp: $L2
			intro: Soit $m($L0$L1$L2) un triangle rectangle en $m($L0)
			rightSentence: $m($L0$L1$L2) est rectangle en $m($L0).
		end
	else
		raise Unknown hiddenIn mode "$hiddenIn".
	end
end