let pages = $import(pages) // Should be in render
let m = macro(x) $pages.formula($x, processor: ascii)
let s from $import(../../core/utils/expression)

makeApproxInstruction: macro(x, approx, unit)
	

	if approx
		let sx = $ s(x).value()
		let ax = $ (sx*10^approx).floor()/10^approx
		if sx != ax
			tronquée\s
			if approx == 0
				if unit
					au $m($unit)
				else
					à l'unité
				end
			else
				if approx == 1
					au dixième
				elseif approx == 2
					au centième
				elseif approx == 3
					au milième
				end
				if unit
					\sde $m($unit)
				end
			end
		end
	end
end