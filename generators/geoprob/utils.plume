let PermFromRank from $import(../../core/utils/walkers)

// Deterministic shuffle of a list, seeded: the seed selects one of the
// n! permutations (rank -> permutation), so the same seed always yields the
// same order. A list of less than two elements is returned as is.
ref shuffleList: macro(lst, seed)
	let n = $ len(lst)
	if n < 2
		return $lst
	end
	let perm = $ PermFromRank(n, seed)
	let out = $Table()
	for i in seq(1, n)
		run $ Table.append(out, lst[perm[i]+1])
	end
	return $out
end
