solveSumAngles: macro(A, B, C, BAC, ABC, ACB)
	type: eqn
	- do
		l: \\widehat{$B$A$C} + \\widehat{$A$B$C} + \\widehat{$A$C$B}
		r: 180
	end
	- do
		l: $BAC + \\widehat{$A$B$C} + $ACB
		r: 180
	end
	- do
		l: $(BAC+ACB) + \\widehat{$A$B$C}
		r: 180
	end
	- do
		l: $(BAC+ACB) + \\widehat{$A$B$C} - $(BAC+ACB)
		r: 180 - $(BAC+ACB)
	end
	- do
		l: \\widehat{$A$B$C}
		r: $ABC
	end
end
