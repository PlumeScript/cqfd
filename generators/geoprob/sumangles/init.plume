let Question from $import(../../../core/cls/question)
let QuestionFactory from $import(../../../core/cls/questionFactory)
let Range from $import(../../../core/parameters/range)
let Choice from $import(../../../core/parameters/set)

let letters from $import(../../geo/utils)

let pages = $import(pages) // Should be in render
let m = macro(x) $pages.formula($x, processor: ascii)

let solveSumAngles, solveSumAnglesIsoscelesSummit, solveSumAnglesIsoscelesBase, solveSumAnglesEquilateral, hat from $import(./utils)
let shuffleList from $import(../utils)

/*
Generate a sum of the angles of a triangle proof\: two angles are given and the third is asked.$newline
$Param(Number, precision, 1) the angles are multiples of it (in degrees).
$code(\0?right) to generate a right triangle (one angle is 90°).
*/
SumAnglesTriangle: macro(Number precision: 1, ?right)
	@QuestionFactory
		parameters: do
			- $Range(20, 120)
			- $Range(1, 80)
			- $Range(2, 8)
			- $Choice(1, 2)
		end
		hyperParameters: do
			- $letters(3)
			- $Range(1, 100)
		end
		get: macro(a1, r, l, rightPos, letters, shuffleSeed)
			let A, B, C = $letters

			let x = $empty
			let a2 = $empty
			let a3 = $empty
			if right
				set x = $ (20 + 60*r/100)
				set x = $ (x / precision).floor() * precision
				if rightPos == 1
					set a1 = 90
					set a2 = $ x
				else
					set a1 = $ x
					set a2 = 90
				end
				set a3 = $ 90-x
			else
				set a1 = $ (a1 / precision).floor() * precision
				set a2 = $ ((20 + (140 - a1) * r/100)/precision).floor()*precision
				set a3 = $ 180-a1-a2
			end

			let hys0 = do
				if right
					if rightPos == 1
						- do
							name: hat($A$C$B)
							value: $x
							type: angle
						end
					else
						- do
							name: hat($B$A$C)
							value: $x
							type: angle
						end
					end
				else
					- do
						name: hat($B$A$C)
						value: $a1
						type: angle
					end
					- do
						name: hat($A$C$B)
						value: $a2
						type: angle
					end
				end
			end
			let hys = $ shuffleList(hys0, shuffleSeed)

			@Question(demonstration)
				unit: °
				premise: do
					if right
						if rightPos == 1
							Soit $m($A$B$C) un triangle rectangle en $m($A)
						else
							Soit $m($A$B$C) un triangle rectangle en $m($C)
						end
					else
						Soit $m($A$B$C) un triangle
					end
				end
				hypotheses: $hys
				target: do
					name: hat($A$B$C)
					type: angle
					value: $a3
				end
				steps: do
					if right
						- do
							type: sentence
							if rightPos == 1
								- $m($A$B$C) est rectangle en $m($A).
							else
								- $m($A$B$C) est rectangle en $m($C).
							end
						end
					end
					- $ solveSumAngles(A, B, C, a1, a3, a2)
				end
			end
		end
	end
end

/*
Generate a sum of the angles proof on an isosceles triangle\: the equal base angles are given and the summit angle is asked.$newline
$Param(Number, precision, 1) the angles are multiples of it (in degrees).
The equilateral case (the 60° base angles) is rejected.
*/
SumAnglesTriangleIsoscelesSummit: macro(Number precision: 1)
	@QuestionFactory
		parameters: do
			- $Range(20, 80)
			- $Range(2, 8)
		end
		validate: macro(b, l)
			return $ b != 60
		end
		hyperParameters: do
			- $letters(3)
			- $Range(1, 100)
		end
		get: macro(b, l, letters, shuffleSeed)
			let A, B, C = $letters
			set b = $ (b / precision).floor() * precision
			let a1 = $ 180-2*b

			let hys0 = do
				- do
					name: hat($A$B$C)
					value: $b
					type: angle
				end
			end
			let hys = $ shuffleList(hys0, shuffleSeed)

			@Question(demonstration)
				unit: °
				premise: Soit $m($A$B$C) un triangle isocèle en $m($A)
				hypotheses: $hys
				target: do
					name: hat($B$A$C)
					type: angle
					value: $a1
				end
				steps: do
					- $ solveSumAnglesIsoscelesSummit(A, B, C, a1, b)
				end
			end
		end
	end
end

/*
Generate a sum of the angles proof on an isosceles triangle\: the summit angle is given and one of the two equal base angles is asked.$newline
$Param(Number, precision, 1) the angles are multiples of it (in degrees).
$code(\0?right) to generate a right isosceles triangle (summit angle 90°, base angles 45°).
*/
SumAnglesTriangleIsoscelesBase: macro(Number precision: 1, ?right)
	@QuestionFactory
		parameters: do
			- $Range(20, 80)
			- $Range(2, 8)
			- $Choice(1, 2)
		end
		hyperParameters: do
			- $letters(3)
			- $Range(1, 100)
		end
		get: macro(b, l, which, letters, shuffleSeed)
			let A, B, C = $letters
			if right
				set b = 45
			else
				set b = $ (b / precision).floor() * precision
			end
			let a1 = $ 180-2*b

			let hys0 = do
				if not right
					- do
						name: hat($B$A$C)
						value: $a1
						type: angle
					end
				end
			end
			let hys = $ shuffleList(hys0, shuffleSeed)

			@Question(demonstration)
				unit: °
				premise: do
					if right
						Soit $m($A$B$C) un triangle rectangle isocèle en $m($A)
					else
						Soit $m($A$B$C) un triangle isocèle en $m($A)
					end
				end
				hypotheses: $hys
				target: do
					if which == 1
						name: hat($A$B$C)
					else
						name: hat($A$C$B)
					end
					type: angle
					value: $b
				end
				steps: do
					if right
						- do
							type: sentence
							- $m($A$B$C) est un triangle rectangle isocèle en $m($A).
						end
					end
					- $ solveSumAnglesIsoscelesBase(A, B, C, a1, b, which)
				end
			end
		end
	end
end

/*
Generate a sum of the angles proof on an equilateral triangle\: one angle is given and one of the two others is asked (all the angles are 60°).
*/
SumAnglesTriangleEquilateral: macro()
	@QuestionFactory
		parameters: do
			- $Choice(1, 2, 3)
		end
		hyperParameters: do
			- $letters(3)
			- $Range(1, 100)
		end
		get: macro(p, letters, shuffleSeed)
			let A, B, C = $letters
			let g1 = $empty
			let g2 = $empty
			let g3 = $empty
			let m1 = $empty
			let m2 = $empty
			let m3 = $empty
			let given = $empty
			let missing = $empty
			let third = $empty
			let g = $empty
			let mm = $empty
			if p == 1
				set g = $Table($B, $A, $C)
				set mm = $Table($A, $B, $C)
				set given = $hat($B, $A, $C)
				set missing = $hat($A, $B, $C)
				set third = $hat($A, $C, $B)
			elseif p == 2
				set g = $Table($A, $B, $C)
				set mm = $Table($B, $A, $C)
				set given = $hat($A, $B, $C)
				set missing = $hat($B, $A, $C)
				set third = $hat($A, $C, $B)
			else
				set g = $Table($A, $C, $B)
				set mm = $Table($A, $B, $C)
				set given = $hat($A, $C, $B)
				set missing = $hat($A, $B, $C)
				set third = $hat($B, $A, $C)
			end
			set g1, g2, g3 = $g
			set m1, m2, m3 = $mm

			@Question(demonstration)
				unit: °
				premise: Soit $m($A$B$C) un triangle équilatéral
				hypotheses: $Table()
				target: do
					name: hat($m1$m2$m3)
					type: angle
					value: 60
				end
				steps: do
					- $ solveSumAnglesEquilateral(given, missing, third)
				end
			end
		end
	end
end
