let Parameter from $import(../../core/cls/parameter)

// lin: problem of class ab + cd = e, with one missing letter.
let situations = for situation in os.Path("./situations").getChildren()
	- $situation.import()
end

Situation: @Parameter
	size: $ len(situations)
	get: macro(i)
		$situations[ 1 + (i+1) % len(situations) ]
	end
end
