// Boulangerie situations: a word problem drawn from a linear equation with
// one missing letter (`lin`), or from a division a = bq+r / a = bd (`div`):
//
//   sign "+" : a*b + c*d = e    a, c quantities; b, d unit prices
//   sign "-" : a - c*d = e      a the money carried in, c the quantity,
//                               d the unit price (c is the amount spent, in
//                               euros, when d is missing)
//   sign ""  : a*b = e          the "hole" caller's "*" label — a bare
//                               product: one term, c and d must be missing
//
// The caller passes every letter (the missing one as its computed solution)
// and `u` points at the letter the question asks for (1..5 = a,b,c,d,e).
// `prenom` is a (name, gender) pair — (Léa, f) — or empty: the question is
// told in the 1st person ("j'ai acheté…") or in the gendered 3rd person
// ("Léa a acheté… elle dépense… combien a-t-elle acheté… ?").
// `?trap` only applies to the bare product (a*b = e): the second purchase
// is then drawn with arbitrary values (a quantity and a unit price,
// seeded by the equation — the same question always tells the same story):
// a quantified distractor that makes the statement read like a full
// two-purchase problem (compatible with several questions — the student
// must read the one posed), while the total is scoped to the first
// purchase, which alone is part of the equation (the check keeps the
// known values only). The two purchases are presented in an alternating
// order — the relevant one first or last.
// Returns a (instruction:, answer:) table, or the `invalid` table when the
// configuration is unsupported or the equation doesn't hold.

let invalid = (invalid: $true)

// The products of the first purchase (priced by b): the cheapest first.
let items1 = do
	- (name: baguette, plural: baguettes, article: une, max: 5)
	- (name: éclair au chocolat, plural: éclairs au chocolat, article: un, max: 20)
	- (name: gâteau, plural: gâteaux, article: un, max: 9999)
end

// The products of the second purchase (priced by d): `tarte` plays there the
// role that `gâteau` plays for item1.
let items2 = do
	- (name: croissant, plural: croissants, article: un, max: 5)
	- (name: éclair au chocolat, plural: éclairs au chocolat, article: un, max: 20)
	- (name: tarte, plural: tartes, article: une, max: 9999)
end

// The first product of `order` whose unit price `price` still fits
// (price < max). `avoidName` skips a product already chosen, so a problem
// never buys two quantities of the same product.
macro pickItem(order, price, avoidName: 0)
	let found = 0
	for item in order
		if price < item.max and (avoidName == 0 or item.name != avoidName)
			set found = $item
			break
		end
	end
	$found
end

// Display a euro amount the french way: 12 → "12", 1.3 → "1,30".
macro euros(x)
	let r = $ x.round(digit: 2)
	if String(r).contains(".") or String(r).contains(",")
		$(Number.format(r, "%.2f", locale: "fr"))
	else
		$(Number.format(r, "%.0f", locale: "fr"))
	end
end

// Display an exact decimal value the french way (the decimal quotient,
// e.g. a weight per bag): 3 → "3", 2.5 → "2,5", 1.125 → "1,125".
macro kg(x)
	$(String(x).replace(".", ","))
end

// "4 croissants" / "4 croissants à 0,80 € pièce" (price = 0: no price)
macro bought(qty, item, price)
	let p = $ price or 0
	if p != 0
		$qty $(item.plural) à $euros($p) € pièce
	else
		$qty $(item.plural)
	end
end

// "des croissants" / "des croissants à 0,80 € pièce" (the quantity is the unknown)
macro some(item, price)
	let p = $ price or 0
	if p != 0
		des $(item.plural) à $euros($p) € pièce
	else
		des $(item.plural)
	end
end

// "pour 7 € de baguettes" (the amount is known, the quantity is not)
macro boughtFor(amount, item)
	pour $(euros(amount)) € de $(item.plural)
end

// "de croissants" or "d'éclairs au chocolat" (elision before a vowel)
macro deItem(item)
	let w = $ item.plural
	if String.startsWith(w, "a") or String.startsWith(w, "e") or String.startsWith(w, "é") or String.startsWith(w, "h") or String.startsWith(w, "i") or String.startsWith(w, "o") or String.startsWith(w, "u") or String.startsWith(w, "y")
		d'$(w)
	else
		de\s$(w)
	end
end

// "une baguette" or "un croissant"
macro oneOf(item)
	$(item.article) $(item.name)
end

// "une baguette" → "Une baguette"
macro cap(s)
	$(String.sub(s, 1).upper())$(String.sub(s, 2, -1))
end

// Value of a purchase: qty*price with a price, the qty itself (an amount in
// euros, or a number of articles) without, 0 when the purchase is missing.
macro term(qty, price)
	if qty and price
		$(qty * price)
	elseif qty
		$(qty)
	else
		0
	end
end

lin: macro(a, b, sign, c, d, e, u, name:, ?trap)
	let ka = $a
	let kb = $b
	let kc = $c
	let kd = $d

	// integers where expected; wide bounds (relaxed 2026-10: the situation
// accepts the caller's drawn numbers — variety over realism)
	if (a and a.floor() != a) or (c and c.floor() != c)
		return $invalid
	end
	if (a and (a < 2 or a > 9999)) or (c and (c < 2 or c > 9999))
		return $invalid
	end
	if (b and (b <= 0 or b > 9999)) or (d and (d <= 0 or d > 9999))
		return $invalid
	end
	if not e or e < 0
		return $invalid
	end

	// sign "" (or missing — the "hole" caller's "*" label passes sign
	// empty) is the bare product a*b = e: one term only, so the second
	// purchase (c, d) must be missing.
	set sign = $ sign or ""
	if sign != "+" and sign != "-" and sign != ""
		return $invalid
	end
	if sign == "" and (c or d)
		return $invalid
	end
	// The trap only dresses the bare product: on a complete equation every
	// letter is given — there is nothing to invent.
	if trap and sign != ""
		return $invalid
	end

	// sign "-": only "a - cd = e" is supported ("ab - cd" never is). When a
	// (resp. c) is missing, b (resp. d) takes its place and the target is
	// remapped accordingly (b is the euros carried in, d the amount spent).
	if sign == "-"
		if a and b
			return $invalid
		end
		if not a
			if not b
				return $invalid
			end
			set a = $b
			set b = $empty
			set ka = $kb
			set kb = $empty
			if u == 2
				set u = 1
			end
		end
		if not c
			if not d
				return $invalid
			end
			set c = $d
			set d = $empty
			set kc = $kd
			set kd = $empty
			if u == 4
				set u = 3
			end
		end
		if u != 1 and u != 3 and u != 5
			return $invalid
		end
	end

	// The trap (bare product only): the second purchase is invented — a
	// quantified distractor (a quantity and a unit price, seeded by the
	// equation — the same question always tells the same story). The
	// invented values are NOT terms of the equation: the check below keeps
	// the known values (ka..kd, as the caller passed them — c and d are
	// missing there), and the statement scopes the total to the first
	// purchase. The two purchases are presented in an alternating order —
	// the relevant one first or last (`swap`, drawn from the same seed) —
	// so the student never learns the relevant term is the first one.
	let swap = 0
	if trap
		let seed = $ (a * 100).round() * 1000000000 + (b * 100).round() * 1000000 + (e * 100).round()
		let random = $Random($(seed))
		set c = $ random(2, 10)
		set d = $ random(5, 15) / 10
		set swap = $ random(0, 1)
	end

	let item1 = 0
	let item2 = 0

	// item1 is priced by b ("+") or by d ("-"); item2 by d (the trap's
	// invented d picks it, as on the full equation). With no price, the
	// cheapest products are assumed (baguette, croissant).
	if sign == "-"
		if d
			set item1 = $ pickItem(items1, d)
		else
			set item1 = $ items1[1]
		end
	else
		if b
			set item1 = $ pickItem(items1, b)
		else
			set item1 = $ items1[1]
		end
		if d
			set item2 = $ pickItem(items2, d, avoidName: item1.name)
		else
			set item2 = $ items2[1]
		end
	end

	if not item1 or not item2
		return $invalid
	end

	// The caller passes a consistent equation (the missing letter is its
	// computed solution): check it, rounded to the cent.
	let lhs = 0
	if sign == "-"
		set lhs = $ a - term(c, d)
	else
		// The equation only involves the KNOWN values (ka..kd, as the
		// caller passed them): "+" → a*b + c*d = e — "" → a*b = e. In the
		// trap the invented c and d are distractors of the statement, not
		// terms of the equation.
		set lhs = $ term(ka, kb) + term(kc, kd)
	end
	if (lhs * 100).round() != (e * 100).round()
		return $invalid
	end

	// The speaker: 1st person when prenom is empty; otherwise the (name,
	// gender) pair — "Léa a acheté", "elle dépense", "a-t-elle", "Elle est
	// arrivée", "Il lui reste", …
	let who = if name and name[1]
		do
			bought: $name[1] a acheté
			spent: $name[1] a dépensé
			spend: $ (name[2] == "f" and "elle dépense" or "il dépense")
			qBought: $ (name[2] == "f" and "a-t-elle" or "a-t-il")
			qSpent: $ (name[2] == "f" and "a-t-elle" or "a-t-il")
			qHad: $ (name[2] == "f" and "avait-elle" or "avait-il")
			arrived: $ (name[2] == "f" and "Elle est arrivée" or "Il est arrivé")
			had: $ (name[2] == "f" and "Elle avait" or "Il avait")
			ansHad: $name[1] avait
			restQ: lui reste-t-il
			restA: Il lui reste
			restLow: il lui reste
		end
	else
		do
			bought: j'ai acheté
			spent: j'ai dépensé
			spend: je dépense
			qBought: ai-je
			qSpent: ai-je
			qHad: avais-je
			arrived: Je suis arrivé
			had: J'avais
			ansHad: J'avais
			restQ: me reste-t-il
			restA: Il me reste
			restLow: il me reste
		end
	end

	// Which letters must be known for the question to be solvable.
	// (sign "" follows the "+" rules: one priced term plus, at most, an
	// unpriced second term.)
	if sign != "-"
		if u == 1
			if not b
				// without b, the total only makes sense when it counts
				// the articles (b and d both missing)
				if d or not c
					return $invalid
				end
			else
				if (c and not d) or (not c and d)
					return $invalid
				end
			end
		elseif u == 2
			if not a
				return $invalid
			end
			if (c and not d) or (not c and d)
				return $invalid
			end
		elseif u == 3
			if not a
				return $invalid
			end
			if (b and not d) or (not b and d)
				return $invalid
			end
		elseif u == 4
			if not a or not c
				return $invalid
			end
		elseif u == 5
			if not a
				return $invalid
			end
			if c
				// one price known and the other missing: the missing
				// purchase is unknown, the total is unsolvable
				if b and not d
					return $invalid
				end
			else
				// no second purchase: the first must be priced (b known);
				// d alone would be a price without a quantity
				if d or not b
					return $invalid
				end
			end
		else
			return $invalid
		end
	end

	if sign != "-"
		return if u == 1
			instruction: do
				À la boulangerie, $(who.bought)\s
				if b
					if trap and swap == 1
						$(bought(c, item2, d)) et $(some(item1, b)).\s
					else
						$(some(item1, b))
						if c
							\set $(bought(c, item2, d))
						end
						.\s
					end
					if trap
						En tout, $(who.spend) $(euros(e)) € en $(item1.plural) ; combien $(who.qBought) acheté $(deItem(item1)) ?
					else
						En tout, $(who.spend) $(euros(e)) € ; combien $(who.qBought) acheté $(deItem(item1)) ?
					end
				else
					$(e) articles : des $(item1.plural) et $(c) $(item2.plural).\s
					Combien $(who.qBought) acheté $(deItem(item1)) ?
				end
			end
			answer: $(cap(who.bought)) $a $item1.plural.
		elseif u == 2
			instruction: do
				À la boulangerie, $(who.bought)\s
				if trap and swap == 1
					$(bought(c, item2, d)) et $(bought(a, item1, 0)).\s
				else
					$(bought(a, item1, 0))
					if c
						\set $(bought(c, item2, d))
					end
					.\s
				end
				// The total is scoped to the first purchase on the bare
				// product (and in the trap, where c is the invented
				// second purchase): the second purchase never counts in it.
				if not c or trap
					En tout, $(who.spend) $(euros(e)) € en $(item1.plural) ; combien coûte $(oneOf(item1)) ?
				else
					En tout, $(who.spend) $(euros(e)) € ; combien coûte $(oneOf(item1)) ?
				end
			end
			answer: $(cap(oneOf(item1))) coûte $(euros(b)) €.
		elseif u == 3
			instruction: do
				À la boulangerie, $(who.bought)\s
				if b
					$(bought(a, item1, b)) et $(some(item2, d)).\s
					En tout, $(who.spend) $(euros(e)) € ; combien $(who.qBought) acheté $(deItem(item2)) ?
				else
					$(e) articles : $(bought(a, item1, 0)) et des $(item2.plural).\s
					Combien $(who.qBought) acheté $(deItem(item2)) ?
				end
			end
			answer: $(cap(who.bought)) $c $item2.plural.
		elseif u == 4
			instruction: do
				À la boulangerie, $(who.bought)\s
				if b
					$(bought(a, item1, b))
				else
					$(boughtFor(a, item1))
				end
					\set $(bought(c, item2, 0)).\s
				En tout, $(who.spend) $(euros(e)) € ; combien coûte $(oneOf(item2)) ?
			end
			answer: $(cap(oneOf(item2))) coûte $(euros(d)) €.
		elseif u == 5
			instruction: do
				À la boulangerie, $(who.bought)\s
				if c
					if trap
						// The bare product with the invented second
						// purchase: the question is scoped to the first
						// one ("dépensé en baguettes"), the invented
						// purchase never counts in the total.
						if swap == 1
							$(bought(c, item2, d)) et $(bought(a, item1, b)).\s
						else
							$(bought(a, item1, b))
							\set $(bought(c, item2, d))
							.\s
						end
						En tout, combien $(who.qSpent) dépensé en $(item1.plural) ?
					else
						if b
							$(bought(a, item1, b)) et $(bought(c, item2, d)).\s
						else
							if d
								$(boughtFor(a, item1)) et $(bought(c, item2, d)).\s
							else
								$(bought(a, item1, 0)) et $(bought(c, item2, 0)).\s
								Combien $(who.qBought) acheté d'articles ?
							end
						end
						if b or d
							En tout, combien $(who.qSpent) dépensé ?
						end
					end
				else
					$(bought(a, item1, b)).\s
					En tout, combien $(who.qSpent) dépensé ?
				end
			end
			answer: do
				if b or d
					if trap
						$(cap(who.spent)) $(euros(e)) € en $(item1.plural).
					else
						$(cap(who.spent)) $(euros(e)) €.
					end
				else
					$(cap(who.bought)) $(e) articles.
				end
			end
		end
	else
		return if u == 1
			instruction: do
				À la boulangerie,\s
				if d
					$(who.bought) $(bought(c, item1, d)).\s
				else
					$(who.spent) $(euros(c)) € en $(item1.plural).\s
				end
				$(who.restA) $(euros(e)) € ; combien $(who.qHad) en entrant ?
			end
			answer: $(cap(who.ansHad)) $(euros(a)) € en entrant.
		elseif u == 3
			instruction: do
				À la boulangerie, $(who.bought) $(some(item1, d)).\s
				$(who.arrived) avec $(euros(a)) € et $(who.restLow) $(euros(e)) € ;\s
				if d
					combien $(who.qBought) acheté $(deItem(item1)) ?
				else
					combien $(who.qSpent) dépensé en $(item1.plural) ?
				end
			end
			answer: do
				if d
					$(cap(who.bought)) $c $item1.plural.
				else
					$(cap(who.spent)) $(euros(c)) € en $(item1.plural).
				end
			end
		elseif u == 5
			instruction: do
				À la boulangerie,\s
				if d
					$(who.bought) $(bought(c, item1, d)).\s
				else
					$(who.spent) $(euros(c)) € en $(item1.plural).\s
				end
				$(who.had) $(euros(a)) € ; combien $(who.restQ) ?
			end
			answer: $(who.restA) $(euros(e)) €.
		end
	end

	// Fallback: every (sign, u) combination is handled or rejected above —
	// keep the explicit exit.
	return $invalid
end

// a = bq + r (euclidean division: a articles, b bags, q the articles per
// bag, r the remainder) or a = bd (decimal division: d the quotient —
// exact, or rounded to a tenth when ?aprx). The caller passes every value,
// the missing ones empty: d truthy tells the decimal story, d empty the
// euclidean one.
//
// The decimal story has two variants, chosen by ?alt (only when ?aprx is
// missing, which keeps the price story for a rounded quotient):
//   price  : a the euros paid, b the kilos — "quel est le prix au kilo ?"
//   weight : a the kilos, b the bags — "quel est le poids d'un sachet ?"
// ?trap adds a quantified distractor that makes the statement read like
// the other variant (a bag count in the price story, a cost in the weight
// story, a cost in the euclidean one) — the same values always tell the
// same story. ?aprx marks the quotient rounded to a tenth (recurring
// decimal): the answer is then "environ …".
// Returns a (instruction:, answer:) table, or the `invalid` table.

div: macro(a, b, q, r, d, name:, ?trap, ?aprx, ?alt)
	// The speaker: 1st person when name is empty; otherwise the (name,
	// gender) pair — the forms div needs have no person agreement
	// ("a acheté", "achète", "lui coûte"), so only the name is used.
	let who = if name and name[1]
		do
			bought: $name[1] a acheté
			buy: $name[1] achète
			cost: Cela lui coûte
		end
	else
		do
			bought: J'ai acheté
			buy: j'achète
			cost: Cela me coûte
		end
	end

	// a and b are the two values the statement always shows: without
	// them there is no problem.
	if not a or not b
		return $invalid
	end

	if d
		// d is a price or a weight per unit: 0 or less is not a division
		// problem (it would also slip past the equation check below, which
		// aprx disables).
		if d <= 0
			return $invalid
		end
		// The statement shows a and b: the quotient d must satisfy a = bd
		// (checked to the cent, like lin). With aprx the caller passes a
		// quotient rounded to a tenth (recurring decimal) — no check.
		if not aprx and (b * d * 100).round() != (a * 100).round()
			return $invalid
		end
		// The weight variant is the exact-quotient story: ?alt selects it,
		// ?aprx keeps the price story. (Not a same-named local: in a do
		// block `let alt = $alt and …` shadows the parameter with itself.)
		let w = $ alt and not aprx
		// A bag count is a count.
		if w and b.floor() != b
			return $invalid
		end
		return do
			instruction: do
				if w
					À la boulangerie, $(who.buy) pour $a kg de viennoiserie \(il y a beaucoup de monde au petit déjeuner)\s
					que la boulangère répartit équitablement en $b sachets.\s
					if trap
						$(who.cost) $(euros(a*20)) €.\s
					end
					Quel est le poids d'un sachet ?
				else
					À la boulangerie, $(who.buy) pour $b kg de viennoiserie
					if trap
						\s\(il y a beaucoup de monde au petit déjeuner)\s
						que la boulangère répartit équitablement en $(1+b/10).ceil() sachets
					end
					.\s
					$(who.cost) $(euros(a)) €
					if d < 10
						\s\(non, ce n'est vraiment pas cher)
					end
					.\s
					Quel est le prix au kilo ?
				end
			end
			answer: do
				if w
					Un sachet pèse\s
					if aprx
						environ\s
					end
					$(kg(d)) kg.
				else
					// The quotient is displayed exact: euros() would round
					// it to the cent (7/8 would show "0,88 €" instead of
					// the exact "0,875 €").
					Le prix au kilo est
					if aprx
						\sd'environ $(kg(d)) €.
					else
						\sde $(kg(d)) €.
					end
				end
			end
		end
	else
		// q and r are the answer(s): without them the problem has none
		// (the caller always passes them — q = a div b, r = a mod b).
		if not q or not r
			return $invalid
		end
		// Counts are integers where expected.
		if a.floor() != a or b.floor() != b or q.floor() != q or r.floor() != r
			return $invalid
		end
		// wide bounds (relaxed 2026-10: variety over realism)
		if b < 2 or b > 9999 or q < 2 or q > 9999 or a < 2 or a > 9999
			return $invalid
		end
		// Euclidean division: a = bq + r with 0 <= r < b — with r >= b the
		// repartition is not maximal and the question admits another answer.
		if a != b * q + r or r < 0 or r >= b
			return $invalid
		end
		return do
			instruction: do
				$(who.bought) $a croissants à la boulangerie
				if trap
					\spour $(euros(a*0.8)) €
				end
				. La boulangère veut les répartir équitablement en $b sachets ;\s
				if alt
					combien y aura-t-il de croissants par sachet ?
				else
					combien de croissants ne pourront pas être mis dans un sachet ?
				end
			end
			answer: do
				if alt
					Il y aura $q croissants par sachet
					if r > 0
						\s(mais il en restera\s
						if r == 1
							1 non réparti).
						else
							$r non répartis).
						end
					else
						.
					end
				else
					if r > 0
						Il y aura\s
						if r == 1
							1 croissant non réparti.
						else
							$r croissants non répartis.
						end
					else
						Tous les croissants seront répartis.
					end
				end
			end
		end
	end

	// Fallback: both branches return above — keep the explicit exit.
	return $invalid
end