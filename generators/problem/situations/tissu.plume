// Tissu (fabric) situation: a word problem drawn from the linear equation
// with one missing letter — the scene is a cut in a roll:
//
//   a - c*d = e
//
//   a = fabric at the start (m²)
//   c = number of squares cut
//   d = area of one square (m²)
//   e = fabric left (m²)
//
// The scene is a subtraction, so only sign "-" is supported; sign "+" and
// "" (and the "*" hole label) are invalid. The trap is not supported either:
// there is no simple product in the scene to confuse with. The caller passes
// every letter (the missing one as its computed solution) and `u` points at
// the letter the question asks for (1..5 = a,b,c,d,e; only 1, 3, 5 are valid
// here). `name` is a (name, gender) pair — (Léa, f) — or empty: the question
// is told in the 1st person ("j'ai coupé…") or in the gendered 3rd person
// ("Léa a coupé… a-t-elle…"). Returns a (instruction:, answer:) table, or
// the `invalid` table when the configuration is unsupported or the equation
// doesn't hold.

let invalid = (invalid: $true)

// Display an area in m² the french way: 30 → "30", 30.5 → "30,5", 12.25 →
// "12,25". A whole number is shown without decimal part. The integer test
// uses the displayed value (String) because a float can carry a hair of
// error (30.round(2) is worth 30.000000000000007, so `floor(x) == x` fails).
macro m2(x)
	if String.contains(String(x), ".")
		let s = $(Number.format(x, "%.2f", locale: "fr"))
		if String.endsWith(s, "00")
			set s = $(String.sub(s, 1, -3))
		elseif String.endsWith(s, "0")
			set s = $(String.sub(s, 1, -2))
		end
		$s
	else
		$(Number.format(x, "%.0f", locale: "fr"))
	end
end

lin: macro(a, b, sign, c, d, e, u, name:, ?trap)
	if trap
		// The trap (a distractor drawn at random on top of the caller's
		// equation) is not supported here: the scene is a bare subtraction,
		// there is no simple product to confuse with.
		return $invalid
	end

	// The scene is a subtraction: a - c*d = e. Only sign "-" is supported
	// ("+" and "" — and the "*" hole label — are not this scene).
	set sign = $ sign or ""
	if sign != "-"
		return $invalid
	end

	// Only the initial amount (a), the number of squares (c) or the
	// remaining fabric (e) can be asked.
	if u != 1 and u != 3 and u != 5
		return $invalid
	end

	// Every letter must be present (the caller passes the missing one as
	// its computed solution).
	if not a or not c or not d or not e
		return $invalid
	end

	// c counts squares: a whole number (tested on the displayed value, see
	// m2), at least 2 (so that "carrés" stays plural). a, d, e are areas,
	// within plausible sizes.
	if String.contains(String(c), ".") or c < 2 or c > 10000
		return $invalid
	end
	if a < 2 or a > 100000
		return $invalid
	end
	if d < 1 or d > 10000
		return $invalid
	end
	if e < 0 or e > 100000
		return $invalid
	end

	// The caller passes a consistent equation (the missing letter is its
	// computed solution): check it, rounded to the cent.
	let lhs = $ a - c * d
	if (lhs * 100).round() != (e * 100).round()
		return $invalid
	end

	// The speaker: 1st person when name is empty; otherwise the (name,
	// gender) pair — "Léa a coupé", "il lui reste", "a-t-elle", "avait-elle".
	let who = if name and name[1]
		do
			firstHad: $name[1] avait
			pCut: $ (name[2] == "f" and "Elle a coupé" or "Il a coupé")
			restEn: il lui en reste
			restait: il lui restait
			restQ: lui reste-t-il
			restA: Il lui reste
			qCut: $ (name[2] == "f" and "a-t-elle" or "a-t-il")
			qHad: $ (name[2] == "f" and "avait-elle" or "avait-il")
		end
	else
		do
			firstHad: J'avais
			pCut: J'ai coupé
			restEn: il m'en reste
			restait: il me restait
			restQ: me reste-t-il
			restA: Il me reste
			qCut: ai-je
			qHad: avais-je
		end
	end

	return if u == 1
		instruction: do
			Après avoir coupé $(m2(c)) carrés de $(m2(d)) m², $(who.restait) $(m2(e)) m² de tissu.\s
			Combien en $(who.qHad) au départ ?
		end
		answer: $(who.firstHad) $(m2(a)) m² de tissu au départ.
	elseif u == 3
		instruction: do
			$(who.firstHad) $(m2(a)) m² de tissu et $(who.restEn) $(m2(e)) m² après avoir coupé des carrés de $(m2(d)) m².\s
			Combien de carrés $(who.qCut) coupés ?
		end
		answer: $(who.pCut) $(m2(c)) carrés.
	elseif u == 5
		instruction: do
			$(who.firstHad) $(m2(a)) m² de tissu.\s
			$(who.pCut) $(m2(c)) carrés de $(m2(d)) m² chacun.\s
			Combien de tissu $(who.restQ) ?
		end
		answer: $(who.restA) $(m2(e)) m².
	end

	// Fallback: every u is handled or rejected above — keep the explicit exit.
	return $invalid
end
