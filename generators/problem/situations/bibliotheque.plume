// Bibliotheque situations: a word problem drawn from a linear equation with
// one missing letter, dressed as the library of a literature doctor (the
// literature is named — country and century, like the old calcN2
// litterature situation, drawn from two lists seeded by the equation):
//
//   sign "+" : a*b + c*d = e    a, c shelf counts; b, d books per shelf
//   sign ""  : a*b = e          a bare product: one set of shelves only,
//                               c and d must be missing
//   sign "-" : never supported
//
// The caller passes every letter (the missing one as its computed solution)
// and `u` points at the letter the question asks for (1..5 = a,b,c,d,e).
// When b (resp. d) is missing, a (resp. c) is a bare count of books in its
// category, not a shelf count. The two-term statements say up front that
// the library is organized in exactly two book categories ("est organisée
// en 2 catégories de livres : la 1re … et la 2e …"), so the total is the
// sum of the two named categories only. `name` is a (Prénom, "m"/"f") pair
// or empty: the story is told in the 1st person
// ("Je suis docteur en littérature roumaine du XIVe siècle…") or in the
// gendered 3rd person ("Léa est docteure en littérature…", "La
// bibliothèque de Marc, docteur en littérature…,…" — docteur/docteure
// agreed with the person, sa/ma with the bibliothèque).
// `trap` is a distractor drawn from the scene: a "fonds ancien" with a
// drawn book count (seeded by the equation, never equal to the total e),
// allowed only on a single-product question (a*b = e); on the complete
// equation it marks the configuration invalid. The fonds ancien and the
// shelves are mentioned in an alternating order (seeded by the equation).
// Returns a (instruction:, answer:) table, or the `invalid` table when the
// configuration is unsupported or the equation doesn't hold.

let invalid = (invalid: $true)

// The literature the doctor specializes in (the decor, like the old
// calcN2 litterature situation): a country and a century.
let countries = do
	- tchèque
	- polonaise
	- roumaine
	- hongroise
	- finlandaise
	- danoise
end
let centuries = do
	- IXe
	- Xe
	- XIe
	- XIIe
	- XIIIe
	- XIVe
end

lin: macro(a, b, sign, c, d, e, u, name:, ?trap)
	// integers; wide bounds (relaxed 2026-10: the situation accepts the
	// caller's drawn numbers — variety over realism)
	if (a and a.floor() != a) or (b and b.floor() != b) or (c and c.floor() != c) or (d and d.floor() != d)
		return $invalid
	end
	if (a and (a < 2 or a > 9999)) or (c and (c < 2 or c > 9999))
		return $invalid
	end
	if (b and (b < 2 or b > 9999)) or (d and (d < 2 or d > 9999))
		return $invalid
	end
	if not e or e < 0
		return $invalid
	end

	// sign "" (or missing — the "hole" caller's "*" label passes sign
	// empty) is the bare product a*b = e: one group only, so the second
	// group (c, d) must be missing. sign "-" is never supported here.
	set sign = $ sign or ""
	if sign != "+" and sign != ""
		return $invalid
	end
	if sign == "" and (c or d)
		return $invalid
	end

	// Which letters must be known for the question to be solvable.
	if u == 1
		if not b
			// without b the first group is a bare count: the total only
			// makes sense when both groups are counts (d missing, c known)
			if d or not c
				return $invalid
			end
		else
			if (c and not d) or (not c and d)
				return $invalid
			end
		end
	elseif u == 2
		if not a
			return $invalid
		end
		if (c and not d) or (not c and d)
			return $invalid
		end
	elseif u == 3
		if not a
			return $invalid
		end
		if (b and not d) or (not b and d)
			return $invalid
		end
	elseif u == 4
		if not a or not c
			return $invalid
		end
	elseif u == 5
		if not a
			return $invalid
		end
		if c
			// one per-shelf count known and the other missing: the missing
			// group is unknown, the total is unsolvable
			if b and not d
				return $invalid
			end
		else
			// no second group: the first must be shelved (b known); d
			// alone would be a per-shelf count without a shelf count
			if d or not b
				return $invalid
			end
		end
	else
		return $invalid
	end

	// The caller passes a consistent equation (the missing letter is its
	// computed solution): check it. A letter without its partner stands
	// for a bare count of books; a missing group is worth 0.
	let lhs = 0
	if a and b
		set lhs = $ a * b
	elseif a
		set lhs = $ a
	end
	if c and d
		set lhs = $ lhs + c * d
	elseif c
		set lhs = $ lhs + c
	end
	if lhs != e
		return $invalid
	end

	// The trap (a "fonds ancien" with a drawn book count) is only
	// meaningful on a single-product question (a*b = e, c and d missing);
	// on the complete equation it has nothing to point at.
	if trap and (c or d)
		return $invalid
	end

	// The literature the doctor specializes in (country and century, the
	// decor of the old calcN2 litterature situation). The situation has no
	// parameter of its own, so the draw is seeded from the equation: a
	// given question always tells the same story (the factory is
	// seed-deterministic).
	let seed = $ (a or 0) * 10000000 + (b or 0) * 100000 + (c or 0) * 1000 + (d or 0) * 10 + (e or 0)
	let random = $Random($(seed))
	let country = $ random.choice(countries)
	let century = $ random.choice(centuries)

	// The trap's "fonds ancien" book count (drawn after the literature,
	// same seeded generator — the same question always tells the same
	// story; never equal to the total e), and `swap`, the alternating
	// order of the fonds ancien and the shelves.
	let fonds = 0
	let swap = 0
	if trap
		set fonds = $ random(2, 60)
		if fonds == e
			set fonds = $ fonds + 1
		end
		set swap = $ random(0, 1)
	end

	// The speaker: 1st person when name is empty; otherwise the (name,
	// gender) pair — "Léa est docteure en littérature tchèque du XIe
	// siècle", "La bibliothèque de Marc, docteur en littérature…", "sa
	// bibliothèque" (the possessive agrees with bibliothèque, never with
	// the doctor; "a-t-elle" refers to the bibliothèque).
	let who = if name and name[1]
		do
			introA: $(name[1]) est $(name[2] == "f" and "docteure" or "docteur") en littérature $country du $century siècle
			// trailing comma: the templates continue with " a …" or
			// " est organisée en …"
			introFull: La bibliothèque de $(name[1]), $(name[2] == "f" and "docteure" or "docteur") en littérature $country du $century siècle,
			Lib: Sa bibliothèque
			hasLib: Sa bibliothèque a
			counts: Sa bibliothèque compte
			qTotal: Combien de livres compte sa bibliothèque au total ?
		end
	else
		do
			introA: Je suis docteur en littérature $country du $century siècle
			introFull: Je suis docteur en littérature $country du $century siècle. Ma bibliothèque
			Lib: Ma bibliothèque
			hasLib: Ma bibliothèque a
			counts: Ma bibliothèque compte
			qTotal: Combien de livres y a-t-il au total ?
		end
	end

	// The two-group statements say up front that the library is organized
	// in exactly two book categories ("est organisée en 2 catégories de
	// livres : la 1re … et la 2e …"), so the total is the sum of the two
	// named categories only.
	if u == 1
		return do
			instruction: do
				if b and c
					$(who.introFull) est organisée en 2 catégories de livres : la 1re catégorie a $(b) livres par étagère et la 2e $(c) étagères de $(d) livres, soit $(e) livres au total.\s
					Combien d'étagères compte la 1re catégorie ?
				elseif b
					if trap and swap == 1
						$(who.introFull) a $(fonds) livres dans son fonds ancien ; elle a $(b) livres par étagère et $(e) livres sur ses étagères.\s
						Combien d'étagères a-t-elle ?
					elseif trap
						$(who.introFull) a $(b) livres par étagère et $(e) livres sur ses étagères ; le fonds ancien compte $(fonds) livres.\s
						Combien d'étagères a-t-elle ?
					else
						$(who.introFull) a $(b) livres par étagère et compte $(e) livres au total.\s
						Combien d'étagères a-t-elle ?
					end
				else
					$(who.introFull) est organisée en 2 catégories de livres : la 2e catégorie a $(c) livres et les 2 catégories ensemble $(e) livres au total.\s
					Combien de livres y a-t-il dans la 1re catégorie ?
				end
			end
			answer: do
				if b and c
					La 1re catégorie a $(a) étagères.
				elseif b
					$(who.hasLib) $(a) étagères.
				else
					Il y a $(a) livres dans la 1re catégorie.
				end
			end
		end
	elseif u == 2
		return do
			instruction: do
				if c
					$(who.introFull) est organisée en 2 catégories de livres : la 1re catégorie a $(a) étagères et la 2e $(c) étagères de $(d) livres, soit $(e) livres au total.\s
					Combien de livres par étagère dans la 1re catégorie ?
				else
					if trap and swap == 1
						$(who.introFull) a $(fonds) livres dans son fonds ancien ; elle a $(a) étagères et $(e) livres sur ses étagères.\s
						Combien de livres par étagère ?
					elseif trap
						$(who.introFull) a $(a) étagères et $(e) livres sur ses étagères ; le fonds ancien compte $(fonds) livres.\s
						Combien de livres par étagère ?
					else
						$(who.introFull) a $(a) étagères et compte $(e) livres au total.\s
						Combien de livres par étagère ?
					end
				end
			end
			answer: do
				if c
					Il y a $(b) livres par étagère dans la 1re catégorie.
				else
					Il y a $(b) livres par étagère.
				end
			end
		end
	elseif u == 3
		return do
			instruction: do
				if b
					$(who.introFull) est organisée en 2 catégories de livres : la 1re catégorie a $(a) étagères de $(b) livres et la 2e $(d) livres par étagère, soit $(e) livres au total.\s
					Combien d'étagères compte la 2e catégorie ?
				else
					$(who.introFull) est organisée en 2 catégories de livres : la 1re catégorie a $(a) livres et les 2 catégories ensemble $(e) livres au total.\s
					Combien de livres y a-t-il dans la 2e catégorie ?
				end
			end
			answer: do
				if b
					La 2e catégorie a $(c) étagères.
				else
					Il y a $(c) livres dans la 2e catégorie.
				end
			end
		end
	elseif u == 4
		return do
			instruction: do
				if b
					$(who.introFull) est organisée en 2 catégories de livres : la 1re catégorie a $(a) étagères de $(b) livres et la 2e $(c) étagères, soit $(e) livres au total.\s
					Combien de livres par étagère dans la 2e catégorie ?
				else
					$(who.introFull) est organisée en 2 catégories de livres : la 1re catégorie a $(a) livres et la 2e $(c) étagères, soit $(e) livres au total.\s
					Combien de livres par étagère dans la 2e catégorie ?
				end
			end
			answer: Il y a $(d) livres par étagère dans la 2e catégorie.
		end
	else
		return do
			instruction: do
				$(who.introA).\s
				if c and b and d
					$(who.Lib) est organisée en 2 catégories de livres : la 1re catégorie a $(a) étagères de $(b) livres et la 2e $(c) étagères de $(d) livres.\s
					$(who.qTotal)
				elseif c and d
					$(who.Lib) est organisée en 2 catégories de livres : la 1re catégorie a $(a) livres et la 2e $(c) étagères de $(d) livres.\s
					$(who.qTotal)
				elseif c
					$(who.Lib) est organisée en 2 catégories de livres : la 1re catégorie a $(a) livres et la 2e $(c) livres.\s
					$(who.qTotal)
				else
					if trap and swap == 1
						$(who.Lib) a $(fonds) livres dans son fonds ancien ; elle a $(a) étagères de $(b) livres.\s
						Combien de livres sur ces $(a) étagères ?
					elseif trap
						$(who.Lib) a $(a) étagères de $(b) livres ; le fonds ancien compte $(fonds) livres.\s
						Combien de livres sur ces $(a) étagères ?
					else
						$(who.Lib) a $(a) étagères de $(b) livres.\s
						$(who.qTotal)
					end
				end
			end
			answer: do
				if c
					$(who.counts) $(e) livres.
				else
					if trap
						Il y a $(e) livres sur ces $(a) étagères.
					else
						$(who.counts) $(e) livres.
					end
				end
			end
		end
	end

	// Fallback: every (sign, u) combination is handled or rejected above —
	// keep the explicit exit.
	return $invalid
end
