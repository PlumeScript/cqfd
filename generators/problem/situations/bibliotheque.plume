// Bibliotheque situations: a word problem drawn from a linear equation with
// one missing letter, dressed as the library of a literature doctor (the
// literature is named — country and century, like the old calcN2
// litterature situation, drawn from two lists seeded by the equation):
//
//   sign "+" : a*b + c*d = e    a, c shelf counts; b, d books per shelf
//   sign ""  : a*b = e          a bare product: one set of shelves only,
//                               c and d must be missing
//   sign "-" : never supported
//
// The caller passes every letter (the missing one as its computed solution)
// and `u` points at the letter the question asks for (1..5 = a,b,c,d,e).
// When b (resp. d) is missing, a (resp. c) is a bare count of books in its
// category, not a shelf count. The two-term statements say up front that
// the library is organized in exactly two NAMED book categories ("est
// organisée en 2 catégories : histoire et fictions" — a pair drawn from
// `catPairs`, seeded by the equation: the same question always tells the
// same story), so the total is the sum of the two named categories only.
// `name` is a (Prénom, "m"/"f") pair
// or empty: the story is told in the 1st person
// ("Je suis docteur en littérature roumaine du XIVe siècle…") or in the
// gendered 3rd person ("Léa est docteure en littérature…", "La
// bibliothèque de Marc, docteur en littérature…,…" — docteur/docteure
// agreed with the person, sa/ma with the bibliothèque).
// `trap` is a distractor drawn from the scene: a "fonds ancien" with a
// drawn book count (seeded by the equation, never equal to the total e),
// allowed only on a single-product question (a*b = e); on the complete
// equation it marks the configuration invalid. The fonds ancien and the
// shelves are mentioned in an alternating order (seeded by the equation).
// Returns a (instruction:, answer:) table, or the `invalid` table when the
// configuration is unsupported or the equation doesn't hold.

let invalid = (invalid: $true)

// The literature the doctor specializes in (the decor, like the old
// calcN2 litterature situation): a country and a century.
let countries = do
	- tchèque
	- polonaise
	- roumaine
	- hongroise
	- finlandaise
	- danoise
end
let centuries = do
	- IXe
	- Xe
	- XIe
	- XIIe
	- XIIIe
	- XIVe
end

// The two book categories (named in the statement — "est organisée en 2
// catégories : histoire et fictions"); `d1`/`d2` the "livres de …" phrase
// of each category (elision included — "livres d'histoires", "livres de
// fictions"), so a bare count reads "75 livres d'histoires" and a shelved
// one "57 étagères de 5 livres de fictions".
let catPairs = do
	- (n1: histoire, d1: d'histoires, n2: fictions, d2: de fictions)
	- (n1: sciences, d1: de sciences, n2: poésie, d2: de poésie)
	- (n1: théâtre, d1: de théâtre, n2: contes, d2: de contes)
	- (n1: philosophie, d1: de philosophie, n2: bande dessinée, d2: de bande dessinée)
	- (n1: récits, d1: de récits, n2: essais, d2: d'essais)
	- (n1: aventures, d1: d'aventures, n2: biographies, d2: de biographies)
end

lin: macro(a, b, sign, c, d, e, u, name:, ?trap)
	// integers; wide bounds (relaxed 2026-10: the situation accepts the
	// caller's drawn numbers — variety over realism)
	if (a and a.floor() != a) or (b and b.floor() != b) or (c and c.floor() != c) or (d and d.floor() != d)
		return $invalid
	end
	if (a and (a < 2 or a > 9999)) or (c and (c < 2 or c > 9999))
		return $invalid
	end
	if (b and (b < 2 or b > 9999)) or (d and (d < 2 or d > 9999))
		return $invalid
	end
	if not e or e < 0
		return $invalid
	end

	// sign "" (or missing — the "hole" caller's "*" label passes sign
	// empty) is the bare product a*b = e: one group only, so the second
	// group (c, d) must be missing. sign "-" is never supported here.
	set sign = $ sign or ""
	if sign != "+" and sign != ""
		return $invalid
	end
	if sign == "" and (c or d)
		return $invalid
	end

	// Which letters must be known for the question to be solvable.
	if u == 1
		if not b
			// without b the first group is a bare count: the total only
			// makes sense when both groups are counts (d missing, c known)
			if d or not c
				return $invalid
			end
		else
			if (c and not d) or (not c and d)
				return $invalid
			end
		end
	elseif u == 2
		if not a
			return $invalid
		end
		if (c and not d) or (not c and d)
			return $invalid
		end
	elseif u == 3
		if not a
			return $invalid
		end
		if (b and not d) or (not b and d)
			return $invalid
		end
	elseif u == 4
		if not a or not c
			return $invalid
		end
	elseif u == 5
		if not a
			return $invalid
		end
		if c
			// one per-shelf count known and the other missing: the missing
			// group is unknown, the total is unsolvable
			if b and not d
				return $invalid
			end
		else
			// no second group: the first must be shelved (b known); d
			// alone would be a per-shelf count without a shelf count
			if d or not b
				return $invalid
			end
		end
	else
		return $invalid
	end

	// The caller passes a consistent equation (the missing letter is its
	// computed solution): check it. A letter without its partner stands
	// for a bare count of books; a missing group is worth 0.
	let lhs = 0
	if a and b
		set lhs = $ a * b
	elseif a
		set lhs = $ a
	end
	if c and d
		set lhs = $ lhs + c * d
	elseif c
		set lhs = $ lhs + c
	end
	if lhs != e
		return $invalid
	end

	// The trap (a "fonds ancien" with a drawn book count) is only
	// meaningful on a single-product question (a*b = e, c and d missing);
	// on the complete equation it has nothing to point at.
	if trap and (c or d)
		return $invalid
	end

	// The literature the doctor specializes in (country and century, the
	// decor of the old calcN2 litterature situation). The situation has no
	// parameter of its own, so the draw is seeded from the equation: a
	// given question always tells the same story (the factory is
	// seed-deterministic).
	let seed = $ (a or 0) * 10000000 + (b or 0) * 100000 + (c or 0) * 1000 + (d or 0) * 10 + (e or 0)
	let random = $Random($(seed))
	let country = $ random.choice(countries)
	let century = $ random.choice(centuries)
	let cat = $ random.choice(catPairs)

	// The trap's "fonds ancien" book count (drawn after the literature,
	// same seeded generator — the same question always tells the same
	// story; never equal to the total e), and `swap`, the alternating
	// order of the fonds ancien and the shelves.
	let fonds = 0
	let swap = 0
	if trap
		set fonds = $ random(2, 60)
		if fonds == e
			set fonds = $ fonds + 1
		end
		set swap = $ random(0, 1)
	end

	// The speaker: 1st person when name is empty; otherwise the (name,
	// gender) pair — "Léa est docteure en littérature tchèque du XIe
	// siècle", "La bibliothèque de Marc, docteur en littérature…", "sa
	// bibliothèque" (the possessive agrees with bibliothèque, never with
	// the doctor; "a-t-elle" refers to the bibliothèque).
	let who = if name and name[1]
		do
			introA: $(name[1]) est $(name[2] == "f" and "docteure" or "docteur") en littérature $country du $century siècle
			// trailing comma: the templates continue with " a …" or
			// " est organisée en …"
			introFull: La bibliothèque de $(name[1]), $(name[2] == "f" and "docteure" or "docteur") en littérature $country du $century siècle,
			Lib: Sa bibliothèque
			hasLib: Sa bibliothèque a
			counts: Sa bibliothèque compte
			qTotal: Combien de livres compte sa bibliothèque au total ?
		end
	else
		do
			introA: Je suis docteur en littérature $country du $century siècle
			introFull: Je suis docteur en littérature $country du $century siècle. Ma bibliothèque
			Lib: Ma bibliothèque
			hasLib: Ma bibliothèque a
			counts: Ma bibliothèque compte
			qTotal: Combien de livres y a-t-il au total ?
		end
	end

	// The two-group statements say up front that the library is organized
	// in exactly two NAMED book categories ("est organisée en 2 catégories
	// : $(cat.n1) et $(cat.n2)"), so the total is the sum of the two
	// named categories only.
	if u == 1
		return do
			instruction: do
				if b and c
					$(who.introFull) est organisée en 2 catégories : $(cat.n1) et $(cat.n2). La catégorie $(cat.n1) a $(b) livres par étagère et la catégorie $(cat.n2) $(c) étagères de $(d) livres, soit $(e) livres au total.\s
					Combien d'étagères compte la catégorie $(cat.n1) ?
				elseif b
					if trap and swap == 1
						$(who.introFull) a $(fonds) livres dans son fonds ancien ; elle a $(b) livres par étagère et $(e) livres sur ses étagères.\s
						Combien d'étagères a-t-elle ?
					elseif trap
						$(who.introFull) a $(b) livres par étagère et $(e) livres sur ses étagères ; le fonds ancien compte $(fonds) livres.\s
						Combien d'étagères a-t-elle ?
					else
						$(who.introFull) a $(b) livres par étagère et compte $(e) livres au total.\s
						Combien d'étagères a-t-elle ?
					end
				else
					$(who.introFull) est organisée en 2 catégories : $(cat.n1) et $(cat.n2). Il y a $(c) livres $(cat.d2) et les 2 catégories ensemble $(e) livres au total.\s
					Combien de livres y a-t-il dans la catégorie $(cat.n1) ?
				end
			end
			answer: do
				if b and c
					La catégorie $(cat.n1) a $(a) étagères.
				elseif b
					$(who.hasLib) $(a) étagères.
				else
					Il y a $(a) livres $(cat.d1).
				end
			end
		end
	elseif u == 2
		return do
			instruction: do
				if c
					$(who.introFull) est organisée en 2 catégories : $(cat.n1) et $(cat.n2). La catégorie $(cat.n1) a $(a) étagères et la catégorie $(cat.n2) $(c) étagères de $(d) livres, soit $(e) livres au total.\s
					Combien de livres par étagère dans la catégorie $(cat.n1) ?
				else
					if trap and swap == 1
						$(who.introFull) a $(fonds) livres dans son fonds ancien ; elle a $(a) étagères et $(e) livres sur ses étagères.\s
						Combien de livres par étagère ?
					elseif trap
						$(who.introFull) a $(a) étagères et $(e) livres sur ses étagères ; le fonds ancien compte $(fonds) livres.\s
						Combien de livres par étagère ?
					else
						$(who.introFull) a $(a) étagères et compte $(e) livres au total.\s
						Combien de livres par étagère ?
					end
				end
			end
			answer: do
				if c
					Il y a $(b) livres par étagère dans la catégorie $(cat.n1).
				else
					Il y a $(b) livres par étagère.
				end
			end
		end
	elseif u == 3
		return do
			instruction: do
				if b
					$(who.introFull) est organisée en 2 catégories : $(cat.n1) et $(cat.n2). La catégorie $(cat.n1) a $(a) étagères de $(b) livres et la catégorie $(cat.n2) $(d) livres par étagère, soit $(e) livres au total.\s
					Combien d'étagères compte la catégorie $(cat.n2) ?
				else
					$(who.introFull) est organisée en 2 catégories : $(cat.n1) et $(cat.n2). Il y a $(a) livres $(cat.d1) et les 2 catégories ensemble $(e) livres au total.\s
					Combien de livres y a-t-il dans la catégorie $(cat.n2) ?
				end
			end
			answer: do
				if b
					La catégorie $(cat.n2) a $(c) étagères.
				else
					Il y a $(c) livres $(cat.d2).
				end
			end
		end
	elseif u == 4
		return do
			instruction: do
				if b
					$(who.introFull) est organisée en 2 catégories : $(cat.n1) et $(cat.n2). La catégorie $(cat.n1) a $(a) étagères de $(b) livres et la catégorie $(cat.n2) $(c) étagères, soit $(e) livres au total.\s
					Combien de livres par étagère dans la catégorie $(cat.n2) ?
				else
					$(who.introFull) est organisée en 2 catégories : $(cat.n1) et $(cat.n2). Il y a $(a) livres $(cat.d1) et $(c) étagères $(cat.d2), soit $(e) livres au total.\s
					Combien de livres par étagère dans la catégorie $(cat.n2) ?
				end
			end
			answer: Il y a $(d) livres par étagère dans la catégorie $(cat.n2).
		end
	else
		return do
			instruction: do
				$(who.introA).\s
				if c and b and d
					$(who.Lib) est organisée en 2 catégories : $(cat.n1) et $(cat.n2). La catégorie $(cat.n1) a $(a) étagères de $(b) livres et la catégorie $(cat.n2) $(c) étagères de $(d) livres.\s
					$(who.qTotal)
				elseif c and d
					$(who.Lib) est organisée en 2 catégories : $(cat.n1) et $(cat.n2). Il y a $(a) livres $(cat.d1) et $(c) étagères de $(d) livres $(cat.d2).\s
					$(who.qTotal)
				elseif c
					$(who.Lib) est organisée en 2 catégories : $(cat.n1) et $(cat.n2). Il y a $(a) livres $(cat.d1) et $(c) livres $(cat.d2).\s
					$(who.qTotal)
				else
					if trap and swap == 1
						$(who.Lib) a $(fonds) livres dans son fonds ancien ; elle a $(a) étagères de $(b) livres.\s
						Combien de livres sur ces $(a) étagères ?
					elseif trap
						$(who.Lib) a $(a) étagères de $(b) livres ; le fonds ancien compte $(fonds) livres.\s
						Combien de livres sur ces $(a) étagères ?
					else
						$(who.Lib) a $(a) étagères de $(b) livres.\s
						$(who.qTotal)
					end
				end
			end
			answer: do
				if c
					$(who.counts) $(e) livres.
				else
					if trap
						Il y a $(e) livres sur ces $(a) étagères.
					else
						$(who.counts) $(e) livres.
					end
				end
			end
		end
	end

	// Fallback: every (sign, u) combination is handled or rejected above —
	// keep the explicit exit.
	return $invalid
end

// Display an exact decimal value the french way (the given amounts and the
// quotient, e.g. a price per book or a weight per book): 3 → "3", 2.5 →
// "2,5", 1.125 → "1,125" — no cent rounding (7/8 stays "0,875", not "0,88").
macro dec(x)
	$(String(x).replace(".", ","))
end

// a = bq + r (euclidean division: a books of a named category (like lin),
// b shelves, q the books per shelf, r the remainder) or a = bd (decimal
// division: d the quotient — exact, or rounded to a tenth when ?aprx),
// told in the library of a literature doctor (country and century, like
// lin). The caller passes every value, the missing ones empty: d truthy
// tells the decimal story, d empty the euclidean one.
//
// The decimal story has two variants, chosen by ?alt (only when ?aprx is
// missing, which keeps the price story for a rounded quotient):
//   price  : a the euros paid, b the books — "quel est le prix d'un livre ?"
//   weight : a the kilos, b the books — "quel est le poids d'un livre ?"
// ?trap adds a quantified distractor that makes the statement read like
// the other variant (a total weight in the price story, a total cost in
// the weight story — the deterministic derivation a + b, never equal to a
// term of the equation) — the same values always tell the same story.
// ?aprx marks the quotient rounded to a tenth (recurring decimal): the
// answer is then "environ …". The euclidean story has no trap (the trap is
// a decimal feature) — it is rejected there.
// Returns a (instruction:, answer:) table, or the `invalid` table.

div: macro(a, b, q, r, d, name:, ?trap, ?aprx, ?alt)
	// a and b are the two values the statement always shows: without
	// them there is no problem.
	if not a or not b
		return $invalid
	end

	// The literature the doctor specializes in (country and century, the
	// decor of lin): the situation has no parameter of its own, so the
	// draw is seeded from the values — a given question always tells the
	// same story (deterministic).
	let seed = $ (a or 0) * 10000000 + (b or 0) * 100000 + (q or 0) * 1000 + (r or 0) * 10 + ((d or 0) * 100).round()
	let random = $Random($(seed))
	let country = $ random.choice(countries)
	let century = $ random.choice(centuries)
	let cat = $ random.choice(catPairs)

	// The speaker: 1st person when name is empty; otherwise the (name,
	// gender) pair — the library is the topic ("Ma bibliothèque : …" /
	// "La bibliothèque de Léa, docteure en littérature… : …"), docteur/
	// docteure and the possessive (mes/ses) agreed with the person.
	let who = if name and name[1]
		do
			lib: La bibliothèque de $(name[1]), $(name[2] == "f" and "docteure" or "docteur") en littérature $country du $century siècle
			paid: $(name[1]) a payé
			has: $(name[1]) a
			poss: ses
		end
	else
		do
			lib: Ma bibliothèque
			paid: j'ai payé
			has: j'ai
			poss: mes
		end
	end

	if d
		// d is a price or a weight per book: 0 or less is not a division
		// problem (it would also slip past the equation check below, which
		// aprx disables).
		if d <= 0
			return $invalid
		end
		// The statement shows a and b: the quotient d must satisfy a = bd
		// (checked to the cent, like lin). With aprx the caller passes a
		// quotient rounded to a tenth (recurring decimal) — no check.
		if not aprx and (b * d * 100).round() != (a * 100).round()
			return $invalid
		end
		// b is a book count: a count is an integer.
		if b.floor() != b
			return $invalid
		end
		// Small personal library: a few dozen euros/kilos, a few books —
		// kept concrete so the per-book result stays plausible.
		if a < 2 or a > 30 or b < 2 or b > 10
			return $invalid
		end
		// The weight variant is the exact-quotient story: ?alt selects it,
		// ?aprx keeps the price story. (Not a same-named local: in a do
		// block `let alt = $alt and …` shadows the parameter with itself.)
		let w = $ alt and not aprx
		return do
			instruction: do
				if w
					// B2 (weight): the b books weigh a kg.
					$(who.lib) : $(who.poss) $b livres $(cat.d1) pèsent $(dec(a)) kg
					if trap
						\set coûtent $(dec(a + b)) €
					end
					.\s
					Quel est le poids d'un livre ?
				else
					// B1 (price): a euros paid for b books.
					$(who.lib) : $(who.paid) $(dec(a)) € pour $b livres $(cat.d1)
					if trap
						\s; elles pèsent $(dec(a + b)) kg
					end
					.\s
					Quel est le prix d'un livre ?
				end
			end
			answer: do
				if w
					// The quotient is displayed exact: a cent-rounded
					// format would show 7/8 as "0,88" instead of the
					// exact "0,875".
					Le poids d'un livre est
					if aprx
						\sd'environ $(dec(d)) kg.
					else
						\sde $(dec(d)) kg.
					end
				else
					Le prix d'un livre est
					if aprx
						\sd'environ $(dec(d)) €.
					else
						\sde $(dec(d)) €.
					end
				end
			end
		end
	else
		// A (euclidean): the trap is a decimal (B) feature — the other
		// variant's info has no meaning when nothing is cut; reject it.
		if trap
			return $invalid
		end
		// q and r are the answer(s): without them the problem has none
		// (the caller always passes them — q = a div b, r = a mod b).
		if not q or not r
			return $invalid
		end
		// Counts are integers where expected.
		if a.floor() != a or b.floor() != b or q.floor() != q or r.floor() != r
			return $invalid
		end
		// Small personal library: a >= 10 books (a repartition of 4 books
		// over 2 shelves is a trivial split), a <= 30 (a few dozen), a
		// few shelves, at least two books per shelf (q ≥ 2) — kept
		// concrete.
		if a < 10 or a > 30 or b < 2 or b > 10 or q < 2
			return $invalid
		end
		// Euclidean division: a = bq + r with 0 <= r < b — with r >= b the
		// repartition is not maximal and the question admits another answer.
		if a != b * q + r or r < 0 or r >= b
			return $invalid
		end
		return do
			instruction: do
				$(who.lib) : $(who.has) $a livres $(cat.d1) à répartir équitablement sur $b étagères ;\s
				if alt
					combien y a-t-il de livres par étagère ?
				else
					combien de livres ne pourront pas être mis sur une étagère complète ?
				end
			end
			answer: do
				if alt
					Il y aura $q livres par étagère
					if r > 0
						\s(mais il en restera\s
						if r == 1
							1 non réparti).
						else
							$r non répartis).
						end
					else
						.
					end
				else
					if r > 0
						Il y aura\s
						if r == 1
							1 livre non réparti.
						else
							$r livres non répartis.
						end
					else
						Tous les livres seront répartis.
					end
				end
			end
		end
	end

	// Fallback: both branches return above — keep the explicit exit.
	return $invalid
end
