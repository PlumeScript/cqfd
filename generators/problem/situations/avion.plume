// Avion situations: a word problem drawn from a linear equation with
// one missing letter (`lin`), or from a division a = bq+r / a = bd
// (`div`), dressed as the seats of an airplane with two classes:
//
//   sign "+" : a*b + c*d = e    a rows, b seats per row (economy class);
//                                c rows, d seats per row (business class);
//                                e total seats
//   sign ""  : a*b = e          a single-class plane: a rows of b seats,
//                                e seats in all
//   sign "-" : invalid          a plane never unseats its classes
//
// The caller passes every letter (the missing one as its computed solution)
// and `u` points at the letter the question asks for (1..5 = a,b,c,d,e).
// `name` is a (Prénom, "m"|"f") pair — (Léa, f) — or empty: the statement
// is the impersonal "L'avion a…" or the named "Léa est pilote, et son
// avion a…" (the plane is always masculine, so the gender never changes a
// form; the "a-t-il" questions refer to the plane).
// `trap` only applies to the single-product equation: the business class
// is then drawn with arbitrary values (a row count and a seats-per-row
// count, seeded by the equation) — a quantified distractor the answer
// ignores — and the question is scoped to the economy class. The two
// classes are named in an alternating order (seeded): the business class
// first or last.
// Returns a (instruction:, answer:) table, or the `invalid` table when
// the configuration is unsupported or the equation doesn't hold.

let invalid = (invalid: $true)

// "L'avion" / "Joe est pilote, et son avion" (named: the owner is a pilot
// and the plane is his/hers; the plane is always masculine, so the gender
// never changes a form — the "a-t-il" questions refer to the plane).
macro plane(name)
	if name and name[1]
		$(name[1]) est pilote, et son avion
	else
		L'avion
	end
end

lin: macro(a, b, sign, c, d, e, u, name:, ?trap)
	// "-" is not an airplane equation: a plane never unseats a class.
	// (The "hole" caller's "*" label passes sign empty: empty and "" are
	// distinct values, "" is truthy, so `sign or ""` normalizes both.)
	set sign = $ sign or ""
	if sign != "+" and sign != ""
		return $invalid
	end

	// Rows, seats per row, total seats are whole numbers.
	if (a and a.floor() != a) or (b and b.floor() != b) or (c and c.floor() != c) or (d and d.floor() != d) or (e and e.floor() != e)
		return $invalid
	end

	// Wide bounds (relaxed 2026-10: the situation accepts the caller's
	// drawn numbers — variety over realism); every count is >= 2, so the
	// plurals ("rangées", "sièges") are always the right form.
	if (a and (a < 2 or a > 50)) or (c and (c < 2 or c > 20))
		return $invalid
	end
	if (b and (b < 2 or b > 50)) or (d and (d < 2 or d > 20))
		return $invalid
	end
	if not e or e < 4
		return $invalid
	end

	// sign "" (one term only) never carries the second class, and the
	// trap never dresses the full equation (nothing left to mention).
	if sign == "" and (c or d)
		return $invalid
	end
	if trap and sign != ""
		return $invalid
	end

	// The caller passes a consistent equation (the missing letter is its
	// computed solution): every letter must be present and the equation
	// must hold.
	if sign == ""
		if not a or not b
			return $invalid
		end
		if u != 1 and u != 2 and u != 5
			return $invalid
		end
		if a*b != e
			return $invalid
		end
	else
		if not a or not b or not c or not d
			return $invalid
		end
		if u < 1 or u > 5
			return $invalid
		end
		if a*b + c*d != e
			return $invalid
		end
	end

	// The speaker: impersonal when name is empty; otherwise the (name,
	// gender) pair — "L'avion de Léa" (the plane is masculine, the
	// gender never changes a form).
	let planeName = $ plane(name)

	// Single class (a*b = e): with the trap, the business class is drawn
	// with arbitrary values (a row count and a seats-per-row count, seeded
	// by the equation) — a quantified distractor — and the question is
	// scoped to the economy class. The two classes are named in an
	// alternating order (seeded, `swap`): the business class first or
	// last.
	if sign == ""
		let swap = 0
		if trap
			let seed = $ (a * 100).round() * 1000000000 + (b * 100).round() * 1000000 + (e * 100).round()
			let random = $Random($(seed))
			set c = $ random(2, 20)
			set d = $ random(2, 6)
			set swap = $ random(0, 1)
			return if u == 1
				instruction: do
					if swap == 1
						$(planeName) a $c rangées de $d sièges en classe affaires et $b sièges par rangée en classe économique, soit $e sièges en classe économique.\s
					else
						$(planeName) a $b sièges par rangée en classe économique, soit $e sièges en classe économique ; la classe affaires a $c rangées de $d sièges.\s
					end
					Combien de rangées a-t-il en classe économique ?
				end
				answer: Il a $a rangées en classe économique.
			elseif u == 2
				instruction: do
					if swap == 1
						$(planeName) a $c rangées de $d sièges en classe affaires et $a rangées en classe économique, soit $e sièges en classe économique.\s
					else
						$(planeName) a $a rangées en classe économique, soit $e sièges en classe économique ; la classe affaires a $c rangées de $d sièges.\s
					end
					Combien de sièges par rangée en classe économique ?
				end
				answer: Il a $b sièges par rangée en classe économique.
			else
				instruction: do
					if swap == 1
						$(planeName) a $c rangées de $d sièges en classe affaires et $a rangées de $b sièges en classe économique.\s
					else
						$(planeName) a $a rangées de $b sièges en classe économique ; la classe affaires a $c rangées de $d sièges.\s
					end
					Combien de sièges a-t-il en classe économique ?
				end
				answer: Il a $e sièges en classe économique.
			end
		end
		return if u == 1
			instruction: do
				$(planeName) a $b sièges par rangée, soit $e sièges au total.\s
				Combien de rangées a-t-il ?
			end
			answer: Il a $a rangées.
		elseif u == 2
			instruction: do
				$(planeName) a $a rangées, soit $e sièges au total.\s
				Combien de sièges par rangée ?
			end
			answer: Il a $b sièges par rangée.
		else
			instruction: do
				$(planeName) a $a rangées de $b sièges.\s
				Combien de sièges a-t-il au total ?
			end
			answer: Il a $e sièges au total.
		end
	end

	// Two classes (a*b + c*d = e), one letter missing.
	return if u == 1
		instruction: do
			$(planeName) a $b sièges par rangée en classe économique et $c rangées de $d sièges en classe affaires, soit $e sièges au total.\s
			Combien de rangées a-t-il en classe économique ?
		end
		answer: Il a $a rangées en classe économique.
	elseif u == 2
		instruction: do
			$(planeName) a $a rangées en classe économique et $c rangées de $d sièges en classe affaires, soit $e sièges au total.\s
			Combien de sièges par rangée en classe économique ?
		end
		answer: Il a $b sièges par rangée en classe économique.
	elseif u == 3
		instruction: do
			$(planeName) a $a rangées de $b sièges en classe économique et $d sièges par rangée en classe affaires, soit $e sièges au total.\s
			Combien de rangées a-t-il en classe affaires ?
		end
		answer: Il a $c rangées en classe affaires.
	elseif u == 4
		instruction: do
			$(planeName) a $a rangées de $b sièges et $c rangées en classe affaires, soit $e sièges au total.\s
			Combien de sièges par rangée en classe affaires ?
		end
		answer: Il a $d sièges par rangée en classe affaires.
	else
		instruction: do
			$(planeName) a $a rangées de $b sièges en classe économique et $c rangées de $d sièges en classe affaires.\s
			Combien de sièges a-t-il au total ?
		end
		answer: Il a $e sièges au total.
	end
end

// a = bq + r (euclidean division: a economy-class seats, b the rows,
// q the seats per row, r the leftover) or a = bd (decimal division: d
// the quotient — exact, or rounded to a tenth when ?aprx). The caller
// passes every value, the missing ones empty: d truthy tells the
// decimal story, d empty the euclidean one.
//
// The decimal story has two variants, chosen by ?alt (only when ?aprx
// is missing, which keeps the price story for a rounded quotient):
//   price   : a the euros paid for b economy seats — "quel est le prix
//             d'une place ?" (1st person when name is empty)
//   baggage : a the kilos of baggage among b passengers — "quel est le
//             quota de bagages par passager ?" (told by the plane)
// ?trap adds the OTHER variant's information — a baggage weight in the
// price story, a baggage cost in the baggage story — a deterministic
// derivative of a and b (a + b — greater than both, so it can never
// coincide with a term of the equation) — so the statement reads trait
// for trait like the other variant; the question posed decides. The
// euclidean story never carries a trap (there is no other variant to
// cross-dress it with — invalid). ?aprx marks the quotient rounded to
// a tenth (recurring decimal): the answer is then "environ …".
// Returns a (instruction:, answer:) table, or the `invalid` table.

// Display an exact decimal value the french way (the quotient, €/place
// or kg/passager): 3 → "3", 2.5 → "2,5", 1.125 → "1,125".
macro exact(x)
	$(String(x).replace(".", ","))
end

div: macro(a, b, q, r, d, name:, ?trap, ?aprx, ?alt)
	// The speaker: 1st person when name is empty; otherwise the (name,
	// gender) pair — the price story only ("a payé"); the baggage
	// story is impersonal, told by the plane.
	let who = if name and name[1]
		do
			paid: $name[1] a payé
		end
	else
		do
			paid: J'ai payé
		end
	end

	// a and b are the two values the statement always shows: without
	// them there is no problem.
	if not a or not b
		return $invalid
	end

	if d
		// d is a price or a baggage quota per unit: 0 or less is not a
		// division problem (it would also slip past the equation check
		// below, which aprx disables).
		if d <= 0
			return $invalid
		end
		// The statement shows a and b: the quotient d must satisfy
		// a = bd (checked to the cent, like lin). With aprx the caller
		// passes a quotient rounded to a tenth (recurring decimal) —
		// no check.
		if not aprx and (b * d * 100).round() != (a * 100).round()
			return $invalid
		end
		// a is a quantity (euros, kilos), b a count (seats,
		// passengers): integers where expected.
		if a.floor() != a or b.floor() != b
			return $invalid
		end
		// Plausible ranges: the quantity a in [2, 60], the unit count
		// b in [2, 20] (a small group / a cabin section — the caller
		// draws wider, the surplus is simply skipped).
		if a < 2 or a > 60 or b < 2 or b > 20
			return $invalid
		end
		// The baggage variant is the exact-quotient story: ?alt selects
		// it, ?aprx keeps the price story. (Not a same-named local: in
		// a do block `let alt = $alt and …` shadows the parameter with
		// itself.)
		let w = $ alt and not aprx
		return do
			instruction: do
				if w
					$(plane(name)) transporte $a kg de bagages, répartis équitablement entre $b passagers
					if trap
						\s; le transport des bagages coûte $(a + b) € au total
					end
					.\s
					Quel est le quota de bagages par passager ?
				else
					$(who.paid) $a € pour $b places en classe économique
					if trap
						\s; l'avion transporte $(a + b) kg de bagages
					end
					.\s
					Quel est le prix d'une place ?
				end
			end
			answer: do
				if w
					Le quota de bagages par passager est
					if aprx
						\sd'environ $(exact(d)) kg.
					else
						\sde $(exact(d)) kg.
					end
				else
					Le prix d'une place est
					if aprx
						\sd'environ $(exact(d)) €.
					else
						\sde $(exact(d)) €.
					end
				end
			end
		end
	else
		// q and r are the answer(s): without them the problem has none
		// (the caller always passes them — q = a div b, r = a mod b).
		if not q or not r
			return $invalid
		end
		// The euclidean story never carries a trap: the trap's purpose
		// is to cross-dress the two decimal variants, and there is no
		// other variant to dress the seats story with.
		if trap
			return $invalid
		end
		// Counts are integers where expected (seats, rows).
		if a.floor() != a or b.floor() != b or q.floor() != q or r.floor() != r
			return $invalid
		end
		// Plausible ranges: a = the economy seats in [10, 60] (a
		// repartition of 4 seats over 2 rows is a trivial split), b = the
		// rows in [2, 20], q the seats per row >= 2 (a one-seat-per-row
		// repartition is not a repartition).
		if a < 10 or a > 60 or b < 2 or b > 20 or q < 2
			return $invalid
		end
		// Euclidean division: a = bq + r with 0 <= r < b — with r >= b
		// the repartition is not maximal and the question admits
		// another answer.
		if a != b * q + r or r < 0 or r >= b
			return $invalid
		end
		return do
			instruction: do
				$(plane(name)) a $a sièges en classe économique, à répartir équitablement en $b rangées.\s
				if alt
					Combien y a-t-il de sièges par rangée ?
				else
					Combien de sièges ne pourront pas être placés dans une rangée ?
				end
			end
			answer: do
				if alt
					Il y aura $q sièges par rangée
					if r > 0
						\s(mais il en restera\s
						if r == 1
							1 non placé).
						else
							$r non placés).
						end
					else
						.
					end
				else
					if r > 0
						Il y aura\s
						if r == 1
							1 siège non placé.
						else
							$r sièges non placés.
						end
					else
						Tous les sièges seront placés.
					end
				end
			end
		end
	end

	// Fallback: both branches return above — keep the explicit exit.
	return $invalid
end
