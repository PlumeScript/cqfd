// Haras (stud) situations: the births at a unicorn stud, a word problem
// drawn from the equation a*b + c*d = e with one missing letter (`lin`),
// or from a division a = bq + r / a = bd (`div`):
//
//   sign "+" : a*b + c*d = e    two meadows (prés) of mares — a, c the
//                               number of mares, b, d the births per mare,
//                               e the newborns in total (u = 1..5)
//   sign ""  : a*b = e          one meadow — the bare product (c and d
//                               missing, u = 1, 2 or 5). With trap, the
//                               2e pré is drawn with arbitrary values (a
//                               mare count and a births-per-mare count,
//                               seeded by the equation, never identical to
//                               the 1er pré) — a quantified distractor,
//                               never an unvalued mention — and the total
//                               is scoped to the 1er pré. The two meadows
//                               are named in an alternating order (seeded):
//                               the 1er pré first or last.
//   sign "-" : invalid          no loss happens at the stud
//
// `div` — a = bq + r (euclidean: a mares reparted in b meadows; alt = 1
// asks the quotient q, alt = 0 the remainder r) or a = bd (decimal: d the
// quotient, exact or rounded to a tenth when ?aprx; ?alt picks the hay
// story — a kilos of hay over the b mares of the 1er pré, "la ration de
// paille par jument" — over the cost story — a euros of food for the b
// mares of the 1er pré, "le coût par jument"). The ?trap adds a quantified
// distractor that makes the statement read like the other variant (a food
// cost in the euclidean one, a cost in the hay variant, a hay quantity in
// the cost variant) — derived from the equation (hay at 2 €/kg) — the
// student must read the question posed.
//
// The caller passes every letter (the missing one as its computed solution)
// and `u` points at the letter the question asks for (1..5 = a,b,c,d,e).
// `name` is a (name, gender) pair — (Léa, "f") — or empty: the scene is
// told in the 1st person ("Dans mon haras, …") or in the 3rd person
// ("Dans le haras de Léa, …"). The trap has no place in the full sum and
// is ignored there.
// Returns a (instruction:, answer:) table, or the `invalid` table when the
// configuration is unsupported or the equation doesn't hold.

let invalid = (invalid: $true)

// "3 licornes" / "1 licorne" (the singular when the count is 1)
macro born(n)
	$n $(n == 1 and "licorne" or "licornes")
end

lin: macro(a, b, sign, c, d, e, u, name:, ?trap)
	// The supported equations: the two-group sum (sign "+", all five
	// letters) and the bare product (sign "" — or empty, the "hole"
	// caller's "*" label — one group, c and d missing). A loss (sign "-")
	// never happens at the stud.
	set sign = $ sign or ""
	if sign == "-"
		return $invalid
	end
	if sign != "+" and sign != ""
		return $invalid
	end

	// integers where expected
	if (a and a.floor() != a) or (b and b.floor() != b) or (c and c.floor() != c) or (d and d.floor() != d) or (e and e.floor() != e)
		return $invalid
	end

	// sign "+": the two groups — a, b, c, d all present, u = 1..5.
	// sign "": one group — c and d missing, u = 1, 2 or 5.
	if sign == ""
		if c or d
			return $invalid
		end
		if u != 1 and u != 2 and u != 5
			return $invalid
		end
	else
		if not a or not b or not c or not d
			return $invalid
		end
		if u < 1 or u > 5
			return $invalid
		end
	end

	// wide bounds (relaxed 2026-10: the situation accepts the caller's
	// drawn numbers — variety over realism); mare counts >= 2 so
	// "juments" stays plural
	if (a and (a < 2 or a > 9999)) or (c and (c < 2 or c > 9999))
		return $invalid
	end
	if (b and (b < 1 or b > 9999)) or (d and (d < 1 or d > 9999))
		return $invalid
	end
	if not e or e < 1
		return $invalid
	end

	// The caller passes a consistent equation (the missing letter is its
	// computed solution): check it.
	let lhs = 0
	if sign == "+"
		set lhs = $ a * b + c * d
	else
		set lhs = $ a * b
	end
	if lhs != e
		return $invalid
	end

	// The scene: 1st person when name is empty; otherwise the stud of the
	// (name, gender) pair — "Dans mon haras," / "Dans le haras de Léa,".
	let who = if name and name[1]
		do
			intro: Dans le haras de $(name[1]),
		end
	else
		do
			intro: Dans mon haras,
		end
	end

	// sign "+": the two meadows are named in the statement ("du 1er pré",
	// "du 2e pré") and the questions are scoped to the mares that
	// gave birth ("ont mis bas") — the total only counts their births.
	if sign == "+"
		return if u == 1
			instruction: do
				$(who.intro)\s
				des juments du 1er pré ont chacune eu $(born(b)) et $c juments du 2e pré en ont eu $d ; au total, $e licornes sont nées.\s
				Combien de juments du 1er pré ont mis bas ?
			end
			answer: Ce sont donc $a juments du 1er pré qui ont mis bas.
		elseif u == 2
			instruction: do
				$(who.intro)\s
				les $a juments du 1er pré ont chacune eu autant de licornes les unes que les autres et les $c juments du 2e pré en ont eu chacune $d ; au total, $e licornes sont nées.\s
				Combien de licornes chacune des juments du 1er pré a-t-elle eues ?
			end
			answer: Chaque jument du 1er pré a donc eu $(born(b)).
		elseif u == 3
			instruction: do
				$(who.intro)\s
				$a juments du 1er pré ont chacune eu $(born(b)) et des juments du 2e pré en ont eu chacune $d ; au total, $e licornes sont nées.\s
				Combien de juments du 2e pré ont mis bas ?
			end
			answer: Ce sont donc $c juments du 2e pré qui ont mis bas.
		elseif u == 4
			instruction: do
				$(who.intro)\s
				$a juments du 1er pré ont chacune eu $(born(b)) ; les $c juments du 2e pré en ont eu chacune autant les unes que les autres, et au total $e licornes sont nées.\s
				Combien de licornes chacune des juments du 2e pré a-t-elle eues ?
			end
			answer: Chaque jument du 2e pré a donc eu $(born(d)).
		elseif u == 5
			instruction: do
				$(who.intro)\s
				$a juments ont chacune eu $(born(b)) et $c juments en ont eu $d.\s
				Combien de licornes sont nées au total ?
			end
			answer: Au total, $e licornes sont nées.
		end
	end

	// sign "": the bare product. With trap, the 2e pré is drawn with a
	// mare count and a births-per-mare count (seeded by the equation,
	// never identical to the 1er pré) — a quantified distractor the answer
	// ignores; the total (and the question) stays scoped to the 1er pré.
	// The two meadows are named in an alternating order (seeded, `swap`):
	// the 1er pré first or last.
	let swap = 0
	if trap
		let seed = $ (a * 100).round() * 1000000000 + (b * 100).round() * 1000000 + (e * 100).round()
		let random = $Random($(seed))
		set c = $ random(2, 20)
		set d = $ random(1, 15)
		if c == a and d == b
			set c = $ c == 20 and 19 or c + 1
		end
		set swap = $ random(0, 1)
		return if u == 1
			instruction: do
				$(who.intro)\s
				if swap == 1
					les $c juments du 2e pré ont chacune eu $(born(d)) ; des juments du 1er pré en ont eu chacune $(born(b)).\s
				else
					des juments du 1er pré ont chacune eu $(born(b)) ; les $c juments du 2e pré en ont eu chacune $d.\s
				end
				Au total, le 1er pré a eu $e licornes.\s
				Combien de juments du 1er pré ont mis bas ?
			end
			answer: Ce sont donc $a juments du 1er pré qui ont mis bas.
		elseif u == 2
			instruction: do
				$(who.intro)\s
				if swap == 1
					les $c juments du 2e pré ont chacune eu $(born(d)) ; les $a juments du 1er pré en ont eu chacune autant les unes que les autres.\s
				else
					les $a juments du 1er pré ont chacune eu autant de licornes les unes que les autres ; les $c juments du 2e pré en ont eu chacune $d.\s
				end
				Au total, le 1er pré a eu $e licornes.\s
				Combien de licornes chacune des juments du 1er pré a-t-elle eues ?
			end
			answer: Chaque jument du 1er pré a donc eu $(born(b)).
		elseif u == 5
			instruction: do
				$(who.intro)\s
				if swap == 1
					les $c juments du 2e pré ont chacune eu $(born(d)) ; les $a juments du 1er pré en ont eu chacune $(born(b)).\s
				else
					les $a juments du 1er pré ont chacune eu $(born(b)) ; les $c juments du 2e pré en ont eu chacune $d.\s
				end
				Combien de licornes le 1er pré a-t-il eu ?
			end
			answer: Le 1er pré a donc eu $e licornes.
		end
	end

	return if u == 1
		instruction: do
			$(who.intro)\s
			des juments ont chacune eu $(born(b)) ; au total $e licornes sont nées.\s
			Combien de juments ont mis bas ?
		end
		answer: Ce sont donc $a juments qui ont mis bas.
	elseif u == 2
		instruction: do
			$(who.intro)\s
			$a juments ont chacune eu autant de licornes les unes que les autres et au total $e licornes sont nées.\s
			Combien de licornes chacune a-t-elle eues ?
		end
		answer: Chaque jument a donc eu $(born(b)).
	elseif u == 5
		instruction: do
			$(who.intro)\s
			$a juments ont chacune eu $(born(b)).\s
			Combien de licornes ont-elles eues au total ?
		end
		answer: Au total, $e licornes sont nées.
	end

	// Fallback: every (sign, u, trap) combination is handled or rejected
	// above — keep the explicit exit.
	return $invalid
end

// Display an exact decimal value the french way (the `div` quotient — a
// hay ration per mare, a cost per mare): 3 → "3", 2.5 → "2,5",
// 0.875 → "0,875". The quotient is never rounded: a cent-rounding would
// show 7/8 as "0,88" instead of the exact "0,875".
macro dec(x)
	$(String(x).replace(".", ","))
end

// a = bq + r (euclidean division: a mares, b meadows, q the mares per
// meadow, r the remainder) or a = bd (decimal division: d the quotient —
// exact, or rounded to a tenth when ?aprx). The caller passes every value,
// the missing ones empty: d truthy tells the decimal story, d empty the
// euclidean one.
//
// The decimal story has two variants of what is divided, chosen by ?alt
// (only when ?aprx is missing, which keeps the cost story for a rounded
// quotient):
//   hay  : a the kilos of hay, b the mares of the 1er pré —
//          "quelle est la ration de paille par jument ?"
//   cost : a the euros of food, b the mares of the 1er pré —
//          "quel est le coût par jument ?"
// ?trap adds a quantified distractor that makes the statement read like
// the other variant (a food cost in the euclidean one, a cost in the hay
// variant, a hay quantity in the cost variant) — derived from the equation
// (hay at 2 €/kg: a kg of hay is 2 €, a mare's food is 20 €, 40 kg of
// hay per mare) — the same values always tell the same story. ?aprx marks
// the quotient rounded to a tenth (recurring decimal): the answer is then
// "environ …".
// Returns a (instruction:, answer:) table, or the `invalid` table.

div: macro(a, b, q, r, d, name:, ?trap, ?aprx, ?alt)
	// The speaker: 1st person when name is empty; otherwise the (name,
	// gender) pair — the forms div needs have no person agreement
	// ("achète", "lui coûte"), so only the name is used. `intro` is the
	// same key `lin` uses.
	let who = if name and name[1]
		do
			intro: Dans le haras de $(name[1]),
			buy: $name[1] achète
			cost: Cela lui coûte
		end
	else
		do
			intro: Dans mon haras,
			buy: j'achète
			cost: Cela me coûte
		end
	end

	// a and b are the two values the statement always shows: without
	// them there is no problem.
	if not a or not b
		return $invalid
	end

	if d
		// d is a hay ration or a cost per mare: 0 or less is not a
		// division problem (it would also slip past the equation check
		// below, which aprx disables).
		if d <= 0
			return $invalid
		end
		// The statement shows a and b: the quotient d must satisfy a = bd
		// (checked to the cent, like lin). With aprx the caller passes a
		// quotient rounded to a tenth (recurring decimal) — no check.
		if not aprx and (b * d * 100).round() != (a * 100).round()
			return $invalid
		end
		// b is a mare count: an integer where expected.
		if b.floor() != b
			return $invalid
		end
		// wide bounds: the caller's divQ2 draws a, b in [2,100] (a the
		// kilos of hay or the euros of food, b the mares of the 1er pré)
		// — variety over realism (relaxed 2026-10)
		if a < 2 or a > 100 or b < 2 or b > 100
			return $invalid
		end
		// The hay variant is the exact-quotient story: ?alt selects it,
		// ?aprx keeps the cost story. (Not a same-named local: in a do
		// block `let alt = $alt and …` shadows the parameter with itself.)
		let w = $ alt and not aprx
		return do
			instruction: do
				if w
					$(who.intro)\s
					$(who.buy) $(dec(a)) kg de paille pour les $b juments du 1er pré, à répartir équitablement
					if trap
						.\s$(who.cost) $(dec(2 * a)) €
					end
					.\s
					Quelle est la ration de paille par jument ?
				else
					$(who.intro)\s
					$(who.buy) $(dec(a)) € de nourriture pour les $b juments du 1er pré
					if trap
						, soit $(dec(40 * b)) kg de paille à répartir équitablement
					end
					.\s
					Quel est le coût par jument ?
				end
			end
			answer: do
				if w
					C'est\s
					if aprx
						environ\s
					end
					$(dec(d)) kg de paille par jument.
				else
					Le coût par jument est
					if aprx
						\sd'environ $(dec(d)) €.
					else
						\sde $(dec(d)) €.
					end
				end
			end
		end
	else
		// q and r are the answer(s): without them the problem has none
		// (the caller always passes them — q = a div b, r = a mod b).
		if not q or not r
			return $invalid
		end
		// Counts are integers where expected.
		if a.floor() != a or b.floor() != b or q.floor() != q or r.floor() != r
			return $invalid
		end
		// Mare counts and meadow counts: a stud is a small group of mares
		// over a few meadows — a in [2,20] mares (a herd, not a single
		// mare, not a breeding farm), b in [2,10] meadows (one meadow is
		// no repartition, more than 10 is not a stud).
		if a < 2 or a > 20 or b < 2 or b > 10
			return $invalid
		end
		// At least 2 mares per meadow: q = 1 makes the question an answer
		// readable off the statement (no division to do).
		if q < 2
			return $invalid
		end
		// Euclidean division: a = bq + r with 0 <= r < b — with r >= b the
		// repartition is not maximal and the question admits another answer.
		if a != b * q + r or r < 0 or r >= b
			return $invalid
		end
		return do
			instruction: do
				$(who.intro)\s
				les $a juments seront réparties équitablement en $b prés
				if trap
					.\s$(who.cost) $(dec(20 * a)) € de nourriture.\s
				else
					.\s
				end
				if alt
					Combien y a-t-il de juments par pré ?
				else
					Combien de juments ne pourront pas être mises dans un pré ?
				end
			end
			answer: do
				if alt
					Il y aura $q juments par pré
					if r > 0
						\s(mais il en restera\s
						if r == 1
							1 non répartie).
						else
							$r non réparties).
						end
					else
						.
					end
				else
					if r > 0
						Il y aura\s
						if r == 1
							1 jument non répartie.
						else
							$r juments non réparties.
						end
					else
						Toutes les juments seront réparties.
					end
				end
			end
		end
	end

	// Fallback: both branches return above — keep the explicit exit.
	return $invalid
end
