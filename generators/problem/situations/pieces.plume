// Pieces situations: a word problem drawn from a linear equation with
// one missing letter (`lin`), or from a division a = bq+r / a = bd
// (`div`), dressed as coins in the pocket (and a piggy bank):
//
//   sign "+" : a*b + c*d = e    a, c coin counts; b, d coin values (€)
//   sign ""  : a*b = e          a bare product: one coin type, c and d
//                               must be missing
//   sign "-" : invalid          coins are not taken out of the pocket
//                               one by one
//
// The caller passes every letter (the missing one as its computed solution)
// and `u` points at the letter the question asks for (1..5 = a,b,c,d,e).
// `name` is a (name, gender) pair — (Léa, f) — or empty: the question is
// told in the 1st person ("j'ai…") or in the gendered 3rd person
// ("Léa a… a-t-elle… ses pièces… sa tirelire…").
//
// The trap only dresses a bare product: the piggy bank then holds a drawn
// quantity of coins of a drawn value (the value always different from the
// pocket coins' value, the quantity seeded by the equation) — a quantified
// distractor, never an unvalued mention — and the question is restricted
// to the pocket coins ("combien d'argent ai-je en pièces de 0,50 € ?").
// The pocket and the piggy bank are mentioned in an alternating order
// (seeded by the equation).
// On the full equation there is no second term to mention: the
// configuration is marked invalid.
//
// `div` dresses a division: the euclidean one (a coins shared fairly in
// b pockets — how many per pocket, or how many left over) and the
// decimal one, with two variants (a euros paid in b coins of the same
// value → the value of one coin; the b coins weigh a grams → the weight
// of one coin). The trap adds the other decimal variant's datum — a
// total weight in the value story, a total amount in the weight story,
// deterministic and never a term of the equation — so the statement
// reads like the other variant and the student must read the question
// posed (the two datums are presented in an alternating order). The
// euclidean story has no second variant to mimic: ?trap is invalid
// there.
//
// The non-trap statements are plain possession statements ("Joe a 9
// pièces de 5,80 € et 60 pièces de 1,10 €…"): the total is the value of
// the coins listed (the "soit X € au total" clause or the sum asked for),
// no framing needed — "tout son argent est en pièces" was useless weight.
//
// Returns a (instruction:, answer:) table, or the `invalid` table when the
// configuration is unsupported or the equation doesn't hold.

let invalid = (invalid: $true)

// Euro coin values: the piggy bank of the trap is drawn from this list.
let coinValues = do
	- 0.05
	- 0.1
	- 0.2
	- 0.5
	- 1
	- 2
end

// Value of the piggy bank's coins (the trap's second coin type): a coin of
// the catalogue, always different from the pocket coins' value (b).
macro trapValue(b)
	let i = $ ((b * 100).round() % 6) + 1
	let v = $ coinValues[i]
	if (v * 100).round() == (b * 100).round()
		set i = $ i % 6 + 1
		set v = $ coinValues[i]
	end
	$v
end

// Display a euro amount the french way: 12 → "12", 1.3 → "1,30".
macro euros(x)
	let r = $ x.round(digit: 2)
	if String(r).contains(".") or String(r).contains(",")
		$(Number.format(r, "%.2f", locale: "fr"))
	else
		$(Number.format(r, "%.0f", locale: "fr"))
	end
end

// Display an exact decimal value the french way (the decimal quotient of
// the div answers, a weight in grams in the statement): 3 → "3",
// 2.5 → "2,5", 0.875 → "0,875". Unlike euros(), it never rounds (7/8
// stays "0,875" — euros() would show "0,88").
macro exact(x)
	$(String(x).replace(".", ","))
end

// Value of a term: qty*price, 0 when the quantity or the price is missing.
macro term(qty, price)
	if qty and price
		$(qty * price)
	else
		0
	end
end

// "mes" → "Mes"
macro cap(s)
	$(String.sub(s, 1).upper())$(String.sub(s, 2, -1))
end

lin: macro(a, b, sign, c, d, e, u, name:, ?trap)
	set sign = $ sign or ""

	// Sign: only "+" (a*b + c*d = e) and the bare product "" (a*b = e).
	// An empty sign means the bare product (the "hole" caller's "*" label).
	if sign != "+" and sign != ""
		return $invalid
	end
	if sign == "" and (c or d)
		return $invalid
	end

	// One coin type: the bare product, or the "+" with no second term.
	let oneProduct = $ sign == "" or (sign == "+" and not c and not d)

	// The trap (the piggy bank holding a drawn quantity of a second coin
	// type) only dresses a bare product: on the full equation there is no
	// second term to mention.
	if trap and not oneProduct
		return $invalid
	end

	// a, c coin counts; b, d coin values in euros; e the total, in euros.
	// Wide bounds (relaxed 2026-10: the situation accepts the caller's
	// drawn numbers — variety over realism).
	if (a and a.floor() != a) or (c and c.floor() != c)
		return $invalid
	end
	if (a and (a < 2 or a > 9999)) or (c and (c < 2 or c > 9999))
		return $invalid
	end
	if (b and (b <= 0 or b > 9999)) or (d and (d <= 0 or d > 9999))
		return $invalid
	end
	if not e or e < 0
		return $invalid
	end

	// The caller passes a consistent equation (the missing letter is its
	// computed solution): check it, rounded to the cent.
	let lhs = $ term(a, b) + term(c, d)
	if (lhs * 100).round() != (e * 100).round()
		return $invalid
	end

	// Which letters must be known for the question to be solvable
	// (one product: the c/d pairing accepts "both missing").
	if u == 1
		if not b or (c and not d) or (not c and d)
			return $invalid
		end
	elseif u == 2
		if not a or (c and not d) or (not c and d)
			return $invalid
		end
	elseif u == 3
		if not a or not b or not d
			return $invalid
		end
	elseif u == 4
		if not a or not b or not c
			return $invalid
		end
	elseif u == 5
		if not a or not b or (c and not d) or (not c and d)
			return $invalid
		end
	else
		return $invalid
	end

	// u = 1 or 3 asks "how many coins of value X" — with both values
	// displayed and equal, the two groups are indistinguishable.
	if (u == 1 or u == 3) and c and (b * 100).round() == (d * 100).round()
		return $invalid
	end

	// The speaker: 1st person when name is empty; otherwise the (name,
	// gender) pair — "Léa a", "elle a", "a-t-elle", "ses", "sa tirelire".
	let who = if name and name[1]
		do
			have: $name[1] a
			// after a colon (same as have: the name stays capitalized)
			haveLow: $name[1] a
			has: $ (name[2] == "f" and "elle a" or "il a")
			capPron: $ (name[2] == "f" and "Elle a" or "Il a")
			q: $ (name[2] == "f" and "a-t-elle" or "a-t-il")
			poss: ses
			tirelire: sa tirelire
		end
	else
		do
			have: J'ai
			// mid-sentence (lowercase j)
			haveLow: j'ai
			has: j'ai
			capPron: J'ai
			q: ai-je
			poss: mes
			tirelire: ma tirelire
		end
	end

	// The piggy bank's coin value (drawn when the trap is on) and coin
	// count (drawn too — the trap is quantified: the piggy bank holds a
	// given number of coins of a given value, never "plein de pièces"
	// without a count).
	let d2 = $ trap and trapValue(b)
	let c2 = 0
	let swap = 0
	if trap
		let seed = $ (a * 100).round() * 1000000000 + (b * 100).round() * 1000000 + (e * 100).round()
		let random = $Random($(seed))
		set c2 = $ random(2, 20)
		set swap = $ random(0, 1)
	end

	return if oneProduct
		if u == 1
			instruction: do
				if trap and swap == 1
					$(cap(who.tirelire)) contient $c2 pièces de $euros($d2) €, et $who.haveLow des pièces de $euros($b) €.\s
					$who.capPron $euros($e) € en pièces de $euros($b) €.\s
					Combien $who.q de pièces de $euros($b) € ?
				elseif trap
					$who.have des pièces de $euros($b) €, et $who.tirelire contient $c2 pièces de $euros($d2) €.\s
					$who.capPron $euros($e) € en pièces de $euros($b) €.\s
					Combien $who.q de pièces de $euros($b) € ?
				else
					$who.have des pièces de $euros($b) €, soit $euros($e) € au total.\s
					Combien $who.q de pièces ?
				end
			end
			answer: do
				if trap
					$who.have $a pièces de $euros($b) €.
				else
					$who.have $a pièces.
				end
			end
		elseif u == 2
			instruction: do
				if trap and swap == 1
					$(cap(who.tirelire)) contient $c2 pièces de $euros($d2) €, et $who.haveLow $a pièces.\s
					$(cap(who.poss)) $a pièces font $euros($e) €.\s
					Combien vaut chacune de $who.poss $a pièces ?
				elseif trap
					$who.have $a pièces, et $who.tirelire contient $c2 pièces de $euros($d2) €.\s
					$(cap(who.poss)) $a pièces font $euros($e) €.\s
					Combien vaut chacune de $who.poss $a pièces ?
				else
					$who.have $a pièces, soit $euros($e) € au total.\s
					Combien vaut une pièce ?
				end
			end
			answer: do
				if trap
					Chacune de $who.poss $a pièces vaut $euros($b) €.
				else
					Une pièce vaut $euros($b) €.
				end
			end
		elseif u == 5
			instruction: do
				if trap and swap == 1
					$(cap(who.tirelire)) contient $c2 pièces de $euros($d2) €, et $who.haveLow $a pièces de $euros($b) €.\s
					Combien d'argent $who.q en pièces de $euros($b) € ?
				elseif trap
					$who.have $a pièces de $euros($b) €, et $who.tirelire contient $c2 pièces de $euros($d2) €.\s
					Combien d'argent $who.q en pièces de $euros($b) € ?
				else
					$who.have $a pièces de $euros($b) €.\s
					Combien d'argent $who.q ?
				end
			end
			answer: do
				if trap
					$who.have $euros($e) € en pièces de $euros($b) €.
				else
					$who.have $euros($e) €.
				end
			end
		end
	else
		if u == 1
			instruction: do
				$who.have des pièces de $euros($b) € et $c pièces de $euros($d) €, soit $euros($e) € au total.\s
				Combien $who.q de pièces de $euros($b) € ?
			end
			answer: do
				$who.have $a pièces de $euros($b) €.
			end
		elseif u == 2
			instruction: do
				$who.have $a pièces et $c pièces de $euros($d) €, soit $euros($e) € au total.\s
				Combien vaut chacune de $who.poss $a pièces ?
			end
			answer: do
				Chacune de $who.poss $a pièces vaut $euros($b) €.
			end
		elseif u == 3
			instruction: do
				$who.have $a pièces de $euros($b) € et des pièces de $euros($d) €, soit $euros($e) € au total.\s
				Combien $who.q de pièces de $euros($d) € ?
			end
			answer: do
				$who.have $c pièces de $euros($d) €.
			end
		elseif u == 4
			instruction: do
				$who.have $a pièces de $euros($b) € et $c pièces, soit $euros($e) € au total.\s
				Combien vaut chacune de $who.poss $c pièces ?
			end
			answer: do
				Chacune de $who.poss $c pièces vaut $euros($d) €.
			end
		elseif u == 5
			instruction: do
				$who.have $a pièces de $euros($b) € et $c pièces de $euros($d) €.\s
				Combien d'argent $who.q ?
			end
			answer: do
				$who.have $euros($e) €.
			end
		end
	end

	// Fallback: every (sign, u) combination is handled or rejected above —
	// keep the explicit exit.
	return $invalid
end

// a = bq + r (euclidean division: a coins shared fairly in b pockets, q
// the coins per pocket, r the coins left over) or a = bd (decimal
// division: d the quotient — exact, or rounded to a tenth when ?aprx).
// The caller passes every value, the missing ones empty: d truthy tells
// the decimal story, d empty the euclidean one.
//
// The decimal story has two variants, chosen by ?alt (only when ?aprx is
// missing, which keeps the value story for a rounded quotient):
//   value  : a the euros paid, b the coins — "quelle est la valeur
//            d'une pièce ?"
//   weight : a the grams, b the coins — "quel est le poids d'une pièce ?"
// ?trap adds the other variant's datum (a total weight in the value
// story, a total amount in the weight story — deterministic, never a
// term of the equation a, b, d) so the statement reads like the other
// variant: the student must read the question posed. The two datums are
// presented in an alternating order (seeded by the equation).
// Returns a (instruction:, answer:) table, or the `invalid` table.

div: macro(a, b, q, r, d, name:, ?trap, ?aprx, ?alt)
	// The speaker: 1st person when name is empty; otherwise the (name,
	// gender) pair — the forms div needs have no person agreement
	// ("a payé", "elles pèsent"), only "veut" is gendered.
	let who = if name and name[1]
		do
			have: $name[1] a
			pay: $name[1] a payé
			// after a semicolon (same as pay: the name stays capitalized)
			payLow: $name[1] a payé
			want: $ (name[2] == "f" and "Elle veut" or "Il veut")
			poss: Ses
		end
	else
		do
			have: J'ai
			pay: J'ai payé
			// after a semicolon (lowercase j)
			payLow: j'ai payé
			want: Je veux
			poss: Mes
		end
	end

	// a and b are the two values the statement always shows: without
	// them there is no problem.
	if not a or not b
		return $invalid
	end

	if d
		// d is a coin value (value variant) or a weight per coin (weight
		// variant): 0 or less is not a division problem (it would also
		// slip past the equation check below, which aprx disables).
		if d <= 0
			return $invalid
		end
		// The statement shows a and b: the quotient d must satisfy a = bd
		// (checked to the cent, like lin). With aprx the caller passes a
		// quotient rounded to a tenth (recurring decimal) — no check.
		if not aprx and (b * d * 100).round() != (a * 100).round()
			return $invalid
		end
		// a = euros (value variant) or grams (weight variant): wide;
		// b = coin count (a handful): narrow.
		if a < 2 or a > 9999 or b < 2 or b > 20
			return $invalid
		end
		// b is a coin count in both variants: an integer ("4,5 pièces"
		// would be ill-formed).
		if b.floor() != b
			return $invalid
		end
		// The weight variant is the exact-quotient story: ?alt selects it,
		// ?aprx keeps the value story. (Not a same-named local: in a macro
		// body `let alt = $alt and …` shadows the parameter with itself.)
		let w = $ alt and not aprx
		// The trap's datum (the other variant's quantity) and the order of
		// the two datums (alternated — the student never learns the
		// relevant one is the first), seeded by the equation: the same
		// problem always tells the same story.
		let swap = 0
		let wgt = 0
		let mont = 0
		if trap
			let seed = $ (a * 100).round() * 1000000000 + (b * 100).round() * 1000000 + (d * 100).round()
			let random = $Random($(seed))
			set swap = $ random(0, 1)
			if w
				// weight variant: the distractor amount, 0,1 € per gram
				// (a plausible order — a real coin is worth about 0,1 €
				// per gram): M = 0,1·a. It must never equal a term of the
				// equation: M = d when b = 10, M = b when a = 10·b
				// (M = a never, a > 0).
				if b == 10 or a == 10 * b
					return $invalid
				end
				set mont = $ 0.1 * a
			else
				// value variant: the distractor weight, 8 g per coin
				// (a 2 € coin weighs 8,5 g): W = 8·b. It must never equal
				// a term of the equation: W = a when a = 8·b, W = d when
				// a = 8·b² (W = b never, b > 0).
				if a == 8 * b or a == 8 * b * b
					return $invalid
				end
				set wgt = $ 8 * b
			end
		end
		return if w
			instruction: do
				if trap
					if swap == 1
						$(who.poss) $b pièces pèsent $(exact(a)) g et valent $(euros(mont)) € au total.\s
						Quel est le poids d'une pièce ?
					else
						$(who.pay) $(euros(mont)) € en $b pièces de même valeur ; elles pèsent $(exact(a)) g.\s
						Quel est le poids d'une pièce ?
					end
				else
					$(who.poss) $b pièces pèsent $(exact(a)) g.\s
					Quel est le poids d'une pièce ?
				end
			end
			answer: do
				Une pièce pèse\s
				if aprx
					environ\s
				end
				$(exact(d)) g.
			end
		else
			instruction: do
				if trap
					if swap == 1
						$(who.poss) $b pièces pèsent $wgt g ; $(who.payLow) $(euros(a)) € en pièces de même valeur.\s
						Quelle est la valeur d'une pièce ?
					else
						$(who.pay) $(euros(a)) € en $b pièces de même valeur ; elles pèsent $wgt g.\s
						Quelle est la valeur d'une pièce ?
					end
				else
					$(who.pay) $(euros(a)) € en $b pièces de même valeur.\s
					Quelle est la valeur d'une pièce ?
				end
			end
			answer: do
				La valeur d'une pièce est
				if aprx
					\sd'environ $(exact(d)) €.
				else
					\sde $(exact(d)) €.
				end
			end
		end
	else
		// euclidean: the trap only exists in the decimal branch — it
		// gives the other variant's information to make the statement
		// read like it; the euclidean story has no second variant to
		// mimic.
		if trap
			return $invalid
		end
		// q and r are the answer(s): without them the problem has none
		// (the caller always passes them — q = a div b, r = a mod b).
		if not q or not r
			return $invalid
		end
		// Counts are integers where expected.
		if a.floor() != a or b.floor() != b or q.floor() != q or r.floor() != r
			return $invalid
		end
		// a = coins, b = pockets: a >= 10 (a repartition of 4 coins over
		// 2 pockets is a trivial split), a <= 20 (a handful), and 2..4
		// pockets (a person carries at most 4 pockets — a tirelire would
		// be a single container).
		if a < 10 or a > 20 or b < 2 or b > 4
			return $invalid
		end
		// q >= 2: at least 2 coins per pocket — with q < 2 the repartition
		// is degenerate and the "per pocket" question is meaningless.
		if q < 2
			return $invalid
		end
		// Euclidean division: a = bq + r with 0 <= r < b — with r >= b the
		// repartition is not maximal and the question admits another answer.
		if a != b * q + r or r < 0 or r >= b
			return $invalid
		end
		return do
			instruction: do
				$(who.have) $a pièces. $(who.want) les répartir équitablement en $b poches ;\s
				if alt
					combien y aura-t-il de pièces par poche ?
				else
					combien de pièces ne pourront pas être mises dans une poche ?
				end
			end
			answer: do
				if alt
					Il y aura $q pièces par poche
					if r > 0
						\s(mais il en restera\s
						if r == 1
							1 non répartie).
						else
							$r non réparties).
						end
					else
						.
					end
				else
					if r > 0
						Il y aura\s
						if r == 1
							1 pièce non répartie.
						else
							$r pièces non réparties.
						end
					else
						Toutes les pièces seront réparties.
					end
				end
			end
		end
	end

	// Fallback: both branches return above — keep the explicit exit.
	return $invalid
end
