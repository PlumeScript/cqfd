let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)

...import(./calc)

/*
Invert a $code(Problem), the equation with its solution is shown, the answer is a statement.
*/
inv: macro(pb)
	@QuestionFactory
		parameters: $Table($pb)
		get: macro(pb)
			// legacy
			if pb.renderClass != "problem"
				@Question(invPb)
					src: $pb
				end
			else
				@Question(problemInv)
					src: $pb
					id: $pb.id
				end
			end
		end
	end
end