let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Range, Decimal from $import(../../core/parameters/range)
let Choice from $import(../../core/parameters/set)
let Node from $import(../../core/utils/tree)
let pool = $Table()

let boulangerie = $import(./situations/boulangerie)

/*
Generate a problem from an hole exercices
*/
hole: macro(calc, ?trap)
	@QuestionFactory
		parameters: do
			- $calc
		end
		get: macro(calc)
			let a, b, sign, c, d, e, u

			if calc.instruction.label == "-" or calc.instruction.label == "+"
				set a = $calc.instruction.children[1]
				set b = $empty
				set c = $calc.instruction.children[2]
				set d = $empty
				set e = $calc.target
				set sign = $calc.instruction.label
			elseif calc.instruction.label == "*"
				set a = $calc.instruction.children[1]
				set b = $calc.instruction.children[2]
				set c = $empty
				set d = $empty
				set e = $calc.target
			end

			if a == "..."
				set a = $calc.solution
				set u = 1
			elseif b == "..."
				set b = $calc.solution
				set u = 2
			elseif c == "..."
				set c = $calc.solution
				set u = 3
			elseif d == "..."
				set d = $calc.solution
				set u = 4
			elseif e == "..."
				set e = $calc.solution
				set u = 5
			end

			let context = $ boulangerie.lin(a, b, sign, c, d, e, u, trap: trap)
			if context.invalid?
				return
			end

			return @Question(problem)
				instruction: $context.instruction
				step: $calc.solutionCalc
				solution: $calc.solution
				answer: $context.answer
				id: $calc.id
			end
		end
	end
end

/*
Generate a problem from an addSub exercices
*/
addSub1: macro(calc, ?trap)
	@QuestionFactory
		parameters: do
			- $calc
		end
		get: macro(calc)
			let a, b, sign, c, d, e, u

			if calc.instruction.label == "-" or calc.instruction.label == "+"
				set a = $calc.instruction.children[1]
				set b = $empty
				set c = $calc.instruction.children[2]
				set d = $empty
				set sign = $calc.instruction.label
			elseif calc.instruction.label == "*"
				set a = $calc.instruction.children[1]
				set b = $calc.instruction.children[2]
				set c = $empty
				set d = $empty
			else
				raise Unsuported label $calc.instruction.label
			end

			set e = $calc.solution
			set u = 5

			let context = $ boulangerie.lin(a, b, sign, c, d, e, u, trap: trap)
			if context.invalid?
				return
			end

			return @Question(problem)
				instruction: $context.instruction
				step: $calc.instruction
				solution: $calc.solution
				answer: $context.answer
				id: $calc.id
			end
		end
	end
end

/*
Generate a problem from two mul exercices
*/
add2Mul: macro(calc, ?trap)
	@QuestionFactory
		parameters: do
			- $calc
			- $calc
			- $Range(5, 5) // Todo: handle Range(1, 5)
		end
		get: macro(calc1, calc2, u)
			let a, b, sign, c, d, e

			
			set a = $calc1.instruction.children[1]
			set b = $calc1.instruction.children[2]
			set c = $calc2.instruction.children[1]
			set d = $calc2.instruction.children[2]

			set e = $ calc1.solution+calc2.solution
			if e<0
				set e *= -1
				set a, b, c, d = ($c, $d, $a, $b)
			end

			let context = $ boulangerie.lin(a, b, "+", c, d, e, u, trap: trap)
			if context.invalid?
				return
			end

			return @Question(problem)
				instruction: $context.instruction
				step: @Node(+)
					- $calc1.instruction
					- $calc2.instruction
				end
				solution: $e
				answer: $context.answer
				id: $calc1.id + $calc2.id
			end
		end
	end
end

/*
Generate a problem from one mul exercices and one number 
*/
addsubMulInt: macro(mul, Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, ?trap)
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $mul
			- $Range(5, 5) // Todo: handle Range(1, 5)
			- $Range(1, 100)
			- $Choice(+, -)
		end
		get: macro(n, calc, u, s, opp)
			let a, b, sign, c, d, e
			
			set a = $n
			set c = $calc.instruction.children[1]
			set d = $calc.instruction.children[2]

			set e = if opp=="+"
				$ n+calc.solution
			else
				$ n-calc.solution
			end
			if e<0
				return
			end

			let context = $ boulangerie.lin(a, b, opp, c, d, e, u, trap: trap)
			if context.invalid?
				return
			end

			return @Question(problem)
				instruction: $context.instruction
				step: @Node($opp)
					- $n
					- $calc.instruction
				end
				solution: $e
				answer: $context.answer
				id: $n $opp $calc.id
			end
		end
	end
end