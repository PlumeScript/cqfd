	- $code(classic (a\, b\, c...))
	- $code(fun (🌻\, 🍎\, 🍌...))
	- $code(length (AC\, FD\, ...))
	- $code(angle (hat(BAC)\, hat(ZFD)\, ...))
end
]end

...import(./reduce)
