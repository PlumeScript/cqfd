let Choice from $import(../../core/parameters/set)
let Range from $import(../../core/parameters/range)
let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let PermFromRank from $import(../../core/utils/walkers)

let figuresParam = $Range(1, 9)

// TODO-FIX: for now, 2000 is treated as "zero hole"
// TODO: permutation in render, shouldn't always be in ascending order.
enigmaSimple: macro(Number minIndex:-3, Number maxIndex:3, Number minFigures: 2, Number maxFigures: 3, figures:, Number minHole: 0, maxHole:, hole:)
	if figures
		set minFigures = $figures
		set maxFigures = $figures
	end
	if hole
		set minHole = $hole
		set maxHole = $hole
	end
	if not maxHole
		set maxHole = $ maxFigures-2
	end

	@QuestionFactory
		parameters: do
			start:     $ Range(minIndex, maxIndex)
			length:    $ Range(minFigures, maxFigures)
			hole:      $ Range(minHole, maxHole)
		end
		hyperParameters: do
			permuHole: $ Range(minFigures, maxFigures)
			for i in seq(maxFigures)
				- $figuresParam
			end
		end
		validate: macro(start:, length:, hole:, permuHole:, ...figures)
			return $ (start+length) <= maxIndex
		end

		type: decimalEgnimaSimple
		get: macro(start:, length:, hole:, permuHole:, ...rawFigures)
			set length += $hole
			let baseFigures = do
				for i in seq(hole)
					- 0
				end
				for i in seq(length-hole-2)
					- $rawFigures[i]
				end
			end

			let permu = $ PermFromRank(length-2, permuHole)

			let figures = do
				- $rawFigures[length-hole-1]
				for i in permu
					- $baseFigures[i+1]
				end
				- $rawFigures[length-hole]
			end

			let solution=0
			for i in seq(length)
				set solution += $ figures[i] * 10^(i+start)
			end
			@Question(decimalEnigmaSimple)
				instruction: $ Table(firstIndex: start, length: length, figures: figures, hole: hole)
				solution: $solution
				id: $start-$length
			end
		end
	end
end

// TODO: handle minIndex
enigmaCalc2: macro(Number minIndex:-3, Number maxIndex:3, Number minSolutions: 1 , Number maxSolutions: 1, solutions:, Number minFigures: 2, Number maxFigures: 2, figures:, calc:, Number minInterval: 10)
	
	if solutions
		set minSolutions = $solutions
		set maxSolutions = $solutions
	end
	if figures
		set minFigures = $figures
		set maxFigures = $figures
	end
	if not calc
		set calc = $Table(+, -, *, /)
	end

	@QuestionFactory
		parameters: do
			start:     $ Range(minIndex, maxIndex)
			length:    $ Range(minFigures, maxFigures)
			solutions: $ Range(minSolutions, maxSolutions)
			calc:      $ Choice(...calc)
			target:    $ Range(1, 9)
		end
		validate: macro(start:, length:, solutions:, calc:, target:)
			$ calc=="*" or calc=="+" or length==2
		end

		get: macro(start:, length:, solutions:, calc:, target:)
			let solutionsTable = $Table((value:, vect: $Table()))

			for i in seq(length)
				set solutionsTable = for solution in solutionsTable
					for j in seq(0, 9)
						if j != 0 or calc != "/"
							- do
								value: if calc == "+"
									$ (solution.value? or 0) + j
								elseif calc == "*"
									$ (solution.value? or 1) * j
								elseif calc == "-"
									if solution.value?
										$ max(j - solution.value, solution.value - j)
									else
										$j
									end
								elseif calc == "/"
									if solution.value?
										$ max(j / solution.value, solution.value / j)
									else
										$j
									end
								end
								vect: ($j, ...solution.vect)
							end
						end
					end
				end
				set solutionsTable = for solution in solutionsTable
					if (calc != "+" and calc != "*") or solution.value <= target
						- $solution
					end
				end
			end
			set solutionsTable = for solution in solutionsTable
				if solution.value == target and (calc != "-" or solution.vect[1] != 0)
					- $solution
				end
			end

			if len(solutionsTable) < minSolutions
				return
			end

			set solutionsTable = for solution in solutionsTable
				- $ Number(Table.join(...solution.vect))
			end

			run $ Table.sort(solutionsTable)
			
			
			let bottom = $ (Table.at(solutionsTable, 1)/10).floor()*10
			let top    = $ (Table.at(solutionsTable, -1)/10).ceil()*10

			// shrink down to maxSolutions, never below a window of minInterval
			while len(solutionsTable) > maxSolutions
				if len(solutionsTable) % 2 == 0
					if (Table.at(solutionsTable, -1) - 1 - bottom) >= minInterval
						set top = $ Table.remove(solutionsTable)-1
					elseif (top - (Table.at(solutionsTable, 1) + 1)) >= minInterval
						set bottom = $ Table.remove(solutionsTable, 1)+1
					else
						break
					end
				else
					if (top - (Table.at(solutionsTable, 1) + 1)) >= minInterval
						set bottom = $ Table.remove(solutionsTable, 1)+1
					elseif (Table.at(solutionsTable, -1) - 1 - bottom) >= minInterval
						set top = $ Table.remove(solutionsTable)-1
					else
						break
					end
				end
			end

			// the window cannot shrink further while keeping minInterval
			if len(solutionsTable) > maxSolutions
				return $empty
			end

			// exclusive window: no solution may sit on a bound
			let minSol = $ Table.at(solutionsTable, 1)
			let maxSol = $ Table.at(solutionsTable, -1)
			if bottom >= minSol
				set bottom = $ (minSol/10).floor()*10
				if bottom >= minSol
					set bottom = $(bottom - 10)
				end
			end
			if top <= maxSol
				set top = $ (maxSol/10).ceil()*10
				if top <= maxSol
					set top = $(top + 10)
				end
			end

			return @Question(decimalEnigmaCalc2)
				instruction: $Table(calc: $calc, target: $target, top: $top, bottom: $bottom)
				solution: $solutionsTable
			end
		end
	end

end