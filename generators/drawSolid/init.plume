// Low quality exercice

let Range from $import(../../core/parameters/range)
let Choice from $import(../../core/parameters/set)
let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)

/*
Generate a cube to draw.
*/
Cube: macro
	@QuestionFactory
		parameters: do
			- $Range(1, 1)
		end
		hyperParameters: do
			- $ Range(1, 20)
			- $ Range(1, 20)
			- $ Choice(0, 1)
			- $ Choice(0, 1)
		end

		get: macro(_, wr, hr, fromBottom, fromRight)
			@Question(drawCube)
				instructions: (wr: $wr, hr:$hr, fromBottom: $(fromBottom==1), fromRight: $(fromRight==1))
			end
		end
	end
end


/*
Generate a cuboid to draw.
*/
Cuboid: macro
	@QuestionFactory
		parameters: do
			- $Range(1, 1)
		end
		hyperParameters: do
			- $ Range(1, 20)
			- $ Range(1, 20)
			- $ Choice(0, 1)
			- $ Choice(0, 1)
		end

		get: macro(_, wr, hr, fromBottom, fromRight)
			@Question(drawCuboid)
				instructions: (wr: $wr, hr:$hr, fromBottom: $(fromBottom==1), fromRight: $(fromRight==1))
			end
		end
	end
end

/*
Generate a cone to draw.
*/
Cone: macro(?cube)
	@QuestionFactory
		parameters: do
			- $Range(1, 1)
		end

		get: macro(_)
			$Question(drawCone)
		end
	end
end

/*
Generate a cylinder to draw.
*/
Cylinder: macro(?cube)
	@QuestionFactory
		parameters: do
			- $Range(1, 1)
		end

		get: macro(_)
			$Question(drawCylinder)
		end
	end
end

/*
Generate a rectangular pyramid to draw.
*/
RectPyramid: macro(?cube)
	@QuestionFactory
		parameters: do
			- $Range(1, 1)
		end

		get: macro(_)
			$Question(drawRectPyramid)
		end
	end
end