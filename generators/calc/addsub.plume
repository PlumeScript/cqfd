let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Node from $import(../../core/utils/tree)
let Choice from $import(../../core/parameters/set)
let Range, Decimal from $import(../../core/parameters/range)
let DecimalRepresentation, getCompute from $import(./utils)

ref addN2: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:, maxCompute:, compute:)
	if figures
		set minFigures = $figures
		set maxFigures = $figures
	end
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		type: astNumber
		get: macro(x, y)
			let realCompute = $ getCompute.add(x, y)

			if (minCompute and minCompute > realCompute) or (maxCompute and maxCompute < realCompute)
				return
			end

			return @Question(calcul)
				instruction: $ Node("+", x, y)
				solution: $(x+y)
				id: $max($x, $y)+$min($x, $y)
				compute: $realCompute
			end
		end
	end
end

ref subN2: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:, maxCompute:, compute:)
	if figures
		set minFigures = $figures
		set maxFigures = $figures
	end
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		type: astNumber
		get: macro(x, y)
			let realCompute = $ getCompute.sub(x, y)

			if (minCompute and minCompute > realCompute) or (maxCompute and maxCompute < realCompute)
				return
			end

			return @Question(calcul)
				instruction: $ Node("-", x, y)
				solution: $(x-y)
				id: $x-$y
				compute: $realCompute
			end
		end
	end
end


macro makeZ(A, B, C, signA, signB, bigger)
	if bigger=="A" and A<B or bigger=="B" and A>B
		set A, B = ($B, $A)
	end

	if signA == "-"
		set A = $Node(-, $A)
	end
	if signB == "-"
		set B = $Node(-, $B)
	end
	if ((bigger=="A" and signA == "-" or bigger=="B" and signB == "-") and C>0) or ((bigger=="A" and signA == "+" or bigger=="B" and signB == "+") and C<0)
		set C = $ -1 * C
	end
	return $ (A, B, C)
end

ref addZ2Plus: macro(?fullSign, ...args)
	@QuestionFactory
		parameters: do
			signA: $Choice(+, -)
			bigger: $Choice(A, B)
		end

		hyperParameters: do
			calc: $ addN2(...args)
		end

		get: macro(signA:, bigger:, calc:)
			let A = $calc.instruction.children[1]
			let B = $calc.instruction.children[2]
			let C = $calc.solution

			let signB = if signA == "+"
				+
			else
				\0-
			end

			set A, B, C = $ makeZ(A, B, C, signA, signB, bigger)
			let instr = $Node(+, $A, $B)
			// fullSign rides on the sum node: the renderer prints every term
			// with an explicit sign, ex: (+5)+(-3)
			if fullSign
				set instr.fullSign = 1
			end

			@Question(calcul)
				instruction: $instr
				solution: $C
				id: $signA$signB$bigger$calc.id
				compute: $calc.compute
			end
		end
	end
end

ref addZ2Minus: macro(?fullSign, ...args)
	@QuestionFactory
		parameters: do
			signA: $Choice(+, -)
			bigger: $Choice(A, B)
			
		end

		hyperParameters: do
			calc: $ subN2(...args)
		end

		get: macro(signA:, bigger:, calc:)
			let A = $calc.instruction.children[1]
			let B = $calc.instruction.children[2]
			let C = $calc.solution

			let signB = if signA == "+"
				\0-
			else
				+
			end

			set A, B, C = $ makeZ(A, B, C, signA, signB, bigger)
			let instr = $Node(+, $A, $B)
			// fullSign rides on the sum node: the renderer prints every term
			// with an explicit sign, ex: (+5)+(-3)
			if fullSign
				set instr.fullSign = 1
			end

			@Question(calcul)
				instruction: $instr
				solution: $C
				id: $signA$signB$bigger$calc.id
				compute: $calc.compute
			end
		end
	end
end

ref addZ2: macro(...args)
	$ addZ2Plus(...args) * addZ2Minus(...args)
end

subZ2: macro(?fullSign, ...args)
	@QuestionFactory
		parameters: $Table($addZ2(...args))
		get: macro(calc)
			let A = $calc.instruction.children[1]
			let B = $calc.instruction.children[2]

			if type(B) == "table" and B.label? == "-"
				set B = $B.children[1]
			else
				set B = $Node(-, $B)
			end
			let instr = $Node(-, $A, $B)
			if fullSign
				set instr.fullSign = 1
			end

			@Question(calcul)
				instruction: $instr
				solution: $calc.solution
				id: -$calc.id
				compute: $calc.compute
			end
		end
	end
end