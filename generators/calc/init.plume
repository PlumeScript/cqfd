...import(./holes)
...import(./addsub)
...import(./muldiv)
...import(./pow)
...import(./sqrt)
...import(./rationnals)
...import(./problem)
...import(./compose)

commondoc: raw[
@InfosList
	- $code(compute) is a raw estimation of time difficulty for a student to do the compute.$newline Can be set by $code(compute), $code(minCompute), $code(maxCompute).
	- $code(\0?fullSign) is used to show (+5)+(-3) instead of 5+(-3)
end
]end

situations: for file in os.Path("./situations").getChildren()
	let all
	if file.getExtension() == "plume"
		let imp = $file.import()
		$(file.getStem()): for k, v in items(imp)
			$k: $v
			if all
				set all += $v
			else
				set all = $v
			end
			all: $all
		end
	end
end