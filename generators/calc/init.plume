...import(./holes)
...import(./addsub)
...import(./muldiv)
...import(./pow)
...import(./problem)


situations: for file in os.Path("./situations").getChildren()
	let all
	if file.getExtension() == "plume"
		let imp = $file.import()
		$(file.getStem()): for k, v in items(imp)
			$k: $v
			if all
				set all += $v
			else
				set all = $v
			end
			all: $all
		end
	end
end