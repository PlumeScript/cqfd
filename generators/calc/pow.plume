let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Node from $import(../../core/utils/tree)
let Choice from $import(../../core/parameters/set)
let Range, Decimal from $import(../../core/parameters/range)
let DecimalRepresentation, getCompute from $import(./utils)

ref powN2: macro(Number minIndex:0, Number maxIndex:0, Number minFigures: 1, Number maxFigures: 1, figures:, minCompute:, maxCompute:, compute:, Number minExposant: 0, Number maxExposant: 3, ?negativeExposant)
	if figures
		set minFigures = $figures
		set maxFigures = $figures
	end
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end

	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Range(minExposant, maxExposant)
		end
		validate: macro(x, y)
			if not minCompute and not maxCompute
				return $true
			end

			if negativeExposant
				if x != 1 and x != 2 and x!= 4 and x!= 5 and x!= 8 and x!= 10 and x!= 16 and x!= 20
					return $false
				end
			end

			// Wrong value for y<0
			let realCompute = $ getCompute.pow(x, y)

			if negativeExposant
				// dirty heuristic
				set realCompute *= 2
			end

			return $ (not minCompute or minCompute <= realCompute) and (not maxCompute or maxCompute >= realCompute)
		end
		get: macro(x, y)
			@Question(calcul)
				instruction: if negativeExposant
					$Node(^, $x, $Node(-, $y))
				else
					$Node(^, $x, $y)
				end
				solution: if negativeExposant
					$(x^(-y))
				else
					$(x^y)
				end
				id: $x^$y
			end
		end
	end
end

powZ2: macro(...args)
	@QuestionFactory
		parameters: $Table($powN2(...args))
		get: macro(calc)
			let x = $calc.instruction.children[1]
			let y = $calc.instruction.children[2]
			if type(y) == "table" and y.label == "-"
				set y = $ -1 * y.children[1]
			end
			@Question(calcul)
				instruction: $ Node("^", Node("-", x), y)
				solution: $((-x)^y)
				id: -$x^$y
			end
		end
	end
end

powDivN2: macro(minDelta:1, maxDelta: 10, ?frac, ?negativeExposant, ...args)
	@QuestionFactory
		parameters: do
			- $ powN2(negativeExposant: negativeExposant, ...args)
			- $ Range(minDelta, maxDelta)
		end

		get: macro(calc, delta)
			let opp = if frac
				/
			else
				\0-:
			end


			let x = $calc.instruction.children[1]
			let y = $calc.instruction.children[2]

			@Question(calcul)
				instruction: @Node($opp)
					if negativeExposant
						- @Node(^)
							- $x
							- $delta
						end
						- @Node(^)
							- $x
							- $(y.children[1]+delta)
						end
					else
						- @Node(^)
							- $x
							- $(y+delta)
						end
						- @Node(^)
							- $x
							- $delta
						end
						
					end
				end
				solution: $calc.solution
				id: $delta-$calc.id-direction
			end
		end
	end
end

powPowN2: macro(...args)
	@QuestionFactory
		parameters: do
			- $ powN2(...args)
		end
		get: macro(calc)
			let d
			let x = $calc.instruction.children[1]
			let y = $calc.instruction.children[2]
			for i in seq(2, y-1)
				if y%i==0
					set d = $i
					break
				end
			end
			if not d
				return
			end

			return @Question(calcul)
				instruction: $Node(^, $Node(^, $x, $d), $(y/d))
				solution: $calc.solution
				id: $x^$d^$(y/d)
			end
		end
	end
end