let Question from $import(../../../core/cls/question)
let QuestionFactory from $import(../../../core/cls/questionFactory)
let Range from $import(../../../core/parameters/range)
let Choice from $import(../../../core/parameters/set)

macro cap(x)
	$x.sub(1).upper()$x.sub(2, -1)
end

money: @QuestionFactory
	parameters: do
		lose: $Choice(dépensé, donné)
		get: $Choice(reçu, gagné)
	end
	hyperParameters: do
		- $Range(5, 50)
		- $Range(5, 50)
	end
	get: macro(x, y, lose:, get:)
		@Question(pbParameters)
			values: do
				x: $x
				y: $y
			end
			unit: €
			sentence: do
				lose: macro(name, x, unit, introduced) $cap($name.have) $lose $x $unit.
				qlose: macro(name) Combien $name.qhave $lose?
				get: macro(name, x, unit, introduced) $cap($name.have) $get $x $unit.
				qget: macro(name) Combien $name.qhave $get?
				total: macro(name, x, unit) $cap($name.have) $x $unit maintenant.
				qtotal: macro(name) Combien $name.qhave maintenant?
				now: macro(name, x, unit) Maintenant, $name.have $x $unit.
				start: macro(name, x, unit) $cap($name.had) $x $unit.
				qstart: macro(name) Combien $name.qhad\0?
			end
		end
	end
end

food: @QuestionFactory
	parameters: do
		food: $Choice(pommes, bonbons, gâteaux, carottes)
		get: $Choice(acheté)
	end
	hyperParameters: do
		- $Range(8, 12)
		- $Range(8, 12)
	end
	get: macro(x, y, food:, get:)
		@Question(pbParameters)
			values: do
				x: $x
				y: $y
			end
			unit: $food
			sentence: do
				// introduced: noun already stated (start sentence) -> "en" form
				lose: macro(name, x, unit, introduced)
					if introduced
						$cap($name.haveEn) mangé $x.
					else
						$cap($name.have) mangé $x $unit.
					end
				end
				qlose: macro(name) Combien en $name.qhad mangé?
				get: macro(name, x, unit, introduced)
					if introduced
						$cap($name.haveEn) $get $x.
					else
						$cap($name.have) $get $x $unit.
					end
				end
				qget: macro(name) Combien en $name.qhad $get?
				total: macro(name, x, unit) $cap($name.have) $x $unit maintenant.
				qtotal: macro(name) Combien en $name.qhave maintenant?
				now: macro(name, x, unit) Maintenant, $name.haveEn $x.
				start: macro(name, x, unit) $cap($name.had) $x $unit.
				qstart: macro(name) Combien en $name.qhad\0?
			end
		end
	end
end