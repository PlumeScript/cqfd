// Repair shop: things repaired (gain) or broken (loss)
fix: @QuestionFactory
	parameters: do
		thing: $Choice(photocopieuses, ampoules, lampadaires, voitures, fusées)
		lose: $Choice(cassé)
		get: $Choice(réparé)
	end
	hyperParameters: do
		- $Range(2, 9)
		- $Range(2, 9)
	end
	get: macro(x, y, thing:, lose:, get:)
		let unit = $thing
		@Question(pbParameters)
			values: do
				x: $x
				y: $y
			end
			unit: $unit
			sentence: $foodSentences($unit, lose: $lose, get: $get)
		end
	end
end
