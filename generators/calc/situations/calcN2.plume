let Question from $import(../../../core/cls/question)
let QuestionFactory from $import(../../../core/cls/questionFactory)
let Range from $import(../../../core/parameters/range)
let Choice from $import(../../../core/parameters/set)

macro cap(x)
	$x.sub(1).upper()$x.sub(2, -1)
	end

// Baker: money on arrival, money spent at the bakery, money left on exit;
// the known pair is (spent, left) with isLoss, or (market, day total)
// without; trap = unit price.
boulangerie: @QuestionFactory
	parameters: do
		item: @Choice
			- du pain
			- des gâteaux
			- des pâtisseries
			- des viennoiseries
		end
	end
	hyperParameters: do
		initial: $Range(20, 50)
		spent: $Range(5, 10)
	end

	get: macro(item:, initial:, spent:)
		@Question(pbParameters)
			values: do
				x: $initial
				y: $spent
			end
			renderInstructions: macro(name, isLoss, unknow, trap, m)
				set trap = if trap
					\sà $m($(spent/10))€ l'unité
				end
				if isLoss
					if unknow == "x"
						A la boulangerie, $name.haveFirst dépensé $m($spent)€ pour acheter $item$trap
						. Vu qu'il $name.indirect restait $m($(initial - spent))€ en sortant, combien $name.qhad en arrivant?
					elseif unknow == "y"
						$cap($name.arrived) à la boulangerie avec $m($initial)€. Après avoir acheté $item$trap
						, il $name.indirect reste $m($(initial - spent))€. Combien $name.qhave dépensé?
					elseif unknow == "z"
						$cap($name.arrived) à la boulangerie avec $m($initial)€. $cap($name.have) dépensé $m($spent)€ pour acheter $item$trap. Combien $name.indirect reste-t-il?
					end
				else
					if unknow == "x"
						A la boulangerie, $name.haveFirst dépensé $m($spent)€ pour acheter $item$trap. $cap($name.name) $name.alsoWent au marché. En tout, $name.have dépensé $m($(initial + spent))€ aujourd'hui. Combien $name.qhad dépensé au marché?
					elseif unknow == "y"
						$cap($name.haveFirst) dépensé $m($initial)€ au marché, puis $name.went à la boulangerie pour acheter $item$trap. En tout, $name.have dépensé $m($(initial + spent))€ aujourd'hui. Combien $name.qhave dépensé à la boulangerie?
					elseif unknow == "z"
						$cap($name.haveFirst) dépensé $m($initial)€ au marché, puis dépensé $m($spent)€ à la boulangerie pour acheter $item$trap. En tout, combien $name.qhave dépensé?
					end
				end
			end
			renderSolution: macro(name, isLoss, unknow, m)
				if isLoss
					if unknow == "x"
						$cap($name.hadFirst) $m($initial)€ en arrivant.
					elseif unknow == "y"
						$cap($name.haveFirst) dépensé $m($spent)€.
					elseif unknow == "z"
						Il $name.indirect reste $m($(initial-spent))€.
					end
				else
					if unknow == "x"
						$cap($name.hadFirst) dépensé $m($initial)€ au marché.
					elseif unknow == "y"
						$cap($name.haveFirst) dépensé $m($spent)€ à la boulangerie.
					elseif unknow == "z"
						En tout, $name.haveFirst dépensé $m($(initial+spent))€.
					end
				end
			end
		end
	end
end

// Repairman: fleet initially working, breakages (loss) or repairs (gain);
// trap = total company fleet, useless for the answer.
reparateur: @QuestionFactory
	parameters: do
		item: @Choice
			- des photocopieuses
			- des imprimantes
			- des lampadaires
			- des téléviseurs
		end
	end
	hyperParameters: do
		initial: $Range(20, 50)
		delta: $Range(5, 12)
	end

	get: macro(item:, initial:, delta:)
		let noun = if item == "des photocopieuses"
			photocopieuses
		elseif item == "des imprimantes"
			imprimantes
		elseif item == "des lampadaires"
			lampadaires
		else
			téléviseurs
		end
		let rest = $(initial - delta)
		let now = $(initial + delta)
		let total = $(initial + delta + 5)
		@Question(pbParameters)
			values: do
				x: $initial
				y: $delta
			end
			renderInstructions: macro(name, isLoss, unknow, trap, m)
				set trap = if trap
					\sL'entreprise possède $m($total) $noun.
				end
				if isLoss
					if unknow == "x"
						$cap($name.nameFirst) répare $item.$trap Suite à une nouvelle panne, $m($delta) ne fonctionnent plus : il n'en reste que $m($rest) en fonctionnement. Combien fonctionnaient avant la panne?
					elseif unknow == "y"
						$cap($name.nameFirst) répare $item.$trap Il y en avait $m($initial) en fonctionnement, mais suite à des pannes, il n'en reste que $m($rest). Combien de $noun ne fonctionnent plus?
					elseif unknow == "z"
						$cap($name.nameFirst) répare $item.$trap Il y en avait $m($initial) en fonctionnement, mais $m($delta) viennent de tomber en panne. Combien fonctionnent encore?
					end
				else
					if unknow == "x"
						$cap($name.nameFirst) répare $item.$trap $cap($name.haveEn) réparé $m($delta) : il y en a maintenant $m($now) en fonctionnement. Combien fonctionnaient avant les réparations?
					elseif unknow == "y"
						$cap($name.nameFirst) répare $item.$trap Il y en avait $m($initial) en fonctionnement et il y en a maintenant $m($now). Combien de $noun $name.qhave réparé?
					elseif unknow == "z"
						$cap($name.nameFirst) répare $item.$trap Il y en avait $m($initial) en fonctionnement et $name.haveEn réparé $m($delta). Combien fonctionnent maintenant?
					end
				end
			end
			renderSolution: macro(name, isLoss, unknow, m)
				if isLoss
					if unknow == "x"
						Au départ, il y avait $m($initial) $noun en fonctionnement.
					elseif unknow == "y"
						$m($delta) $noun ne fonctionnent plus.
					elseif unknow == "z"
						Il reste $m($rest) $noun en fonctionnement.
					end
				else
					if unknow == "x"
						Au départ, il y avait $m($initial) $noun en fonctionnement.
					elseif unknow == "y"
						$cap($name.have) réparé $m($delta) $noun.
					elseif unknow == "z"
						Il y a maintenant $m($now) $noun en fonctionnement.
					end
				end
			end
		end
	end
end

// Magical animal breeder: herd in the stud, sales (loss) or births (gain);
// trap = number of meadows.
licorne: @QuestionFactory
	parameters: do
		animal: @Choice
			- des licornes
			- des pégases
			- des griffons
		end
	end
	hyperParameters: do
		initial: $Range(15, 40)
		delta: $Range(2, 10)
		meadows: $Range(2, 6)
	end

	get: macro(animal:, initial:, delta:, meadows:)
		let noun = if animal == "des licornes"
			licornes
		elseif animal == "des pégases"
			pégases
		else
			griffons
		end
		let born = if animal == "des licornes"
			nées
		else
			nés
		end
		let rest = $(initial - delta)
		let now = $(initial + delta)
		@Question(pbParameters)
			values: do
				x: $initial
				y: $delta
			end
			renderInstructions: macro(name, isLoss, unknow, trap, m)
				let introSimple = if name.name == "je"
					J'élève $animal.
				else
					$cap($name.nameFirst) élève $animal.
				end
				let introTrap = if name.name == "je"
					Je possède $m($meadows) prés dans lesquels j'élève $animal.
				else
					$cap($name.nameFirst) possède $m($meadows) prés dans lesquels $name.name élève $animal.
				end
				let intro = if trap
					$introTrap
				else
					$introSimple
				end
				if isLoss
					if unknow == "x"
						$intro $m($delta) ont quitté le haras : il en reste $m($rest). Combien de $noun y avait-il dans le haras au départ?
					elseif unknow == "y"
						$intro Il y en avait $m($initial) dans le haras, mais il n'en reste que $m($rest). Combien de $noun ont quitté le haras?
					elseif unknow == "z"
						$intro Il y en avait $m($initial) dans le haras, mais $m($delta) ont quitté. Combien de $noun restent dans le haras?
					end
				else
					if unknow == "x"
						$intro $m($delta) sont $born : il y en a maintenant $m($now) dans le haras. Combien de $noun y avait-il dans le haras au départ?
					elseif unknow == "y"
						$intro Il y a $m($initial) $noun dans le haras et il y en a maintenant $m($now). Combien de $noun sont $born?
					elseif unknow == "z"
						$intro Il y a $m($initial) $noun dans le haras et $m($delta) sont $born. Combien de $noun y a-t-il maintenant?
					end
				end
			end
			renderSolution: macro(name, isLoss, unknow, m)
				if isLoss
					if unknow == "x"
						Au départ, il y avait $m($initial) $noun dans le haras.
					elseif unknow == "y"
						$m($delta) $noun ont quitté le haras.
					elseif unknow == "z"
						Il reste $m($rest) $noun dans le haras.
					end
				else
					if unknow == "x"
						Au départ, il y avait $m($initial) $noun dans le haras.
					elseif unknow == "y"
						$m($delta) $noun sont $born.
					elseif unknow == "z"
						Il y a maintenant $m($now) $noun dans le haras.
					end
				end
			end
		end
	end
end

// Literature doctor: collection of a minor country's literature,
// sales (loss) or purchases (gain); trap = books per box.
litterature: @QuestionFactory
	parameters: do
		country: @Choice
			- tchèque
			- polonaise
			- roumaine
			- hongroise
			- finlandaise
			- danoise
		end
		century: @Choice
			- IXe
			- Xe
			- XIe
			- XIIe
			- XIIIe
			- XIVe
		end
	end
	hyperParameters: do
		initial: $Range(15, 60)
		delta: $Range(4, 12)
		perBox: $Range(4, 10)
	end

	get: macro(country:, century:, initial:, delta:, perBox:)
		let rest = $(initial - delta)
		let now = $(initial + delta)
		@Question(pbParameters)
			values: do
				x: $initial
				y: $delta
			end
			renderInstructions: macro(name, isLoss, unknow, trap, m)
				let title = if name.name == "elle"
					docteure
				else
					docteur
				end
				let intro = if name.name == "je"
					Je suis docteur en littérature.
				else
					$cap($name.nameFirst) est $title en littérature.
				end
				set trap = if trap
					\sChaque colis contient $m($perBox) livres.
				end
				if isLoss
					if unknow == "x"
						$intro$trap $cap($name.have) vendu $m($delta) livres sur la littérature $country du $century siècle, et $name.haveEn maintenant $m($rest). Combien de livres $name.qhad au départ?
					elseif unknow == "y"
						$intro$trap $cap($name.had) $m($initial) livres sur la littérature $country du $century siècle, et $name.haveEn maintenant $m($rest). Combien de livres $name.qhave vendu?
					elseif unknow == "z"
						$intro$trap $cap($name.had) $m($initial) livres sur la littérature $country du $century siècle, puis $name.haveEn vendu $m($delta). Combien de livres $name.indirect reste-t-il?
					end
				else
					if unknow == "x"
						$intro$trap $cap($name.have) acheté $m($delta) livres sur la littérature $country du $century siècle, et $name.haveEn maintenant $m($now). Combien de livres $name.qhad au départ?
					elseif unknow == "y"
						$intro$trap $cap($name.had) $m($initial) livres sur la littérature $country du $century siècle, et $name.haveEn maintenant $m($now). Combien de livres $name.qhave acheté?
					elseif unknow == "z"
						$intro$trap $cap($name.have) $m($initial) livres sur la littérature $country du $century siècle ; $name.haveEn encore acheté $m($delta). Combien de livres $name.qhave maintenant?
					end
				end
			end
			renderSolution: macro(name, isLoss, unknow, m)
				if isLoss
					if unknow == "x"
						Au départ, $name.had $m($initial) livres sur la littérature $country du $century siècle.
					elseif unknow == "y"
						$cap($name.have) vendu $m($delta) livres sur la littérature $country du $century siècle.
					elseif unknow == "z"
						Il $name.indirect reste $m($rest) livres.
					end
				else
					if unknow == "x"
						Au départ, $name.had $m($initial) livres sur la littérature $country du $century siècle.
					elseif unknow == "y"
						$cap($name.have) acheté $m($delta) livres sur la littérature $country du $century siècle.
					elseif unknow == "z"
						$cap($name.have) maintenant $m($now) livres sur la littérature $country du $century siècle.
					end
				end
			end
		end
	end
end

// Birthday party: cakes bought, eaten by the guests (loss) or brought back (gain);
// trap = cuts per cake.
fete: @QuestionFactory
	parameters: do
	end
	hyperParameters: do
		initial: $Range(6, 12)
		delta: $Range(2, 4)
		perCake: $Range(4, 8)
	end

	get: macro(initial:, delta:, perCake:)
		let rest = $(initial - delta)
		let now = $(initial + delta)
		@Question(pbParameters)
			values: do
				x: $initial
				y: $delta
			end
			renderInstructions: macro(name, isLoss, unknow, trap, m)
				let possessif = if name.name == "je"
					ma
				else
					sa
				end
				set trap = if trap
					\sChaque gâteau est coupé en $m($perCake) parts.
				end
				if isLoss
					if unknow == "x"
						À la fête d'anniversaire, les invités ont mangé $m($delta) gâteaux.$trap Il en reste $m($rest) : combien de gâteaux $name.qhave achetés?
					elseif unknow == "y"
						$cap($name.haveFirst) acheté $m($initial) gâteaux pour $possessif fête d'anniversaire.$trap Il en reste $m($rest) : combien de gâteaux les invités ont-ils mangés?
					elseif unknow == "z"
						$cap($name.haveFirst) acheté $m($initial) gâteaux pour $possessif fête d'anniversaire.$trap Les invités en ont mangé $m($delta) : combien de gâteaux reste-t-il?
					end
				else
					if unknow == "x"
						À la fête d'anniversaire, les invités ont rapporté $m($delta) gâteaux.$trap Il y en a maintenant $m($now) : combien de gâteaux $name.qhave achetés?
					elseif unknow == "y"
						$cap($name.haveFirst) acheté $m($initial) gâteaux pour $possessif fête d'anniversaire.$trap Il y en a maintenant $m($now) : combien de gâteaux les invités ont-ils rapportés?
					elseif unknow == "z"
						$cap($name.haveFirst) acheté $m($initial) gâteaux pour $possessif fête d'anniversaire.$trap Les invités en ont rapporté $m($delta) : combien de gâteaux y a-t-il maintenant?
					end
				end
			end
			renderSolution: macro(name, isLoss, unknow, m)
				let possessif = if name.name == "je"
					ma
				else
					sa
				end
				if isLoss
					if unknow == "x"
						$cap($name.haveFirst) acheté $m($initial) gâteaux pour $possessif fête d'anniversaire.
					elseif unknow == "y"
						Les invités ont mangé $m($delta) gâteaux.
					elseif unknow == "z"
						Il reste $m($rest) gâteaux.
					end
				else
					if unknow == "x"
						$cap($name.haveFirst) acheté $m($initial) gâteaux pour $possessif fête d'anniversaire.
					elseif unknow == "y"
						Les invités ont rapporté $m($delta) gâteaux.
					elseif unknow == "z"
						Il y a maintenant $m($now) gâteaux.
					end
				end
			end
		end
	end
end

// Piggy bank: money inside, withdrawals (loss) or deposits (gain);
// trap = price of the piggy bank (euros, like the money).
tirelire: @QuestionFactory
	parameters: do
	end
	hyperParameters: do
		initial: $Range(20, 60)
		delta: $Range(5, 10)
		price: $Range(5, 20)
	end

	get: macro(initial:, delta:, price:)
		let rest = $(initial - delta)
		let now = $(initial + delta)
		@Question(pbParameters)
			values: do
				x: $initial
				y: $delta
			end
			renderInstructions: macro(name, isLoss, unknow, trap, m)
				let possessif = if name.name == "je"
					ma
				else
					sa
				end
				set trap = if trap
					\sLa tirelire a coûté $m($price)€.
				end
				if isLoss
					if unknow == "x"
						Cette semaine, $name.haveFirst retiré $m($delta)€ de $possessif tirelire.$trap
						\sIl $name.indirect reste $m($rest)€. Combien d'argent $name.qhad dans $possessif tirelire au début de la semaine?
					elseif unknow == "y"
						Au début de la semaine, $name.hadFirst $m($initial)€ dans $possessif tirelire.$trap
						\sMaintenant, il $name.indirect reste $m($rest)€. Combien d'argent $name.qhave retiré?
					elseif unknow == "z"
						Au début de la semaine, $name.hadFirst $m($initial)€ dans $possessif tirelire.$trap
						\sCette semaine, $name.haveFirst retiré $m($delta)€. Combien d'argent $name.indirect reste-t-il?
					end
				else
					if unknow == "x"
						Cette semaine, $name.haveFirst ajouté $m($delta)€ à $possessif tirelire.$trap
						\sMaintenant, elle contient $m($now)€. Combien d'argent contenait-elle au début de la semaine?
					elseif unknow == "y"
						Au début de la semaine, $possessif tirelire contenait $m($initial)€.$trap
						\sMaintenant, elle contient $m($now)€. Combien d'argent $name.qhave ajouté?
					elseif unknow == "z"
						Au début de la semaine, $possessif tirelire contenait $m($initial)€.$trap
						\sCette semaine, $name.haveFirst ajouté $m($delta)€ à la tirelire. Combien d'argent contient-elle maintenant?
					end
				end
			end
			renderSolution: macro(name, isLoss, unknow, m)
				let possessif = if name.name == "je"
					ma
				else
					sa
				end
				if isLoss
					if unknow == "x"
						Au début de la semaine, $name.hadFirst $m($initial)€ dans $possessif tirelire.
					elseif unknow == "y"
						$cap($name.haveFirst) retiré $m($delta)€ de $possessif tirelire.
					elseif unknow == "z"
						Il $name.indirect reste $m($rest)€ dans $possessif tirelire.
					end
				else
					if unknow == "x"
						Au début de la semaine, $possessif tirelire contenait $m($initial)€.
					elseif unknow == "y"
						$cap($name.haveFirst) ajouté $m($delta)€ à $possessif tirelire.
					elseif unknow == "z"
						Maintenant, $possessif tirelire contient $m($now)€.
					end
				end
			end
		end
	end
end

// Thermometer: outside temperature, drop (loss) or rise (gain);
// trap = max range of the thermometer (degrees, like the temperature).
thermometre: @QuestionFactory
	parameters: do
	end
	hyperParameters: do
		initial: $Range(15, 40)
		delta: $Range(2, 10)
		maxTemp: $Range(50, 100)
	end

	get: macro(initial:, delta:, maxTemp:)
		let rest = $(initial - delta)
		let now = $(initial + delta)
		@Question(pbParameters)
			values: do
				x: $initial
				y: $delta
			end
			renderInstructions: macro(name, isLoss, unknow, trap, m)
				set trap = if trap
					\sLe thermomètre peut mesurer jusqu'à $m($maxTemp) °C.
				end
				if isLoss
					if unknow == "x"
						La température a baissé de $m($delta) °C et est maintenant de $m($rest) °C.$trap
						\sCombien faisait-il au début de la journée?
					elseif unknow == "y"
						Au début de la journée, la température était de $m($initial) °C.$trap
						\sMaintenant, elle est de $m($rest) °C. De combien de degrés a-t-elle baissé?
					elseif unknow == "z"
						Au début de la journée, la température était de $m($initial) °C.$trap
						\sElle a baissé de $m($delta) °C. Combien fait-il maintenant?
					end
				else
					if unknow == "x"
						Maintenant, la température est de $m($now) °C.$trap
						\sDepuis le matin, elle a monté de $m($delta) °C. Combien faisait-il ce matin?
					elseif unknow == "y"
						Ce matin, la température était de $m($initial) °C.$trap
						\sMaintenant, elle est de $m($now) °C. De combien de degrés a-t-elle monté?
					elseif unknow == "z"
						Ce matin, la température était de $m($initial) °C.$trap
						\sDepuis, elle a monté de $m($delta) °C. Combien fait-il maintenant?
					end
				end
			end
			renderSolution: macro(name, isLoss, unknow, m)
				if isLoss
					if unknow == "x"
						Au début de la journée, la température était de $m($initial) °C.
					elseif unknow == "y"
						La température a baissé de $m($delta) °C.
					elseif unknow == "z"
						Maintenant, la température est de $m($rest) °C.
					end
				else
					if unknow == "x"
						Ce matin, la température était de $m($initial) °C.
					elseif unknow == "y"
						La température a monté de $m($delta) °C.
					elseif unknow == "z"
						Maintenant, la température est de $m($now) °C.
					end
				end
			end
		end
	end
end

// Elevator: current floor, going down (loss) or going up (gain);
// trap = max number of floors of the building (floors, like the levels).
ascenseur: @QuestionFactory
	parameters: do
	end
	hyperParameters: do
		initial: $Range(20, 60)
		delta: $Range(3, 10)
		maxFloors: $Range(80, 120)
	end

	get: macro(initial:, delta:, maxFloors:)
		let rest = $(initial - delta)
		let now = $(initial + delta)
		@Question(pbParameters)
			values: do
				x: $initial
				y: $delta
			end
			renderInstructions: macro(name, isLoss, unknow, trap, m)
				set trap = if trap
					\sL'immeuble compte au maximum $m($maxFloors) étages.
				end
				if isLoss
					if unknow == "x"
						L'ascenseur est descendu de $m($delta) étages et s'est arrêté au $m($rest)e étage.$trap
						\sÀ quel étage était-il au départ?
					elseif unknow == "y"
						L'ascenseur était au $m($initial)e étage.$trap
						\sMaintenant, il est au $m($rest)e étage. De combien d'étages est-il descendu?
					elseif unknow == "z"
						L'ascenseur était au $m($initial)e étage.$trap
						\sIl est descendu de $m($delta) étages. À quel étage est-il maintenant?
					end
				else
					if unknow == "x"
						L'ascenseur est monté de $m($delta) étages et s'est arrêté au $m($now)e étage.$trap
						\sÀ quel étage était-il au départ?
					elseif unknow == "y"
						L'ascenseur était au $m($initial)e étage.$trap
						\sMaintenant, il est au $m($now)e étage. De combien d'étages est-il monté?
					elseif unknow == "z"
						L'ascenseur était au $m($initial)e étage.$trap
						\sIl est monté de $m($delta) étages. À quel étage est-il maintenant?
					end
				end
			end
			renderSolution: macro(name, isLoss, unknow, m)
				if isLoss
					if unknow == "x"
						Au départ, l'ascenseur était au $m($initial)e étage.
					elseif unknow == "y"
						L'ascenseur est descendu de $m($delta) étages.
					elseif unknow == "z"
						Maintenant, l'ascenseur est au $m($rest)e étage.
					end
				else
					if unknow == "x"
						Au départ, l'ascenseur était au $m($initial)e étage.
					elseif unknow == "y"
						L'ascenseur est monté de $m($delta) étages.
					elseif unknow == "z"
						Maintenant, l'ascenseur est au $m($now)e étage.
					end
				end
			end
		end
	end
end

// Cross-country run: loss = km left of a course of known length
// (x = length, y = km done, z = km left); gain = two-part run
// (x = km done before part 2, y = length of part 2, z = km done in total);
// trap = average running speed (km/h, like the distances).
course: @QuestionFactory
	parameters: do
	end
	hyperParameters: do
		initial: $Range(20, 60)
		delta: $Range(5, 15)
		speed: $Range(8, 14)
	end

	get: macro(initial:, delta:, speed:)
		let rest = $(initial - delta)
		let now = $(initial + delta)
		@Question(pbParameters)
			values: do
				x: $initial
				y: $delta
			end
			renderInstructions: macro(name, isLoss, unknow, trap, m)
				set trap = if trap
					\sLa vitesse moyenne des coureurs est de $m($speed) km/h.
				end
				if isLoss
					if unknow == "x"
						$cap($name.haveFirst) déjà couru $m($delta) km et il $name.indirect reste $m($rest) km à faire.$trap
						\sQuelle est la longueur totale de la course?
					elseif unknow == "y"
						La course fait $m($initial) km et il $name.indirect reste $m($rest) km à faire.$trap
						\sCombien de km $name.qhave déjà courus?
					elseif unknow == "z"
						La course fait $m($initial) km.$trap
						\s$cap($name.haveFirst) déjà couru $m($delta) km. Combien de km $name.indirect reste-t-il?
					end
				else
					if unknow == "x"
						Après la deuxième étape, $name.haveFirst parcouru $m($now) km en tout.$trap
						\sCette étape a fait $m($delta) km. Combien de km $name.qhad déjà parcourus avant cette étape?
					elseif unknow == "y"
						Avant la deuxième étape, $name.hadFirst parcouru $m($initial) km.$trap
						\sAprès, $name.haveFirst parcouru $m($now) km en tout. Quelle est la longueur de la deuxième étape?
					elseif unknow == "z"
						Avant la deuxième étape, $name.hadFirst parcouru $m($initial) km.$trap
						\sCette étape a fait $m($delta) km. Combien de km $name.qhave parcourus en tout?
					end
				end
			end
			renderSolution: macro(name, isLoss, unknow, m)
				if isLoss
					if unknow == "x"
						La course fait $m($initial) km en tout.
					elseif unknow == "y"
						$cap($name.haveFirst) déjà couru $m($delta) km.
					elseif unknow == "z"
						Il $name.indirect reste $m($rest) km à faire.
					end
				else
					if unknow == "x"
						Avant la deuxième étape, $name.hadFirst déjà parcouru $m($initial) km.
					elseif unknow == "y"
						La deuxième étape a fait $m($delta) km.
					elseif unknow == "z"
						En tout, $name.haveFirst parcouru $m($now) km.
					end
				end
			end
		end
	end
end

// Sock monster under the bed: socks in the drawer, eaten (loss) or given
// back (gain); trap = number of monsters living under the bed.
monstreChaussettes: @QuestionFactory
	parameters: do
	end
	hyperParameters: do
		initial: $Range(10, 30)
		delta: $Range(2, 8)
		monsters: $Range(2, 6)
	end

	get: macro(initial:, delta:, monsters:)
		let rest = $(initial - delta)
		let now = $(initial + delta)
		@Question(pbParameters)
			values: do
				x: $initial
				y: $delta
			end
			renderInstructions: macro(name, isLoss, unknow, trap, m)
				set trap = if trap
					\sEn réalité, il y a $m($monsters) monstres sous le lit.
				end
				if isLoss
					if unknow == "x"
						Le monstre sous le lit a mangé $m($delta) chaussettes.$trap
						\sIl reste $m($rest) chaussettes dans le tiroir. Combien de chaussettes y avait-il au départ?
					elseif unknow == "y"
						Au départ, le tiroir contenait $m($initial) chaussettes.$trap
						\sMaintenant, il n'en reste que $m($rest). Combien de chaussettes le monstre a-t-il mangées?
					elseif unknow == "z"
						Le tiroir contenait $m($initial) chaussettes.$trap
						\sLe monstre en a mangé $m($delta). Combien de chaussettes reste-t-il?
					end
				else
					if unknow == "x"
						Le monstre a rendu $m($delta) chaussettes.$trap
						\sMaintenant, il y a $m($now) chaussettes dans le tiroir. Combien de chaussettes y avait-il au départ?
					elseif unknow == "y"
						Au départ, le tiroir contenait $m($initial) chaussettes.$trap
						\sMaintenant, il y en a $m($now). Combien de chaussettes le monstre a-t-il rendues?
					elseif unknow == "z"
						Le tiroir contenait $m($initial) chaussettes.$trap
						\sLe monstre en a rendu $m($delta). Combien de chaussettes y a-t-il maintenant?
					end
				end
			end
			renderSolution: macro(name, isLoss, unknow, m)
				if isLoss
					if unknow == "x"
						Au départ, il y avait $m($initial) chaussettes dans le tiroir.
					elseif unknow == "y"
						Le monstre a mangé $m($delta) chaussettes.
					elseif unknow == "z"
						Il reste $m($rest) chaussettes dans le tiroir.
					end
				else
					if unknow == "x"
						Au départ, il y avait $m($initial) chaussettes dans le tiroir.
					elseif unknow == "y"
						Le monstre a rendu $m($delta) chaussettes.
					elseif unknow == "z"
						Il y a maintenant $m($now) chaussettes dans le tiroir.
					end
				end
			end
		end
	end
end

// Space station: crew on board, returned to Earth (loss) or arrived by
// shuttle (gain); trap = station capacity (astronauts, like the crew).
stationSpatiale: @QuestionFactory
	parameters: do
	end
	hyperParameters: do
		initial: $Range(12, 40)
		delta: $Range(2, 8)
		capacity: $Range(60, 100)
	end

	get: macro(initial:, delta:, capacity:)
		let rest = $(initial - delta)
		let now = $(initial + delta)
		@Question(pbParameters)
			values: do
				x: $initial
				y: $delta
			end
			renderInstructions: macro(name, isLoss, unknow, trap, m)
				set trap = if trap
					\sLa station peut accueillir au maximum $m($capacity) astronautes.
				end
				if isLoss
					if unknow == "x"
						$m($delta) astronautes sont retournés sur Terre.$trap
						\sIl reste $m($rest) astronautes dans la station. Combien d'astronautes y avait-il avant?
					elseif unknow == "y"
						Avant, il y avait $m($initial) astronautes dans la station.$trap
						\sMaintenant, il n'y en reste que $m($rest). Combien d'astronautes sont retournés sur Terre?
					elseif unknow == "z"
						Il y avait $m($initial) astronautes dans la station.$trap
						\s$m($delta) astronautes sont retournés sur Terre. Combien d'astronautes reste-t-il dans la station?
					end
				else
					if unknow == "x"
						$m($delta) astronautes sont arrivés par navette.$trap
						\sIl y en a maintenant $m($now) dans la station. Combien d'astronautes y avait-il avant?
					elseif unknow == "y"
						Avant, il y avait $m($initial) astronautes dans la station.$trap
						\sMaintenant, il y en a $m($now). Combien d'astronautes sont arrivés par navette?
					elseif unknow == "z"
						Il y avait $m($initial) astronautes dans la station.$trap
						\s$m($delta) astronautes sont arrivés par navette. Combien d'astronautes y a-t-il maintenant?
					end
				end
			end
			renderSolution: macro(name, isLoss, unknow, m)
				if isLoss
					if unknow == "x"
						Avant, il y avait $m($initial) astronautes dans la station.
					elseif unknow == "y"
						$m($delta) astronautes sont retournés sur Terre.
					elseif unknow == "z"
						Il reste $m($rest) astronautes dans la station.
					end
				else
					if unknow == "x"
						Avant, il y avait $m($initial) astronautes dans la station.
					elseif unknow == "y"
						$m($delta) astronautes sont arrivés par navette.
					elseif unknow == "z"
						Il y a maintenant $m($now) astronautes dans la station.
					end
				end
			end
		end
	end
end

// Bear and honey: honey pots in the cellar, emptied by the bear (loss) or
// brought by the bees (gain); trap = empty jars in the attic (pots, like
// the honey pots, other room, so they are clearly not the emptied ones).
oursMiel: @QuestionFactory
	parameters: do
	end
