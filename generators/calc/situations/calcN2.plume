end

// Market: things bought / sold / made
marketMade: @QuestionFactory
	parameters: do
		thing: $Choice(voitures, télévisions, piscines)
		get: $Choice(acheté, fabriqué)
	end
	hyperParameters: do
		- $Range(2, 9)
		- $Range(2, 9)
	end
	get: macro(x, y, thing:, get:)
		let unit = $thing
		let lose = vendu
		@Question(pbParameters)
			values: do
				x: $x
				y: $y
			end
			unit: $unit
			sentence: $foodSentences($unit, lose: $lose, get: $get)
		end
	end
end

