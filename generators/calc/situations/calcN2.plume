let Question from $import(../../../core/cls/question)
let QuestionFactory from $import(../../../core/cls/questionFactory)
let Range from $import(../../../core/parameters/range)
let Choice from $import(../../../core/parameters/set)

macro cap(x)
	$x.sub(1).upper()$x.sub(2, -1)
	end

boulangerie: @QuestionFactory
	parameters: do
		item: @Choice
			- du pain
			- des gâteaux
			- des pâtisseries
			- des viennoiseries
		end
	end
	hyperParameters: do
		initial: $Range(20, 50)
		spent: $Range(5, 10)
	end

	get: macro(item:, initial:, spent:)
		@Question(pbParameters)
			values: do
				x: $initial
				y: $spent
			end
			renderInstructions: macro(name, isLoss, unknow, trap, m)
				set trap = if trap
					\sà $m($(spent/10))€ l'unité
				end
				if isLoss
					if unknow == "x"
						A la boulangerie, $name.haveFirst dépensé $m($spent)€ pour acheter $item$trap
						. Vu qu'il $name.indirect restait $m($(initial - spent))€ en sortant, combien $name.qhad en arrivant?
					elseif unknow == "y"
						$cap($name.arrived) à la boulangerie avec $m($initial)€. Après avoir acheté $item$trap
						, il $name.indirect reste $m($(initial - spent))€. Combien $name.qhave dépensé?
					elseif unknow == "z"
						$cap($name.arrived) à la boulangerie avec $m($initial)€. $cap($name.have) dépensé $m($spent)€ pour acheter $item$trap. Combien $name.indirect reste-t-il?
					end
				else
					if unknow == "x"
						A la boulangerie, $name.haveFirst dépensé $m($spent)€ pour acheter $item$trap. $cap($name.name) $name.alsoWent au marché. En tout, $name.have dépensé $m($(initial + spent))€ aujourd'hui. Combien $name.qhad dépensé au marché?
					elseif unknow == "y"
						$cap($name.haveFirst) dépensé $m($initial)€ au marché, puis $name.went à la boulangerie pour acheter $item$trap. En tout, $name.have dépensé $m($(initial + spent))€ aujourd'hui. Combien $name.qhave dépensé à la boulangerie?
					elseif unknow == "z"
						$cap($name.haveFirst) dépensé $m($initial)€ au marché, puis dépensé $m($spent)€ à la boulangerie pour acheter $item$trap. En tout, combien $name.qhave dépensé?
					end
				end
			end
			renderSolution: macro(name, isLoss, unknow, m)
				if isLoss
					if unknow == "x"
						$cap($name.hadFirst) $m($initial)€ en arrivant.
					elseif unknow == "y"
						$cap($name.haveFirst) dépensé $m($spent)€.
					elseif unknow == "z"
						Il $name.indirect reste $m($(initial-spent))€.
					end
				else
					if unknow == "x"
						$cap($name.hadFirst) dépensé $m($initial)€ au marché.
					elseif unknow == "y"
						$cap($name.haveFirst) dépensé $m($spent)€ à la boulangerie.
					elseif unknow == "z"
						En tout, $name.haveFirst dépensé $m($(initial+spent))€.
					end
				end
			end
		end
	end
end
