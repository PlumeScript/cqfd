let Question from $import(../../../core/cls/question)
let QuestionFactory from $import(../../../core/cls/questionFactory)
let Range from $import(../../../core/parameters/range)
let Choice, ChoiceSet from $import(../../../core/parameters/set)



boulangerie: @QuestionFactory
	let infos = do
		- (name: baguette, namePlural: baguettes, coeffMin: 0.5, coeffMax: 1, countMax: 20, digit: 1)
		- (name: croissant, namePlural: croissants, coeffMin: 0.8, coeffMax: 1.2, countMax: 20, digit: 1)
		- (name: pain au chocolat, namePlural: pains au chocolat, coeffMin: 0.8, coeffMax: 1.2, countMax: 20, digit: 1)
		- (name: gâteau, namePlural: gâteaux, coeffMin: 10, coeffMax: 50, countMax: 5, digit: 0)
	end
	parameters: do
		items: @ChoiceSet(3)
			- 1
			- 2
			- 3
			- 4
		end
		for i in seq(6)
			- $Range(0, 100)
		end
	end
	get: macro(items:, ...vars)
		@Question(pbParameters)
			items: for i, item in enumerate(items)
				- do
					let itemInfos = $infos[item]
					name: $itemInfos.name
					namePlural: $itemInfos.namePlural
					coeff: $(
						((
							itemInfos.coeffMin +
							(itemInfos.coeffMax - itemInfos.coeffMin) * vars[i]/ 100
						)*10^itemInfos.digit).ceil()/10^itemInfos.digit
					)
					count: $ (itemInfos.countMax * vars[3 + i] / 100).ceil()
				end
			end
			renderInstructions: macro(question)
				for item in question.items
					if item.count>0
						$item.count x $item.namePlural ($item.coeff€ pièce)
					else
						$item.count x coupon de réduction ($item.coeff€ pièce)
					end
				end
			end
			renderSolution: macro(question)

			end
		end
	end
end