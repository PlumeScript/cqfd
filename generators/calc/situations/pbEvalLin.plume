// Librairie: three books drawn among five; the negative term is the return
// of an untouched book ("rendu/rendue(s)").
librairie: @QuestionFactory
	let infos = do
		- (name: roman, namePlural: romans, negS: roman rendu, negP: romans rendus, unit: pièce, minU: 65, maxU: 100, digit: 1, countMax: 5)
		- (name: bande dessinée, namePlural: bandes dessinées, negS: bande dessinée rendue, negP: bandes dessinées rendues, unit: pièce, minU: 70, maxU: 120, digit: 1, countMax: 5)
		- (name: magazine, namePlural: magazines, negS: magazine rendu, negP: magazines rendus, unit: pièce, minU: 50, maxU: 80, digit: 1, countMax: 4)
		- (name: atlas, namePlural: atlas, negS: atlas rendu, negP: atlas rendu, unit: pièce, minU: 120, maxU: 200, digit: 1, countMax: 2)
		- (name: livre de cuisine, namePlural: livres de cuisine, negS: livre de cuisine rendu, negP: livres de cuisine rendus, unit: pièce, minU: 150, maxU: 250, digit: 1, countMax: 2)
	end
	parameters: do
		items: @ChoiceSet(3)
			- 1
			- 2
			- 3
			- 4
			- 5
		end
		- $Range(0, 100)
		- $Range(0, 100)
		- $Range(0, 100)
		- $Range(0, 100)
		- $Range(0, 100)
		- $Range(0, 100)
	end
	get: macro(items:, ...vars)
		@Question(pbParameters)
			contextName: librairie
			items: for i, item in enumerate(items)
				let info = $infos[item]
				- do
					name: $info.name
					namePlural: $info.namePlural
					negS: $info.negS
					negP: $info.negP
					unit: $info.unit
					dec: $ (info.minU + (info.maxU - info.minU) * vars[i] / 100).ceil() * 10^(1 - info.digit)
					count: $(max(1, ((info.countMax * vars[3 + i]) / 100).ceil()))
				end
