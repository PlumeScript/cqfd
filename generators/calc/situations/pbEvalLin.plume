let Question from $import(../../../core/cls/question)
let QuestionFactory from $import(../../../core/cls/questionFactory)
let Range from $import(../../../core/parameters/range)
let Choice, ChoiceSet from $import(../../../core/parameters/set)

// Boulangerie context for pbEvalLin: three distinct products drawn among
// four, each with a price interpolated in [minU..maxU] units of
// 10^-digit euro, rounded up to the unit, and a shop count (>= 1).
// Prices are kept in integer tenths of euro (`dec`) so the pbEvalLin
// total stays exact; the display price is dec/10.
macro itemLine(item)
	let n = $(Number.abs(item.count))
	let price = $(Number(item.dec/10).localize())
	if item.count < 0
		if n == 1
			$n coupon de réduction ($price € pièce)
		else
			$n coupons de réduction ($price € pièce)
		end
	else
		$n $(n == 1 and item.name or item.namePlural) ($price € pièce)
	end
end

macro listItems(question)
	let last = $(len(question.items))
	for i, item in enumerate(question.items)
		if i > 1
			$(i == last and " et" or ",")
		end
		\s$itemLine($item)
	end
end

boulangerie: @QuestionFactory
	let infos = do
		- (name: baguette, namePlural: baguettes, minU: 5, maxU: 10, digit: 1, countMax: 20)
		- (name: croissant, namePlural: croissants, minU: 8, maxU: 12, digit: 1, countMax: 20)
		- (name: pain au chocolat, namePlural: pains au chocolat, minU: 8, maxU: 12, digit: 1, countMax: 20)
		- (name: gâteau, namePlural: gâteaux, minU: 10, maxU: 50, digit: 0, countMax: 5)
	end
	parameters: do
		items: @ChoiceSet(3)
			- 1
			- 2
			- 3
			- 4
		end
		- $Range(0, 100)
		- $Range(0, 100)
		- $Range(0, 100)
		- $Range(0, 100)
		- $Range(0, 100)
		- $Range(0, 100)
	end
	get: macro(items:, ...vars)
		@Question(pbParameters)
			items: for i, item in enumerate(items)
				let info = $infos[item]
				- do
					name: $info.name
					namePlural: $info.namePlural
					dec: $ (info.minU + (info.maxU - info.minU) * vars[i] / 100).ceil() * 10^(1 - info.digit)
					count: $(max(1, ((info.countMax * vars[3 + i]) / 100).ceil()))
				end
			end
			renderInstructions: macro(question)
				Le ticket de caisse d'une boulangerie indique :
				$listItems($question)
				. Quel est le montant total à payer ?
			end
			renderSolution: macro(question)
				Le montant total à payer est de $(Number(question.solution).localize()) €.
			end
		end
	end
end
