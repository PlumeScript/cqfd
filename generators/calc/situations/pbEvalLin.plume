	let infos = do
		- (name: pomme, namePlural: pommes, negS: pommes abîmées rendues, negP: pommes abîmées rendues, unit: le kilo, minU: 20, maxU: 35, digit: 1, countMax: 5)
		- (name: fraise, namePlural: fraises, negS: fraises abîmées rendues, negP: fraises abîmées rendues, unit: le kilo, minU: 50, maxU: 80, digit: 1, countMax: 4)
		- (name: tomate, namePlural: tomates, negS: tomates abîmées rendues, negP: tomates abîmées rendues, unit: le kilo, minU: 30, maxU: 50, digit: 1, countMax: 4)
		- (name: melon, namePlural: melons, negS: melon abîmé rendu, negP: melons abîmés rendus, unit: pièce, minU: 40, maxU: 70, digit: 1, countMax: 3)
		- (name: pot de miel, namePlural: pots de miel, negS: pot de miel fêlé rendu, negP: pots de miel fêlés rendus, unit: le pot, minU: 30, maxU: 60, digit: 1, countMax: 3)
