// train (#129): the named « chef de ligne » prose, same 4-slot indexing
// (index = level: gare=1, train=2, wagon=3, roue=4). `n` is the
// already-rendered count (formula); `ligne`/`mesTrains` are the
// name-dependent possessives (ma/sa, mes/ses).
let trainSentences = do
	top: do
		- macro(n, ligne, mesTrains)
			$cap($ligne) ligne dessert $n gares.
		end
		- macro(n, ligne, mesTrains)
			$cap($ligne) ligne a $n trains en service.
		end
		- macro(n, ligne, mesTrains)
		end
		- macro(n, ligne, mesTrains)
		end
	end
	link: do
		- macro(n, ligne, mesTrains)
		end
		- macro(n, ligne, mesTrains)
			Chaque gare reçoit $n trains.
		end
		- macro(n, ligne, mesTrains)
			Chaque train est composé de $n wagons.
		end
		- macro(n, ligne, mesTrains)
			Chaque wagon a $n roues.
		end
	end
	// the level just below the target: a link the question never uses
	trap: do
		- macro(n, ligne, mesTrains)
		end
		- macro(n, ligne, mesTrains)
		end
		- macro(n, ligne, mesTrains)
			Chaque train a $n wagons.
		end
		- macro(n, ligne, mesTrains)
			Chaque wagon a $n roues.
		end
	end
	total: do
		- macro(n, ligne, mesTrains)
		end
		- macro(n, ligne, mesTrains)
			En tout, il y a $n trains sur $ligne ligne.
		end
		- macro(n, ligne, mesTrains)
			En tout, il y a $n wagons sur $ligne ligne.
		end
		- macro(n, ligne, mesTrains)
			En tout, il y a $n roues sur $ligne ligne.
		end
	end
	askMult: do
		- macro(ligne, mesTrains)
		end
		- macro(ligne, mesTrains)
			En tout, combien de trains circulent sur $ligne ligne\0?
		end
		- macro(ligne, mesTrains)
			En tout, combien de wagons circulent sur $ligne ligne\0?
		end
		- macro(ligne, mesTrains)
			En tout, combien de roues portent $mesTrains trains\0?
		end
	end
	askDivTop: do
		- macro(ligne, mesTrains)
			Combien de gares dessert $ligne ligne\0?
		end
		- macro(ligne, mesTrains)
			Combien de trains $ligne ligne a-t-elle en service\0?
		end
		- macro(ligne, mesTrains)
		end
		- macro(ligne, mesTrains)
		end
	end
	askDiv: do
		- macro(ligne, mesTrains)
		end
		- macro(ligne, mesTrains)
			Combien de trains y a-t-il dans chaque gare\0?
		end
		- macro(ligne, mesTrains)
			Combien de wagons y a-t-il dans chaque train\0?
		end
		- macro(ligne, mesTrains)
			Combien de roues y a-t-il sur chaque wagon\0?
		end
	end
	answerMult: do
		- macro(n, ligne, mesTrains)
		end
		- macro(n, ligne, mesTrains)
			En tout, $n trains circulent sur $ligne ligne.
		end
		- macro(n, ligne, mesTrains)
			En tout, $n wagons circulent sur $ligne ligne.
		end
		- macro(n, ligne, mesTrains)
			En tout, $mesTrains trains portent $n roues.
		end
	end
	answerDivTop: do
		- macro(n, ligne, mesTrains)
			$cap($ligne) ligne dessert donc $n gares.
		end
		- macro(n, ligne, mesTrains)
			$cap($ligne) ligne a donc $n trains en service.
		end
		- macro(n, ligne, mesTrains)
		end
		- macro(n, ligne, mesTrains)
		end
	end
	answerDiv: do
		- macro(n, ligne, mesTrains)
		end
		- macro(n, ligne, mesTrains)
			Chaque gare reçoit donc $n trains.
		end
		- macro(n, ligne, mesTrains)
			Chaque train est donc composé de $n wagons.
		end
		- macro(n, ligne, mesTrains)
			Chaque wagon a donc $n roues.
		end
	end
end

// The 9 generic contexts: the sentence table does the work; `name` is
// unused here (kept for the shared (question, name, unknown, depth, start,
// ...) signature of renderInstructions/renderSolution).
macro genericInstructions(question, name, unknown, depth, start, trap, m)
	$ question.context.sentence.top[start](m(question.context.values[1]))
	for i in seq(1, depth)
		\s$ question.context.sentence.link[start+i](m(question.context.values[i+1]))
	end
	// trap: the level just below the target, useless for the answer
	if trap and start+depth+1 <= question.context.vocSize
		\s$ question.context.sentence.link[start+depth+1](m(question.context.values[depth+2]))
	end
	\s$ question.context.sentence.ask[start+depth]()
end

macro genericSolution(question, name, unknown, depth, start, m)
	$ question.context.sentence.answer[start+depth](m(question.solution))
end

let situations = do
	- do
		name: train
		// train (#129): intro (named chef de ligne) -> top (if the top count is
		// known) -> links (skipping the hidden factor) -> total (division only) ->
		// trap -> question (the total, or the hidden top / per-level count).
		instructions: macro (question, name, unknown, depth, start, trap, m)
			let ligne = if name.name == "je"
				ma
			else
				sa
			end
			let mesTrains = if name.name == "je"
				mes
			else
				ses
			end
			// the title is gendered: « cheffe » for the named female character
			let title = if name.name == "elle"
				cheffe
			else
				chef
			end
			let intro = if name.name == "je"
				Je suis $title de ligne.
			else
				$cap($name.nameFirst) est $title de ligne.
			end
			$intro
			if unknown > 1
				\s$ trainSentences.top[start](m(question.context.values[1]), ligne, mesTrains)
			end
			// a link is skipped only when it introduces the hidden factor — which
			// happens in division (unknown <= depth), never in multiplication, where
			// every factor is given
			for i in seq(1, depth)
				if (unknown > depth) or (i+1 != unknown)
					\s$ trainSentences.link[start+i](m(question.context.values[i+1]), ligne, mesTrains)
				end
			end
			if unknown <= depth
				\s$ trainSentences.total[start+depth](m(question.total), ligne, mesTrains)
			end
			if trap and start+depth+1 <= question.context.vocSize
				\s$ trainSentences.trap[start+depth+1](m(question.context.values[depth+2]), ligne, mesTrains)
			end
			if unknown > depth
				\s$ trainSentences.askMult[start+depth](ligne, mesTrains)
			else
				if unknown == 1
					\s$ trainSentences.askDivTop[start](ligne, mesTrains)
				else
					\s$ trainSentences.askDiv[start+unknown-1](ligne, mesTrains)
				end
			end
		end
		solution: macro (question, name, unknown, depth, start, m)
			let ligne = if name.name == "je"
				ma
			else
				sa
			end
			let mesTrains = if name.name == "je"
				mes
			else
				ses
			end
			if unknown > depth
				$ trainSentences.answerMult[start+depth](m(question.solution), ligne, mesTrains)
			else
				if unknown == 1
					$ trainSentences.answerDivTop[start](m(question.solution), ligne, mesTrains)
				else
					$ trainSentences.answerDiv[start+unknown-1](m(question.solution), ligne, mesTrains)
				end
			end
		end
		voc: do
			- gare
			- train
			- wagon
			- roue
		end
		sentences: do
			top: do
				- macro(n)
					Il y a $n gares.
				end
				- macro(n)
					Il y a $n trains.
