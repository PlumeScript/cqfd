let Question from $import(../../../core/cls/question)
let QuestionFactory from $import(../../../core/cls/questionFactory)
let Range from $import(../../../core/parameters/range)
let Choice from $import(../../../core/parameters/set)

let r = $Range(2, 10)

// matrioska (rendered by pbMulX, problem.plume): a chain of `depth`
// multiplications over the context's 4-level vocabulary (level 1 = top).
// No generic context: `situations` is the list of the specific contexts —
// each entry is self-contained (name, instructions/solution macros, voc, its
// own sentences table, division flag, maxStart); matrioska draws an entry by
// index (Range(1, len(situations))) and stores it as the Question's context.
// Each context is a named character (gendered title) with its own prose and
// full division. Every sentences table list is 4 slots wide, index = level,
// so the (start, depth) arithmetic needs no per-context offset:
//   top[level]         the count of level `level`        (level = start)
//   link[level]        the count of level `level`        (start+1 .. start+depth; slot 1 = dummy)
//   total[level]       the given total (division)        (level = start+depth; slot 1 = dummy)
//   askMult[level]     the question about the total      (level = start+depth; slot 1 = dummy)
//   askDiv[level]      the per-level division question   (level = start+1 .. start+depth; slot 1 = dummy)
//   askDivTop[level]   the hidden-top division question  (level = start)
//   answerMult/answerDiv/answerDivTop[level] the solution sentences (same indexes)
//   trap[level]        the level just below the target   (level = start+depth+1; a link the question never uses)
// pbMulX hides `unknown`: unknown = depth+1 → the total is hidden
// (multiplication); unknown = 1..depth → a factor is hidden and the total is
// given (division — only contexts with `division` set, and only when the
// factory is called with the `division:` flag). Each context rejects
// start > maxStart (train: 2, the others: 3).

macro cap(x)
	$x.sub(1).upper()$x.sub(2, -1)
	end

// Per-context sentence templates (the 9 generic contexts): one explicit
// string per level, so elision (« d'élèves »), plurals (« pépites de
// caramel ») and the part-whole verb (« Chaque wagon a ») stay correct.
let sentences = do
	// train: gare -> train -> wagon -> roue (named "chef de ligne" + division, #129 — kept for key completeness, unused by train)
	
