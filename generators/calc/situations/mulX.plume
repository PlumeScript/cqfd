matrioska: @QuestionFactory
	parameters: do
		- $Choice(train, chocolat, collège, arbre, ville, magasin, salle, caisse, haras, étoile)
		- $r
	end
	hyperParameters: do
		start: $Range(1, 4)
		for i in seq(5)
			- $r
		end
	end
	get: macro(context, start:, ...values)
		@Question(pbParameters)
			voc: if context == "train"
				- gare
				- train
				- wagon
				- roue
			elseif context == "chocolat"
				- caisse
				- boîte
				- chocolat
				- pépite de caramel
			elseif context == "collège"
				- collège
				- bâtiment
				- classe
				- élève
			elseif context == "arbre"
				- arbre
				- branche
				- nid
				- œuf
			elseif context == "ville"
				- ville
				- parking
				- voiture
				- siège
			elseif context == "magasin"
				- magasin
				- piano
				- touche
				- corde
			elseif context == "salle"
				- salle
				- aquarium
				- poulpe
				- tentacule
			elseif context == "caisse"
				- caisse
				- pack
				- brique
				- litre de jus
			elseif context == "haras"
				- haras
				- pré
				- licorne
				- crin
			else
				- étoile
				- planète
				- lune
				- cratère
			end
			values: $values
			start: $start
			sentence: $sentences[context]
		end
	end
end
