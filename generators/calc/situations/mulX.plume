let Question from $import(../../../core/cls/question)
let QuestionFactory from $import(../../../core/cls/questionFactory)
let Range from $import(../../../core/parameters/range)
let Choice from $import(../../../core/parameters/set)

let r = $Range(2, 10)

// matrioska (rendered by pbMulX, problem.plume): a chain of `depth`
// multiplications over the context's 4-level vocabulary (level 1 = top).
// Every template list is 4 slots wide, index = level, so the (start, depth)
// arithmetic needs no per-context offset:
//   top[level]    the count of level `level`           (level = start)
//   link[level]   the count of level `level`           (start+1 .. start+depth; slot 1 = dummy)
//   ask[level]    the question about the total         (level = start+depth; slot 1 = dummy)
//   answer[level] the answer about the total           (level = start+depth; slot 1 = dummy)
// pbMulX hides `unknown`: unknown = depth+1 → the total is hidden
// (multiplication, every context); unknown = 1..depth → a factor is hidden
// and the total is given (division — only contexts with `division` set,
// currently `train` only). The trap is the level just below the target
// (start+depth+1): a link the question never uses. `train` (#129): a named
// « chef de ligne » character (ma/sa, mes/ses) and per-level division prose
// — in trainSentences below; the context rejects start > 2.

macro cap(x)
	$x.sub(1).upper()$x.sub(2, -1)
	end

// Per-context sentence templates (the 9 generic contexts): one explicit
// string per level, so elision (« d'élèves »), plurals (« pépites de
// caramel ») and the part-whole verb (« Chaque wagon a ») stay correct.
let sentences = do
