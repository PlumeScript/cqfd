					Chaque haras a donc $n prés.
				end
				- macro(n)
					Chaque pré a donc $n licornes.
				end
				- macro(n)
					Chaque licorne a donc $n crins.
				end
			end
			answerDivTop: do
				- macro(n, poss)
					Il y a donc $n haras dans la région.
				end
				- macro(n, poss)
					Il y a donc $n prés dans $poss haras.
				end
				- macro(n, poss)
					Il y a donc $n licornes dans $poss haras.
				end
				- macro(n, poss)
				end
			end
			trap: do
				- macro(n)
				end
				- macro(n)
				end
				- macro(n)
					Chaque pré abrite $n licornes.
				end
				- macro(n)
					Chaque licorne porte $n crins.
				end
			end
		end
	end

	- do
		name: étoile
		// étoile: the named astronomer — the observatory (l'observatoire)
		// tracks the stars: étoile -> planète -> lune -> cratère.
		instructions: macro (question, name, unknown, depth, start, trap, m)
			let sentence = $ question.context.sentence
			let poss = if name.name == "je"
				mon
			else
				son
			end
			// the role is invariable (astronome)
			let intro = if name.name == "je"
				Je suis astronome.
			else
				$cap($name.nameFirst) est astronome.
			end
			$intro
			if unknown > 1
				\s$ sentence.top[start](m(question.context.values[1]), poss)
			end
			// a link is skipped only when it introduces the hidden factor
			// (division); in multiplication every factor is given
			for i in seq(1, depth)
				if (unknown > depth) or (i+1 != unknown)
					\s$ sentence.link[start+i](m(question.context.values[i+1]))
				end
			end
			if unknown <= depth
				\s$ sentence.total[start+depth](m(question.total), poss)
			end
			if trap and start+depth+1 <= question.context.vocSize
				\s$ sentence.trap[start+depth+1](m(question.context.values[depth+2]))
			end
			if unknown > depth
				\s$ sentence.askMult[start+depth]()
			else
				if unknown == 1
					\s$ sentence.askDivTop[start](poss)
				else
					\s$ sentence.askDiv[start+unknown-1]()
				end
			end
		end
		solution: macro (question, name, unknown, depth, start, m)
			let sentence = $ question.context.sentence
			let poss = if name.name == "je"
				mon
			else
				son
			end
			if unknown > depth
				$ sentence.answerMult[start+depth](m(question.solution))
			else
				if unknown == 1
					$ sentence.answerDivTop[start](m(question.solution), poss)
				else
					$ sentence.answerDiv[start+unknown-1](m(question.solution))
				end
			end
		end
		voc: do
			- étoile
			- planète
			- lune
			- cratère
		end
		division: $true
		maxStart: 3
		sentences: do
			top: do
				- macro(n, poss)
					$cap($poss) observatoire suit $n étoiles.
				end
				- macro(n, poss)
					$cap($poss) observatoire suit $n planètes.
				end
				- macro(n, poss)
					$cap($poss) observatoire suit $n lunes.
				end
				- macro(n, poss)
				end
			end
			link: do
				- macro(n)
				end
				- macro(n)
					Chaque étoile a $n planètes.
				end
				- macro(n)
					Chaque planète a $n lunes.
				end
				- macro(n)
					Chaque lune a $n cratères.
				end
			end
			total: do
				- macro(n, poss)
				end
				- macro(n, poss)
					En tout, il y a $n planètes.
				end
				- macro(n, poss)
					En tout, il y a $n lunes.
				end
				- macro(n, poss)
					En tout, il y a $n cratères.
				end
			end
			askMult: do
				- macro()
				end
				- macro()
					En tout, combien de planètes y a-t-il\0?
				end
				- macro()
					En tout, combien de lunes y a-t-il\0?
				end
				- macro()
					En tout, combien de cratères y a-t-il\0?
				end
			end
			askDiv: do
				- macro()
				end
				- macro()
					Combien de planètes y a-t-il par étoile\0?
				end
				- macro()
					Combien de lunes y a-t-il par planète\0?
				end
				- macro()
					Combien de cratères y a-t-il sur chaque lune\0?
				end
			end
			askDivTop: do
				- macro(poss)
					Combien d'étoiles $poss observatoire suit-il\0?
				end
				- macro(poss)
					Combien de planètes $poss observatoire suit-il\0?
				end
				- macro(poss)
					Combien de lunes $poss observatoire suit-il\0?
				end
				- macro(poss)
				end
			end
			answerMult: do
				- macro(n)
				end
				- macro(n)
					En tout, il y a $n planètes.
				end
				- macro(n)
					En tout, il y a $n lunes.
				end
				- macro(n)
					En tout, il y a $n cratères.
				end
			end
			answerDiv: do
				- macro(n)
				end
				- macro(n)
					Chaque étoile a donc $n planètes.
				end
				- macro(n)
					Chaque planète a donc $n lunes.
				end
				- macro(n)
					Chaque lune a donc $n cratères.
				end
			end
			answerDivTop: do
				- macro(n, poss)
					$cap($poss) observatoire suit donc $n étoiles.
				end
				- macro(n, poss)
					$cap($poss) observatoire suit donc $n planètes.
				end
				- macro(n, poss)
					$cap($poss) observatoire suit donc $n lunes.
				end
				- macro(n, poss)
				end
			end
			trap: do
				- macro(n)
				end
				- macro(n)
				end
				- macro(n)
					Chaque planète présente $n lunes.
				end
				- macro(n)
					Chaque lune arbore $n cratères.
				end
			end
		end
	end

	// Template
	// - do
	// 	name: name
	// 	instructions: macro (question, name, unknown, depth, start, trap, m)
	// 		// ...
	// 	end
	// 	solution: macro (question, name, unknown, depth, start, m)
	// 		//  ...
	// 	end
	// 	voc: do
	// 		// - name1
	// 		// - name2
	// 		// ...
	// 	end
	// 	division: $true
	// 	maxStart: 2
	// 	sentences: ...
	// end
end



matrioska: @QuestionFactory
	parameters: do
		- $Range(1, $len($situations))
		- $r
	end
	hyperParameters: do
		start: $Range(1, 4)
		for i in seq(5)
			- $r
		end
	end
	get: macro(contextNum, start:, ...values)
		let context = $situations[contextNum]
		if start > context.maxStart
			return
		end
		return @Question(pbParameters)
			contextName: $context.name
			voc: $context.voc
			// if context == "train"
			// 	- gare
			// 	- train
			// 	- wagon
			// 	- roue
			// elseif context == "chocolat"
			// 	- caisse
			// 	- boîte
			// 	- chocolat
			// 	- pépite de caramel
			// elseif context == "collège"
			// 	- collège
			// 	- bâtiment
			// 	- classe
			// 	- élève
			// elseif context == "arbre"
			// 	- arbre
			// 	- branche
			// 	- nid
			// 	- œuf
			// elseif context == "ville"
			// 	- ville
			// 	- parking
			// 	- voiture
			// 	- siège
			// elseif context == "magasin"
			// 	- magasin
			// 	- piano
			// 	- touche
			// 	- corde
			// elseif context == "salle"
			// 	- salle
			// 	- aquarium
			// 	- poulpe
			// 	- tentacule
			// elseif context == "caisse"
			// 	- caisse
			// 	- pack
			// 	- brique
			// 	- litre de jus
			// elseif context == "haras"
			// 	- haras
			// 	- pré
			// 	- licorne
			// 	- crin
			// else
			// 	- étoile
			// 	- planète
			// 	- lune
			// 	- cratère
			// end
			vocSize: 4
			values: $values
			start: $start
			sentence: $context.sentences
			division: $context.division
			renderInstructions: $context.instructions
			renderSolution:  $context.solution
		end
	end
end
