let Range from $import(../../core/parameters/range)
let Choice from $import(../../core/parameters/set)
let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Node from $import(../../core/utils/tree)

// Problem class: k1 * X + k2 * Y = Z
pbCalcN2: macro(context, names:)
	@QuestionFactory
		parameters: do
			unknown: $Choice(x, y, z)
			isLoss: $Choice(0, 1)
		end
		hyperParameters: do
			context: $context
			name: if names
				$Choice(...names)
			else
				$Choice(0)
			end
		end

		get: macro(unknown:, isLoss:, context:, name:)
			let values = do
				...context.values
			end

			if isLoss and values.x < values.y
				set values.x, values.y = ($values.y,  $values.x)
			end
			// Avoid null, and 1 for plural.
			if isLoss and (values.x == values.y) or (values.x == values.y+1)
				set values.x *= 2
			end

			set values.z = if isLoss==1
				$(values.x - values.y)
			else
				$(values.x + values.y)
			end

			@Question(pbCalcN2)
				context: $context
				values: $values
				calcul: @Node
					if isLoss==1
						if unknown == "x"
							- +
							- $values.y
							- $values.z
						elseif unknown == "y"
							- \0-
							- $values.x
							- $values.z
						elseif unknown == "z"
							- \0-
							- $values.x
							- $values.y
						end
					else
						if unknown == "x"
							- \0-
							- $values.z
							- $values.y
						elseif unknown == "y"
							- \0-
							- $values.z
							- $values.x
						elseif unknown == "z"
							- +
							- $values.x
							- $values.y
						end
					end

				end
				solution: do
					$values[unknown]
				end
				instructions: do
					unknown: $unknown
					isLoss: $(isLoss==1)
				end
				name: $(name != 0 and name)
				id: $unknown-$isLoss
			end
		end
	end
end

// Problem class: A * B * C * ... = Z
pbMulX: macro(context, names:, Number minDepth: 1, Number maxDepth: 1,depth:)
	if depth
		set minDepth = $depth
		set maxDepth = $depth
	end

	@QuestionFactory
		parameters: do
			unknown: $ Range(1, maxDepth+1)
			depth:   $ Range(minDepth, maxDepth)
		end
		hyperParameters: do
			context: $context
			name: if names
				$Choice(...names)
			else
				$Choice(0)
			end
		end

		validate: macro(unknown:, depth:)
			// TODO: support division
			// return $ unknown <=depth+1
			return $ unknown == depth+1
		end

		get: macro(unknown:, depth:, context:, name:)
			let calcul = $ Node("number", Table.at(context.values, depth+1))
			let result = $ Table.at(context.values, depth+1)
			for i in seq(depth, 1, -1)
				set calcul = $ Node("*", context.values[i], calcul)
				set result *= $ context.values[i]
			end

			let values = $Table(...context.values)
			set values[unknown+1] = $ result

			@Question(pbMulX)
				context: $context
				values: $values
				calcul: $calcul
				solution: $values[unknown+1]
				instructions: do
					unknown: $unknown
					depth: $depth
				end
				name: $(name != 0 and name)
				id: $unknown-$depth
			end
		end
	end
end