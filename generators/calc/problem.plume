// TODO For now, trap are pure useless infos.
// Should be useless / usefull depending on final question.

let Range from $import(../../core/parameters/range)
let Choice from $import(../../core/parameters/set)
let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Node from $import(../../core/utils/tree)

invPb: macro(pb)
	@QuestionFactory
		parameters: $Table($pb)
		get: macro(pb)
			@Question(invPb)
				src: $pb
			end
		end
	end
end

// Problem class: k1 * X + k2 * Y = Z
pbCalcN2: macro(context, names:, ?trap)
	@QuestionFactory
		parameters: do
			unknown: $Choice(x, y, z)
			isLoss: $Choice(0, 1)
		end
		hyperParameters: do
			context: $context
			name: if names
				$Choice(...names)
			else
				$Choice(0)
			end
		end

		get: macro(unknown:, isLoss:, context:, name:)
			let values = do
				...context.values
			end

			if isLoss and values.x < values.y
				set values.x, values.y = ($values.y,  $values.x)
			end
			// Avoid null, and 1 for plural.
			if isLoss and (values.x == values.y) or (values.x == values.y+1)
				set values.x *= 2
			end

			set values.z = if isLoss==1
				$(values.x - values.y)
			else
				$(values.x + values.y)
			end

			@Question(pbCalcN2)
				context: $context
				values: $values
				trap: $trap
				calcul: @Node
					if isLoss==1
						if unknown == "x"
							- +
							- $values.y
							- $values.z
						elseif unknown == "y"
							- \0-
							- $values.x
							- $values.z
						elseif unknown == "z"
							- \0-
							- $values.x
							- $values.y
						end
					else
						if unknown == "x"
							- \0-
							- $values.z
							- $values.y
						elseif unknown == "y"
							- \0-
							- $values.z
							- $values.x
						elseif unknown == "z"
							- +
							- $values.x
							- $values.y
						end
					end

				end
				solution: do
					$values[unknown]
				end
				instructions: do
					unknown: $unknown
					isLoss: $(isLoss==1)
				end
				name: $(name != 0 and name)
				id: $unknown-$isLoss
			end
		end
	end
end

// Problem class: a chain of `depth` multiplications over the context's
// vocabulary (matrioska). The context question carries `start` (top level),
// `values` (the drawn factors) and the rendering; this layer hides `unknown`:
//   unknown = depth+1 → the total is hidden (multiplication) — every context;
//   unknown = 1..depth → a factor is hidden, the total is given (division) —
//   only contexts that set `division` (currently `train` only, #129), and
//   only when the factory is called with the `division:` flag.
pbMulX: macro(context, names:, Number minDepth: 1, Number maxDepth: 1,depth:, ?trap, ?division)
	if depth
		set minDepth = $depth
		set maxDepth = $depth
	end

	@QuestionFactory
		parameters: do
			unknown: $ Range(1, maxDepth+1)
			depth:   $ Range(minDepth, maxDepth)
		end

		hyperParameters: do
			context: $context
			name: if names
				$Choice(...names)
			else
				$Choice(0)
			end
		end

		validate: macro(unknown:, depth:)
			// the hidden slot is one of the depth+1 chain positions
			return $ unknown <= depth+1
		end

		get: macro(unknown:, depth:, context:, name:)
			// division only where the context supports it
			if unknown <= depth and not( context.division? and division)
				return
			end
			// the chain must fit in the 4-level vocabulary
			if context.start + depth > context.vocSize
				return
			end

			let total = $ context.values[1]
			let calcul = $ Node("number", context.values[1])
			for i in seq(2, depth+1)
				set total *= $ context.values[i]
				set calcul = $ Node("*", calcul, context.values[i])
			end

			let solution = if unknown <= depth
				$ context.values[unknown]
			else
				$ total
			end

			// division: total ÷ the known factors (ascending, skipping unknown)
			if unknown <= depth
				set calcul = $ Node("number", total)
				for i in seq(1, depth+1)
					if i != unknown
						set calcul = $ Node("-:", calcul, context.values[i])
					end
				end
			end

			return @Question(pbMulX)
				trap: $trap
				context: $context
				total: $total
				calcul: $calcul
				solution: $solution
				instructions: do
					unknown: $unknown
					depth: $depth
				end
				name: $(name != 0 and name)
				id: $unknown-$depth
			end
		end
	end
end

// Evaluate a linear combination of the context's items: the instruction
// lists the first `itemCount` items with a quantity each and asks for the
// total (ax +/- by +/- cz over a situation). `select` shapes the quantities:
//   0 → 1: the bare price (the "1" coefficient)
//   1 → the context's count
//   2 → the context's count, negated (coupon de réduction / retour)
// Constraints: the first term is positive; at most `maxOnes` bare prices;
// at least one full count (a quantity >= 2); itemCount >= 2 keeps at most
// one item absent. A context count of 1 is doubled so the quantity 1 is
// never displayed ("1 x price" is ambiguous and breaks the plural) —
// bare-price terms (select 0) keep their 1. Prices are stored in integer
// tenths of euro (item.dec), so the total is exact.
pbEvalLin: macro(context, minItemCount:2, maxItemCount: 3, maxOnes: 2, names:, ?trap)
	@QuestionFactory
		parameters: do
			- $ Range(minItemCount, maxItemCount)
			- $ Range(0, 1)
			- $ Range(0, 2)
			- $ Range(0, 2)
		end
		hyperParameters: do
			context: $context
			name: if names
				$Choice(...names)
			else
				$Choice(0)
			end
		end
		validate: macro(itemCount, context:, name:, ...select)
			// the first term is always positive
			if select[1] == 2
				return $false
			end
			let ones = 0
			let full = 0
			for i in seq(itemCount)
				if select[i] == 0
					set ones = $(ones + 1)
				elseif select[i] == 1
					set full = $(full + 1)
				end
			end
			// max `maxOnes` bare prices, at least one full count
			return $(ones <= maxOnes and full >= 1)
		end
		get: macro(itemCount, context:, name:, ...select)
			let result = 0

			let items = for i in seq(itemCount)
				let item = $ context.items[i]
				let count = if select[i] == 0
					1
				elseif select[i] == 2
					$ -item.count
				else
					$item.count
				end
				if select[i] != 0 and (count == -1 or count == 1)
					set count *= 2
				end
				set result = $(result + count * item.dec)
				- do
					name: $item.name
					namePlural: $item.namePlural
					// display labels, copied as-is: the situation's itemLine
					// renders the unit and the negative labels
					negS: $item.negS
					negP: $item.negP
					unit: $item.unit
					dec: $item.dec
					count: $count
				end
			end

			// a $(...) atom breaks a call's argument list (the / inside is
			// read as template): hoist the price out into a let first
			let firstPrice = $(items[1].dec/10)
			let tip = if items[1].count > 1
				$ Node("*", $items[1].count, $firstPrice)
			else
				$firstPrice
			end
			for i in seq(2, itemCount)
				let count = $items[i].count
				let price = $(items[i].dec/10)
				// a quoted string in a let/set RHS keeps its quotes (plain
				// text); a $(...) is a Lua expression, so the sign is built
				// there as a real string
				let opp = $(count < 0 and "-" or "+")
				if count < 0
					set count = $ -count
				end
				if count > 1
					set tip = $ Node(opp, tip, Node("*", count, price))
				else
					set tip = $ Node(opp, tip, price)
				end
			end

			if result <= 0
				return
			end

			// unused select slots would repeat the same question under
			// distinct ids: normalize them so the id is per visible shape
			if itemCount < 3
				set select[3] = 0
			end

			return @Question(pbEvalLin)
				items: $items
				context: $context
				solution: $(result/10)
				calcul: $tip
				name: $(name != 0 and name)
				id: $(itemCount)-$(Table.join(...select))
			end
		end
	end
end