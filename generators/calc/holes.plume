let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Node from $import(../../core/utils/tree)
let Choice from $import(../../core/parameters/set)
let Range, Decimal from $import(../../core/parameters/range)
let DecimalRepresentation, getCompute from $import(./utils)

let addN2, subN2 from $import(./addsub)

/*
Rewrite an $code(subN2) exercice as an hole equality (hole first).
*/
addN2HoleFirst: macro(...params)
	@QuestionFactory
		parameters: do
			- $subN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(+, ..., $calc.instruction.children[2])
				solution: $calc.solution
				solutionCalc: $calc.instruction
				completed: @Node(+)
					- $Node(bold, $calc.solution)
					- $calc.instruction.children[2]
				end
				target: $calc.instruction.children[1]
			end
		end
	end
end

/*
Rewrite an $code(subN2) exercice as an hole equality (hole second).
*/
addN2HoleSecond: macro(...params)
	@QuestionFactory
		parameters: do
			- $subN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(+, $calc.instruction.children[2], ...)
				solution: $calc.solution
				solutionCalc: $calc.instruction
				completed: @Node(+)
					- $calc.instruction.children[2]
					- $Node(bold, $calc.solution)
				end
				target: $calc.instruction.children[1]
			end
		end
	end
end

/*
Rewrite an $code(addN2) exercice as an hole equality (hole first).
*/
subN2HoleFirst: macro(...params)
	@QuestionFactory
		parameters: do
			- $addN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(-, ..., $calc.instruction.children[1])
				solution: $calc.solution
				solutionCalc: $calc.instruction
				completed: @Node(-)
					- $Node(bold, $calc.solution)
					- $calc.instruction.children[1]
				end
				target: $calc.instruction.children[2]
			end
		end
	end
end

/*
Rewrite an $code(addN2) exercice as an hole equality (hole last).
*/
subN2HoleSecond: macro(...params)
	@QuestionFactory
		parameters: do
			- $subN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(-, $calc.instruction.children[1], ...)
				solution: $calc.solution
				solutionCalc: $calc.instruction
				completed: @Node(-)
					- $calc.instruction.children[1]
					- $Node(bold, $calc.solution)
				end
				target: $calc.instruction.children[2]
			end
		end
	end
end

/*
Writhe add hole equality (hole first) between two $quote(Decimal), but there is no solution.
*/
addN2HoleFirstNoSolution: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:)
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		validate: macro(x, y)
			$(x > y)
		end
		get: macro(x, y)
			@Question(calculHoleNoSolution)
				instruction: $Node(+, ..., $x)
				target: $y
				solution: $Node(>, $x, $y)
			end
		end
	end
end

/*
Writhe add hole equality (hole second) between two $quote(Decimal), but there is no solution.
*/
addN2HoleSecondNoSolution: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:)
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		validate: macro(x, y)
			$(x > y)
		end
		get: macro(x, y)
			@Question(calculHoleNoSolution)
				instruction: $Node(+, $x, ...)
				target: $y
				solution: $Node(>, $x, $y)
			end
		end
	end
end

/*
Writhe sub hole equality (hole second) between two $quote(Decimal), but there is no solution.
*/
subN2HoleSecondNoSolution: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:)
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		validate: macro(x, y)
			$(y > x)
		end
		get: macro(x, y)
			@Question(calculHoleNoSolution)
				instruction: $Node(-, $x, ...)
				target: $y
				solution: $Node(>, $y, $x)
			end
		end
	end
end