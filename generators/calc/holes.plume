let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Node from $import(../../core/utils/tree)
let Choice from $import(../../core/parameters/set)
let Range, Decimal from $import(../../core/parameters/range)
let DecimalRepresentation, getCompute from $import(./utils)

let addN2, subN2 from $import(./addsub)
let mulN2, divQ2 from $import(./muldiv)

/*
Rewrite an $ParamSet(addN2) exercice as a hole equality (hole first).
*/
ref addN2HoleFirst: macro(...params)
	@QuestionFactory
		parameters: do
			- $subN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(+, ..., $calc.instruction.children[2])
				solution: $calc.solution
				solutionCalc: $calc.instruction
				completed: @Node(+)
					- $Node(bold, $calc.solution)
					- $calc.instruction.children[2]
				end
				target: $calc.instruction.children[1]
				id: $calc.id-1
			end
		end
	end
end

/*
Rewrite an $ParamSet(addN2) exercice as a hole equality (hole second).
*/
ref addN2HoleSecond: macro(...params)
	@QuestionFactory
		parameters: do
			- $subN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(+, $calc.instruction.children[2], ...)
				solution: $calc.solution
				solutionCalc: $calc.instruction
				completed: @Node(+)
					- $calc.instruction.children[2]
					- $Node(bold, $calc.solution)
				end
				target: $calc.instruction.children[1]
				id: $calc.id-2
			end
		end
	end
end

/*
Wrapper for $ParamSet(addN2HoleFirst) and $ParamSet(addN2HoleSecond).
*/
addN2Hole: macro(...args)
	$ (addN2HoleFirst(...args) + addN2HoleSecond(...args)).tree()
end

/*
Rewrite a $ParamSet(subN2) exercice as a hole equality (hole first).
*/
ref subN2HoleFirst: macro(...params)
	@QuestionFactory
		parameters: do
			- $addN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(-, ..., $calc.instruction.children[1])
				solution: $calc.solution
				solutionCalc: $calc.instruction
				completed: @Node(-)
					- $Node(bold, $calc.solution)
					- $calc.instruction.children[1]
				end
				target: $calc.instruction.children[2]
				id: $calc.id-1
			end
		end
	end
end

/*
Rewrite a $ParamSet(subN2) exercice as a hole equality (hole second).
*/
ref subN2HoleSecond: macro(...params)
	@QuestionFactory
		parameters: do
			- $subN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(-, $calc.instruction.children[1], ...)
				solution: $calc.solution
				solutionCalc: $calc.instruction
				completed: @Node(-)
					- $calc.instruction.children[1]
					- $Node(bold, $calc.solution)
				end
				target: $calc.instruction.children[2]
				id: $calc.id-2
			end
		end
	end
end

/*
Wrapper for $ParamSet(subN2HoleFirst) and $ParamSet(subN2HoleSecond).
*/
subN2Hole: macro(...args)
	$ (subN2HoleFirst(...args) + subN2HoleSecond(...args)).tree()
end

/*
Write add hole equality (hole first) between two $ParamSet(Decimal), but there is no solution.
*/
ref addN2HoleFirstNoSolution: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:)
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		validate: macro(x, y)
			$(x > y)
		end
		get: macro(x, y)
			@Question(calculHoleNoSolution)
				instruction: $Node(+, ..., $x)
				target: $y
				solution: $Node(>, $x, $y)
				id: $x+...=$y-ns-1
			end
		end
	end
end

/*
Write add hole equality (hole second) between two  $ParamSet(Decimal), but there is no solution.
*/
ref addN2HoleSecondNoSolution: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:)
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		validate: macro(x, y)
			$(x > y)
		end
		get: macro(x, y)
			@Question(calculHoleNoSolution)
				instruction: $Node(+, $x, ...)
				target: $y
				solution: $Node(>, $x, $y)
				id: $x+...=$y-ns-2
			end
		end
	end
end

/*
Wrapper for $ParamSet(addN2HoleSecondNoSolution) and $ParamSet(addN2HoleSecondNoSolution).
*/
addN2HoleNoSolution: macro(...args)
	$ (addN2HoleFirstNoSolution(...args) + addN2HoleSecondNoSolution(...args)).tree()
end


/*
Write sub hole equality (hole second) between two $ParamSet(Decimal), but there is no solution.
*/
subN2HoleSecondNoSolution: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:)
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		validate: macro(x, y)
			$(y > x)
		end
		get: macro(x, y)
			@Question(calculHoleNoSolution)
				instruction: $Node(-, $x, ...)
				target: $y
				solution: $Node(>, $y, $x)
				id: $x+...=$y-ns-2
			end
		end
	end
end

/*
Transform a $ParamSet(mulN2) into an equality with hole first.
*/
ref mulHoleFirst: macro(...params)
	@QuestionFactory
		parameters: do
			- $mulN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(*, ..., $calc.instruction.children[1])
				solution: $calc.instruction.children[2]
				solutionCalc: @Node(-:)
					- $calc.solution
					- $calc.instruction.children[1]
				end
				completed: @Node(*)
					- $Node(bold, $calc.instruction.children[2])
					- $calc.instruction.children[1]
				end
				target: $calc.solution
				id: $calc.solution-1
			end
		end
	end
end

/*
Transform a $ParamSet(mulN2) into an equality with hole second.
*/
ref mulHoleSecond: macro(...params)
	@QuestionFactory
		parameters: do
			- $mulN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(*, $calc.instruction.children[1], ...)
				solution: $calc.instruction.children[2]
				solutionCalc: @Node(-:)
					- $calc.solution
					- $calc.instruction.children[1]
				end
				completed: @Node(*)
					- $Node(bold, $calc.instruction.children[2])
					- $calc.instruction.children[1]
				end
				target: $calc.solution
				id: $calc.solution-2
			end
		end
	end
end


/*
Wrapper for $ParamSet(mulHoleFirst) and $ParamSet(mulHoleSecond).
*/
mulHole: macro(...args)
	$ (mulHoleFirst(...args) + mulHoleSecond(...args)).tree()
end

/*
Transform a $ParamSet(divQ2) into an equality with hole first.$newline
$Param(Bool, \0frac, false) to show decimal as frac.
*/
ref mulHoleFirstRationnal: macro(?frac, ...params)
	@QuestionFactory
		parameters: do
			- $divQ2(...params)
		end
		get: macro(calc)
			let solutionValue = $ calc.instruction.children[2]/calc.instruction.children[1]
			
			let solution = if solutionValue.floor()==solutionValue or (calc.period==0 and not frac)
				$solutionValue
			else
				@Node(/)
					- $calc.instruction.children[2]
					- $calc.instruction.children[1]
				end
			end
			@Question(calculHole)
				instruction: $Node(*, ..., $calc.instruction.children[1])
				solution: $solution
				completed: @Node(*)
					- $Node(bold, $solution) 
					- $calc.instruction.children[1]
				end
				target: $calc.instruction.children[2]
				id: $calc.id-1
			end
		end
	end
end

/*
Transform a $ParamSet(divQ2) into an equality with hole second.$newline
$Param(Bool, \0frac, false) to show decimal as frac.
*/
ref mulHoleSecondRationnal: macro(?frac, ...params)
	@QuestionFactory
		parameters: do
			- $divQ2(...params)
		end
		get: macro(calc)
			let solutionValue = $ calc.instruction.children[1]/calc.instruction.children[2]
			
			let solution = if solutionValue.floor()==solutionValue or (calc.period==0 and not frac)
				$solutionValue
			else
				@Node(/)
					- $calc.instruction.children[1]
					- $calc.instruction.children[2]
				end
			end
			@Question(calculHole)
				instruction: $Node(*, $calc.instruction.children[2], ...)
				solution: $solution
				completed: @Node(*)
					- $Node(bold, $solution)
					- $calc.instruction.children[2]
				end
				target: $calc.instruction.children[1]
				id: $calc.instruction.children[1]/$calc.instruction.children[2]
			end
		end
	end
end

/*
Wrapper for $ParamSet(mulHoleFirstRationnal) and $ParamSet(mulHoleFirstSecond).
*/
mulHoleRationnal: macro(...args)
	$ (mulHoleFirstRationnal(...args) + mulHoleSecondRationnal(...args)).tree()
end