macro decomposition(n, b: 10)
	let result = $Table()
	while n>0
		run $ Table.append(result, n % b)
		set n = $ (n/b).floor()
	end
	return $result
end

ref DecimalRepresentation: macro(Number x, b: 10)
	let intPart = $x.floor()
	// decimal length from the shortest decimal spelling of x
	let ns = $(String(x).replace(".", ""))
	let decLen = $(len(ns) - len(String(intPart)))
	let decPart = 0
	if decLen != 0
		set decPart = $ (x - intPart) * 10^decLen
		set decPart = $decPart.round()
	end
	let intFigures = $ decomposition(intPart, b: b)
	let decFigures = $ decomposition(decPart, b: b)
	// pad leading zeros up to the spelled decimal length
	while len(decFigures) < decLen
		run $ Table.append(decFigures, 0)
	end
	let sizeIntPart = $ len(intFigures)
	let sizeDecPart = $ len(decFigures)

	intPart: $intPart
	decPart: $decPart
	intFigures: $intFigures
	decFigures: $decFigures
	sizeIntPart: $sizeIntPart
	sizeDecPart: $sizeDecPart

	get: macro(i)
		if i>0
			$intFigures[i]
		else
			$decFigures[-i+1]
		end
	end

	getFigures: macro()
		for i in seq(self.sizeDecPart)
			- $self.decFigures[i]
		end
		for i in seq(self.sizeIntPart)
			- $self.intFigures[i]
		end
	end

	getFiguresAlong: macro(x)
		// decimal part emitted least-significant first, aligned on the decimal point
		let size = $ max(self.sizeDecPart, x.sizeDecPart)
		for i in seq(size)
			let j = $ self.sizeDecPart - size + i
			let k = $ x.sizeDecPart - size + i
			- $ (self.decFigures[j]? or 0, x.decFigures[k]? or 0)
		end
		set size = $ max(self.sizeIntPart, x.sizeIntPart)
		for i in seq(size)
			- $ (self.intFigures[i]? or 0, x.intFigures[i]? or 0)
		end
	end
end

// Weight of a table fact: 0 trivial (a or b in 0/1), 1 easy (min 2/5),
// 2 medium (min 3/4/6/9), 3 hard (min 7/8)
macro tableWeight(a, b)
	if a == 0 or a == 1 or b == 0 or b == 1
		return 0
	end
	if min(a, b) == 2 or min(a, b) == 5
		return 1
	end
	if min(a, b) == 7 or min(a, b) == 8
		return 3
	end
	return 2
end

// Score of one orientation of the long multiplication grid (rows = digits of
// the first operand, columns of the second): carries, diagonal assemblies,
// weighted table facts, width bonus
macro mulScore(dx, dy)
	let realCompute = 0
	let sum = $Table()
	for i, fx in enumerate(dx.getFigures())
		let carry = 0
		for j, fy in enumerate(dy.getFigures())
			let prod = $ fx * fy + carry
			if prod >= 10
				set carry = $ (prod / 10).floor()
				set realCompute += 1
			else
				set carry = 0
			end
			set sum[i] = $ sum[i]? or Table()
			set sum[i][j] = $ prod

			if sum[i-1]?[j+1]? and sum[i-1]?[j+1]? != 0 and prod != 0
				set realCompute += 1
			end

			set realCompute += $ tableWeight(fx, fy)
		end
		// store the row carry-out for the next row's diagonal check
		if carry != 0
			set sum[i][len(dy.getFigures()) + 1] = $carry
		end
	end

	// width bonus: one point per 4 digits beyond 3 (counting down)
	let w = $ dx.sizeIntPart + dx.sizeDecPart + dy.sizeIntPart + dy.sizeDecPart - 3
	let bonus = 0
	while w >= 4
		set w -= 4
		set bonus += 1
	end
	return $ realCompute + bonus
end

ref getCompute: do
	add: macro(x, y)
		let dx = $ DecimalRepresentation(x)
		let dy = $ DecimalRepresentation(y)

		let carry = 0
		let realCompute = 0
		for fx, fy in dx.getFiguresAlong(dy)
			let sum = $ fx + fy + carry
			if fx*fy != 0 or fy*carry != 0 or carry*fx != 0
				set realCompute += 1
			end
			if fx*fy*carry != 0
				set realCompute += 1
			end
			if sum >= 10
				set carry = 1
			else
				set carry = 0
			end
		end

		return $realCompute
	end

	sub: macro(x, y)
		let dx = $ DecimalRepresentation(x)
		let dy = $ DecimalRepresentation(y)

		let carry = 0
		let realCompute = 0
		for fx, fy in dx.getFiguresAlong(dy)
			let dif = $ fx - fy - carry
			if fy != 0
				set realCompute += 1
			end
			if carry != 0
				set realCompute += 1
			end
			if dif < 0
				set carry = 1
			else
				set carry = 0
			end
		end

		return $realCompute
	end

	mul: macro(x, y)
		let dx = $ DecimalRepresentation(x)
		let dy = $ DecimalRepresentation(y)
		return $ min(mulScore(dx, dy), mulScore(dy, dx))
	end

	pow: macro(x, y)
		let realCompute = 0
		let result = $x
		if y>0
			for i in seq(y-1)
				set realCompute += $ getCompute.mul(result, x)
				set result *= $x
			end
		end
		return $realCompute
	end
end