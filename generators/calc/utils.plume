macro decomposition(n, b: 10)
	let result = $Table()
	while n>0
		run $ Table.append(result, n % b)
		set n = $ (n/b).floor()
	end
	return $result
end

ref DecimalRepresentation: macro(Number x, b: 10)
	let intPart = $x.floor()
	// decimal length from the shortest decimal spelling of x
	let ns = $(String(x).replace(".", ""))
	let decLen = $(len(ns) - len(String(intPart)))
	let decPart = 0
	if decLen != 0
		set decPart = $ (x - intPart) * 10^decLen
		set decPart = $decPart.round()
	end
	let intFigures = $ decomposition(intPart, b: b)
	let decFigures = $ decomposition(decPart, b: b)
	// pad leading zeros up to the spelled decimal length
	while len(decFigures) < decLen
		run $ Table.append(decFigures, 0)
	end
	let sizeIntPart = $ len(intFigures)
	let sizeDecPart = $ len(decFigures)

	intPart: $intPart
	decPart: $decPart
	intFigures: $intFigures
	decFigures: $decFigures
	sizeIntPart: $sizeIntPart
	sizeDecPart: $sizeDecPart

	get: macro(i)
		if i>0
			$intFigures[i]
		else
			$decFigures[-i+1]
		end
	end

	getFigures: macro()
		for i in seq(self.sizeDecPart)
			- $self.decFigures[i]
		end
		for i in seq(self.sizeIntPart)
			- $self.intFigures[i]
		end
	end

	getFiguresAlong: macro(x)
		// decimal part emitted least-significant first, aligned on the decimal point
		let size = $ max(self.sizeDecPart, x.sizeDecPart)
		for i in seq(size)
			let j = $ self.sizeDecPart - size + i
			let k = $ x.sizeDecPart - size + i
			- $ (self.decFigures[j]? or 0, x.decFigures[k]? or 0)
		end
		set size = $ max(self.sizeIntPart, x.sizeIntPart)
		for i in seq(size)
			- $ (self.intFigures[i]? or 0, x.intFigures[i]? or 0)
		end
	end
end

// Weight of a table fact: 0 trivial (a or b in 0/1), 1 easy (min 2/5),
// 2 medium (min 3/4/6/9), 3 hard (min 7/8)
macro tableWeight(a, b)
	if a == 0 or a == 1 or b == 0 or b == 1
		return 0
	end
	if min(a, b) == 2 or min(a, b) == 5
		return 1
	end
	if min(a, b) == 7 or min(a, b) == 8
		return 3
	end
	return 2
end

// Score of one orientation of the long multiplication grid (rows = digits of
// the first operand, columns of the second): carries, diagonal assemblies,
// weighted table facts, width bonus
macro mulScore(dx, dy)
	let realCompute = 0
	let sum = $Table()
	for i, fx in enumerate(dx.getFigures())
		let carry = 0
		for j, fy in enumerate(dy.getFigures())
			let prod = $ fx * fy + carry
			if prod >= 10
				set carry = $ (prod / 10).floor()
				set realCompute += 1
			else
				set carry = 0
			end
			set sum[i] = $ sum[i]? or Table()
			set sum[i][j] = $ prod

			if sum[i-1]?[j+1]? and sum[i-1]?[j+1]? != 0 and prod != 0
				set realCompute += 1
			end

			set realCompute += $ tableWeight(fx, fy)
		end
		// store the row carry-out for the next row's diagonal check
		if carry != 0
			set sum[i][len(dy.getFigures()) + 1] = $carry
		end
	end

	// width bonus: one point per 4 digits beyond 3 (counting down)
	let w = $ dx.sizeIntPart + dx.sizeDecPart + dy.sizeIntPart + dy.sizeDecPart - 3
	let bonus = 0
	while w >= 4
		set w -= 4
		set bonus += 1
	end
	return $ realCompute + bonus
end

ref getCompute: do
	add: macro(x, y)
		let dx = $ DecimalRepresentation(x)
		let dy = $ DecimalRepresentation(y)

		let carry = 0
		let realCompute = 0
		for fx, fy in dx.getFiguresAlong(dy)
			let sum = $ fx + fy + carry
			if fx*fy != 0 or fy*carry != 0 or carry*fx != 0
				set realCompute += 1
			end
			if fx*fy*carry != 0
				set realCompute += 1
			end
			if sum >= 10
				set carry = 1
			else
				set carry = 0
			end
		end

		return $realCompute
	end

	sub: macro(x, y)
		let dx = $ DecimalRepresentation(x)
		let dy = $ DecimalRepresentation(y)

		let carry = 0
		let realCompute = 0
		for fx, fy in dx.getFiguresAlong(dy)
			let dif = $ fx - fy - carry
			if fy != 0
				set realCompute += 1
			end
			if carry != 0
				set realCompute += 1
			end
			if dif < 0
				set carry = 1
			else
				set carry = 0
			end
		end

		return $realCompute
	end

	mul: macro(x, y)
		if x==0 or x==1 or y==0 or y==1
			return 0
		end
		
		let dx = $ DecimalRepresentation(x)
		let dy = $ DecimalRepresentation(y)
		return $ min(mulScore(dx, dy), mulScore(dy, dx))
	end

	// Score of the French long division C / B: per quotient digit cycle
	// (decision, estimation table, row carries + tables, short subtraction)
	div: macro(C, B)
		if B==1 or C==0
			return 0
		end
		// French long division: one cycle per quotient digit (k=0 included)
		let const dx = $ DecimalRepresentation(C)
		let const dy = $ DecimalRepresentation(B)
		let const t = $ max(dx.sizeDecPart, dy.sizeDecPart)
		let const Cn = $ (C * 10^t).round()
		let const Bn = $ (B * 10^t).round()
		let const Cf = $ decomposition(Cn)
		let const Bf = $ decomposition(Bn)
		let const n = $ len(Cf)
		let const m = $ len(Bf)

		// one cycle: decision, estimation table, row carries + tables, short sub
		macro cycle(P, k)
			let carry = 0
			let rowCarry = 0
			let j = 1
			while j <= m
				let const p = $ k * Bf[j] + carry
				if p >= 10
					set rowCarry += 1
					set carry = $ (p / 10).floor()
				else
					set carry = 0
				end
				set j += 1
			end
			let rowTw = 0
			set j = 1
			while j < m
				set rowTw += $ tableWeight(k, Bf[j])
				set j += 1
			end
			return $ 1 + tableWeight(k, Bf[m]) + rowCarry + rowTw + getCompute.sub(P, k * Bn)
		end

		// L = length of the first prefix of Cn >= Bn (0: quotient < 1)
		let L = 0
		let P = 0
		let j = 1
		while j <= n
			set P = $ P * 10 + Cf[n - j + 1]
			if L == 0 and P >= Bn
				set L = $j
			end
			set j += 1
		end

		let score = 0
		let r = 0
		if L != 0
			let Q = 0
			set j = 1
			while j <= L
				set Q = $ Q * 10 + Cf[n - j + 1]
				set j += 1
			end
			set P = $Q
			while r < n - L + 1
				set r += 1
				let const k = $ (P / Bn).floor()
				set score += $ cycle(P, k)
				set P = $ P - k * Bn
				if r < n - L + 1
					set P = $ P * 10 + Cf[n - L - r + 1]
				end
			end
		end

		// decimal part: bring down zeros until the exact remainder 0
		// (guard r < 20: non-terminating decimals stop early, e.g. 1/3)
		while P > 0 and r < 20
			set r += 1
			set P *= 10
			let const k = $ (P / Bn).floor()
			set score += $ cycle(P, k)
			set P = $ P - k * Bn
		end

		return $score
	end

	pow: macro(x, y)
		if x==0 or x==1 or y==0 or y==1
			return 0
		end

		let realCompute = 0
		let result = $x
		let e = $y
		if y < 0
			set e = $ -1 * y
		end
		if e > 0
			for i in seq(e-1)
				set realCompute += $ getCompute.mul(result, x)
				set result *= $x
			end
		end
		if y < 0
			set realCompute += $ getCompute.div(1, result)
		end
		return $realCompute
	end

	// Score of the digit-by-digit square root of n (French extraction):
	// one cycle per pair of digits around the decimal point — decision +1,
	// estimation fact, trial row k x (20R + k) (carries + tables), short sub.
	// Decimal digits come from DecimalRepresentation, which keeps the leading
	// zeros of the decimal part; radicands below 1e-4 are out of scope (T27).
	sqrt: macro(n)
		// value of the c-th two-digit group (c from 1, most-significant
		// first) of an LSB-first figures table: a lone most-significant
		// digit when the length is odd
		macro pairValue(f, c)
			let const L = $ len(f)
			if L % 2 == 1 and c == 1
				return $ f[L]
			end
			let const top = $ L - 2 * c + 2 + (L % 2)
			return $ f[top]*10 + f[top-1]
		end

		let const d = $ DecimalRepresentation(n)
		let const ip = $ d.intFigures
		let const dp = $ d.decFigures
		let const nI = $ ((len(ip) + 1) / 2).floor()
		let const nD = $ ((len(dp) + 1) / 2).floor()
		let const total = $ nI + nD

		// one cycle: decision, estimation fact, trial row, short subtraction
		macro cycle(P, R, k)
			let est = 0
			if R == 0
				set est = $ tableWeight(k, k)
			else
				let const rf = $ decomposition(2 * R)
				set est = $ tableWeight(k, rf[len(rf)])
			end
			let rowCarry = 0
			let rowTw = 0
			if R != 0
				let const Nf = $ decomposition(20 * R + k)
				let carry = 0
				let j = 1
				while j <= len(Nf)
					let const p = $ k * Nf[j] + carry
					if p >= 10
						set rowCarry += 1
						set carry = $ (p / 10).floor()
					else
						set carry = 0
					end
					set j += 1
				end
				set j = 1
				while j < len(Nf)
					set rowTw += $ tableWeight(k, Nf[j])
					set j += 1
				end
			end
			return $ 1 + est + rowCarry + rowTw + getCompute.sub(P, k * (20 * R + k))
		end

		let P = 0
		let R = 0
		let score = 0
		let c = 1
		while c <= total
			let g = 0
			if c <= nI
				set g = $ pairValue(ip, c)
			else
				set g = $ pairValue(dp, c - nI)
			end
			set P = $ P * 100 + g
			// k: largest 0..9 with (20R + k) * k <= P (off perfect squares too)
			let k = 0
			while (20 * R + k + 1) * (k + 1) <= P
				set k += 1
			end
			let const N = $ 20 * R + k
			set score += $ cycle(P, R, k)
			set R = $ R * 10 + k
			set P = $ P - k * N
			set c += 1
		end

		return $score
	end
end