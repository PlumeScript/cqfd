let FactNumber, FactNumber2Coprimes, FactNumber4 from $import(../../core/parameters/factNumber)
let Range from $import(../../core/parameters/range)
let Choice from $import(../../core/parameters/set)

let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Node from $import(../../core/utils/tree)
let FactNumberCls from $import(../../core/utils/factNumber)

macro prettyFrac(a, b)
	if a == 0
		0
	elseif b == 1
		$a
	else
		$Node(/, $a, $b)
	end
end

/*
Generate a fraction $formula(\\frac{ak}{bk}) to simplify, where $code(a\, b) result of $ParamSet(FactNumber2Coprimes).$newline
$code(k) is between $Param(Number, minK, 2) and $Param(Number, maxK, 10).
*/
ref simplifyRationnal: macro(minP:, maxP:, maxE:, minN: 2, maxN: 1000, minK: 2, maxK: 10)
	@QuestionFactory
		parameters: do
			- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			- $ Range(minK, maxK)
		end
		validate: macro(r, k)
			return $ r[1].value * k >= minN and r[1].value * k <= maxN and r[2].value * k >= minN and r[2].value * k <= maxN
		end
		get: macro(r, k)
			@Question(calcul)
				instruction: @Node(/)
					- $ r[1].value * k
					- $ r[2].value * k
				end
				solution: @Node(/)
					- $r[1].value
					- $r[2].value
				end
			end
		end
	end
end

/*
Generate a fraction $formula(\\frac{nk}{k}) that simplifies to an integer $ParamSet(FactNumber).$newline
$code(k) is between $Param(Number, minK, 2) and $Param(Number, maxK, 10).
*/
ref simplifyRationnalInteger: macro(minP:, maxP:, maxE:, minN: 2, maxN: 1000, minK: 2, maxK: 10)
	@QuestionFactory
		parameters: do
			- $ FactNumber(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			- $ Range(minK, maxK)
		end
		get: macro(r, k)
			@Question(calcul)
				instruction: @Node(/)
					- $ r.value * k
					- $ k
				end
				solution: $r.value
			end
		end
	end
end

/*
Generate an irreducible fraction with $ParamSet(FactNumber2Coprimes)
*/
ref simplifyRationnalIrreductible: macro(minP:, maxP:, maxE:, minN: 2, maxN: 1000, minK: 2, maxK: 10)
	@QuestionFactory
		parameters: do
			- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
		end
		get: macro(r)
			@Question(calcul)
				instruction: @Node(/)
					- $r[1].value
					- $r[2].value
				end
				solution: @Node(/)
					- $r[1].value
					- $r[2].value
				end
			end
		end
	end
end

/*
Rewrite a $ParamSet(simplifyRationnal) as a hole equality between the fraction and its simplification.
*/
rationnalHoleEquality: macro(minP:, maxP:, maxE:, minN:, maxN:, minK: 2, maxK: 10)
	@QuestionFactory
		parameters: do
			- $ simplifyRationnal(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN, minK: minK, maxK: maxK)
			- $ Choice(1, 2, 3, 4)
			- $ Choice(0, 1)
		end
		get: macro(exo, holePos, switch)
			let a = $exo.instruction
			let b = $exo.solution

			if switch == 1
				set a, b = ($b, $a)
			end

			@Question(calcRationnalHole)
				instruction: do
					left: @Node(/)
						- if holePos != 1
							$ a.children[1]
						else
							\0...
						end
						- if holePos != 2
							$ a.children[2]
						else
							\0...
						end
					end
					right: @Node(/)
						- if holePos != 3
							$ b.children[1]
						else
							\0...
						end
						- if holePos != 4
							$ b.children[2]
						else
							\0...
						end
					end
				end
				solution:do
					left: $a
					right: $b
				end
				id: $exo.id-$holePos-$switch
			end
		end
	end
end

/*
Generate two fractions to rewrite with a common denominator. Use $ParamSet(FactNumber).$newline
Support $code(\0?integer), $code(\0?coprime) and $code(\0?multiple).
*/
reduceCommonDenominator: macro(minP:, maxP:, maxE:, minN:, maxN:, minK: 2, maxK: 10, ?multiple, ?coprime, ?integer)
	if integer and (multiple or coprime)
		raise Integer flag must be used alone
	end
	@QuestionFactory
		parameters: do
			if integer
				- $ FactNumber(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
				- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			else
				- $ FactNumber4(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN, minK: minK, maxK: maxK, multiple: multiple, coprime: coprime)
				- $Choice(1)
			end
		end
		hyperParameters: do
			- $Range(0, 100)
		end
		get: macro(base, second, switch)
			@Question(reduceCommonDenominator)
				let a, b, c, d = if integer
					- $base
					- $ FactNumberCls.fromNumber(1)
					...second
				else
					...base
				end

				if switch % 2 == 0
					set a, b, c, d = ($c, $d, $a, $b)
				end

				let e = $ b.lcm(d)
				let as = $ a.value * e.value / b.value
				let cs = $ c.value * e.value / d.value

				instruction: do
					- @prettyFrac
						- $a.value
						- $b.value
					end
					- @prettyFrac
						- $c.value
						- $d.value
					end
				end
				solution: do
					- @prettyFrac
						- $as
						- $e.value
					end
					- @prettyFrac
						- $cs
						- $e.value
					end
				end
			end
		end
	end
end

/*
Generate an addition or a subtraction between two fractions, using $ParamSet(FactNumber4).$newline
Use flag $code(\0?integer) to generate an addition or a substraction between a integer and a fraction.$newline
Use flag $code(\0?percentage) to rewrite one fraction as $formula(a%).$newline
Use flag $code(\0?noSimplification) to prevent simplification..$newline
Use flag $code(\0?noNegative) to prevent negatives numbers.
*/
addSubRationnal: macro(minP:, maxP:, maxE:, minN:, maxN:, minK: 2, maxK: 10, ?sameDenominator, ?noSameNumerator, ?multiple, ?coprime, ?integer, ?percentage, ?noSimplification, ?noNegative)
	@QuestionFactory
		parameters: do
			if integer
				- $ FactNumber(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
				- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			else
				- $ FactNumber4(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN, minK: minK, maxK: maxK, multiple: multiple, coprime: coprime, sameDenominator: sameDenominator, noSameNumerator: noSameNumerator, forceb: (percentage and 100))
				- $Choice(1)
			end
			- $Choice(+, -)
		end
		hyperParameters: do
			- $Range(0, 100)
		end
		get: macro(base, second, opp, switch)
			@Question(calcul)
				let a, b, c, d = if integer
					- $base
					- $ FactNumberCls.fromNumber(1)
					...second
				else
					...base
				end

				if switch % 2 == 0
					set a, b, c, d = ($c, $d, $a, $b)
				end

				let bottom = $ b.lcm(d)
				let left  = $ a.value * bottom.value / b.value
				let right = $ c.value * bottom.value / d.value

				if opp == "-"
					set right *= -1
				end

				if noNegative and left + right < 0
					set left, right = ($(-right), $(-left))
					set a, b, c, d = ($c, $d, $a, $b)
				end

				let top = $ FactNumberCls.fromNumber(left + right)
				let k = $ top.gcd(bottom)

				instruction: @Node($opp)
					- if percentage and b.value == 100
						$a.value \\%
					else
						@prettyFrac
							- $a.value
							- $b.value
						end
					end
					- if percentage and d.value == 100
						$d.value \\%
					else
						@prettyFrac
							- $c.value
							- $d.value
						end
					end
				end
				beforeSimplification: @prettyFrac
					- $top.value
					- $bottom.value
				end
				simplification: if noSimplification
					1
				else
					$k.value
				end
				solution: if noSimplification
					@Node(/)
						- $ top.value
						- $ bottom.value
					end
				elseif top.value/bottom.value == (top.value/bottom.value).floor()
					$ top.value/bottom.value
				else
					@Node(/)
						- $ top.value / k.value
						- $ bottom.value / k.value
					end
				end
				usualTrap: @prettyFrac
					- $ a.value + c.value
					- $ b.value + d.value
				end
			end
		end
	end
end

/*
Generate a multiplication between two fractions $ParamSet(FactNumber2Coprimes), capped by the simplification factor between $Param(Number, minK, 2) and $Param(Number, maxK, 10)..$newline
Use flag $code(\0?integer) to generate a multiplication between a integer and a fraction.$newline
Use flag $code(\0?percentage) to rewrite one fraction as $formula(a%).$newline
Use flag $code(\0?noSimplification) to prevent simplification.
*/
ref mulRationnal: macro(minP:, maxP:, maxE:, minN:, maxN:, minK:, maxK:, ?percentage, ?integer, ?noSimplification)
	@QuestionFactory
		parameters:do
			if integer
				- $ FactNumber(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			else
				- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			end
			- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN, force: (percentage and 100))
		end
		hyperParameters: do
			- $Range(0, 100)
		end
		get: macro(ab, cd, switch)
			let a, b = if integer
				$Table($ab, $FactNumberCls.fromNumber(1))
			else
				$ab
			end
			let d, c = $cd

			if switch % 2 == 0
				set a, b, c, d = ($c, $d, $a, $b)
			end

			let top    = $ a*c
			let bottom = $ b*d
			let k = $ top.gcd(bottom)

			// Expensive
			if minK and k.value < minK or maxK and k.value > maxK
				return
			end

			return @Question(calcul)
				infos: do
					a: $a
					b: $b
					c: $c
					d: $d
				end
				instruction: @Node(*)
					- @prettyFrac
						- $a.value
						- $b.value
					end
					- if percentage and d.value == 100
						$c.value \\%
					else
						@prettyFrac
							- $c.value
							- $d.value
						end
					end
				end
				steps: do
					- @Node(/)
						- @Node(*)
							- $a.value
							- $c.value
						end
						- @Node(*)
							- $b.value
							- $d.value
						end
					end
				end
				beforeSimplification: @Node(/)
					- $top.value
					- $bottom.value
				end
				simplification: if noSimplification
					1
				else
					$k.value
				end
				solution: if noSimplification
					@Node(/)
						- $top.value
						- $bottom.value
					end
				else
					@prettyFrac
						- $ top.value / k.value
						- $ bottom.value / k.value
					end
				end
				usualTrap: @prettyFrac
					- $ a.value*b.value
					- $ c.value
				end
			end
		end
	end
end

/*
Convert a $ParamSet(mulRationnal) to a division.
*/
divRationnal: macro(...args)
	@QuestionFactory
		parameters: do
			- $ mulRationnal(...args)
		end
		get: macro(calc)
			return @Question(calcul)
				...calc
				instruction: @Node(-:)
					- @Node(/)
						- $calc.infos.a.value
						- $calc.infos.b.value
					end
					- @Node(/)
						- $calc.infos.d.value
						- $calc.infos.c.value
					end
				end
				steps: do
					- $calc.instruction
					...calc.steps
				end
				usualTrap: @prettyFrac
					- $ calc.info.a.value*calc.info.b.value
					- $ calc.info.c.value*calc.info.d.value
				end
			end
		end
	end
end