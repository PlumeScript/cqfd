let FactNumber2Coprimes, FactNumber4 from $import(../../core/parameters/factNumber)
let Range from $import(../../core/parameters/range)
let Choice from $import(../../core/parameters/set)

let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Node from $import(../../core/utils/tree)

ref simplifyRationnal: macro(minP:, maxP:, maxE:, minN: 2, maxN: 1000, minK: 2, maxK: 10)
	@QuestionFactory
		parameters: do
			- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			- $ Range(minK, maxK)
		end
		validate: macro(r, k)
			return $ r[1].value * k >= minN and r[1].value * k <= maxN and r[2].value * k >= minN and r[2].value * k <= maxN
		end
		get: macro(r, k)
			@Question(calcul)
				instruction: @Node(/)
					- $ r[1].value * k
					- $ r[2].value * k
				end
				solution: @Node(/)
					- $r[1].value
					- $r[2].value
				end
			end
		end
	end
end

ref simplifyRationnalIrreductible: macro(minP:, maxP:, maxE:, minN: 2, maxN: 1000, minK: 2, maxK: 10)
	@QuestionFactory
		parameters: do
			- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
		end
		get: macro(r)
			@Question(calcul)
				instruction: @Node(/)
					- $r[1].value
					- $r[2].value
				end
				solution: @Node(/)
					- $r[1].value
					- $r[2].value
				end
			end
		end
	end
end

rationnalHoleEquality: macro(minP:, maxP:, maxE:, minN:, maxN:, minK: 2, maxK: 10)
	@QuestionFactory
		parameters: do
			- $ simplifyRationnal(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			- $ Choice(1, 2, 3, 4)
			- $ Choice(0, 1)
		end
		get: macro(exo, holePos, switch)
			let a = $exo.instruction
			let b = $exo.solution

			if switch == 1
				set a, b = ($b, $a)
			end

			@Question(calcRationnalHole)
				instruction: do
					left: @Node(/)
						- if holePos != 1
							$ a.children[1]
						else
							\0...
						end
						- if holePos != 2
							$ a.children[2]
						else
							\0...
						end
					end
					right: @Node(/)
						- if holePos != 3
							$ b.children[1]
						else
							\0...
						end
						- if holePos != 4
							$ b.children[2]
						else
							\0...
						end
					end
				end
				solution:do
					left: $a
					right: $b
				end
				id: $exo.id-$holePos-$switch
			end
		end
	end
end

reduceCommonDenominator: macro(minP:, maxP:, maxE:, minN:, maxN:, minK: 2, maxK: 10, ?multiple, ?coprime)
	@QuestionFactory
		parameters: do
			- $ FactNumber4(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN, minK: minK, maxK: maxK, multiple: multiple, coprime: coprime)
		end
		get: macro(base)
			@Question(reduceCommonDenominator)
				let a, b, c, d = $base
				let e = $ b.lcm(d)
				let as = $ a.value * e.value / b.value
				let cs = $ c.value * e.value / d.value

				instruction: do
					- @Node(/)
						- $a.value
						- $b.value
					end
					- @Node(/)
						- $c.value
						- $d.value
					end
				end
				solution: do
					- @Node(/)
						- $as
						- $e.value
					end
					- @Node(/)
						- $cs
						- $e.value
					end
				end
			end
		end
	end
end