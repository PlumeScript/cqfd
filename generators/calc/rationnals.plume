let FactNumber, FactNumber2Coprimes, FactNumber4 from $import(../../core/parameters/factNumber)
let Range from $import(../../core/parameters/range)
let Choice from $import(../../core/parameters/set)

let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Node from $import(../../core/utils/tree)
let FactNumberCls from $import(../../core/utils/factNumber)

macro prettyFrac(a, b)
	if a == 0
		0
	elseif b == 1
		$a
	else
		$Node(/, $a, $b)
	end
end

ref simplifyRationnal: macro(minP:, maxP:, maxE:, minN: 2, maxN: 1000, minK: 2, maxK: 10)
	@QuestionFactory
		parameters: do
			- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			- $ Range(minK, maxK)
		end
		validate: macro(r, k)
			return $ r[1].value * k >= minN and r[1].value * k <= maxN and r[2].value * k >= minN and r[2].value * k <= maxN
		end
		get: macro(r, k)
			@Question(calcul)
				instruction: @Node(/)
					- $ r[1].value * k
					- $ r[2].value * k
				end
				solution: @Node(/)
					- $r[1].value
					- $r[2].value
				end
			end
		end
	end
end

ref simplifyRationnalInteger: macro(minP:, maxP:, maxE:, minN: 2, maxN: 1000, minK: 2, maxK: 10)
	@QuestionFactory
		parameters: do
			- $ FactNumber(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			- $ Range(minK, maxK)
		end
		get: macro(r, k)
			@Question(calcul)
				instruction: @Node(/)
					- $ r.value * k
					- $ k
				end
				solution: $r.value
			end
		end
	end
end

ref simplifyRationnalIrreductible: macro(minP:, maxP:, maxE:, minN: 2, maxN: 1000, minK: 2, maxK: 10)
	@QuestionFactory
		parameters: do
			- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
		end
		get: macro(r)
			@Question(calcul)
				instruction: @Node(/)
					- $r[1].value
					- $r[2].value
				end
				solution: @Node(/)
					- $r[1].value
					- $r[2].value
				end
			end
		end
	end
end

rationnalHoleEquality: macro(minP:, maxP:, maxE:, minN:, maxN:, minK: 2, maxK: 10)
	@QuestionFactory
		parameters: do
			- $ simplifyRationnal(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			- $ Choice(1, 2, 3, 4)
			- $ Choice(0, 1)
		end
		get: macro(exo, holePos, switch)
			let a = $exo.instruction
			let b = $exo.solution

			if switch == 1
				set a, b = ($b, $a)
			end

			@Question(calcRationnalHole)
				instruction: do
					left: @Node(/)
						- if holePos != 1
							$ a.children[1]
						else
							\0...
						end
						- if holePos != 2
							$ a.children[2]
						else
							\0...
						end
					end
					right: @Node(/)
						- if holePos != 3
							$ b.children[1]
						else
							\0...
						end
						- if holePos != 4
							$ b.children[2]
						else
							\0...
						end
					end
				end
				solution:do
					left: $a
					right: $b
				end
				id: $exo.id-$holePos-$switch
			end
		end
	end
end

reduceCommonDenominator: macro(minP:, maxP:, maxE:, minN:, maxN:, minK: 2, maxK: 10, ?multiple, ?coprime, ?integer)
	if integer and (multiple or coprime)
		raise Integer flag must be used alone
	end
	@QuestionFactory
		parameters: do
			if integer
				- $ FactNumber(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
				- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			else
				- $ FactNumber4(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN, minK: minK, maxK: maxK, multiple: multiple, coprime: coprime)
				- $Choice(1)
			end
		end
		hyperParameter: do
			- $Range(0, 100)
		end
		get: macro(base, second, switch)
			@Question(reduceCommonDenominator)
				let a, b, c, d = if integer
					- $base
					- $ FactNumberCls.fromNumber(1)
					...second
				else
					...base
				end

				if switch % 2 == 0
					set a, b, c, d = ($c, $d, $a, $b)
				end

				let e = $ b.lcm(d)
				let as = $ a.value * e.value / b.value
				let cs = $ c.value * e.value / d.value

				instruction: do
					- @prettyFrac
						- $a.value
						- $b.value
					end
					- @prettyFrac
						- $c.value
						- $d.value
					end
				end
				solution: do
					- @prettyFrac
						- $as
						- $e.value
					end
					- @prettyFrac
						- $cs
						- $e.value
					end
				end
			end
		end
	end
end

addSubRationnal: macro(minP:, maxP:, maxE:, minN:, maxN:, minK: 2, maxK: 10, ?sameDenominator, ?noSameNumerator, ?multiple, ?coprime, ?integer)
	@QuestionFactory
		parameters: do
			if integer
				- $ FactNumber(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
				- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			else
				- $ FactNumber4(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN, minK: minK, maxK: maxK, multiple: multiple, coprime: coprime, sameDenominator: sameDenominator, noSameNumerator: noSameNumerator)
				- $Choice(1)
			end
			- $Choice(+, -)
		end
		hyperParameters: do
			- $Range(0, 100)
		end
		get: macro(base, second, opp, switch)
			@Question(calcul)
				let a, b, c, d = if integer
					- $base
					- $ FactNumberCls.fromNumber(1)
					...second
				else
					...base
				end

				if switch % 2 == 0
					set a, b, c, d = ($c, $d, $a, $b)
				end

				

				let bottom = $ b.lcm(d)
				let left  = $ a.value * bottom.value / b.value
				let right = $ c.value * bottom.value / d.value

				if opp == "-"
					set right *= -1
				end

				let top = $ FactNumberCls.fromNumber(left + right)
				let k = $ top.gcd(bottom)

				instruction: @Node($opp)
					- @prettyFrac
						- $a.value
						- $b.value
					end
					- @prettyFrac
						- $c.value
						- $d.value
					end
				end
				beforeSimplification: @prettyFrac
					- $top.value
					- $bottom.value
				end
				simplification: $k.value
				
				solution: if top.value/bottom.value == (top.value/bottom.value).floor()
					$ top.value/bottom.value
				else
					@Node(/)
						- $ top.value / k.value
						- $ bottom.value / k.value
					end
				end
			end
		end
	end
end

ref mulRationnal: macro(minP:, maxP:, maxE:, minN:, maxN:, minK:, maxK:)
	@QuestionFactory
		parameters: do
			- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
			- $ FactNumber2Coprimes(minP: minP, maxP: maxP, maxE: maxE, minN: minN, maxN: maxN)
		end

		get: macro(ab, cd)
			let a, b = $ab
			let c, d = $cd

			let top    = $ a*c
			let bottom = $ b*d
			let k = $ top.gcd(bottom)

			// Expensive
			if minK and k.value < minK or maxK and k.value > maxK
				return
			end

			return @Question(calcul)
				infos: do
					a: $a
					b: $b
					c: $c
					d: $d
				end
				instruction: @Node(*)
					- @Node(/)
						- $a.value
						- $b.value
					end
					- @Node(/)
						- $c.value
						- $d.value
					end
				end
				steps: do
					- @Node(/)
						- @Node(*)
							- $a.value
							- $c.value
						end
						- @Node(*)
							- $b.value
							- $d.value
						end
					end
				end
				beforeSimplification: @Node(/)
					- $top.value
					- $bottom.value
				end
				simplification: $k.value
				solution: @Node(/)
					- $ top.value / k.value
					- $ bottom.value / k.value
				end
			end
		end
	end
end

divRationnal: macro(...args)
	@QuestionFactory
		parameters: do
			- $ mulRationnal(...args)
		end
		get: macro(calc)
			return @Question(calcul)
				...calc
				instruction: @Node(-:)
					- @Node(/)
						- $calc.infos.a.value
						- $calc.infos.b.value
					end
					- @Node(/)
						- $calc.infos.d.value
						- $calc.infos.c.value
					end
				end
				steps: do
					- $calc.instruction
					...calc.steps
				end
			end
		end
	end
end