let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Node from $import(../../core/utils/tree)
let Decimal from $import(../../core/parameters/range)
let DecimalRepresentation from $import(./utils)

addN2: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:, maxCompute:, compute:)
	if figures
		set minFigures = $figures
		set maxFigures = $figures
	end
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		type: astNumber
		validate: macro(x, y)
			if not minCompute and not maxCompute
				return $true
			end

			let dx = $ DecimalRepresentation(x)
			let dy = $ DecimalRepresentation(y)

			let carry = 0
			let realCompute = 0
			for fx, fy in dx.getFiguresAlong(dy)
				let sum = $ fx + fy + carry
				if fx*fy != 0 or fy*carry != 0 or carry*fx != 0
					set realCompute += 1
				end
				if fx*fy*carry != 0
					set realCompute += 1
				end
				if sum >= 10
					set carry = 1
				else
					set carry = 0
				end
			end

			return $ (not minCompute or minCompute <= realCompute) and (not maxCompute or maxCompute >= realCompute)
		end
		get: macro(x, y)
			@Question(calcul)
				instruction: $ Node("+", x, y)
				solution: $(x+y)
				id: $max($x, $y)+$min($x, $y)
			end
		end
	end
end

subN2: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:, maxCompute:, compute:)
	if figures
		set minFigures = $figures
		set maxFigures = $figures
	end
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		type: astNumber
		validate: macro(x, y)
			if x<y
				return $false
			end
			if not minCompute and not maxCompute
				return $true
			end

			let dx = $ DecimalRepresentation(x)
			let dy = $ DecimalRepresentation(y)

			let carry = 0
			let realCompute = 0
			for fx, fy in dx.getFiguresAlong(dy)
				let dif = $ fx - fy - carry
				if fy != 0
					set realCompute += 1
				end
				if carry != 0
					set realCompute += 1
				end
				if dif < 0
					set carry = 1
				else
					set carry = 0
				end
			end
			
			return $ (not minCompute or minCompute <= realCompute) and (not maxCompute or maxCompute >= realCompute)
		end
		get: macro(x, y)
			@Question(calcul)
				instruction: $ Node("-", x, y)
				solution: $(x-y)
				id: $x-$y
			end
		end
	end
end

// TODO: consider figureNumber
mulN2: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:, maxCompute:, compute:)
	if figures
		set minFigures = $figures
		set maxFigures = $figures
	end
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end
	// TODO: check carry values against number size
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		type: astNumber
		validate: macro(x, y)
			if not minCompute and not maxCompute
				return $true
			end

			let dx = $ DecimalRepresentation(x)
			let dy = $ DecimalRepresentation(y)

			let realCompute = 0
			let sum = $Table()
			for i, fx in enumerate(dx.getFigures())
				let carry = 0
				for j, fy in enumerate(dy.getFigures())
					let prod = $ fx * fy + carry
					if prod >= 10
						set carry = $ (prod / 10).floor()
						set realCompute += 1
					else
						set carry = 0
					end
					set sum[i] = $ sum[i]? or Table()
					set sum[i][j] = $ prod

					if sum[i-1]?[j+1]? and sum[i-1]?[j+1]? != 0 and prod != 0
						set realCompute += 1
					end

					if fx != 0 and fy != 0 and fx != 1 and fy != 1
						set realCompute += 1
					end
				end
			end

			return $ (not minCompute or minCompute <= realCompute) and (not maxCompute or maxCompute >= realCompute)
		end
		get: macro(x, y)
			@Question(calcul)
				instruction: $ Node("*", x, y)
				solution: $(x*y)
				id: $max($x, $y)*$min($x, $y)
			end
		end
	end
end
