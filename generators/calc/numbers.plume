let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Node from $import(../../core/utils/tree)
let Choice from $import(../../core/parameters/set)
let Range, Decimal from $import(../../core/parameters/range)
let DecimalRepresentation, getCompute from $import(./utils)

ref addN2: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:, maxCompute:, compute:)
	if figures
		set minFigures = $figures
		set maxFigures = $figures
	end
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		type: astNumber
		validate: macro(x, y)
			if not minCompute and not maxCompute
				return $true
			end

			let realCompute = $ getCompute.add(x, y)

			return $ (not minCompute or minCompute <= realCompute) and (not maxCompute or maxCompute >= realCompute)
		end
		get: macro(x, y)
			@Question(calcul)
				instruction: $ Node("+", x, y)
				solution: $(x+y)
				id: $max($x, $y)+$min($x, $y)
			end
		end
	end
end

ref subN2: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:, maxCompute:, compute:)
	if figures
		set minFigures = $figures
		set maxFigures = $figures
	end
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		type: astNumber
		validate: macro(x, y)
			if x<y
				return $false
			end
			if not minCompute and not maxCompute
				return $true
			end

			let realCompute = $ getCompute.sub(x, y)
			
			return $ (not minCompute or minCompute <= realCompute) and (not maxCompute or maxCompute >= realCompute)
		end
		get: macro(x, y)
			@Question(calcul)
				instruction: $ Node("-", x, y)
				solution: $(x-y)
				id: $x-$y
			end
		end
	end
end


macro makeZ(A, B, C, signA, signB, bigger)
	if bigger=="A" and A<B or bigger=="B" and A>B
		set A, B = ($B, $A)
	end

	if signA == "-"
		set A = $Node(-, $A)
	end
	if signB == "-"
		set B = $Node(-, $B)
	end
	if bigger=="A" and signA == "-" or bigger=="B" and signB == "-"
		if C != 0
			set C = $Node(-, $C)
		end
	end
	return $ (A, B, C)
end

ref addZ2Plus: macro(...args)
	@QuestionFactory
		parameters: do
			signA: $Choice(+, -)
			bigger: $Choice(A, B)
		end

		hyperParameters: do
			calc: $ addN2(...args)
		end

		get: macro(signA:, bigger:, calc:)
			let A = $calc.instruction.children[1]
			let B = $calc.instruction.children[2]
			let C = $calc.solution

			let signB = if signA == "+"
				+
			else
				\0-
			end

			set A, B, C = $ makeZ(A, B, C, signA, signB, bigger)

			@Question(calcul)
				instruction: $ Node("+", A, B)
				solution: $C
				id: $signA$signB$bigger$calc.id
			end
		end
	end
end

ref addZ2Minus: macro(...args)
	@QuestionFactory
		parameters: do
			signA: $Choice(+, -)
			bigger: $Choice(A, B)
			
		end

		hyperParameters: do
			calc: $ subN2(...args)
		end

		get: macro(signA:, bigger:, calc:)
			let A = $calc.instruction.children[1]
			let B = $calc.instruction.children[2]
			let C = $calc.solution

			let signB = if signA == "+"
				\0-
			else
				+
			end

			set A, B, C = $ makeZ(A, B, C, signA, signB, bigger)

			@Question(calcul)
				instruction: $ Node("+", A, B)
				solution: $C
				id: $signA$signB$bigger$calc.id
			end
		end
	end
end

ref addZ2: macro(...args)
	$ addZ2Plus(...args) * addZ2Minus(...args)
end

subZ2: macro(...args)
	@QuestionFactory
		parameters: $Table($addZ2(...args))
		get: macro(calc)
			let A = $calc.instruction.children[1]
			let B = $calc.instruction.children[2]

			if type(B) == "table" and B.label? == "-"
				set B = $B.children[1]
			else
				set B = $Node(-, $B)
			end

			@Question(calcul)
				instruction: $ Node("-", A, B)
				solution: $calc.solution
				id: -$calc.id
			end
		end
	end
end

// TODO: consider figureNumber
ref mulN2: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:, maxCompute:, compute:)
	if figures
		set minFigures = $figures
		set maxFigures = $figures
	end
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end
	// TODO: check carry values against number size
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		type: astNumber
		validate: macro(x, y)
			if not minCompute and not maxCompute
				return $true
			end

			let realCompute = $ getCompute.mul(x, y)

			return $ (not minCompute or minCompute <= realCompute) and (not maxCompute or maxCompute >= realCompute)
		end
		get: macro(x, y)
			@Question(calcul)
				instruction: $ Node("*", x, y)
				solution: $(x*y)
				id: $max($x, $y)*$min($x, $y)
			end
		end
	end
end

// TODO: toggle full parenthesis (ex: (+1) * (-2)) (same for addZ2)
mulZ2: macro(...params)
	@QuestionFactory
		parameters: do
			signA: $Choice(+, -)
			signB: $Choice(+, -)
		end
		hyperParameters: do
			calc: $mulN2(...params)
		end
		get: macro(signA:, signB:, calc:)
			let A = $calc.instruction.children[1]
			let B = $calc.instruction.children[2]
			let C = $calc.solution

			if signA == "-"
				set A = $Node(-, $A)
			end
			if signB == "-"
				set B = $Node(-, $B)
			end
			if signA != signB
				set C = $Node(-, $C)
			end

			@Question(calcul)
				instruction: $ Node("*", A, B)
				solution: $C
				id: $signA$signB$calc.id
			end
		end
	end
end

ref powN2: macro(Number minIndex:0, Number maxIndex:0, Number minFigures: 1, Number maxFigures: 1, figures:, minCompute:, maxCompute:, compute:, Number minExposant: 0, Number maxExposant: 3, ?negativeExposant)
	if figures
		set minFigures = $figures
		set maxFigures = $figures
	end
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end

	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Range(minExposant, maxExposant)
		end
		validate: macro(x, y)
			if not minCompute and not maxCompute
				return $true
			end

			let realCompute = $ getCompute.pow(x, y)

			return $ (not minCompute or minCompute <= realCompute) and (not maxCompute or maxCompute >= realCompute)
		end
		get: macro(x, y)
			@Question(calcul)
				instruction: $Node(^, $x, $y)
				solution: $(x^y)
				id: $x^$y
			end
		end
	end
end

powZ2: macro(...args)
	@QuestionFactory
		parameters: $Table($powN2(...args))
		get: macro(calc)
			let x = $calc.instruction.children[1]
			let y = $calc.instruction.children[2]
			@Question(calcul)
				instruction: $ Node("^", Node("-", x), y)
				solution: $((-x)^y)
				id: -$x^$y
			end
		end
	end
end

addN2HoleFirst: macro(...params)
	@QuestionFactory
		parameters: do
			- $subN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(+, ..., $calc.instruction.children[2])
				solution: $calc.solution
				solutionCalc: $calc.instruction
				completed: @Node(+)
					- $Node(bold, $calc.solution)
					- $calc.instruction.children[2]
				end
				target: $calc.instruction.children[1]
			end
		end
	end
end

addN2HoleSecond: macro(...params)
	@QuestionFactory
		parameters: do
			- $subN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(+, $calc.instruction.children[2], ...)
				solution: $calc.solution
				solutionCalc: $calc.instruction
				completed: @Node(+)
					- $calc.instruction.children[2]
					- $Node(bold, $calc.solution)
				end
				target: $calc.instruction.children[1]
			end
		end
	end
end

subN2HoleFirst: macro(...params)
	@QuestionFactory
		parameters: do
			- $addN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(-, ..., $calc.instruction.children[1])
				solution: $calc.solution
				solutionCalc: $calc.instruction
				completed: @Node(-)
					- $Node(bold, $calc.solution)
					- $calc.instruction.children[1]
				end
				target: $calc.instruction.children[2]
			end
		end
	end
end

subN2HoleSecond: macro(...params)
	@QuestionFactory
		parameters: do
			- $subN2(...params)
		end
		get: macro(calc)
			@Question(calculHole)
				instruction: $Node(-, $calc.instruction.children[1], ...)
				solution: $calc.solution
				solutionCalc: $calc.instruction
				completed: @Node(-)
					- $calc.instruction.children[1]
					- $Node(bold, $calc.solution)
				end
				target: $calc.instruction.children[2]
			end
		end
	end
end

addN2HoleFirstNoSolution: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:)
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		validate: macro(x, y)
			$(x > y)
		end
		get: macro(x, y)
			@Question(calculHoleNoSolution)
				instruction: $Node(+, ..., $x)
				target: $y
				solution: $Node(>, $x, $y)
			end
		end
	end
end

addN2HoleSecondNoSolution: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:)
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		validate: macro(x, y)
			$(x > y)
		end
		get: macro(x, y)
			@Question(calculHoleNoSolution)
				instruction: $Node(+, $x, ...)
				target: $y
				solution: $Node(>, $x, $y)
			end
		end
	end
end

subN2HoleSecondNoSolution: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:)
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		validate: macro(x, y)
			$(y > x)
		end
		get: macro(x, y)
			@Question(calculHoleNoSolution)
				instruction: $Node(-, $x, ...)
				target: $y
				solution: $Node(>, $y, $x)
			end
		end
	end
end