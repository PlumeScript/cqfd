let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Node from $import(../../core/utils/tree)
let Decimal from $import(../../core/parameters/range)
let DecimalRepresentation from $import(./utils)

addN2: macro(Number minIntSize:1, Number maxIntSize:2, Number minDecSize:0, Number maxDecSize:0, minCarry:, maxCarry:, carry:, intSize:, decSize:)
	if carry
		set minCarry = $carry
		set maxCarry = $carry
	end
	if intSize
		set minIntSize = $intSize
		set maxIntSize = $intSize
	end
	if decSize
		set minDecSize = $decSize
		set maxDecSize = $decSize
	end
	// TODO: check carry values against number size
	@QuestionFactory
		parameters: do
			- $ Decimal(minIntSize, maxIntSize, minDecSize, maxDecSize)
			- $ Decimal(minIntSize, maxIntSize, minDecSize, maxDecSize)
		end
		type: astNumber
		validate: macro(x, y)
			if not minCarry and not maxCarry
				return $true
			end

			let dx = $ DecimalRepresentation(x)
			let dy = $ DecimalRepresentation(y)

			let carryCount = 0
			let carry = 0
			for fx, fy in dx.getFiguresAlong(dy)
				let sum = $ fx + fy + carry
				if sum >= 10
					set carry = 1
					set carryCount += 1
				else
					set carry = 0
				end
			end

			return $ (not minCarry or minCarry <= carryCount) and (not maxCarry or maxCarry >= carryCount)
		end
		get: macro(x, y)
			@Question(calcul)
				instruction: $ Node("+", x, y)
				solution: $(x+y)
				id: $max($x, $y)+$min($x, $y)
			end
		end
	end
end

subN2: macro(Number minIntSize:1, Number maxIntSize:2, Number minDecSize:0, Number maxDecSize:0, minCarry:, maxCarry:, carry:, intSize:, decSize:)
	if carry
		set minCarry = $carry
		set maxCarry = $carry
	end
	if intSize
		set minIntSize = $intSize
		set maxIntSize = $intSize
	end
	if decSize
		set minDecSize = $decSize
		set maxDecSize = $decSize
	end
	// TODO: check carry values against number size
	@QuestionFactory
		parameters: do
			- $ Decimal(minIntSize, maxIntSize, minDecSize, maxDecSize)
			- $ Decimal(minIntSize, maxIntSize, minDecSize, maxDecSize)
		end
		type: astNumber
		validate: macro(x, y)
			if x<y
				return $false
			end
			if not minCarry and not maxCarry
				return $true
			end

			let dx = $ DecimalRepresentation(x)
			let dy = $ DecimalRepresentation(y)

			let carryCount = 0
			let carry = 0
			for fx, fy in dx.getFiguresAlong(dy)
				let dif = $ fx - fy - carry
				if dif < 0
					set carry = 1
					set carryCount += 1
				else
					set carry = 0
				end
			end
			
			return $ (not minCarry or minCarry <= carryCount) and (not maxCarry or maxCarry >= carryCount)
		end
		get: macro(x, y)
			@Question(calcul)
				instruction: $ Node("-", x, y)
				solution: $(x-y)
				id: $x-$y
			end
		end
	end
end

// TODO: consider figureNumber
mulN2: macro(Number minIntSize:1, Number maxIntSize:2, Number minDecSize:0, Number maxDecSize:0, minCompute:, maxCompute:, intSize:, decSize:, compute:)
	if intSize
		set minIntSize = $intSize
		set maxIntSize = $intSize
	end
	if decSize
		set minDecSize = $decSize
		set maxDecSize = $decSize
	end
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end
	// TODO: check carry values against number size
	@QuestionFactory
		parameters: do
			- $ Decimal(minIntSize, maxIntSize, minDecSize, maxDecSize)
			- $ Decimal(minIntSize, maxIntSize, minDecSize, maxDecSize)
		end
		type: astNumber
		validate: macro(x, y)
			if not minCompute and not maxCompute
				return $true
			end

			let dx = $ DecimalRepresentation(x)
			let dy = $ DecimalRepresentation(y)

			let realCompute = 0
			let sum = $Table()
			for i, fx in enumerate(dx.getFigures())
				let carry = 0
				for j, fy in enumerate(dy.getFigures())
					let prod = $ fx * fy + carry
					if prod >= 10
						set carry = $ (prod / 10).floor()
						set realCompute += 1
					else
						set carry = 0
					end
					set sum[i] = $ sum[i]? or Table()
					set sum[i][j] = $ prod

					if sum[i-1]?[j+1]? and sum[i-1]?[j+1]? != 0 and prod != 0
						set realCompute += 1
					end

					if fx != 0 and fy != 0 and fx != 1 and fy != 1
						set realCompute += 1
					end
				end
			end

			return $ (not minCompute or minCompute <= realCompute) and (not maxCompute or maxCompute >= realCompute)
		end
		get: macro(x, y)
			@Question(calcul)
				instruction: $ Node("*", x, y)
				solution: $(x*y)
				id: $max($x, $y)*$min($x, $y)
			end
		end
	end
end
