let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Node from $import(../../core/utils/tree)
let Choice from $import(../../core/parameters/set)
let Range, Decimal from $import(../../core/parameters/range)
let DecimalRepresentation, getCompute from $import(./utils)
let FactNumberCls from $import(../../core/utils/factNumber)

/*
Generate a multiplication between two $ParamSet(Decimal), capped by $code(compute).
*/
ref mulN2: macro(Number minIndex:-3, Number maxIndex:0, Number minFigures: 2, Number maxFigures: 3, figures:, minCompute:, maxCompute:, compute:)
	// TODO: consider figureNumber
	if figures
		set minFigures = $figures
		set maxFigures = $figures
	end
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end
	@QuestionFactory
		parameters: do
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
			- $ Decimal(minFigures, maxFigures, minIndex, maxIndex)
		end
		type: astNumber
		

		get: macro(x, y)
			let realCompute = $ getCompute.mul(x, y)

			if (minCompute and minCompute > realCompute) or (maxCompute and maxCompute < realCompute)
				return
			end

			return @Question(calcul)
				instruction: $ Node("*", x, y)
				solution: $(x*y)
				id: $max($x, $y)*$min($x, $y)
				compute: $realCompute
			end
		end
	end
end

/*
Convert a $ParamSet(mulN2) to a signed multiplication.
Support $code(\0?fullSign).
*/
mulZ2: macro(?fullSign, ...params)
	// fullSign\: explicit sign on every factor, ex: (+1) * (-2)
	@QuestionFactory
		parameters: do
			signA: $Choice(+, -)
			signB: $Choice(+, -)
		end
		hyperParameters: do
			calc: $mulN2(...params)
		end
		get: macro(signA:, signB:, calc:)
			let A = $calc.instruction.children[1]
			let B = $calc.instruction.children[2]
			let C = $calc.solution

			if signA == "-"
				set A = $Node(-, $A)
			end
			if signB == "-"
				set B = $Node(-, $B)
			end
			if signA != signB
				set C *= -1
			end

			let instr = $Node(*, $A, $B)
			if fullSign
				set instr.fullSign = 1
			end

			@Question(calcul)
				instruction: $instr
				solution: $C
				id: $signA$signB$calc.id
				compute: $calc.compute
			end
		end
	end
end

/*
$deprecated\: use $ParamSet(divQ2) instead.$newline
Convert a $ParamSet(mulN2) to a division capped by compute.$newline
Flag $code(\0?alt) to show correction as $formula(a = b \\times c) instead of $formula(\\frac a b = c).$newline 
Flag $code(\0?frac) to print it as a fraction.
*/
ref divN2: macro(minCompute:, maxCompute:, compute:, ?frac, ?alt, ...args)
	// Straightforward, should be enhanced
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end
	@QuestionFactory
		parameters: $Table($mulN2(...args))
		get: macro(calc)
			let opp = if frac
				/
			else
				\0-:
			end

			let A = $calc.instruction.children[1]
			let B = $calc.instruction.children[2]
			let C = $calc.solution

			if type(A) == "table" and A.label == "-"
				set A = $ -1 * A.children[1]
			end

			let const realCompute = $ getCompute.div(C, B)
			if (minCompute and minCompute > realCompute) or (maxCompute and maxCompute < realCompute)
				return
			end

			return @Question(calcul)
				instruction: $ Node(opp, C, B)
				if alt
					solution: $ Node("=", C, Node("*", A, B))
					solutionHideCalcul: $true
				else
					solution: $A
				end
				id: $C/$B
				compute: $realCompute
			end
		end
	end
end

/*
Convert a $ParamSet(divN2) to a signed division.
Support $code(\0?fullSign).
Flag $code(\0?frac) to print it as a fraction.
*/
divZ2: macro(?frac, ?fullSign, ...params)
	// fullSign\: no double sign in division rendering, kept for API uniformity
	@QuestionFactory
		parameters: do
			signA: $Choice(+, -)
			signB: $Choice(+, -)
		end
		hyperParameters: do
			calc: $divN2(...params)
		end
		get: macro(signA:, signB:, calc:)
			let opp = if frac
				/
			else
				\0-:
			end

			let A = $calc.instruction.children[1]
			let B = $calc.instruction.children[2]
			let C = $calc.solution

			if signA == "-"
				set A = $Node(-, $A)
			end
			if signB == "-"
				set B = $Node(-, $B)
			end
			if signA != signB
				set C *= -1
			end

			let instr = $ Node(opp, A, B)
			if fullSign
				set instr.fullSign = 1
			end

			@Question(calcul)
				instruction: $instr
				solution: $C
				id: $signA$signB$calc.id
				compute: $calc.compute
			end
		end
	end
end

/*
Generate a rationnal division with a period between $Param(Number, minPeriod, 1) and $Param(Number, maxPeriod, 1).$newline
If $code(minPeriod) is set to $formula(0), you can use $Param(Number, minDecimalPart, 0) and $Param(Number, maxDecimalPart, 1).$newline
Dividende will be between $Param(Number, minA, 2) and $Param(Number, maxA, 100).$newline
Divisor will be between $Param(Number, minB, 2) and $Param(Number, maxB, 100).$newline
Caped by compute.$newline
Flag $code(\0?frac) to print it as a fraction, $code(\0?greaterA) and $code(\0g?reaterB) to force $formula(a) or $formula(b) to be the greater, $code(\0?euclidean) to be shown as an integer division.
*/
ref divQ2: macro(Number minA: 2, Number maxA:100, Number minB: 2, Number maxB:100, Number minPeriod: 1, Number maxPeriod: 2, period:, minCompute:, maxCompute:, minDecimalPart:, maxDecimalPart:, decimalPart:, compute:,?frac, ?greaterA, ?greaterB, ?euclidean)
	if period
		set minPeriod = $period
		set maxPeriod = $period
	end
	if decimalPart
		set minDecimalPart = $decimalPart
		set maxDecimalPart = $decimalPart
	end
	if compute
		set minCompute = $compute
		set maxCompute = $compute
	end
	if minPeriod > maxPeriod
		raise `minPeriod` cannot be greater than `maxPeriod`
	end
	if greaterA and maxA < minB
		raise greaterA (`$greaterA`) cannot be lesser than minB (`$minB`)
	end
	if greaterB and maxB < minA
		raise greaterB (`$greaterB`) cannot be lesser than minB (`$minA`)
	end

	@QuestionFactory
		parameters: do
			- $ Range(minA, maxA)
			- $ Range(minB, maxB)
			- $ Range(minPeriod, maxPeriod)
			if minDecimalPart and maxDecimalPart
				- $ Range(minDecimalPart, maxDecimalPart)
			else
				- $ Choice(-1)
			end
		end
		validate: macro(a, b, period, decimalPart)
			if a < b and greaterA or a > b and greaterB or a==b
				return
			end
			if period == 0 and decimalPart != -1
				return $ (a/b*10^decimalPart).floor() == (a/b)*10^decimalPart and (a/b*10^(decimalPart-1)).floor() != (a/b)*10^(decimalPart-1)
			end

			let m = $ b / FactNumberCls.fromNumber(a).gcd(b).value
			while m%2==0
				set m /= 2
			end
			while m%5==0
				set m /= 5
			end

			if m==1
				return $ period==0
			end

			let k = 1
			while 10^k % m != 1
				// to huge
				if k>30
					return
				end
				set k += 1
			end

			if k != period
				return
			end

			return $true
		end

		get: macro(a, b, period, decimalPart)
			let opp = if frac
				/
			elseif euclidean
				⊢
			else
				\0-:
			end

			let realCompute = $ getCompute.div(a, b)
			if (minCompute and realCompute < minCompute) or (maxCompute and realCompute>maxCompute)
				return
			end

			return @Question(calcul)
				instruction: $Node($opp, $a, $b)
				solution: if euclidean
					$ Node("=", a, Node("+", Node("*", b, (a/b).floor()), a%b))
				elseif period == 0
					$(a/b)
				else
					$String($(a/b)).sub(1, -1)...
				end
				solutionHideCalcul: $euclidean
				euclidean: $euclidean
				period: $period
				a: $a
				b: $b
				id: $a/$b
				compute: $realCompute
			end
		end
	end
end