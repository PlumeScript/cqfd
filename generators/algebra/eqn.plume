let Choice from $import(../../core/parameters/set)
let Range from $import(../../core/parameters/range)
let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)

let FactNumberCls, primes from $import(../../core/utils/factNumber)

let s from $import(../../core/utils/expression)
let variableNames from $import(./utils)

/*
Generate an equation to solve, disguised by applying, in order, the $code(opps) operations to both sides of $formula(x = a).$newline
The displayed question is the reduced result (e.g. $formula(9(e + 8) = 63)) and the answer steps the operations back in reverse order.$newline
$Param(String, solution, integer) the value of the solution.
@InfosList
	- $code(integer)\: $formula(a) is drawn between $formula(-10) and $formula(10).
	- $code(rationnal)\: the solution is the fraction $formula(a/b) with $formula(a) between $formula(-10) and $formula(10) and $formula(b) between $formula(2) and $formula(10).
end

$Param(String[], opps, Table(+)) the operations applied, in order, to both sides; each operation is drawn a value between $formula(2) and $formula(10).
@InfosList
	- $code(+) and $code(-) add or remove a number from both sides.
	- $code(+x) and $code(-x) add or remove a multiple of the left expression from both sides, so that the variable appears on both sides (e.g. $formula(6i = 9 + 5i)).
	- $code(*) multiply both sides by a number.
	- $code(/) divide both sides by a number (the right side is then generally a fraction).
	- $code(%) like $code(/), but the solution is scaled by the value first, so the right side is not divided by it (an integer right side for $code(integer) solutions).
	- $code(^2q)\: must be first. Square equation with two rational solutions\: $formula(x^2 = a^2) gives $formula(x = a) or $formula(x = -a).
	- $code(^2i)\: must be first. Square equation with two irrational solutions\: $formula(x^2 = a^2 + k) with $formula(k) between $formula(2) and $formula(10) (and not a perfect square for $code(integer) solutions).
	- $code(^2c)\: must be first. Square equation with a negative right side\: no real solution, the answer is $code(Pas de solutions.). Requires $code(integer) solutions.
end

The question also carries $code(solveSteps)\: the inverse operations applied to the left side only, in solving order — consumed by $ParamSet(reduceBoth).$newline
An unknown operation, or a $code(^2) operation that is not first, raises an error.

Todo\: irrationnal distractor & solutions
*/
ref eqn: macro(opps:, style: classic, solution: integer, ?lightSolution, ?switch)
	if not opps
		set opps = $Table(+)
	end

	for i, opp in enumerate(opps)
		if i != 1 and (opp == "^2q" or opp == "^2i" or opp == "^2c")
			raise `opp` must be first.
		end

		if opp != "+" and opp != "+x" and opp != "-" and opp != "-x" and opp != "*" and opp != "/"and opp != "%" and opp != "^2i" and opp != "^2q" and opp != "^2c"
			raise Unknown opp `$opp`.
		end
	end

	@QuestionFactory
		parameters: do
			- $Range(-10, 10)
			if solution == "rationnal"
				- $Choice(2, 10)
			else
				- $Choice(0)
			end
			for i in seq(len(opps))
				- $Range(2, 10)
			end
		end
		hyperParameters: do
			- $variableNames[style]
		end
		get: macro(a, b, ...values)
			let x = if solution == "integer"
				$a
			elseif solution == "rationnal"
				if a%b == 0
					set b += 1
				end
				$ s(a)/b
			end

			let name = $Table.at($values, -1)
			let left  = $ s(name)
			let namefactor = 1

			for i in seq(len(opps))
				if opps[i] == "%"
					set x *= $ values[i]
					set namefactor /=  $values[i]
				elseif opps[i] == "*"
					set namefactor *=  $values[i]
				elseif opps[i] == "^2i"
					set left = $ left^2
					set x = $ x^2 + values[i]
					while solution == "integer" and (x^0.5).floor() == x^0.5
						set x += 1
					end
				elseif opps[i] == "^2q"
					set left = $ left^2
					set x = $ x^2
				elseif opps[i] == "-x"
					if values[i] - namefactor == 0
						set values[i] += $namefactor
					end
				elseif opps[i] == "+x"
					if values[i] + namefactor == 0
						set values[i] -= $namefactor
					end
				elseif opps[i] == "^2c"
					set left = $ left^2
					set x = $ -x.abs()
				end
			end

			let right = $ s(x)

			let members = (l:$left, r:$right)
			for i in seq(len(opps))
				for k, member in items(members)
					if opps[i] == "+"
						set members[k] += $values[i]
					elseif opps[i] == "+x"
						set members[k] += $ values[i] * left
					elseif opps[i] == "-"
						set members[k] -= $values[i]
					elseif opps[i] == "-x"
						set members[k] -= $ values[i] * left
					elseif opps[i] == "*"
						set members[k] *= $values[i]
					elseif opps[i] == "/" or opps[i] == "%"
						set members[k] /= $values[i]
					end
				end
			end

			for k, member in items(members)
				set members[k] = $members[k].reduce()
			end

			if switch
				set members.l, members.r = ($members.r, $members.l)
			end

			let solveSteps = $Table()
			@Question(eqn)
				lightSolution: $lightSolution
				steps: do
					- do
						l: $members.l.reduce()
						r: $members.r.reduce()
					end
					for i in seq(len(opps), 1, -1)
						for k, member in items(members)
							if opps[i] == "+"
								set members[k] -= $values[i]
								if k == "l"
									run $ Table.append(solveSteps, ("-", values[i]))
								end
							elseif opps[i] == "+x"
								set members[k] -= $ values[i] * left
								if k == "l"
									run $ Table.append(solveSteps, ("-", values[i] * left))
								end
							elseif opps[i] == "-"
								set members[k] += $values[i]
								if k == "l"
									run $ Table.append(solveSteps, ("+", values[i]))
								end
							elseif opps[i] == "-x"
								set members[k] += $ values[i] * left
								if k == "l"
									run $ Table.append(solveSteps, ("+", values[i] * left))
								end
							elseif opps[i] == "*"
								set members[k] /= $values[i]
								if k == "l"
									run $ Table.append(solveSteps, ("\\div", values[i]))
								end
							elseif opps[i] == "/" or opps[i] == "%"
								set members[k] *= $values[i]
								if k == "l"
									run $ Table.append(solveSteps, ("\\times", values[i]))
								end
							end
						end

						if opps[i] == "^2q" or opps[i] == "^2i"
							- do
								l:  $ s(name)
								r:  $ (members.r.root()).reduce()
								r2: $ (-(members.r.root())).reduce()
							end
						elseif opps[i] == "^2c"
							finalLabel: Pas de solutions.
						else
							if not lightSolution
								- do
									l: $members.l
									r: $members.r
								end
							end
							for k, member in items(members)
								set members[k] = $members[k].reduce()
							end
							if switch and i==1
								set members.l, members.r = ($members.r, $members.l)
							end
							- do
								l: $members.l
								r: $members.r
							end
						end
					end
				end
				id: $a-$b-$repr($opps)-$repr($values)
				solveSteps: $solveSteps
			end
		end
	end
end