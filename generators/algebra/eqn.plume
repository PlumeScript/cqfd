let Choice from $import(../../core/parameters/set)
let Range from $import(../../core/parameters/range)
let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)

let FactNumberCls, primes from $import(../../core/utils/factNumber)

let s from $import(../../core/utils/expression)
let variableNames from $import(./utils)

/*
$Param(String, solution, integer) maybe
@InfosList
	- $code(integer)
	- $code(rationnal)
end

$Param(String, opps, (+)) maybe
@InfosList
	- $code(+), $code(+x)
	- $code(-), $code(-x)
	- $code(/)
	- $code(%) like $code(/) but force right member to be an integer.
	- $code(*)
	- $code(^2q)\: must be first. Rationnal square root.
	- $code(^2i)\: must be first. Irrationnal square root.
	- $code(^2c)\: must be first. Complex square root.
end

Todo\: irrationnal distractor & solutions
*/
ref eqn: macro(opps:, style: classic, solution: integer)
	if not opps
		set opps = $Table(+)
	end

	for i, opp in enumerate(opps)
		if i != 1 and (opp == "^2q" or opp == "^2i" or opp == "^2c")
			raise `opp` must be first.
		end

		if opp != "+" and opp != "+x" and opp != "-" and opp != "-x" and opp != "*" and opp != "/"and opp != "%" and opp != "^2i" and opp != "^2q" and opp != "^2c"
			raise Unknown opp `$opp`.
		end
	end

	@QuestionFactory
		parameters: do
			- $Range(-10, 10)
			if solution == "rationnal"
				- $Choice(2, 10)
			else
				- $Choice(0)
			end
			for i in seq(len(opps))
				- $Range(2, 10)
			end
		end
		hyperParameters: do
			- $variableNames[style]
		end
		get: macro(a, b, ...values)
			let x = if solution == "integer"
				$a
			elseif solution == "rationnal"
				if a%b == 0
					set b += 1
				end
				$ s(a)/b
			end

			let name = $Table.at($values, -1)
			let left  = $ s(name)
			let namefactor = 1

			for i in seq(len(opps))
				if opps[i] == "%"
					set x *= $ values[i]
					set namefactor /=  $values[i]
				elseif opps[i] == "*"
					set namefactor *=  $values[i]
				elseif opps[i] == "^2i"
					set left = $ left^2
					set x = $ x^2 + values[i]
					while solution == "integer" and (x^0.5).floor() == x^0.5
						set x += 1
					end
				elseif opps[i] == "^2q"
					set left = $ left^2
					set x = $ x^2
				elseif opps[i] == "-x"
					if values[i] - namefactor == 0
						set values[i] += $namefactor
					end
				elseif opps[i] == "+x"
					if values[i] + namefactor == 0
						set values[i] -= $namefactor
					end
				elseif opps[i] == "^2c"
					set left = $ left^2
					set x = $ -x.abs()
				end
			end

			let right = $ s(x)

			let members = (l:$left, r:$right)
			for i in seq(len(opps))
				for k, member in items(members)
					if opps[i] == "+"
						set members[k] += $values[i]
					elseif opps[i] == "+x"
						set members[k] += $ values[i] * left
					elseif opps[i] == "-"
						set members[k] -= $values[i]
					elseif opps[i] == "-x"
						set members[k] -= $ values[i] * left
					elseif opps[i] == "*"
						set members[k] *= $values[i]
					elseif opps[i] == "/" or opps[i] == "%"
						set members[k] /= $values[i]
					end
				end
			end

			for k, member in items(members)
				set members[k] = $members[k].reduce()
			end

			let solveSteps = $Table()
			@Question(eqn)
				steps: do
					- do
						l: $members.l.reduce()
						r: $members.r.reduce()
					end
					for i in seq(len(opps), 1, -1)
						for k, member in items(members)
							if opps[i] == "+"
								set members[k] -= $values[i]
								if k == "l"
									run $ Table.append(solveSteps, ("-", values[i]))
								end
							elseif opps[i] == "+x"
								set members[k] -= $ values[i] * left
								if k == "l"
									run $ Table.append(solveSteps, ("-", values[i] * left))
								end
							elseif opps[i] == "-"
								set members[k] += $values[i]
								if k == "l"
									run $ Table.append(solveSteps, ("+", values[i]))
								end
							elseif opps[i] == "-x"
								set members[k] += $ values[i] * left
								if k == "l"
									run $ Table.append(solveSteps, ("+", values[i] * left))
								end
							elseif opps[i] == "*"
								set members[k] /= $values[i]
								if k == "l"
									run $ Table.append(solveSteps, ("\\div", values[i]))
								end
							elseif opps[i] == "/" or opps[i] == "%"
								set members[k] *= $values[i]
								if k == "l"
									run $ Table.append(solveSteps, ("\\times", values[i]))
								end
							end
						end

						if opps[i] == "^2q" or opps[i] == "^2i"
							- do
								l:  $ s(name)
								r:  $ (members.r.root()).reduce()
								r2: $ (-(members.r.root())).reduce()
							end
						elseif opps[i] == "^2c"
							finalLabel: Pas de solutions.
						else
							- do
								l: $members.l
								r: $members.r
							end
							for k, member in items(members)
								set members[k] = $members[k].reduce()
							end
							- do
								l: $members.l
								r: $members.r
							end
						end
					end
				end
				id: $a-$b-$repr($opps)-$repr($values)
				solveSteps: $solveSteps
			end
		end
	end
end