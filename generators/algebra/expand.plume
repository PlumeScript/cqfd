let Choice from $import(../../core/parameters/set)
let Range from $import(../../core/parameters/range)
let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)

let s from $import(../../core/utils/expression)
let variableNames from $import(./utils)


/*
Generate an expansion exercice from the first step of a $code(reduceSum) question — the sum is combined with a number between $formula(2) and $formula(10), then expanded term by term (no reduction).$newline
$posParam(QuestionFactory, sum, 1) a $code(reduceSum) object.$newline
$code(opps) the operations the first combination is drawn from (default $code(/) and $code(*)).
@InfosList
	- $code(*)\: the sum is multiplied by the number.
	- $code(/)\: the sum is divided by the number.
	- $code(-:)\: like $code(/), but the division is rendered with the $code(\\div) operator.
end
*/
simpleExpand: macro(sum, opps: (/, *))
	@QuestionFactory
		parameters: do
			- $sum
			- $Range(2, 10)
			- $Choice(...opps)
		end
		get: macro(sum, factor, opp)
			return @Question(eq)
				steps: if opp=="/"
					- $ sum.steps[1] / factor
					- $ (sum.steps[1] / factor).expand()
				elseif opp=="-:"
					- $ sum.steps[1].divOp(factor)
					- $ (sum.steps[1].divOp(factor)).expand()
				else
					- $ factor * sum.steps[1]
					- $ (factor * sum.steps[1]).expand()
				end
			end
		end
	end
end