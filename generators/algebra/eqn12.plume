let Choice from $import(../../core/parameters/set)
let Range from $import(../../core/parameters/range)
let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)

let FactNumberCls, primes from $import(../../core/utils/factNumber)

let s from $import(../../core/utils/expression)
let variableNames from $import(./utils)

/*
$formula(x=a)-class equation
*/
ref eqnX: macro(style: classic, ...args)
	@QuestionFactory
		parameters: do
			- $Range(-10, 10)
			- $ Range(0, 1)
		end
		hyperParameters: do
			- $variableNames[style]
		end
		get: macro(a, sw, name)
			@Question(eqn)
				steps: do
					- do
						if sw==0
							l: $s($name)
							r: $s($a)
						else
							l: $s($a)
							r: $s($name)
						end
					end
				end
				id: x=$a
				solutions: $Table($a)
			end
		end
	end
end

/*
$formula(x²=a)-class equation.$newline
Source may be $ParamSet(sqrtN) or $ParamSet(sqrtC)
*/
ref eqnX2: macro(source, style: classic, ?negative, ...args)
	@QuestionFactory
		parameters: do
			- $source
			- $Choice(0, 1)
		end
		hyperParameters: do
			- $variableNames[style]
		end
		get: macro(source, sw, name)
			let square = $source.square
			let dsquare = $ (square * 10^(max(0, Math.log(square - square.floor()) / Math.log(10)))).floor()

			let q = $ FactNumberCls.fromNumber(dsquare).isRationnal()
			let solutions = if square>=0
				if q
					- $ s(square^0.5)
					if square != 0
						- $ s(-(square^0.5))
					end
				else
					- $ s(square).root()
					- $ s(-1*(s(square).root())).reduce()
				end
			else
				...Table()
			end
			@Question(eqn)
				steps: do
					- do
						if sw==0
							l: $ s(name)^2
							r: $ s(square)
						else
							l: $ s(square)
							r: $ s(name)^2
						end
					end
					if len(solutions)>0
						- do
							l: $s($name)
							r: $solutions[1]
							if len(solutions)>1
								r2: $solutions[2]
							end
						end
					else
						finalLabel: Pas de solution
					end
				end
				id: x²=$square
				solutions: $solutions
			end
		end
	end
end

/*
$formula(X+a=b)-class equation, with $formula(a) added to each member of the source (once or twice), were X is $posParam(QuestionFactory, source, 1).
*/
ref eqnAdd: macro(...args)
	let sourceA = $ args[1]?
	if sourceA
		run $ Table.remove(args)
	else
		set sourceA = $ eqnX(...args)
	end
	let sourceB = $ args[1]?
	if sourceB
		run $ Table.remove(args)
	else
		set sourceB = $ Range(1, 10)
	end

	@QuestionFactory
		parameters: do
			- $sourceA
			- $Range(1, 10)
			- $ Choice(0, 1)
			- $ Choice(0, 1)
		end
		get: macro(source, a, s1, s2)
			let left  = if s1==0
				$ (source.steps[1].l + s(a))
			else
				$ (s(a) + source.steps[1].l + s(a))
			end
			let right  = if s2==0
				$ (source.steps[1].r + s(a))
			else
				$ (s(a) + source.steps[1].r + s(a))
			end

			set left  = $ left.reduce()
			set right = $ right.reduce()

			@Question(eqn)
				steps: do
					- do
						l: $ left
						r: $ right
					end
					- do
						l: $ left - s(a)
						r: $ right - s(a)
					end
					...source.steps
				end
				solutions: $source.solutions
				id: $source.id+$a
			end
		end
	end
end

/*
$formula(X-a=b)-class equation, were X is $posParam(QuestionFactory, source, 1).
*/
ref eqnSub: macro(source, ...args)
	@QuestionFactory
		parameters: do
			- $source
			- $Range(1, 10)
		end
		get: macro(source, a)
			let left  = $ (source.steps[1].l - s(a)).reduce()
			let right = $ (source.steps[1].r - s(a)).reduce()

			@Question(eqn)
				steps: do
					- do
						l: $ left
						r: $ right
					end
					- do
						l: $ left + s(a)
						r: $ right + s(a)
					end
					...source.steps
				end
				solutions: $source.solutions
				id: $source.id-$a
			end
		end
	end
end

/*
Wrapper for $ParamSet(eqnAdd) and $ParamSet(eqnSub)
*/
eqnAddSub: macro(...args)
	$ eqnAdd(...args) * eqnSub(...args)
end

/*
$formula(X/a=b)-class equation, were X is $posParam(QuestionFactory, source, 1).
*/
ref eqnMul: macro(source, ?integer, ...args)
	@QuestionFactory
		parameters: do
			- $source
			- $Range(2, 10)
		end
		validate: macro(source, a)
			return $ source.steps[1].l.reduce() != 0 and source.steps[1].r.reduce() != 0
		end

		get: macro(source, a)
			let left  = $ (source.steps[1].l/a).reduce()
			let right = $ (source.steps[1].r/a).reduce()

			@Question(eqn)
				steps: do
					- do
						l: $ left
						r: $ right
					end
					- do
						l: $ left * s(a)
						r: $ right * s(a)
					end
					...source.steps
				end
				solutions: $source.solutions
				id: $source.id+$a
			end
		end
	end
end

/*
$formula(X*a=b)-class equation, were X is $posParam(QuestionFactory, source, 1).
*/
ref eqnDiv: macro(source, ...args)
	@QuestionFactory
		parameters: do
			- $source
			- $Range(2, 10)
		end
		get: macro(source, a)
			let left  = $ (source.steps[1].l * s(a)).reduce()
			let right = $ (source.steps[1].r * s(a)).reduce()

			@Question(eqn)
				steps: do
					- do
						l: $ left
						r: $ right
					end
					- do
						l: $ left / s(a)
						r: $ right / s(a)
					end
					...source.steps
				end
				solutions: $source.solutions
				id: $source.id-$a
			end
		end
	end
end

/*
Wrapper for $ParamSet(eqnMul) and $ParamSet(eqnDiv)
*/
eqnMulDiv: macro(...args)
	$ eqnMul(...args) * eqnDiv(...args)
end