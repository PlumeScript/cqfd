let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Range from $import(../../core/parameters/range)
let Node from $import(../../core/utils/tree)
let variableNames from $import(./utils)
let Choice from $import(../../core/parameters/set)

macro inject(calc, letter, pos, filters)
	set calc = $ Table.deepcopy(calc)
	let pool = $ Table(calc)
	let flat = $ Table()
	
	while len(pool) > 0
		let top = $ Table.remove(pool)
		for i, child in enumerate(top.children)
			if filters.avoid?
				if filters.avoid[top.label]? == i or filters.avoid[top.label]? == "all"
					continue
				end
			end
			if filters.only?
				if not filters.only[top.label]? == i or filters.avoid[top.label]? == "all"
					continue
				end
			end

			let isLeaf = $ type(child) != "table"
			if not isLeaf and child.label == "-" and len(child.children) == 1
				set isLeaf = $true
				set child = $ -child.children[1]
			end
			if isLeaf
				run $ Table.append(flat, (parent: top, pos: i, value: child))
			else
				run $ Table.append(pool, child)
			end
		end
		
	end

	let spot = $flat[1 + pos%len(flat)]
	let value = $spot.value
	set spot.parent.children[spot.pos] = $Node(var, $letter)

	return ($calc, $value)
end

/*
Create an exercice in the form $code(Si a=4\, alors a+1=...)$newline
$posParam(QuestionFactory, source, 1) maybe any calc exercice.
*/
eval: macro(source, style: classic, filters:)
	@QuestionFactory
		parameters: do
			- $source
		end
		hyperParameters: do
			- $variableNames[style]
			- $ Range(1, 1000)
		end
		get: macro(source, letter, injectionSpot)
			let calc, value = $ inject(source.instruction, letter, injectionSpot, filters)
			@Question(eval)
				instruction: do
					value: $value
					letter: $letter
					calc: $calc
				end
				solutionCalc: $source.instruction
				solution: $source.solution
				id: $source.id
			end
		end
	end
end

ref evalCheckSimpleTrue: macro(source, style: classic, filters:)
	@QuestionFactory
		parameters: do
			- $source
		end
		hyperParameters: do
			- $variableNames[style]
			- $ Range(1, 1000)
		end
		get: macro(source, letter, injectionSpot)
			let calc, value = $ inject(source.instruction, letter, injectionSpot, filters)

			@Question(evalCheck)
				instruction: do
					value: $value
					letter: $letter
					left: $calc
					right: $ source.solution
				end
				solutionCalcLeft: $source.instruction
				validResultLeft: $source.solution
				solution: $true
				id: $source.id-true
			end
		end
	end
end

ref evalCheckSimpleFalse: macro(source, style: classic, filters:)
	@QuestionFactory
		parameters: do
			- $source
		end
		hyperParameters: do
			- $variableNames[style]
			- $ Range(1, 1000)
			- $ Choice(-3, -2, -1, 1, 2, 3)
		end
		get: macro(source, letter, injectionSpot, delta)
			let calc, value = $ inject(source.instruction, letter, injectionSpot, filters)

			let right = if source.usualTrap?
				$source.usualTrap
			else
				$ source.solution + delta
			end

			@Question(evalCheck)
				instruction: do
					value: $value
					letter: $letter
					left: $calc
					right: $right
				end
				solutionCalcLeft: $source.instruction
				validResultLeft: $source.solution
				solution: $false
				id: $source.id-false
			end
		end
	end
end


/*
Create an exercice in the form $code(a+1=4 si=4)$newline
$posParam(QuestionFactory, source, 1) maybe any calc exercice.
*/
evalCheckSimple: macro(...args)
	$ evalCheckSimpleTrue(...args) + evalCheckSimpleFalse(...args)
end