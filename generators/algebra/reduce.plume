let Choice from $import(../../core/parameters/set)
let Range from $import(../../core/parameters/range)
let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)

let s from $import(../../core/utils/expression)
let variableNames from $import(./utils)

/*
Generate a $formula(abcd...) reduction exercice.
@InfosList
	- $Param(Number, factors, 2) to set number of factors.
	- $Param(Number, variables, 1) to set number of differents variables.
	- $Param(Number, orphans, 1) to set number of differents non-variables factors.
	- $Param(Number, minPower, 1), $Param(Number, maxPower, 1) to min/max exposant (variables only).
	- $Param(Bool, \0?negativeExposant, false) allow negative exposant (variables only)
	- $Param(Bool, \0?negativeFactor, false) allow negative factors (orphans only)
end
*/
ref reduceMul: macro(Number factors: 2, Number variables: 1, Number orphans: 1, Number minPower: 1, Number maxPower: 1, style: classic, ?negativeFactor, ?negativeExposant)
	if variables + orphans > factors
		raise To few factors (currently: `$factors`) for `$variables`  variables and `$orphans`  orphans.
	end

	@QuestionFactory
		parameters: do
			for i in seq(factors)
				- $ Range(minPower, maxPower)
				- if negativeExposant
					$Choice(+, -)
				else
					$Choice(+)
				end
				- $ Range(1, variables + (orphans>0 and 1 or 0))
			end
			for i in seq(orphans)
				- $Range(1, 5)
				- if negativeFactor
					$Choice(+, -)
				else
					$Choice(+)
				end
			end
		end
		hyperParameters: do
			for i in seq(variables)
				- $variableNames[style]
			end
		end
		validate: macro(...args)
			let check = do
				for i in seq(variables)
					- $false
				end
				for i in seq(orphans)
					- $false
				end
			end
			let orphanIndex = 0
			for i in seq(factors)
				let nameIndex = $args[3*i]
				if nameIndex <= variables
					set check[nameIndex] = $true
				else
					set orphanIndex += 1
					set check[variables+orphanIndex] = $true
					if orphanIndex > orphans
						return
					end
				end
			end
			for i in seq(variables+orphans)
				if not check[i]
					return
				end
			end

			return $true
		end

		get: macro(...args)
			let expr
			let orphanIndex = 0
			let variableList = $Table()

			for i in seq(factors)
				let power     = $args[3*i-2]
				let powerSign = $args[3*i-1]
				let nameIndex = $args[3*i]

				let value = if nameIndex <=variables
					let var = $args[3*factors + 2*orphans + nameIndex]
					run $ Table.append(variableList, var)
					$var
				else
					set orphanIndex += 1
					let value = $args[3*factors + 2*orphanIndex-1]
					let sign  = $args[3*factors + 2*orphanIndex]
					
					if sign == "-"
						set value *= -1
					end
					$ s(value)
				end
				
				if expr
					if powerSign=="+"
						set expr *= $ s(value)^power
					else
						set expr *= $ s(value)^(-power)
					end
				else
					if powerSign=="+"
						set expr = $ s(value)^power
					else
						set expr = $ s(value)^(-power)
					end
				end
			end
			@Question(eq)
				steps: do
					- $expr.pretty()
					- $expr.reduce()
				end
				vars: $variableList
			end
		end
	end
end
/*
Generate a $formula(ax+by+cz+...) reduction exercice.
@InfosList
	- $Param(Number, terms, 2) to set number of terms.
	- $Param(Number, variables, 1) to set number of differents variables.
	- $Param(Number, orphans, 1) to set number of differents non-variables factors.
	- $Param(QuestionFactory, termTemplate, \$variablesNames[style]) used to generate variables. Intended to be use with reduceMul
	- $Param(Bool, \0?negativeTerm, false) allow negative terms
end
*/
reduceSum: macro(Number terms: 2, Number variables: 1, Number orphans: 1, termTemplate:, style: classic, ?negativeTerm)
	let variableTermCount = $variables
	if not termTemplate
		set termTemplate      = $variableNames[style]
	else
		set variableTermCount = $ terms - orphans
	end
	// todo: randomize factor order (acb+bac instead of abc + abc)
	if terms < 2
		raise terms cannot be lesser than 2 (currently: `$terms`)
	end
	if variables + orphans > terms
		raise To few terms (currently: `$terms`) for `$variables`  variables and `$orphans`  orphans.
	end
	@QuestionFactory
		parameters: do
			for i in seq(terms)
				- $Range(1, 10)
				- if negativeTerm
					$Choice(+, -)
				else
					$Choice(+)
				end
				- $ Range(1, variableTermCount + (orphans>0 and 1 or 0))
			end
			for i in seq(orphans)
				- $Range(1, 5)
			end
		end
		hyperParameters: do
			for i in seq(variableTermCount)
				- $termTemplate
			end
		end
		validate: macro(...args)
			let check = do
				for i in seq(variableTermCount)
					- $false
				end
				for i in seq(orphans)
					- $false
				end
			end
			let orphanIndex = 0
			for i in seq(terms)
				let nameIndex = $args[3*i]
				if nameIndex <= variableTermCount
					set check[nameIndex] = $true
				else
					set orphanIndex += 1
					set check[variableTermCount+orphanIndex] = $true
					if orphanIndex > orphans
						return
					end
				end
			end
			for i in seq(variableTermCount+orphans)
				if not check[i] and (variables == variableTermCount or i>variables)
					return
				end
			end

			return $true
		end

		get: macro(...args)
			let expr
			let orphanIndex = 0
			let variableList = $Table()

			for i in seq(terms)
				let value     = $args[3*i-2]
				let sign      = $args[3*i-1]
				let nameIndex = $args[3*i]

				let term = if nameIndex <= variableTermCount
					let term = $args[3*terms + orphans + nameIndex]
					if type(term) == "table"
						let rterm = $term.steps[1]
						
						for i, var in enumerate(term.vars? or Table())
							if not Table.find(variableList, var)
								if len(variableList) < variables
									run $ Table.append(variableList, String(var))
								else
									set rterm = $rterm.eval($var:$variableList[1+(7*i)%len(variableList)])
								end
							end
						end
						set term = $rterm
					end
					$ value * s(term)
				else
					set orphanIndex += 1
					$ s(args[3*terms + orphanIndex])
				end

				if variables != variableTermCount and len(variableList) < variables
					return
				end

				if expr
					if sign == "+"
						set expr += $term
					else
						set expr -= $term
					end
				else
					if sign == "+"
						set expr = $term
					else
						set expr = $ (-1*term).pretty()
					end
				end
			end

			return @Question(eq)
				steps: do
					- $expr.pretty()
					- $expr.reduce()
				end
				vars: $variableList
			end
		end
	end
end

let eqn12 from $import(./eqn12)
/*
Generate an exercice like $code(Voici une égalité. Faîtes $formula(+5) à chaque membre et réduisez).$newline
Use $ParamSet(eqn12).
*/
reduceBoth: macro(...args)
	@QuestionFactory
		parameters: do
			- $eqn12(...args)
			- $Choice(1, 3)
		end
		get: macro(source, step)
			set step = $ 1 + (step-1) % len(source.firstSteps)
			@Question(reduceBoth)
				instruction: do
					eqn: $source.steps[1]
					calc: $source.firstSteps[step]
				end
				steps: do
					- $source.steps[1]
					if source.firstSteps[step][1] == "+"
						- do
							l: $ (source.steps[1].l + source.firstSteps[step][2]).pretty()
							r: $ (source.steps[1].r + source.firstSteps[step][2]).pretty()
						end
						- do
							l: $ (source.steps[1].l + source.firstSteps[step][2]).reduce()
							r: $ (source.steps[1].r + source.firstSteps[step][2]).reduce()
						end
					elseif source.firstSteps[step][1] == "-"
						- do
							l: $ (source.steps[1].l - source.firstSteps[step][2]).pretty()
							r: $ (source.steps[1].r - source.firstSteps[step][2]).pretty()
						end
						- do
							l: $ (source.steps[1].l - source.firstSteps[step][2]).reduce()
							r: $ (source.steps[1].r - source.firstSteps[step][2]).reduce()
						end
					elseif source.firstSteps[step][1] == "\\times"
						- do
							l: $ (source.steps[1].l * source.firstSteps[step][2]).pretty()
							r: $ (source.steps[1].r * source.firstSteps[step][2]).pretty()
						end
						- do
							l: $ (source.steps[1].l * source.firstSteps[step][2]).reduce()
							r: $ (source.steps[1].r * source.firstSteps[step][2]).reduce()
						end
					elseif source.firstSteps[step][1] == "\\div"
						- do
							l: $ (source.steps[1].l / source.firstSteps[step][2]).pretty()
							r: $ (source.steps[1].r / source.firstSteps[step][2]).pretty()
						end
						- do
							l: $ (source.steps[1].l / source.firstSteps[step][2]).reduce()
							r: $ (source.steps[1].r / source.firstSteps[step][2]).reduce()
						end
					end
				end
				id: $source.id-$step
			end
		end
	end
end