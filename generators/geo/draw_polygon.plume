let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Range from $import(../../core/parameters/range)
let Choice from $import(../../core/parameters/set)

use figure2D
let letters from $import(./utils)

let pages = $import(pages) // Should be in render

macro angleTip(A, B, C)
    $ ((A-B).normalize() + (C-B).normalize()).normalize().angle() + Math.pi
end

macro lineLabel(A, B, label)
	let angle = $ (B-A).angle()
	if angle < -Math.pi/4 or angle > 5*Math.pi/4
		set angle += $ Math.pi
	end

	$ Dot((A+B)/2, label: label, angle: (B-A).normal().angle(), direction: angle)
end

// Todo: names isocele, rectangle...

/*
Generate a triangle to draw from two angles.$newpar
Angle will be a multiple of $Param(Number, precision, 1)
*/
drawTriangle2angles: macro(Number precision: 1)
	@QuestionFactory
		parameters: do
			- $Range(20, 120)
			- $Range(1, 80)
			- $Range(2, 8)
		end

		hyperParameters: do
			- $letters(3)
			- $Range(0, 180)
			- $Range(5, 15)
		end

		get: macro(a1, r, l, letters, rotation, position)
			let _A, _B, _C = $letters

			set a1 = $ (a1 / precision).floor() * precision
			let a2 = $ ((20 + (140 - a1) * r/100)/precision).floor()*precision

			@Question(draw)
				description: do
					Sachant que\s
					$pages.formula(\\widehat{$_A$_B$_C}=$a1°),\s
					$pages.formula(\\widehat{$_B$_A$_C}=$a2°)\s
					et\s
					$pages.formula($_A$_B=$l\0cm),\s
					tracer le triangle $pages.formula($_A$_B$_C).
				end
				figure: do
					let B = $Vect2D(0, 0)

					let A = $ Vect2D(a: rotation, r: 1, ?deg)
					let line1 = $ Line2D(B, Vect2D(a: rotation+a1, r: 1, ?deg))
					let line2 = $ Line2D(A, Vect2D(a: rotation+(180-a2), r: 1, ?deg))
					let C = $ line1.intersect(line2)[1]

					- $ Polygon(A, B, C)
					- $ Dot(A, label: _A, angle: angleTip(B, A, C))
					- $ Dot(B, label: _B, angle: angleTip(C, B, A))
					- $ Dot(C, label: _C, angle: angleTip(A, C, B))
					- $ Angle(A, B, C, fill: "#ddd", ?noline)
					- $ Angle(C, A, B, fill: "#ddd", ?noline)
					- $ lineLabel(A, B, l.."cm")
				end
				tip: Si vous avez été précis, vous aurez $pages.formula(\\widehat{$_A$_C$_B}=$(180-a1-a2)°)
			end
		end
	end
end

/*
Generate a triangle to draw from two lengths.$newpar
Angle will be a multiple of $Param(Number, precision, 1)
*/
drawTriangle2lengths: macro(Number precision: 1)
	@QuestionFactory
		parameters: do
			- $Range(20, 70)
			- $Range(5, 15)
			- $Range(2, 8)
		end

		hyperParameters: do
			- $letters(3)
			- $Range(0, 180)
		end

		get: macro(a, r, l1, letters, rotation)
			let _A, _B, _C = $letters

			set a = $ (a / precision).floor() * precision
			let l2 = $ (l1*r/10).ceil()

			@Question(draw)
				description: do
					Sachant que\s
					$pages.formula(\\widehat{$_A$_B$_C}=$a°),\s
					$pages.formula($_A$_B=$l1\0cm)\s
					et\s
					$pages.formula($_A$_C=$l2\0cm),\s
					tracer le triangle $pages.formula($_A$_B$_C).
				end
				figure: do
					let B = $Vect2D(0, 0)

					let A = $ Vect2D(a: rotation, r: l1, ?deg)
					let line = $ Line2D(B, Vect2D(a: rotation+a, r: 1, ?deg))
					let circle = $ Circle2D(B, l2)
					let C = $ line.intersect(circle)[1]

					- $ Polygon(A, B, C)
					- $ Dot(A, label: _A, angle: angleTip(B, A, C))
					- $ Dot(B, label: _B, angle: angleTip(C, B, A))
					- $ Dot(C, label: _C, angle: angleTip(A, C, B))
					- $ Angle(C, B, A, fill: "#ddd", ?noline)
					- $ lineLabel(B, A, l1.."cm")
					- $ lineLabel(C, B, l2.."cm")
				end
			end
		end
	end
end

/*
Generate a regular polygon to draw.$newline
The number of sides is drawn between $Param(Number, minSide, 3) and $Param(Number, maxSide, 8) — only the values that divide $formula(360) are possible.$newline
The side is drawn between $formula(3) and $formula(6)\0cm.
*/
drawRegularPolygon: macro(minSide: 3, maxSide: 8)
	@QuestionFactory
		parameters: do
			- @Choice
				for i in seq(minSide, maxSide)
					if 360/i == (360/i).floor()
						- $i
					end
				end
			end
		end
		hyperParameters: do
			- $Range(3, 6)
			- $Range(1, 180)
		end
		get: macro(n, l, offset)
			@Question(draw)
				description: do
					Tracer un\s
					if n==3
						triangle équilatéral
					elseif n==4
						carré
					elseif n==5
						pentagone régulier
					elseif n==6
						hexagone régulier
					elseif n==7
						heptagone régulier
					elseif n==8
						octogone régulier
					elseif n==9
						énéagone régulier
					elseif n==10
						décagone régulier
					end
					\sde côté $pages.formula($l\0cm).
				end
				tip: Il s'agit un polygone à $pages.formula($n) côté de longueur $pages.formula($l\0cm). Tous ses angles mesurent $pages.formula($(180-360/n)°).
				figure: do
					for i in seq(n)
						let A = $ Vect2D(r: 1, a: offset + (i-1)*360/n, ?deg)
						let B = $ Vect2D(r: 1, a: offset + i*360/n, ?deg)
						- $ Segment(A, B)
						- $ SegmentTickMark(A, B)
						if i==1
							- $ lineLabel(A, B, l.."cm")
						end
					end
				end
			end
		end
	end
end