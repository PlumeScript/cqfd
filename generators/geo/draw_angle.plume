let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Range from $import(../../core/parameters/range)
let Choice from $import(../../core/parameters/set)

use figure2D
let letters from $import(./utils)

let pages = $import(pages) // Should be in render

/*
Generate an angle to draw between $Param(Number[0-maxAngle], minAngle, 0) and $Param(Number[minAngle-180], maxAngle, 180).$newline
The angle will be a multiple of $Param(Number, precision, 1).$newline
There are shortcut:
@InfosList
	- $code(\0?zero) for $formula(0°)
	- $code(\0?acute) for $formula(1-89°)
	- $code(\0?right) for $formula(90°)
	- $code(\0?obtuse) for $formula(91-179°)
	- $code(\0?straight) for $formula(180°)
end
$code(\0?indirect) to indirect instruction.
*/
drawAngle: macro(Number minAngle: 0, Number maxAngle: 180, Number precision: 1, ?zero, ?acute, ?right, ?obtuse, ?straight, ?indirect)
	if zero
		set minAngle = 0
		set maxAngle = 0
	elseif acute
		set minAngle = 1
		set maxAngle = 89
	elseif right
		set minAngle = 90
		set maxAngle = 90
	elseif obtuse
		set minAngle = 91
		set maxAngle = 179
	elseif straight
		set minAngle = 180
		set maxAngle = 180
	end

	if minAngle > maxAngle
		raise `maxAngle` must be greater than `minAngle`.
	end
	if minAngle < 0
		raise `minAngle` must be greater than `0`.
	end
	if maxAngle > 180
		raise `maxAngle` must be `180` or less.
	end


	set minAngle = $(minAngle/precision).ceil()
	set maxAngle = $(maxAngle/precision).floor()
	if  minAngle > maxAngle
		raise `precision` is to high with theses angles values.
	end

	@QuestionFactory
		parameters: do
			- $ Range(minAngle, maxAngle)
		end
		hyperParameters: do
			- $letters(3)
			- $ Range(0, 360)
			- $ Range(5, 15)
		end
		get: macro(angle, letters, rotation, position)
			set angle *= $precision
			let _A, _B, _C = $letters
			@Question(draw)
				description: if indirect
					Placer $pages.formula($_A\, $_B\, $_C) tel que $pages.formula(\\widehat{$_A$_B$_C} = $angle°).
				else
					Tracer $pages.formula(\\widehat{$_A$_B$_C} = $angle°)
				end
				figure: do
					let A = $ Vect2D(a: rotation, r: 10, ?deg)
					let B = $ Vect2D(0, 0)
					let C = $ Vect2D(a: angle+rotation, r: position, ?deg)
					
					if not indirect
						- $ Angle(A, B, C)
					end
					- $ Dot(A, label: _A, angle: (B-A).normal().angle() ,?cross, ?deg)
					- $ Dot(B, label: _B, angle: 180 + rotation+angle/2, cross: indirect, ?deg)
					- $ Dot(C, label: _C, angle: 180 + (B-C).normal().angle(), ?cross, ?deg)
				end
			end
		end
	end
end