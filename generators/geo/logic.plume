// Dirty and rigid
// sub-optimal letter generation

// Intersection entre cercles/disques de centres différents
// corde/diamètre est segment/droite/demi-droite

let pages = $import(pages) // Should be in render

let Question from $import(../../core/cls/question)
let QuestionFactory from $import(../../core/cls/questionFactory)
let Choice from $import(../../core/parameters/set)
let Range from $import(../../core/parameters/range)

let figure2D = $import(figure2D)

let letters from $import(./utils)

ref lineNotationPool: do
	- do
		- macro(_, A, B, ...letters) $pages.formula([$A$B])
		- macro(_, A, B, ...letters) l'ensemble des points entre $pages.formula($A) et $pages.formula($B)
		- macro(_, A, B, ...letters) un segment
	end
	- do
		- macro(_, A, B, ...letters) $pages.formula(($A$B))
		- macro(_, A, B, ...letters) l'ensemble des points alignés avec $pages.formula($A) et $pages.formula($B)
		- macro(_, A, B, ...letters) une droite
	end
	- do
		- macro(_, A, B, ...letters) $pages.formula([$A$B\))
		- macro(_, A, B, ...letters) le segment $pages.formula([$A$B]) prolongé du côté de $pages.formula($B)
		- macro(_, A, B, ...letters) une demi-droite
	end
	- do
		- macro(_, A, B, ...letters) $pages.formula($A$B)
		- macro(_, A, B, ...letters) la distance entre $pages.formula($A) et $pages.formula($B)
		- macro(_, A, B, ...letters) un nombre
	end
end

circlePool: do
	- do
		- macro(n, O, ...letters) Le cercle de centre $pages.formula($O), de rayon $pages.formula($n\0cm)
		- macro(n, O, ...letters) l'ensemble des points situés à $pages.formula($n\0cm) exactement de $pages.formula($O)
	end
	- do
		- macro(n, O, ...letters) Le disque de centre $pages.formula($O), de rayon $pages.formula($n\0cm)
		- macro(n, O, ...letters) l'ensemble des points situés à $pages.formula($n\0cm) ou moins de $pages.formula($O)
	end
end

macro sentence(w)
	if w.sub(1, 1).find("[a-z]", ?rich)
		$w.sub(1, 1).upper()$w.sub(2, -1)
	else
		$w
	end
end


shuffle: macro(pool, ?alwaysTrue, ?alwaysFalse)
	if alwaysTrue and alwaysFalse
		raise Theses flags arn't compatibles
	end
	@QuestionFactory
		parameters: do
			- $Range(1, 4) // first
			- $Range(1, 3) // wich one
			if alwaysFalse
				- $Range(1, 4) // second
			else
				- $Choice(x)
			end
			- $Range(1, 3) // wich one
		end
		hyperParameters: do
			- $letters(3)
			- $Range(1, 10)
		end
		get: macro(a, b, c, d, letters, n)

			if alwaysTrue
				set c = $a
			end

			set a = $ (a-1) % len(pool) + 1
			set c = $ (c-1) % len(pool) + 1

			set b = $ (b-1) % len(pool[a]) + 1
			set d = $ (d-1) % len(pool[c]) + 1

			// Natural wording
			if b != 1
				set a, b, c, d = ($c, $d, $a, $b)
			end

			if a == c and b == d
				return
			elseif alwaysFalse and a == c
				return
			// Not double
			elseif b == d
				return
			// Not 3 first
			elseif pool == lineNotationPool and a == 3
				return
			// "un nombre" should be associated with a notation
			elseif pool == lineNotationPool and (c == 4 and d == 3 and b != 1 or a == 4 and b == 3 and d != 1)
				return
			end

			let given  = $pool[a][b]
			let target = $pool[c][d]
			
			return @Question(logic)
				instruction: @sentence $given($n, ...letters) est $target($n, ...letters)
				solution: do
					isTruth: $ a==c
					infos: do
						explanation: if a != c
							@sentence $given($n, ...letters) est $pool[a][d]($n, ...letters)
						else
							par définition
						end
					end
				end
				id: $a-$b-$c-$d
			end
		end
	end
end



let ifThenPool = do
	circle: do
		letters: 2
		number: 1
		valid: do
			- macro(A, B, n)
				sentence: si $pages.formula($A$B = $n\0cm), alors $pages.formula($A) appartient au cercle de centre $pages.formula($B), de rayon $pages.formula($n\0cm)
				explanation: par définition
			end
			// Reciproque
			- macro(A, B, n)
				sentence: si $pages.formula($A) appartient au cercle de centre $pages.formula($B), de rayon $pages.formula($n\0cm) alors $pages.formula($A$B = $n\0cm)
				explanation: par définition
			end
		end
		invalid: do
			- macro(A, B, n)
				sentence: si $pages.formula($A$B < $n\0cm), alors $pages.formula($A) appartient au cercle de centre $pages.formula($B), de rayon $pages.formula($n\0cm)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0))
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((0.5, 0.5), label: $A, ?cross)
				end
			end
			- macro(A, B, n)
				sentence: si $pages.formula($A$B > $n\0cm), alors $pages.formula($A) appartient au cercle de centre $pages.formula($B), de rayon $pages.formula($n\0cm)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0))
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((1.5, -0.5), label: $A, ?cross)
				end
			end
			// Reciproques
			- macro(A, B, n)
				sentence: si $pages.formula($A) appartient au cercle de centre $pages.formula($B), de rayon $pages.formula($n\0cm), alors $pages.formula($A$B < $n\0cm)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0))
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((-1, 0), label: $A, angle: $(-Math.pi), ?cross)
				end
			end
			- macro(A, B, n)
				sentence: si $pages.formula($A) appartient au cercle de centre $pages.formula($B), de rayon $pages.formula($n\0cm), alors $pages.formula($A$B > $n\0cm)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0))
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((-1, 0), label: $A, angle: $(-Math.pi), ?cross)
				end
			end
		end
	end
	disque: do
		letters: 2
		number: 1
		valid: do
			- macro(A, B, n)
				sentence: si $pages.formula($A$B = $n\0cm), alors $pages.formula($A) appartient au disque de centre $pages.formula($B), de rayon $pages.formula($n\0cm)
				explanation: par définition
			end
			- macro(A, B, n)
				sentence: si $pages.formula($A$B < $n\0cm), alors $pages.formula($A) appartient au disque de centre $pages.formula($B), de rayon $pages.formula($n\0cm)
				explanation: par définition
			end
			- macro(A, B, n)
				sentence: si $pages.formula($A) appartient au cercle de centre $pages.formula($B), de rayon $pages.formula($n\0cm), alors $pages.formula($A$B = $n\0cm)
				explanation: par définition
			end
			- macro(A, B, n)
				sentence: si $pages.formula($A) appartient au disque de centre $pages.formula($B), de rayon $pages.formula($n\0cm), alors $pages.formula($A$B \\leq $n\0cm)
				explanation: par définition
			end
		end
		invalid: do
			- macro(A, B, n)
				sentence: si $pages.formula($A$B > $n\0cm), alors $pages.formula($A) appartient au disque de centre $pages.formula($B), de rayon $pages.formula($n\0cm)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0), fill: #aaa5)
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((1.5, 0), label: $A, ?cross)
				end
			end
			// Reciproques
			- macro(A, B, n)
				sentence: si $pages.formula($A) appartient au disque de centre $pages.formula($B), de rayon $pages.formula($n\0cm), alors $pages.formula($A$B > $n\0cm)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0), fill: #aaa5)
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((0.5, 0.5), label: $A, ?cross)
				end
			end
			- macro(A, B, n)
				sentence: si $pages.formula($A) appartient au disque de centre $pages.formula($B), de rayon $pages.formula($n\0cm), alors $pages.formula($A$B = $n\0cm)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0), fill: #aaa5)
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((0.5, 0), label: $A, ?cross)
				end
			end
			- macro(A, B, n)
				sentence: si $pages.formula($A) appartient au disque de centre $pages.formula($B), de rayon $pages.formula($n\0cm), alors $pages.formula($A$B < $n\0cm)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0), fill: #aaa5)
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((-1, 0), label: $A, angle: $(-Math.pi), ?cross)
				end
			end
		end
	end
	center: do
		letters: 3
		number: 0
		valid: do
			- macro(A, B, C)
				sentence: si $pages.formula($A) est le centre du disque $pages.formula(\\mathscr D), alors $pages.formula($A \\in \\mathscr D)
				explanation: le centre est bien à moins d'un rayon... Du centre!
			end
			- macro(A, B, C)
				sentence: si $pages.formula([$A$B]) est un diamètre du cercle $pages.formula(\\mathscr C) de centre $pages.formula($C), alors $pages.formula($C \\in [$A$B])
				explanation: par définition
			end
			- macro(A, B, C)
				sentence: si $pages.formula([$A$B]) est un diamètre du cercle $pages.formula(\\mathscr C) de centre $pages.formula($C), alors $pages.formula( $A$C=$C$B)
				explanation: le centre du cercle est le milieu de tout diamètre
			end
			- macro(A, B, C)
				sentence: si $pages.formula([$A$B]) est un diamètre du cercle $pages.formula(\\mathscr C) de centre $pages.formula($C), alors $pages.formula($C) est le milieu de $pages.formula([$A$B])
				explanation: le centre du cercle est le milieu de tout diamètre
			end
			- macro(A, B, C)
				sentence: Si $pages.formula([$A$C]) est un rayon du cercle $pages.formula(\\mathscr C), alors   le centre de $pages.formula(\\mathscr C) est $pages.formula($A) ou $pages.formula($C)
				explanation: un rayon est le segment qui relie le centre du cercle à un point du cercle
			end
		end
		invalid: do
			- macro(A, B, C)
				sentence: si $pages.formula($A) est le centre du cercle $pages.formula(\\mathscr C), alors $pages.formula($A \\in \\mathscr C)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0))
					- $figure2D.Dot((0, 0), label: $A, ?cross)
				end
			end
			- macro(A, B, C)
				sentence: Soit $pages.formula(\\mathscr D) un disque. Si $pages.formula($A \\in \\mathscr D), alors $pages.formula($A) est le centre de $pages.formula(\\mathscr D)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0), fill: #aaa5)
					- $figure2D.Dot((0.5, 0.5), label: $A, ?cross)
				end
			end
			- macro(A, B, C)
				sentence: Si $pages.formula([$A$C]) est un rayon du cercle $pages.formula(\\mathscr C), alors  le centre de $pages.formula(\\mathscr C)  est $pages.formula($A)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0))
					- $figure2D.Segment((0, 0), (1, 0))
					- $figure2D.Dot((0, 0), label: $C, ?cross)
					- $figure2D.Dot((1, 0), label: $A, ?cross)
				end
			end
		end
	end
	radius: do
		letters: 3
		number: 0
		valid: do
			- macro(O, A, _)
				sentence: Soit $pages.formula(\\mathscr C) un cercle. Si $pages.formula($O) est le centre de $pages.formula(\\mathscr C) et $pages.formula($A \\in \\mathscr C), alors $pages.formula([$O$A]) est un rayon de $pages.formula(\\mathscr C)
				explanation: par définition
			end
			- macro(O, A, _)
				sentence: Soit $pages.formula(\\mathscr C) un cercle. Si $pages.formula($O \\in \\mathscr C) et $pages.formula($A \\in \\mathscr C), alors $pages.formula([$O$A]) est une corde de $pages.formula(\\mathscr C)
				explanation: par définition
			end
			- macro(O, A, _)
				sentence: Soit $pages.formula(\\mathscr C) un cercle. Si $pages.formula([$O$A]) est une corde de $pages.formula(\\mathscr C) passant par son centre, alors $pages.formula([$O$A]) est un diamètre de $pages.formula(\\mathscr C)
				explanation: par définition
			end
			- macro(A, B, C)
				sentence: Si $pages.formula($A) et $pages.formula($B) appartiennent au cercle de centre $pages.formula($C), alors $pages.formula($A$C = $B$C)
				explanation: tous les points du cercle sont à la même distance de son centre
			end
			// Reciproques
			- macro(O, A, _)
				sentence: Soit $pages.formula(\\mathscr C) un cercle. Si  $pages.formula([$O$A]) est une corde de $pages.formula(\\mathscr C), alors $pages.formula($O \\in \\mathscr C)
				explanation: par définition
			end
			- macro(O, A, _)
				sentence: Soit $pages.formula(\\mathscr C) un cercle. Si  $pages.formula([$O$A]) est une corde de $pages.formula(\\mathscr C), alors $pages.formula($A \\in \\mathscr C)
				explanation: par définition
			end
			- macro(O, A, _)
				sentence: Soit $pages.formula(\\mathscr C) un cercle. Si $pages.formula([$O$A]) est un diamètre de $pages.formula(\\mathscr C), alors $pages.formula([$O$A]) est une corde de $pages.formula(\\mathscr C) passant par son centre
				explanation: par définition
			end
			- macro(O, A, B)
				sentence: Soit $pages.formula(\\mathscr D) un disque de diamètre $pages.formula([$O$A]). Si $pages.formula($B \\in  [$O$A]) alors $pages.formula($B \\in \\mathscr D)
				explanation: un disque contient tous les points de son diamètre
			end
		end
		invalid: do
			- macro(O, A, _)
				sentence: Soit $pages.formula(\\mathscr C) un cercle. Si $pages.formula($O \\in \\mathscr C) et $pages.formula($A \\in \\mathscr C), alors $pages.formula([$O$A]) est un rayon de $pages.formula(\\mathscr C)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0))
					- $figure2D.Dot((0, 0), ?cross)
					- $figure2D.Segment((1, 0), (0, 1))
					- $figure2D.Dot((1, 0), label: $O, ?cross)
					- $figure2D.Dot((0, 1), label: $A, ?cross)
				end
			end
			- macro(O, A, _)
				sentence: Soit $pages.formula(\\mathscr C) un cercle. Si $pages.formula($O) est le centre de $pages.formula(\\mathscr C) et $pages.formula($A \\in \\mathscr C), alors $pages.formula([$O$A]) est une corde de $pages.formula(\\mathscr C)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0))
					- $figure2D.Segment((0, 0), (1, 0))
					- $figure2D.Dot((0, 0), label: $O, ?cross)
					- $figure2D.Dot((1, 0), label: $A, ?cross)
				end
			end
			- macro(O, A, _)
				sentence: Soit $pages.formula(\\mathscr C) un cercle. Si $pages.formula([$O$A]) passe par le centre de $pages.formula(\\mathscr C), alors $pages.formula([$O$A]) est un diamètre de $pages.formula(\\mathscr C)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0))
					- $figure2D.Dot((0, 0), ?cross)
					- $figure2D.Segment((-2, 0), (1.5, 0))
					- $figure2D.Dot((-2, 0), label: $O, ?cross)
					- $figure2D.Dot((1.5, 0), label: $A, ?cross)
				end
			end
			- macro(A, B, C)
				sentence: Si $pages.formula($A$C = $B$C), alors $pages.formula($A) et $pages.formula($B) appartiennent au cercle de centre $pages.formula($C)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0))
					- $figure2D.Dot((0, 0), label: $C, ?cross)
					- $figure2D.Dot((2, 0), label: $A, ?cross)
					- $figure2D.Dot((0, 2), label: $B, ?cross)
				end
			end
			- macro(A, B, C)
				sentence: Si $pages.formula($A) et $pages.formula($B) appartiennent au disque de centre $pages.formula($C), alors $pages.formula($A$C = $B$C)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0), fill: #aaa5)
					- $figure2D.Dot((0, 0), label: $C, ?cross)
					- $figure2D.Dot((0.4, -0.4), label: $A, ?cross)
					- $figure2D.Dot((0, 0.8), label: $B,  angle:$(Math.pi/2), ?cross)
				end
			end
			- macro(A, B, C)
				sentence: Si $pages.formula($A$C = $B$C), alors $pages.formula($A) et $pages.formula($B) appartiennent au disque de centre $pages.formula($C)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0), fill: #aaa5)
					- $figure2D.Dot((0, 0), label: $C, ?cross)
					- $figure2D.Dot((2, 0), label: $A, ?cross)
					- $figure2D.Dot((0, 2), label: $B, ?cross)
				end
			end
			- macro(O, A, B)
				sentence: Soit $pages.formula(\\mathscr C) un cercle de diamètre $pages.formula([$O$A]). Si $pages.formula($B \\in  [$O$A]) alors $pages.formula($B \\in \\mathscr C)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0))
					- $figure2D.Segment((-1, 0), (1, 0))
					- $figure2D.Dot((-1, 0), label: $O, ?cross)
					- $figure2D.Dot((1, 0), label: $A, ?cross)
					- $figure2D.Dot((0.5, 0), label: $B, ?cross)
				end
			end
		end
	end

	_in: do
		letters: 3
		number: 0
		valid: do
			- macro(A, B, C)
				sentence: si $pages.formula($A \\in [$B$C]), alors $pages.formula($A) est "sur" $pages.formula([$B$C])
				explanation: par définition
			end
			- macro(A, B, C)
				sentence: si $pages.formula($A) est "sur" $pages.formula([$B$C]), alors on écrira $pages.formula($A \\in [$B$C])
				explanation: par définition
			end
			- macro(A, B, C)
				sentence: si $pages.formula($A \\notin [$B$C]), alors $pages.formula($A) est "en dehors" de $pages.formula([$B$C])
				explanation: par définition
			end
		end
		invalid: do
			- macro(A, B, C)
				sentence: si $pages.formula($A \\in [$B$C]), alors $pages.formula($A) est "en dehors" de $pages.formula([$B$C])
				explanation: $pages.formula($A) est "sur" de $pages.formula([$B$C])
			end
			- macro(A, B, C)
				sentence: si $pages.formula($A \\notin [$B$C]), alors $pages.formula($A) est "sur" $pages.formula([$B$C])
				explanation: $pages.formula($A) est "en dehors" de $pages.formula([$B$C])
			end
			- macro(A, B, C)
				sentence: si $pages.formula($A) est "sur" $pages.formula([$B$C]), alors on écrira $pages.formula($A \\notin [$B$C])
				explanation:  on écrira $pages.formula($A \\in [$B$C])
			end
		end
	end
	middle: do
		letters: 3
		number: 0
		valid: do
			- macro(A, B, C)
				sentence: si $pages.formula($A$B=$B$C) et $pages.formula($B \\in [$A$C]), alors $pages.formula($B) est le milieu de $pages.formula([$A$C])
				explanation: par définition
			end
			- macro(A, B, C)
				sentence: si $pages.formula($B) est le milieu de $pages.formula([$A$C]), alors $pages.formula($A$B=$B$C)
				explanation: par définition
			end
			- macro(A, B, C)
				sentence: si $pages.formula($B) est le milieu de $pages.formula([$A$C]), alors $pages.formula($B \\in [$A$C])
				explanation: par définition
			end
			- macro(A, B, C)
				sentence: si $pages.formula($B) est le milieu de $pages.formula([$A$C]), alors $pages.formula($B$C = $A$C \\div 2)
				explanation: le milieu de $pages.formula([$A$C]) est à égale distance des extrémités, soit la moitié de la longueur
			end
		end
		invalid: do
			- macro(A, B, C)
				sentence: si $pages.formula($A$B=$B$C), alors $pages.formula($B) est le milieu de $pages.formula([$A$C])
				figure: do
					- $figure2D.Segment((-1, 0), (1, 0))
					- $figure2D.Dot((-1, 0), label: $A, ?cross)
					- $figure2D.Dot((1, 0), label: $C, ?cross)
					- $figure2D.Dot((0, 1), label: $B, ?cross)
				end
			end
			- macro(A, B, C)
				sentence: si $pages.formula($B \\in [$A$C]), alors $pages.formula($B) est le milieu de $pages.formula([$A$C])
				figure: do
					- $figure2D.Segment((-1, 0), (1, 0))
					- $figure2D.Dot((-1, 0), label: $A, ?cross)
					- $figure2D.Dot((1, 0), label: $C, ?cross)
					- $figure2D.Dot((-0.5, 0), label: $B, ?cross)
				end
			end
		end
	end
	inter: do
		letters: 5
		number: 0
		valid: do
			- macro(A, B, C, D, E)
				sentence: Si $pages.formula($E \\in ($A$B)) et $pages.formula($E \\in ($C$D)) alors $pages.formula($E) est un point d'intersection de $pages.formula(($A$B)) et $pages.formula(($C$D))
				explanation: par définition
			end
			- macro(A, B, C, D, E)
				sentence: Si $pages.formula($E) est un point d'intersection de $pages.formula(($A$B)) et $pages.formula(($C$D)) alors $pages.formula($E \\in ($A$B)) et $pages.formula($E \\in ($C$D))
				explanation: par définition
			end
		end
		invalid: do
			- macro(A, B, C, D, E)
				sentence: Si $pages.formula($E) est un point d'intersection de $pages.formula(($A$B)) et $pages.formula(($C$D)) alors $pages.formula($E \\in [$A$B]) et $pages.formula($E \\in [$C$D)]
				figure: do
					- $figure2D.Line((0, 0), (1, 0))
					- $figure2D.Line((2, 1), (2, 2))
					- $figure2D.Dot((0, 0), label: $A, ?cross)
					- $figure2D.Dot((1, 0), label: $B, ?cross)
					- $figure2D.Dot((2, 1), label: $C, angle: 0, ?cross)
					- $figure2D.Dot((2, 2), label: $D, angle: 0, ?cross)
					- $figure2D.Dot((2, 0), label: $E, angle: $(-Math.pi/4), ?cross)
				end
			end
			- macro(A, B, C, D, E)
				sentence: Si $pages.formula($E \\in ($A$B)) et $pages.formula($E \\in ($C$D)) alors $pages.formula($E) est un point d'intersection de $pages.formula([$A$B]) et $pages.formula([$C$D])
				figure: do
					- $figure2D.Line((0, 0), (1, 0))
					- $figure2D.Line((2, 1), (2, 2))
					- $figure2D.Dot((0, 0), label: $A, ?cross)
					- $figure2D.Dot((1, 0), label: $B, ?cross)
					- $figure2D.Dot((2, 1), label: $C, angle: 0, ?cross)
					- $figure2D.Dot((2, 2), label: $D, angle: 0, ?cross)
					- $figure2D.Dot((2, 0), label: $E, angle: $(-Math.pi/4), ?cross)
				end
			end
		end
	end

	segmentLength: do
		letters: 3
		number: 1
		valid: do
			- macro(A, B, C, n)
				sentence: Si $pages.formula($A \\in [$B$C]), alors $pages.formula($A$B \\leq $B$C)
				explanation: si $pages.formula($A \\in [$B$C]), alors $pages.formula($A$B + $A$C = $B$C), donc $pages.formula($A$B \\leq $B$C)
			end
			- macro(A, B, C, n)
				sentence: Si $pages.formula($A$B > $B$C), alors $pages.formula($A \\notin [$B$C])
				explanation: par définition
			end
		end
		invalid: do
			- macro(A, B, C, n)
				sentence: Si $pages.formula($A$B \\leq $B$C), alors $pages.formula($A \\in [$B$C])
				figure: do
					- $figure2D.Segment((0, 0), (2, 0))
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((2, 0), label: $C, ?cross)
					- $figure2D.Dot((0.25, 0.5), label: $A, angle:$(Math.pi/2), ?cross)
				end
			end
			- macro(A, B, C, n)
				sentence: Si $pages.formula($A \\notin [$B$C]), alors $pages.formula($A$B > $B$C)
				figure: do
					- $figure2D.Segment((0, 0), (2, 0))
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((2, 0), label: $C, ?cross)
					- $figure2D.Dot((0.25, 0.5), label: $A, angle:$(Math.pi/2), ?cross)
				end
			end
		end
	end

	lineInter: do
		letters: 3
		number: 0
		valid: do
			- macro(A, B, C)
				sentence: Si $pages.formula($A \\in [$B$C]), alors $pages.formula($A \\in ($B$C))
			end
			- macro(A, B, C)
				sentence: Si $pages.formula($A \\in [$B$C]), alors $pages.formula($A \\in [$B$C\))
			end
			- macro(A, B, C)
				sentence: Si $pages.formula($A \\in [$B$C\)), alors $pages.formula($A \\in ($B$C))
			end
		end
		invalid: do
			- macro(A, B, C)
				sentence: Si $pages.formula($A \\in ($B$C)), alors $pages.formula($A \\in [$B$C])
				figure: do
					- $figure2D.Line((0, 0), (2, 0))
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((2, 0), label: $C, ?cross)
					- $figure2D.Dot((3, 0), label: $A, angle: $(Math.pi/2), ?cross)
				end
			end
			- macro(A, B, C)
				sentence: Si $pages.formula($A \\in [$B$C\)), alors $pages.formula($A \\in [$B$C])
				figure: do
					- $figure2D.HalfLine((0, 0), (2, 0))
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((2, 0), label: $C, ?cross)
					- $figure2D.Dot((3, 0), label: $A, angle: $(Math.pi/2), ?cross)
				end
			end
			- macro(A, B, C)
				sentence: Si $pages.formula($A \\in ($B$C)), alors $pages.formula($A \\in [$B$C\))
				figure: do
					- $figure2D.Line((0, 0), (2, 0))
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((2, 0), label: $C, ?cross)
					- $figure2D.Dot((-1, 0), label: $A, angle: $(Math.pi/2), ?cross)
				end
			end
		end
	end

	doubleDisque: do
		letters: 2
		number: 2
		valid: do
			- macro(A, B, n1, n2)
				if n1==n2
					set n1 += 1
				end
				do
					sentence: Si $pages.formula($A) appartient au disque de centre $pages.formula($B) de rayon $pages.formula($(min(n1, n2))cm), alors $pages.formula($A) appartient au disque de centre $pages.formula($B) de rayon $pages.formula($(max(n1, n2))cm)
					explanation: un disque est inclus dans le disque de même centre et de rayon plus grand
				end
			end
			- macro(A, B, n1, n2)
				if n1==n2
					set n1 += 1
				end
				do
					sentence: Si $pages.formula($A) appartient au cercle de centre $pages.formula($B) de rayon $pages.formula($(min(n1, n2))cm), alors $pages.formula($A) appartient au disque de centre $pages.formula($B) de rayon $pages.formula($(max(n1, n2))cm)
					explanation: un cercle est inclus dans le disque de même centre et de rayon plus grand
				end
			end
		end
		invalid: do
			- macro(A, B, n1, n2)
				if n1==n2
					set n1 += 1
				end
				do
					sentence: Si $pages.formula($A) appartient au disque de centre $pages.formula($B) de rayon $pages.formula($(max(n1, n2))cm), alors $pages.formula($A) appartient au disque de centre $pages.formula($B) de rayon $pages.formula($(min(n1, n2))cm)
					figure: do
						- $figure2D.Circle((0, 0), (2, 0), fill: #ddd)
						- $figure2D.Circle((0, 0), (1, 0), fill: #aaa)
						- $figure2D.Dot((1.5, 0), label: $A, angle: $(Math.pi/4), ?cross)
					end
				end
			end
			- macro(A, B, n1, n2)
				if n1==n2
					set n1 += 1
				end
				do
					sentence: Si $pages.formula($A) appartient au cercle de centre $pages.formula($B) de rayon $pages.formula($(max(n1, n2))cm), alors $pages.formula($A) appartient au disque de centre $pages.formula($B) de rayon $pages.formula($(min(n1, n2))cm)
					figure: do
						- $figure2D.Circle((0, 0), (2, 0))
						- $figure2D.Circle((0, 0), (1, 0), fill: #aaa5)
						- $figure2D.Dot((2, 0), label: $A, angle: $(Math.pi/4), ?cross)
					end
				end
			end
			- macro(A, B, n1, n2)
				if n1==n2
					set n1 += 1
				end
				do
					sentence: Si $pages.formula($A) appartient au disque de centre $pages.formula($B) de rayon $pages.formula($(min(n1, n2))cm), alors $pages.formula($A) appartient au cercle de centre $pages.formula($B) de rayon $pages.formula($(max(n1, n2))cm)
					figure: do
						- $figure2D.Circle((0, 0), (2, 0))
						- $figure2D.Circle((0, 0), (1, 0), fill: #aaa5)
						- $figure2D.Dot((0.5, 0.5), label: $A, angle: $(Math.pi/4), ?cross)
					end
				end
			end
		end
	end

	circleDisque: do
		letters: 2
		number: 1
		valid: do
			- macro(A, B, n)
				sentence: Si $pages.formula($A) appartient au cercle de centre $pages.formula($B) de rayon $pages.formula($n\0cm), alors $pages.formula($A) appartient au disque de centre $pages.formula($B) de rayon $pages.formula($n\0cm)
				explanation: un cercle est inclus dans le disque de même centre et de même rayon
			end
			- macro(A, B, n)
				sentence: Si $pages.formula($A) n'appartient pas au disque de centre $pages.formula($B) de rayon $pages.formula($n\0cm), alors $pages.formula($A) n'appartient pas au cercle de centre $pages.formula($B) de rayon $pages.formula($n\0cm)
				explanation: par contraposée
			end
		end
		invalid: do
			- macro(A, B, n)
				sentence: Si $pages.formula($A) appartient au disque de centre $pages.formula($B) de rayon $pages.formula($n\0cm), alors $pages.formula($A) appartient au cercle de centre $pages.formula($B) de rayon $pages.formula($n\0cm)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0), fill: #aaa5)
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((0.5, 0.5), label: $A, ?cross)
				end
			end
			- macro(A, B, n)
				sentence: Si $pages.formula($A) n'appartient pas au cercle de centre $pages.formula($B) de rayon $pages.formula($n\0cm), alors $pages.formula($A) n'appartient pas au disque de centre $pages.formula($B) de rayon $pages.formula($n\0cm)
				figure: do
					- $figure2D.Circle((0, 0), (1, 0), fill: #aaa5)
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((0.4, -0.4), label: $A, ?cross)
				end
			end
		end
	end

	align: do
		letters: 3
		number: 0
		valid: do
			- macro(A, B, C)
				sentence: Si $pages.formula($A\, $B\, $C) sont alignés, alors $pages.formula($A \\in ($B$C))
				explanation: par définition
			end
			- macro(A, B, C)
				sentence: Si $pages.formula($A \\in ($B$C)), alors $pages.formula($A\, $B\, $C) sont alignés
				explanation: par définition
			end
			// rec false
			- macro(A, B, C)
				sentence: Si $pages.formula($A \\in [$B$C\)), alors $pages.formula($A\, $B\, $C) sont alignés
				explanation: tous les points de $pages.formula([$B$C\\)) sont sur la droite $pages.formula(($B$C))
			end
			// rec false
			- macro(A, B, C)
				sentence: Si $pages.formula($A \\in [$B$C]), alors $pages.formula($A\, $B\, $C) sont alignés
				explanation: tous les points de $pages.formula([$B$C]) sont sur la droite $pages.formula(($B$C))
			end
		end
		invalid: do
			- macro(A, B, C)
				sentence: Si $pages.formula($A\, $B\, $C) sont alignés, alors $pages.formula($A \\in [$B$C])
				figure: do
					- $figure2D.Line((0, 0), (1, 0))
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((1, 0), label: $C, ?cross)
					- $figure2D.Dot((1.5, 0), label: $A, angle: $(Math.pi/2), ?cross)
				end
			end
			// rec true
			- macro(A, B, C)
				sentence: Si $pages.formula($A\, $B\, $C) sont alignés, alors $pages.formula($A \\in [$B$C\))
				figure: do
					- $figure2D.Line((0, 0), (1, 0))
					- $figure2D.Dot((0, 0), label: $B, ?cross)
					- $figure2D.Dot((1, 0), label: $C, ?cross)
					- $figure2D.Dot((-0.5, 0), label: $A, angle: $(Math.pi/2), ?cross)
				end
			end
		end
	end

	
end

ifThen: do
	for name, infos in items(ifThenPool)
		$name: @QuestionFactory
			parameters: do
				- $ Range(1, len(infos.valid) + len(infos.invalid))
			end
			hyperParameters: do
				for i in seq(infos.number)
					- $Range(1, 20)
				end
				letters: $ letters(infos.letters)
			end
			get: macro(i, letters:, ...numbers)
				let valid = $ i <= len(infos.valid)
				let item = if valid
					$infos.valid[i]
				else
					$infos.invalid[i-len(infos.valid)]
				end

				let infos = $item(...List($letters), ...numbers)
				@Question(logic)
					instruction: @sentence $infos.sentence
					solution: do
						isTruth: $valid
						infos: $infos
					end
					id: $i
				end
			end
		end
	end
end